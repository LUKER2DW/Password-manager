# Copy to .env (git-ignored) and fill in. Read by apps/mobile-android/build.ps1 and
# tools/release/make-manifest-keys.ps1.
# Without a .env, build.ps1 takes the key made by make-release-key.ps1 and its password sealed
# for this Windows user (DPAPI); without either, it signs with the Android debug key.

# The Android release key (PKCS#12, alias "vault").
VAULT_SIGNING_STORE=C:\path\to\release.p12
# Its password. Kept in plain text here: anyone who can read this file can sign an "update".
VAULT_SIGNING_PASSWORD=

# The release manifest's keys (tools/release/make-manifest-keys.ps1). Without these, the script
# keeps them in %APPDATA%\PasswordVault\signing with their passwords sealed for this Windows
# user (DPAPI). Places of the sealed key files, if elsewhere:
VAULT_MANIFEST_KEY=
VAULT_MANIFEST_BACKUP_KEY=
# Their passwords, in plain text here: anyone who can read this file and the keys can sign a
# release the apps take.
VAULT_MANIFEST_PASSWORD=
VAULT_MANIFEST_BACKUP_PASSWORD=
