# Copy to .env (git-ignored) and fill in. Read by apps/mobile-android/build.ps1.
# Without a .env, build.ps1 takes the key made by make-release-key.ps1 and its password sealed
# for this Windows user (DPAPI); without either, it signs with the Android debug key.

# The Android release key (PKCS#12, alias "vault").
VAULT_SIGNING_STORE=C:\path\to\release.p12
# Its password. Kept in plain text here: anyone who can read this file can sign an "update".
VAULT_SIGNING_PASSWORD=
