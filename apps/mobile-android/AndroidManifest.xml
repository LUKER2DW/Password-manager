<?xml version="1.0" encoding="utf-8"?>
<!-- The phone app's identity and what it may do. build.gradle builds the APK from it, with the
     Rust library (cargo, see build.ps1) as its native code. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sync with the person's own server or WebDAV folder; fingerprint unlock; updates of the
         app from that server (Android still asks the person, and checks the update's
         signature). No camera permission: Google's code scanner (Play services) shows its own
         camera screen and hands back only the code's text. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- What this app may see of the others (Android 11 on): those that open https links, so
         autofill can tell a browser from another app and check its certificate (Place.java);
         and the system's installer, which shows the question before an update goes in. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.content.pm.action.CONFIRM_INSTALL" />
        </intent>
    </queries>

    <!-- Plain http is let through by Android only so a Tailscale address (100.x.y.z, encrypted
         by WireGuard) works; the app itself refuses http:// to anywhere else (sync/http.rs). -->
    <application
        android:label="Vault"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <!-- Play services fetches the QR code scanner when the app is installed, not at the
             first scan. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- NativeActivity running the Rust library, plus the system's pickers, fingerprint
             unlock, the code scanner and updates (VaultActivity.java). -->
        <activity
            android:name="org.passwordvault.phone.VaultActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|uiMode|density">
            <meta-data
                android:name="android.app.lib_name"
                android:value="vault_mobile_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The screen that asks for the fingerprint before a fill. -->
        <activity
            android:name="org.passwordvault.phone.AutofillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The installer's answers: not exported, so only the PendingIntent the installer was
             given leads here. -->
        <receiver
            android:name="org.passwordvault.phone.InstallReceiver"
            android:exported="false" />

        <service
            android:name="org.passwordvault.phone.VaultAutofillService"
            android:label="@string/autofill_label"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>
