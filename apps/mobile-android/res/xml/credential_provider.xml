<?xml version="1.0" encoding="utf-8"?>
<!-- What Vault answers through Android's Credential Manager (VaultCredentialService.java):
     passkeys. Passwords go through autofill, as before. -->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
