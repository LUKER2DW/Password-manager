msgstr "Por WebDAV: {}"

msgctxt "PhoneWindow"
msgid "Through your vault server: {}"
msgstr "Pelo seu servidor de cofre: {}"

msgctxt "PhoneWindow"
msgid "Its own HTTPS certificate, checked against the one this phone knows"
msgstr "Certificado HTTPS próprio, conferido com o que este celular conhece"

msgctxt "PhoneWindow"
msgid "Shows a QR code for the other device"
msgstr "Mostra um QR code para o outro aparelho"

msgctxt "PhoneWindow"
msgid "In the folder"
msgstr "Na pasta"

msgctxt "PhoneWindow"
msgid "One sealed copy per device; this phone's is {}"
msgstr "Uma cópia lacrada por aparelho; a deste celular tem {}"

msgctxt "PhoneWindow"
msgid "{n} copy"
msgid_plural "{n} copies"
msgstr[0] "{n} cópia"
msgstr[1] "{n} cópias"

msgctxt "PhoneWindow"
msgid "When it moved to a new name or address"
msgstr "Quando ele muda de nome ou endereço"

msgctxt "PhoneWindow"
msgid "Type where the server is now. The phone checks that the server there knows it before using it. Its certificate stays the one this phone knows unless the address you type brings a new #pin=."
msgstr "Digite onde o servidor está agora. O celular confere se o servidor de lá o conhece antes de usá-lo. O certificado continua o que este celular conhece, a menos que o endereço digitado traga um novo #pin=."

msgctxt "PhoneWindow"
msgid "Keeps syncing while one doesn't answer"
msgstr "Continua sincronizando enquanto um não responde"

msgctxt "PhoneWindow"
msgid "Paste an invite for it: the vaultsync: line from Add a device on a device that already uses it, or one from vault-server invite with its address below."
msgstr "Cole um convite para ele: a linha vaultsync: de Adicionar um aparelho em um aparelho que já o usa, ou uma de vault-server invite com o endereço dele abaixo."

msgctxt "PhoneWindow"
msgid "What changed"
msgstr "O que mudou"

msgctxt "PhoneWindow"
msgid "installed"
msgstr "instalada"

msgctxt "PhoneWindow"
msgid "Only the newest"
msgstr "Só a mais nova"

msgctxt "PhoneWindow"
msgid "Earlier versions too"
msgstr "Versões anteriores também"

msgctxt "PhoneWindow"
msgid "No logins with a password yet."
msgstr "Ainda não há logins com senha."

msgctxt "PhoneWindow"
msgid "Nothing to fix: every password is strong, used once and not found in a leak the watch knows of."
msgstr "Nada para corrigir: toda senha é forte, usada uma vez só e não aparece em nenhum vazamento conhecido pela vigilância."

msgctxt "PhoneWindow"
msgid "New folder"
msgstr "Nova pasta"

msgctxt "PhoneWindow"
msgid "This folder"
msgstr "Esta pasta"

msgctxt "PhoneWindow"
msgid "Icon"
msgstr "Ícone"

msgctxt "PhoneWindow"
msgid "Delete this folder"
msgstr "Excluir esta pasta"

msgctxt "PhoneWindow"
msgid "Back"
msgstr "Voltar"

msgctxt "PhoneWindow"
msgid "One-time code (counter)"
msgstr "Código de uso único (contador)"

msgctxt "PhoneWindow"
msgid "One-time code"
msgstr "Código de uso único"

msgctxt "PhoneWindow"
msgid "Website, not encrypted (http)"
msgstr "Site, sem criptografia (http)"

msgctxt "PhoneWindow"
msgid "Open"
msgstr "Abrir"

msgctxt "PhoneWindow"
msgid "View"
msgstr "Ver"

msgctxt "PhoneWindow"
msgid "Created {}"
msgstr "Criado em {}"

msgctxt "PhoneWindow"
msgid "Last edited {}"
msgstr "Editado por último em {}"

msgctxt "PhoneWindow"
msgid "When you turn on two-step sign-in, the site shows a QR code: scan it, or paste the text key shown under it (often under “Can't scan it?”), or an otpauth:// link."
msgstr "Quando você liga o login em duas etapas, o site mostra um QR code: escaneie, ou cole a chave em texto que aparece embaixo dele (muitas vezes em “Não consegue escanear?”), ou um link otpauth://."

msgctxt "PhoneWindow"
msgid "Kind of code"
msgstr "Tipo de código"

msgctxt "PhoneWindow"
msgid "Time-based"
msgstr "Por tempo"

msgctxt "PhoneWindow"
msgid "Counter-based"
msgstr "Por contador"

msgctxt "PhoneWindow"
msgid "Card name"
msgstr "Nome do cartão"

msgctxt "PhoneWindow"
msgid "Service"
msgstr "Serviço"

msgctxt "PhoneWindow"
msgid "Taken from the QR code or key"
msgstr "Tirado do QR code ou da chave"

msgctxt "PhoneWindow"
msgid "The server or what the key is for"
msgstr "O servidor ou para que serve a chave"

msgctxt "PhoneWindow"
msgid "PIN, if it has one"
msgstr "PIN, se tiver"

msgctxt "PhoneWindow"
msgid "Online cards have none"
msgstr "Cartões virtuais não têm"

msgctxt "PhoneWindow"
msgid "Scan the QR code the site shows for its authenticator app, or paste the key shown under it (often under “Can't scan it?”). Leave it empty if the site has none."
msgstr "Escaneie o QR code que o site mostra para o app autenticador, ou cole a chave que aparece embaixo dele (muitas vezes em “Não consegue escanear?”). Deixe vazio se o site não tiver."

msgctxt "PhoneWindow"
msgid "Notes can be formatted: **bold**, *italic*, `code`, lists with - and links."
msgstr "As notas aceitam formatação: **negrito**, *itálico*, `código`, listas com - e links."

msgctxt "PhoneWindow"
msgid "Folder"
msgstr "Pasta"

msgctxt "PhoneWindow"
msgid "No folder"
msgstr "Sem pasta"

msgctxt "PhoneWindow"
msgid "Back to automatic"
msgstr "Voltar ao automático"

msgctxt "PhoneWindow"
msgid "Your master password"
msgstr "Sua senha mestra"

msgctxt "Words"
msgid "The export couldn't be made ({})."
msgstr "Não foi possível fazer a exportação ({})."

msgctxt "Words"
msgid "Some items are behind the item lock, and the export would leave their secrets out. Open one of them first (one right answer opens them all for a while), then export."
msgstr "Alguns itens estão atrás do bloqueio de itens, e a exportação deixaria os segredos deles de fora. Abra um deles antes (uma resposta certa abre todos por um tempo) e exporte depois."

msgctxt "Words"
msgid "That isn't the file's password. Try again."
msgstr "Essa não é a senha do arquivo. Tente de novo."

msgctxt "Words"
msgid "Give the export a password of at least 12 characters."
msgstr "Dê à exportação uma senha de pelo menos 12 caracteres."

msgctxt "Words"
msgid "“{}” has a password"
msgstr "“{}” tem senha"

msgctxt "Words"
msgid "Change the master password"
msgstr "Trocar a senha mestra"

msgctxt "Words"
msgid "“{}” is locked"
msgstr "“{}” está bloqueado"

msgctxt "Words"
msgid "The file is protected. Type the password it was saved with; it is used only to read the file."
msgstr "O arquivo é protegido. Digite a senha com que ele foi salvo; ela é usada só para ler o arquivo."

msgctxt "Words"
msgid "The Secret Key and your emergency kit stay the same. Devices that sync this vault ask for the new password at their next unlock."
msgstr "A chave secreta e o seu kit de emergência continuam os mesmos. Os aparelhos que sincronizam este cofre pedem a nova senha no próximo desbloqueio."

msgctxt "Words"
msgid "Import"
msgstr "Importar"

msgctxt "Words"
msgid "Change password"
msgstr "Trocar senha"

msgctxt "Words"
msgid "Show the secrets"
msgstr "Mostrar os segredos"

msgctxt "PhoneWindow"
msgid "A password for the export"
msgstr "Uma senha para a exportação"

msgctxt "PhoneWindow"
msgid "The file's password"
msgstr "A senha do arquivo"

msgctxt "PhoneWindow"
msgid "Your master password is asked first. A plain export (JSON or CSV) holds every password unencrypted: anyone who gets the file reads them. The protected export opens only with the password you give it."
msgstr "Sua senha mestra é pedida antes. Uma exportação simples (JSON ou CSV) guarda todas as senhas sem criptografia: quem pegar o arquivo consegue lê-las. A exportação protegida só abre com a senha que você der a ela."

msgctxt "PhoneWindow"
msgid "Encrypted with a password you choose"
msgstr "Criptografada com uma senha que você escolhe"

msgctxt "PhoneWindow"
msgid "Its export: a JSON or CSV file, a KeePass database (.kdbx), or this app's protected export (.vaultx); a file with a password asks for it. Logins already in the vault are skipped. Delete a plain export once it is imported."
msgstr "A exportação dele: um arquivo JSON ou CSV, um banco do KeePass (.kdbx) ou a exportação protegida deste app (.vaultx); um arquivo com senha pede por ela. Logins que já estão no cofre são pulados. Apague uma exportação simples depois de importá-la."

msgctxt "PhoneWindow"
msgid "The secrets of this item are locked. Your master password shows them."
msgstr "Os segredos deste item estão bloqueados. Sua senha mestra os mostra."

msgctxt "PhoneWindow"
msgid "The secrets of this item are locked. The item PIN shows them."
msgstr "Os segredos deste item estão bloqueados. O PIN dos itens os mostra."

msgctxt "PhoneWindow"
msgid "The secrets of this item are locked. The item password shows them."
msgstr "Os segredos deste item estão bloqueados. A senha dos itens os mostra."

msgctxt "PhoneWindow"
msgid "Type your master password to see its secrets."
msgstr "Digite sua senha mestra para ver os segredos dele."

msgctxt "PhoneWindow"
msgid "Type the item PIN to see its secrets."
msgstr "Digite o PIN dos itens para ver os segredos dele."

msgctxt "PhoneWindow"
msgid "Type the item password to see its secrets."
msgstr "Digite a senha dos itens para ver os segredos dele."

msgctxt "PhoneWindow"
msgid "Exporting…"
msgstr "Exportando…"

msgctxt "Messages"
msgid "Password vault"
msgstr "Cofre de senhas"

msgctxt "Words"
msgid "That is the public key. The private one is the file of the same name without .pub (often id_ed25519 or id_rsa)."
msgstr "Essa é a chave pública. A privada é o arquivo de mesmo nome sem .pub (muitas vezes id_ed25519 ou id_rsa)."

msgctxt "Words"
msgid "This form of key isn't read here (PuTTY's .ppk, or an older encrypted form). On a computer, ssh-keygen -p -f with the key's file writes it in OpenSSH's form; then bring that."
msgstr "Este formato de chave não é lido aqui (o .ppk do PuTTY, ou um formato criptografado mais antigo). Num computador, ssh-keygen -p -f com o arquivo da chave a grava no formato do OpenSSH; depois traga essa."

msgctxt "Words"
msgid "That passphrase doesn't open the key. Try again."
msgstr "Essa frase secreta não abre a chave. Tente de novo."

msgctxt "Words"
msgid "Clear the list?"
msgstr "Limpar a lista?"

msgctxt "Words"
msgid "Delete this password from the list?"
msgstr "Excluir esta senha da lista?"

msgctxt "Words"
msgid "Add a device to this vault?"
msgstr "Adicionar um aparelho a este cofre?"

msgctxt "Words"
msgid "The key has a passphrase"
msgstr "A chave tem uma frase secreta"

msgctxt "Words"
msgid "Every password copied or used from the generator leaves this phone's list. This can't be undone."
msgstr "Todas as senhas copiadas ou usadas do gerador saem da lista deste celular. Isso não pode ser desfeito."

msgctxt "Words"
msgid "It leaves this phone's list. A login that uses it keeps it."
msgstr "Ela sai da lista deste celular. Um login que a usa continua com ela."

msgctxt "Words"
msgid "Your vault server makes a one-time invite and this phone shows it as a QR code, for an hour. The other device still needs your master password and Secret Key."
msgstr "O seu servidor do cofre cria um convite de uso único e este celular o mostra como QR code, por uma hora. O outro aparelho ainda precisa da sua senha mestra e da Chave Secreta."

msgctxt "Words"
msgid "Type it once to open the key. The vault keeps the key without it: the vault itself protects it, and the copy you take out works without a passphrase."
msgstr "Digite-a uma vez para abrir a chave. O cofre guarda a chave sem ela: o próprio cofre a protege, e a cópia que você tirar funciona sem frase secreta."

msgctxt "Words"
msgid "Clear"
msgstr "Limpar"

msgctxt "Words"
msgid "Show the invite"
msgstr "Mostrar o convite"

msgctxt "Words"
msgid "Open the key"
msgstr "Abrir a chave"

msgctxt "ColorRow"
msgid "Its own colour"
msgstr "A cor própria"

msgctxt "ColorRow"
msgid "Colour {}"
msgstr "Cor {}"

msgctxt "LookPicker"
msgid "Icon colour"
msgstr "Cor do ícone"

msgctxt "LookPicker"
msgid "Tile colour"
msgstr "Cor do fundo"

msgctxt "PhoneWindow"
msgid "The key's passphrase"
msgstr "A frase secreta da chave"

msgctxt "PhoneWindow"
msgid "Leave the folder"
msgstr "Sair da pasta"

msgctxt "PhoneWindow"
msgid "{}s"
msgstr "{}s"

msgctxt "PhoneWindow"
msgid "The name is kept in the vault, so your other devices show it too. The icon is this phone's own. The phone keeps its copy in the app's private storage, where other apps can't read it and Android encrypts it with the phone."
msgstr "O nome fica guardado no cofre, então os seus outros aparelhos também o mostram. O ícone é só deste celular. O celular guarda a cópia dele no armazenamento privado do app, onde outros apps não leem e o Android a criptografa com o celular."

msgctxt "PhoneWindow"
msgid "Choose"
msgstr "Escolher"

msgctxt "PhoneWindow"
msgid "Inside"
msgstr "Dentro de"

msgctxt "PhoneWindow"
msgid "No folder: at the top"
msgstr "Nenhuma pasta: no topo"

msgctxt "PhoneWindow"
msgid "Icon and colour"
msgstr "Ícone e cor"

msgctxt "PhoneWindow"
msgid "A folder keeps related items together; choose one in an item's editor. A folder can go inside another (Inside): it then shows under it, and opening the outer one shows the items of both. Deleting a folder keeps its items (they go back to no folder) and the folders inside it."
msgstr "Uma pasta junta itens relacionados; escolha uma no editor de um item. Uma pasta pode ficar dentro de outra (Dentro de): ela aparece embaixo dela, e abrir a de fora mostra os itens das duas. Excluir uma pasta mantém os itens dela (que voltam a ficar sem pasta) e as pastas dentro dela."

msgctxt "PhoneWindow"
msgid "Key type"
msgstr "Tipo de chave"

msgctxt "PhoneWindow"
msgid "Fingerprint"
msgstr "Impressão digital"

msgctxt "PhoneWindow"
msgid "Key"
msgstr "Chave"

msgctxt "PhoneWindow"
msgid "No key yet"
msgstr "Nenhuma chave ainda"

msgctxt "PhoneWindow"
msgid "Make a new Ed25519 key here, or bring yours: pasted, or from its file. A key with a passphrase asks for it once."
msgstr "Crie uma chave Ed25519 nova aqui, ou traga a sua: colada, ou do arquivo dela. Uma chave com frase secreta pede a frase uma vez."

msgctxt "PhoneWindow"
msgid "Its public half couldn't be read."
msgstr "A metade pública dela não pôde ser lida."

msgctxt "PhoneWindow"
msgid "Automatic: the site's icon or the first letter"
msgstr "Automático: o ícone do site ou a primeira letra"

msgctxt "PhoneWindow"
msgid "A line icon"
msgstr "Um ícone de traço"

msgctxt "PhoneWindow"
msgid "Every item"
msgstr "Todos os itens"

msgctxt "Messages"
msgid "That is the public key. The private one is the file of the same name without .pub (often id_ed25519 or id_rsa)."
msgstr "Essa é a chave pública. A privada é o arquivo de mesmo nome sem .pub (muitas vezes id_ed25519 ou id_rsa)."

msgctxt "Messages"
msgid "This form of key isn't read here (PuTTY's .ppk, or an older encrypted form). ssh-keygen -p -f with the key's file writes it in OpenSSH's form; then bring that."
msgstr "Este formato de chave não é lido aqui (o .ppk do PuTTY, ou um formato criptografado mais antigo). ssh-keygen -p -f com o arquivo da chave a grava no formato do OpenSSH; depois traga essa."

msgctxt "Messages"
msgid "That passphrase doesn't open the key. Try again."
msgstr "Essa frase secreta não abre a chave. Tente de novo."

msgctxt "PhoneWindow"
msgid "Pages spring back at their ends. Codes: tap or drag left to copy, drag right to edit, hold to reorder; the circle goes from green to red. Password health rebuilt, with filters. Forgot the master password: the recovery parts of the emergency kit, scanned or typed. The site's icon next to its address. Join a server with its address, pin and invite, or scan its code. Updates looked for on every server the vault syncs through."
msgstr "As páginas voltam ao lugar nas pontas. Códigos: toque ou arraste para a esquerda para copiar, para a direita para editar, segure para reordenar; o círculo vai do verde ao vermelho. Saúde das senhas refeita, com filtros. Esqueceu a senha mestra: as partes de recuperação do kit de emergência, escaneadas ou digitadas. O ícone do site ao lado do endereço. Entre em um servidor com o endereço, o pin e o convite, ou escaneie o código dele. Atualizações procuradas em todos os servidores por onde o cofre sincroniza."

msgctxt "PhoneWindow"
msgid "Secret fields with a cursor: tap where to fix a typo. Pages stretch at their ends. Folders inside folders, a folder picker and the folders under All. Colours for item and vault icons. Codes show their seconds; drag a card to edit it. SSH keys in every common form, a passphrase asked once. The vault renamed here; sync changes confirmed with the master password. A smaller app, hidden in the recent apps view."
msgstr "Campos secretos com cursor: toque onde corrigir um erro de digitação. As páginas esticam nas pontas. Pastas dentro de pastas, um seletor de pastas e as pastas embaixo de Todos. Cores para os ícones dos itens e dos cofres. Os códigos mostram os segundos; arraste um cartão para editá-lo. Chaves SSH em todos os formatos comuns, com a frase secreta pedida uma vez. O cofre renomeado aqui; mudanças na sincronização confirmadas com a senha mestra. Um app menor, escondido na tela de apps recentes."

msgctxt "Words"
msgid "A recovery part has a typo. Each looks like A0- and four groups of seven letters and digits, as printed on its page of the kit."
msgstr "Uma parte de recuperação tem erro de digitação. Cada uma é A0- e quatro grupos de sete letras e números, como está impressa na sua página do kit."

msgctxt "Words"
msgid "The same recovery part was given twice: each one is A, B or C, and they must be different ones."
msgstr "A mesma parte de recuperação foi dada duas vezes: cada uma é A, B ou C, e elas precisam ser diferentes."

msgctxt "Words"
msgid "These recovery parts aren't this vault's, or they are from an older kit. Use the parts of the newest emergency kit."
msgstr "Estas partes de recuperação não são deste cofre, ou são de um kit mais antigo. Use as partes do kit de emergência mais novo."

msgctxt "Words"
msgid "This vault has no recovery parts: its emergency kit was made before they existed, or they were used. Make a new kit on your computer."
msgstr "Este cofre não tem partes de recuperação: o kit de emergência dele foi feito antes delas existirem, ou elas já foram usadas. Faça um kit novo no computador."

msgctxt "Words"
msgid "Only the first {} pages are shown: the rest would take too much of the phone's memory. Save the file to see all of it."
msgstr "Só as primeiras {} páginas são mostradas: o resto usaria memória demais do celular. Salve o arquivo para ver tudo."

msgctxt "Words"
msgid "This PDF's pages are too large to show here. Save the file to see it."
msgstr "As páginas deste PDF são grandes demais para mostrar aqui. Salve o arquivo para vê-lo."

msgctxt "HealthSummary"
msgid "Change the leaked ones first: they are known to attackers."
msgstr "Troque primeiro as vazadas: quem ataca já conhece."

msgctxt "HealthSummary"
msgid "Start with the weak ones: they are the easiest to guess."
msgstr "Comece pelas fracas: são as mais fáceis de adivinhar."

msgctxt "HealthSummary"
msgid "Give each login a password of its own, so one leak opens only one."
msgstr "Dê a cada login uma senha só dele, para que um vazamento abra só um."

msgctxt "HealthSummary"
msgid "Old passwords are worth changing now and then."
msgstr "Vale trocar as senhas antigas de vez em quando."

msgctxt "HealthSummary"
msgid "Strong, used once, and not in a leak the watch knows of."
msgstr "Fortes, usadas uma vez só e fora dos vazamentos que a vigilância conhece."

msgctxt "PhoneWindow"
msgid "Forgot your master password?"
msgstr "Esqueceu a senha mestra?"

msgctxt "PhoneWindow"
msgid "No Secret Key? Use two recovery parts"
msgstr "Sem a chave secreta? Use duas partes de recuperação"

msgctxt "PhoneWindow"
msgid "Your new Secret Key"
msgstr "Sua nova chave secreta"

msgctxt "PhoneWindow"
msgid "No Secret Key on this phone?"
msgstr "Sem a chave secreta neste celular?"

msgctxt "PhoneWindow"
msgid "Bring back the Secret Key"
msgstr "Recuperar a chave secreta"

msgctxt "PhoneWindow"
msgid "The vault now opens with your new master password and this Secret Key. Write it down, or keep it with your emergency kit: your other devices ask for both at their next unlock. The recovery parts you used no longer work, so make a new emergency kit on your computer soon."
msgstr "O cofre agora abre com a sua nova senha mestra e esta chave secreta. Anote-a, ou guarde junto do seu kit de emergência: seus outros dispositivos pedem as duas no próximo desbloqueio. As partes de recuperação que você usou não funcionam mais, então faça logo um kit de emergência novo no computador."

msgctxt "PhoneWindow"
msgid "Your emergency kit has three recovery parts, A, B and C, each on a page of its own. All three together let you choose a new master password. The vault then gets a new Secret Key too, and the parts you used stop working."
msgstr "Seu kit de emergência tem três partes de recuperação, A, B e C, cada uma numa página. As três juntas deixam você escolher uma nova senha mestra. O cofre também ganha uma nova chave secreta, e as partes usadas deixam de funcionar."

msgctxt "PhoneWindow"
msgid "Any two of the kit's three recovery parts bring back your Secret Key. Your master password still opens the vault, as usual."
msgstr "Duas quaisquer das três partes de recuperação do kit trazem de volta a sua chave secreta. A senha mestra continua abrindo o cofre, como sempre."

msgctxt "PhoneWindow"
msgid "A recovery part"
msgstr "Uma parte de recuperação"

msgctxt "PhoneWindow"
msgid "Another recovery part"
msgstr "Outra parte de recuperação"

msgctxt "PhoneWindow"
msgid "The third recovery part"
msgstr "A terceira parte de recuperação"

msgctxt "PhoneWindow"
msgid "Choose the new master password"
msgstr "Escolher a nova senha mestra"

msgctxt "PhoneWindow"
msgid "Recovering…"
msgstr "Recuperando…"

msgctxt "PhoneWindow"
msgid "Copied"
msgstr "Copiado"

msgctxt "PhoneWindow"
msgid "Tap a code to copy it, or drag its card to the left. Drag it to the right to edit or delete it. Hold a card to move it up or down."
msgstr "Toque num código para copiá-lo, ou arraste o cartão dele para a esquerda. Arraste para a direita para editar ou apagar. Segure um cartão para movê-lo para cima ou para baixo."

msgctxt "PhoneWindow"
msgid "No copy here yet: it synced somewhere else"
msgstr "Ainda sem cópia aqui: ele sincronizou em outro lugar"

msgctxt "PhoneWindow"
msgid "Your vault server has version {}: nothing newer than this one."
msgstr "Seu servidor do cofre tem a versão {}: nada mais novo que esta."

msgctxt "PhoneWindow"
msgid "Leaked logins"
msgstr "Logins vazados"

msgctxt "PhoneWindow"
msgid "Logins with a weak password"
msgstr "Logins com senha fraca"

msgctxt "PhoneWindow"
msgid "Logins that share a password"
msgstr "Logins que dividem uma senha"

msgctxt "PhoneWindow"
msgid "Logins not changed in a year"
msgstr "Logins sem troca há um ano"

msgctxt "PhoneWindow"
msgid "Logins to look at, the worst first"
msgstr "Logins para olhar, os piores primeiro"

msgctxt "PhoneWindow"
msgid "Leaked"
msgstr "Vazada"

msgctxt "PhoneWindow"
msgid "Weak"
msgstr "Fraca"

msgctxt "PhoneWindow"
msgid "Reused ×{}"
msgstr "Repetida ×{}"

msgctxt "PhoneWindow"
msgid "Leaks"
msgstr "Vazamentos"

msgctxt "PhoneWindow"
msgid "Once a day, while the vault is open, each password is checked against known data breaches. Only the first 5 characters of its SHA-1 fingerprint leave the phone, never the password."
msgstr "Uma vez por dia, com o cofre aberto, cada senha é conferida com os vazamentos conhecidos. Só os 5 primeiros caracteres da impressão SHA-1 dela saem do celular, nunca a senha."

msgctxt "PhoneWindow"
msgid "While the watch is off, a password found in a data breach isn't marked here. It sends only the first 5 characters of each password's SHA-1 fingerprint, never a password."
msgstr "Com a vigilância desligada, uma senha encontrada num vazamento não é marcada aqui. Ela envia só os 5 primeiros caracteres da impressão SHA-1 de cada senha, nunca uma senha."

msgctxt "PhoneWindow"
msgid "On"
msgstr "Ligada"

msgctxt "PhoneWindow"
msgid "Off: leaks aren't found"
msgstr "Desligada: vazamentos não são encontrados"

msgctxt "PhoneWindow"
msgid "What these mean"
msgstr "O que isto quer dizer"

msgctxt "PhoneWindow"
msgid "Leaked: found in a data breach by the leak watch. Whoever has that breach can try it anywhere: change it first, and everywhere you used it."
msgstr "Vazada: encontrada num vazamento pela vigilância. Quem tem esse vazamento pode testá-la em qualquer lugar: troque-a primeiro, e em todo lugar onde você a usou."

msgctxt "PhoneWindow"
msgid "Weak: a guess would find it soon. A generated password of 16 characters or more, or five words, is out of reach."
msgstr "Fraca: um palpite a acharia logo. Uma senha gerada de 16 caracteres ou mais, ou de cinco palavras, fica fora de alcance."

msgctxt "PhoneWindow"
msgid "Reused: the same password opens another login, so one leak opens both."
msgstr "Repetida: a mesma senha abre outro login, então um vazamento abre os dois."

msgctxt "PhoneWindow"
msgid "Old: not changed in over a year. Worth changing now and then, above all for the logins that matter most."
msgstr "Antiga: não foi trocada há mais de um ano. Vale trocar de vez em quando, sobretudo nos logins que mais importam."

msgctxt "PhoneWindow"
msgid "The site's icon"
msgstr "O ícone do site"

msgctxt "PhoneWindow"
msgid "{n} year old"
msgid_plural "{n} years old"
msgstr[0] "{n} ano"
msgstr[1] "{n} anos"

msgctxt "PhoneWindow"
msgid "32 letters and digits"
msgstr "32 letras e números"

msgctxt "PhoneWindow"
msgid "Certificate pin (only for the server's own HTTPS)"
msgstr "Pin do certificado (só para o HTTPS próprio do servidor)"

msgctxt "PhoneWindow"
msgid "Leave empty behind Tailscale or a domain"
msgstr "Deixe vazio com Tailscale ou um domínio"

msgctxt "PhoneWindow"
msgid "Join"
msgstr "Entrar"

msgctxt "PhoneWindow"
msgid "Paste a line instead"
msgstr "Colar uma linha"

msgctxt "PhoneWindow"
msgid "Type the address"
msgstr "Digitar o endereço"

msgctxt "Words"
msgid "That picture holds no recovery part: {}"
msgstr "Esta imagem não traz uma parte de recuperação: {}"

msgctxt "Words"
msgid "Version {} is ready"
msgstr "A versão {} está pronta"

msgctxt "Words"
msgid "Install"
msgstr "Instalar"

msgctxt "PhoneWindow"
msgid "Scan it from the kit"
msgstr "Escanear do kit"

msgctxt "PhoneWindow"
msgid "Scan a part"
msgstr "Escanear uma parte"

msgctxt "PhoneWindow"
msgid "From a picture"
msgstr "De uma imagem"

msgctxt "Messages"
msgid "The new address answers with this vault: it is the one used from now on."
msgstr "O novo endereço responde com este cofre: ele é o usado daqui em diante."

msgctxt "PhoneWindow"
msgid "Autofill in other apps checks who signed the app, not only its name: a login saved from an app is tied to its certificate. A vault key renewed on a computer is taken here with the new Secret Key and your master password. Signed with the app's own release key: uninstall an older copy once before installing it."
msgstr "O preenchimento em outros apps confere quem assinou o app, não só o nome dele: um login salvo de um app fica ligado ao certificado dele. Uma chave do cofre renovada no computador é adotada aqui com a nova chave secreta e a sua senha mestra. Assinado com a chave de lançamento do próprio app: desinstale uma cópia mais antiga uma vez antes de instalá-lo."

msgctxt "PhoneWindow"
msgid "Passwords shown evenly spaced, in a font of the app's own. The Secret Key shown two groups to a line, in bigger boxes. A recovery part read from the picture it was hidden in. A new version offered as soon as your server has it. The languages with their flags."
msgstr "Senhas mostradas com espaçamento uniforme, numa fonte do próprio app. A chave secreta mostrada em dois grupos por linha, em quadros maiores. Uma parte de recuperação lida da imagem onde foi escondida. Uma versão nova oferecida assim que seu servidor a tiver. Os idiomas com suas bandeiras."

msgctxt "Words"
msgid "The recovery didn't finish ({}). Nothing changed: the recovery parts still work, and this phone didn't keep the Secret Key. Try again."
msgstr "A recuperação não terminou ({}). Nada mudou: as partes de recuperação continuam valendo, e este celular não guardou a chave secreta. Tente de novo."

msgctxt "Words"
msgid "This phone couldn't keep the Secret Key ({}), and the recovery parts you used no longer work. Write the Secret Key below on your emergency kit now, then make a new kit on your computer."
msgstr "Este celular não conseguiu guardar a chave secreta ({}), e as partes de recuperação que você usou não funcionam mais. Anote agora a chave secreta abaixo no seu kit de emergência e depois faça um kit novo no computador."

msgctxt "PhoneWindow"
msgid "Your Secret Key"
msgstr "Sua chave secreta"

msgctxt "PhoneWindow"
msgid "Hidden while the item lock is closed: any of these may be a locked item's password now. Open a locked item to see them again."
msgstr "Ocultas enquanto a trava de itens está fechada: qualquer uma delas pode ser agora a senha de um item trancado. Abra um item trancado para vê-las de novo."

msgctxt "PhoneWindow"
msgid "Website, autofill skips it"
msgstr "Site, o preenchimento o ignora"

msgctxt "Words"
msgid "That Secret Key and master password open none of the renewed copies. Use the Secret Key of the kit made when the vault key was renewed."
msgstr "Essa chave secreta e a senha mestra não abrem nenhuma cópia renovada. Use a chave secreta do kit feito quando a chave do cofre foi renovada."

msgctxt "Words"
msgid "This phone couldn't keep the new Secret Key ({}), so nothing was changed."
msgstr "Este celular não conseguiu guardar a nova chave secreta ({}), então nada foi alterado."

msgctxt "Words"
msgid "This phone couldn't keep the new Secret Key ({}), and its copy of the vault opens only with it now: keep the new emergency kit at hand, it is asked at the next unlock."
msgstr "Este celular não conseguiu guardar a nova chave secreta ({}), e a cópia do cofre aqui agora abre só com ela: mantenha o novo kit de emergência à mão, ele é pedido no próximo desbloqueio."

msgctxt "Words"
msgid "Use the renewed vault key"
msgstr "Usar a chave do cofre renovada"

msgctxt "Words"
msgid "Another device renewed the vault key and printed a new kit. Type the Secret Key from that kit, and your master password: this phone then keeps the new key and syncs again. Unlock with the phone turns off until you turn it on again."
msgstr "Outro aparelho renovou a chave do cofre e imprimiu um novo kit. Digite a chave secreta desse kit e a sua senha mestra: este celular então guarda a nova chave e sincroniza de novo. O Desbloqueio pelo celular fica desligado até você ligar de novo."

msgctxt "Words"
msgid "Use the new key"
msgstr "Usar a nova chave"

msgctxt "Words"
msgid "This phone uses the renewed vault key now and syncs again. Unlock with the phone is off until you turn it on again."
msgstr "Este celular usa agora a chave do cofre renovada e sincroniza de novo. O Desbloqueio pelo celular fica desligado até você ligar de novo."

msgctxt "Words"
msgid "This phone uses the renewed vault key now and syncs again."
msgstr "Este celular usa agora a chave do cofre renovada e sincroniza de novo."

msgctxt "Words"
msgid "The vault key was renewed on another device. Settings, Sync asks once for the new Secret Key, from the new emergency kit."
msgstr "A chave do cofre foi renovada em outro aparelho. Configurações, Sincronização pede uma vez a nova chave secreta, do novo kit de emergência."

msgctxt "PhoneWindow"
msgid "New Secret Key"
msgstr "Nova chave secreta"

msgctxt "PhoneWindow"
msgid "{n} device still uses the vault's former key: its changes come in once it takes the new one."
msgid_plural "{n} devices still use the vault's former key: their changes come in once they take the new one."
msgstr[0] "{n} aparelho ainda usa a chave antiga do cofre: as alterações dele chegam quando ele passar a usar a nova."
msgstr[1] "{n} aparelhos ainda usam a chave antiga do cofre: as alterações deles chegam quando passarem a usar a nova."

msgctxt "PhoneWindow"
msgid "The vault key was renewed on another device: its copies open only with the new Secret Key, from the new emergency kit made there. Type it once here to keep syncing."
msgstr "A chave do cofre foi renovada em outro aparelho: as cópias dele só abrem com a nova chave secreta, do novo kit de emergência feito lá. Digite-a uma vez aqui para continuar sincronizando."

msgctxt "PhoneWindow"
msgid "Type the new Secret Key"
msgstr "Digite a nova chave secreta"

msgctxt "Messages"
msgid "That Secret Key and master password open none of the renewed copies. Use the Secret Key of the kit made when the vault key was renewed."
msgstr "Essa chave secreta e a senha mestra não abrem nenhuma cópia renovada. Use a chave secreta do kit feito quando a chave do cofre foi renovada."

msgctxt "Messages"
msgid "This computer couldn't keep the new Secret Key ({}), so nothing was changed."
msgstr "Este computador não conseguiu guardar a nova chave secreta ({}), então nada foi alterado."

msgctxt "Messages"
msgid "This computer couldn't keep the new Secret Key ({}), and the vault file now opens only with it: keep the new emergency kit at hand, it is asked at the next unlock."
msgstr "Este computador não conseguiu guardar a nova chave secreta ({}), e o arquivo do cofre agora abre só com ela: mantenha o novo kit de emergência à mão, ele é pedido no próximo desbloqueio."

msgctxt "Messages"
msgid "Windows didn't take the change to starting at sign-in ({}). The check shows what Windows will do."
msgstr "O Windows não aceitou a mudança na abertura ao entrar ({}). A caixa mostra o que o Windows vai fazer."

msgctxt "Messages"
msgid "That folder is copied to the cloud by {}: the kit's keys would leave this computer. Choose a folder on this computer or a USB drive, or print the kit. Nothing was saved."
msgstr "Essa pasta é copiada para a nuvem pelo {}: as chaves do kit sairiam deste computador. Escolha uma pasta deste computador ou um pendrive, ou imprima o kit. Nada foi salvo."

msgctxt "Messages"
msgid "That folder already holds part {}. Keep each recovery part in a different place: two of them bring back the Secret Key, three open the vault. Nothing was saved."
msgstr "Essa pasta já tem a parte {}. Guarde cada parte de recuperação num lugar diferente: duas delas trazem de volta a chave secreta, três abrem o cofre. Nada foi salvo."

msgctxt "Messages"
msgid "The vault key was renewed: the old kit, the old Secret Key and older copies of the file no longer open it. Print the new kit now. Windows Hello is off until you turn it on again."
msgstr "A chave do cofre foi renovada: o kit antigo, a chave secreta antiga e as cópias mais antigas do arquivo não abrem mais o cofre. Imprima o novo kit agora. O Windows Hello fica desligado até você ligar de novo."

msgctxt "Messages"
msgid "The vault key was renewed: the old kit, the old Secret Key and older copies of the file no longer open it. Print the new kit now."
msgstr "A chave do cofre foi renovada: o kit antigo, a chave secreta antiga e as cópias mais antigas do arquivo não abrem mais o cofre. Imprima o novo kit agora."

msgctxt "Messages"
msgid "This computer uses the renewed vault key now and syncs again. Windows Hello is off until you turn it on again."
msgstr "Este computador usa agora a chave do cofre renovada e sincroniza de novo. O Windows Hello fica desligado até você ligar de novo."

msgctxt "Messages"
msgid "This computer uses the renewed vault key now and syncs again."
msgstr "Este computador usa agora a chave do cofre renovada e sincroniza de novo."

msgctxt "Messages"
msgid "The vault key was renewed on another device. Settings → Sync asks once for the new Secret Key, from the new emergency kit."
msgstr "A chave do cofre foi renovada em outro aparelho. Configurações → Sincronização pede uma vez a nova chave secreta, do novo kit de emergência."

msgctxt "Messages"
msgid "The vault key was renewed, but the vault locked before the new kit showed. Open Emergency kit and issue new recovery parts: the ones made then can't be shown again."
msgstr "A chave do cofre foi renovada, mas o cofre bloqueou antes de o novo kit aparecer. Abra o kit de emergência e gere novas partes de recuperação: as geradas então não podem ser mostradas de novo."

msgctxt "PhoneWindow"
msgid "Your server can now fetch each new version from the project's releases by itself, so updates show up here without anyone publishing them by hand."
msgstr "Seu servidor agora pode buscar sozinho cada versão nova nas versões publicadas do projeto, então as atualizações aparecem aqui sem ninguém publicá-las à mão."

msgctxt "Messages"
msgid "Vault couldn't find its own program file, which the browsers start for the extension, so the extension can't be connected."
msgstr "O Vault não encontrou o próprio arquivo do programa, que os navegadores abrem para a extensão, então a extensão não pode ser conectada."

msgctxt "Words"
msgid "A newer version of this app is out. Android asks you before it installs it, and installs it only if it is signed like the app you have. Later, it waits in Settings, Updates."
msgstr "Saiu uma versão mais nova deste app. O Android pergunta antes de instalar, e só instala se ela for assinada como o app que você tem. Se for depois, ela fica esperando em Configurações, Atualizações."

msgctxt "Words"
msgid "Version {} of the app is out. Install it in Settings, About and updates."
msgstr "Saiu a versão {} do app. Instale em Configurações, Sobre e atualizações."

msgctxt "PhoneWindow"
msgid "Updates come from the project's releases on GitHub, and the file is taken only if it matches the SHA-256 GitHub lists for it. Android installs one only if it is signed with the same key as the app already here, and asks you first."
msgstr "As atualizações vêm das versões publicadas do projeto no GitHub, e o arquivo só é aceito se bater com o SHA-256 que o GitHub lista para ele. O Android instala uma somente se estiver assinada com a mesma chave do app já instalado aqui, e pergunta antes."

msgctxt "PhoneWindow"
msgid "Updates come from your own vault server: what it fetched from the project's releases, or what a computer put there (vault-server publish-app). Android installs one only if it is signed with the same key as the app already here, and asks you first."
msgstr "As atualizações vêm do seu próprio servidor do cofre: o que ele buscou nas versões publicadas do projeto, ou o que um computador colocou lá (vault-server publish-app). O Android instala uma somente se estiver assinada com a mesma chave do app já instalado aqui, e pergunta antes."

msgctxt "PhoneWindow"
msgid "Get updates from"
msgstr "Receber atualizações de"

msgctxt "PhoneWindow"
msgid "GitHub"
msgstr "GitHub"

msgctxt "PhoneWindow"
msgid "My vault server"
msgstr "Meu servidor do cofre"

msgctxt "PhoneWindow"
msgid "Look for updates by itself"
msgstr "Procurar atualizações sozinho"

msgctxt "PhoneWindow"
msgid "Every hour while a vault is open"
msgstr "A cada hora, enquanto um cofre está aberto"

msgctxt "PhoneWindow"
msgid "After syncing, every few minutes"
msgstr "Depois de sincronizar, a cada poucos minutos"

msgctxt "PhoneWindow"
msgid "Asking GitHub…"
msgstr "Consultando o GitHub…"

msgctxt "PhoneWindow"
msgid "This vault doesn't sync through a server. Choose GitHub, or set up sync in Settings, Sync."
msgstr "Este cofre não sincroniza por um servidor. Escolha o GitHub, ou configure a sincronização em Configurações, Sincronização."

msgctxt "PhoneWindow"
msgid "The newest release is version {}: nothing newer than this one."
msgstr "A versão publicada mais nova é a {}: nada mais novo que esta."

msgctxt "PhoneWindow"
msgid "No update is on your vault server yet. It fetches them itself when it follows the releases (VAULT_SERVER_APP_UPDATES), or a computer puts one there: vault-server publish-app."
msgstr "Ainda não há atualização no seu servidor do cofre. Ele as busca sozinho quando acompanha as versões publicadas (VAULT_SERVER_APP_UPDATES), ou um computador coloca uma lá: vault-server publish-app."

msgctxt "Messages"
msgid "Windows now starts this copy of Vault when you sign in, instead of {}."
msgstr "Agora o Windows abre esta cópia do Vault quando você entra, em vez de {}."

msgctxt "Messages"
msgid "{} recovery parts saved, each in a file of its own. Keep them in different places."
msgstr "{} partes de recuperação salvas, cada uma num arquivo próprio. Guarde-as em lugares diferentes."

msgctxt "Messages"
msgid "Another program changed how the browser reaches Vault. Vault put it back and ignored that request. If you didn't install something like that, check this computer."
msgstr "Outro programa mudou o caminho do navegador até o Vault. O Vault desfez a mudança e ignorou aquele pedido. Se você não instalou nada assim, verifique este computador."

msgctxt "Messages"
msgid "The browser extension's folder couldn't be written ({}). Try again; if it keeps failing, close the browser first."
msgstr "Não foi possível gravar a pasta da extensão do navegador ({}). Tente de novo; se continuar falhando, feche o navegador antes."

msgctxt "Messages"
msgid "The browser extension's folder couldn't be opened ({})."
msgstr "Não foi possível abrir a pasta da extensão do navegador ({})."

msgctxt "Messages"
msgid "Another program changed the browser extension's files. Vault put them back: restart the browser so it runs them as Vault wrote them. If you didn't install something like that, check this computer."
msgstr "Outro programa mudou os arquivos da extensão do navegador. O Vault os restaurou: reinicie o navegador para que ele rode os arquivos como o Vault os gravou. Se você não instalou nada assim, verifique este computador."

msgctxt "Messages"
msgid "Vault couldn't check the browser extension's files ({}). It tries again in a few minutes; if this keeps coming back, restart the browser, then Vault."
msgstr "O Vault não conseguiu verificar os arquivos da extensão do navegador ({}). Ele tenta de novo em alguns minutos; se isso continuar aparecendo, reinicie o navegador e depois o Vault."

msgctxt "PhoneWindow"
msgid "Opens again: 0.4.2 and 0.4.3 closed as soon as they started. Updates come from the project's releases on GitHub, or from your server if you choose it, and are looked for every hour while a vault is open, so a fix reaches you the same day."
msgstr "Abre de novo: a 0.4.2 e a 0.4.3 fechavam assim que começavam. As atualizações vêm das versões publicadas do projeto no GitHub, ou do seu servidor se você escolher, e são procuradas a cada hora enquanto um cofre está aberto, então uma correção chega no mesmo dia."

msgctxt "PhoneWindow"
msgid "Updates hold up on a phone whose network stumbles: a request GitHub didn't get is made again after a moment, and a look on its own that failed is made again in a few minutes."
msgstr "Atualizações que aguentam uma rede instável: um pedido que não chegou ao GitHub é feito de novo após um instante, e uma procura automática que falhou é refeita em poucos minutos."

msgctxt "PhoneWindow"
msgid "Nothing changes on the phone: this version makes the Windows apps harder to take over through a bug."
msgstr "Nada muda no celular: esta versão deixa os apps do Windows mais difíceis de invadir através de uma falha."

msgctxt "Words"
msgid "The file holds every item, attached files and passkeys included, encrypted with a password you choose here. It opens only with that password, in this app or the desktop one: whoever has both can sign in with those passkeys, so make it long."
msgstr "O arquivo guarda todos os itens, com anexos e passkeys, criptografado com uma senha que você escolhe aqui. Ele só abre com essa senha, neste app ou no do computador: quem tiver os dois consegue entrar com essas passkeys, então use uma senha longa."

msgctxt "Words"
msgid "A passkey for “{}” was saved."
msgstr "Uma passkey para “{}” foi salva."

msgctxt "PhoneWindow"
msgid "Passkeys"
msgstr "Passkeys"

msgctxt "PhoneWindow"
msgid "Your vault's passkeys in the phone's browsers and apps (Android 14 and later: turn Vault on in the phone's settings, under passwords and accounts), a filter for every item with a passkey, and the protected export now keeps attached files and passkeys."
msgstr "As passkeys do seu cofre nos navegadores e apps do celular (Android 14 em diante: ative o Vault nas configurações do celular, em senhas e contas), um filtro para todo item com passkey, e a exportação protegida agora leva anexos e passkeys."

msgctxt "Messages"
msgid "Another request to connect came while this one waited, so this is a new code. Connect only if the extension shows this same code; if it doesn't, refuse."
msgstr "Outro pedido de conexão chegou enquanto este esperava, por isso este é um código novo. Conecte somente se a extensão mostrar este mesmo código; se não mostrar, recuse."

msgctxt "Messages"
msgid "That folder can't be used as the browser extension ({}). It needs a manifest.json at its top and no links."
msgstr "Essa pasta não pode ser usada como a extensão do navegador ({}). Ela precisa de um manifest.json no topo e de nenhum link."

msgctxt "Messages"
msgid "Vault didn't take the browser extension of GitHub's release {}. It keeps the one it has."
msgstr "O Vault não aceitou a extensão do navegador da versão {} do GitHub. Ele continua com a que tem."

msgctxt "Words"
msgid "Show the card's PIN"
msgstr "Mostrar o PIN do cartão"

msgctxt "Words"
msgid "Show the private key"
msgstr "Mostrar a chave privada"

msgctxt "Words"
msgid "Show the password"
msgstr "Mostrar a senha"

msgctxt "Words"
msgid "Copy the card's PIN"
msgstr "Copiar o PIN do cartão"

msgctxt "Words"
msgid "Copy the private key"
msgstr "Copiar a chave privada"

msgctxt "Words"
msgid "Copy the password"
msgstr "Copiar a senha"

msgctxt "Words"
msgid "Copy the one-time code"
msgstr "Copiar o código de uso único"

msgctxt "Words"
msgid "Show the card's number"
msgstr "Mostrar o número do cartão"

msgctxt "Words"
msgid "Copy the card number"
msgstr "Copiar o número do cartão"

msgctxt "Words"
msgid "Copy the security code"
msgstr "Copiar o código de segurança"

msgctxt "Words"
msgid "Show the note"
msgstr "Mostrar a nota"

msgctxt "Words"
msgid "Edit this item"
msgstr "Editar este item"

msgctxt "Words"
msgid "Show the file"
msgstr "Mostrar o arquivo"

msgctxt "Words"
msgid "Save the file"
msgstr "Salvar o arquivo"

msgctxt "Words"
msgid "Show the generated passwords"
msgstr "Mostrar as senhas geradas"

msgctxt "Words"
msgid "Copy a generated password"
msgstr "Copiar uma senha gerada"

msgctxt "Words"
msgid "Confirm it's you"
msgstr "Confirme que é você"

msgctxt "Words"
msgid "Nothing was shown or copied: this phone has no screen lock to ask. Set one in Android's settings, or turn off “Ask for the fingerprint or screen lock every time” in Settings, Security."
msgstr "Nada foi mostrado nem copiado: este celular não tem bloqueio de tela para pedir. Configure um nas configurações do Android, ou desative “Pedir a digital ou o bloqueio de tela toda vez” em Configurações, Segurança."

msgctxt "Words"
msgid "Nothing was shown or copied: the phone's check didn't pass ({})."
msgstr "Nada foi mostrado nem copiado: a verificação do celular não passou ({})."

msgctxt "PhoneWindow"
msgid "Each password"
msgstr "Cada senha"

msgctxt "PhoneWindow"
msgid "Off: a password, a code or a card shows and copies with a tap while the vault is open."
msgstr "Desligado: uma senha, um código ou um cartão aparece e é copiado com um toque enquanto o cofre está aberto."

msgctxt "PhoneWindow"
msgid "Before a password, a one-time code, a card's number or code, a secure note or a file shows or is copied, and before an item opens in the editor, the phone asks for your fingerprint, face or screen lock. Each time: nothing is remembered in between."
msgstr "Antes que uma senha, um código de uso único, o número ou o código de um cartão, uma nota segura ou um arquivo apareça ou seja copiado, e antes que um item abra no editor, o celular pede sua digital, rosto ou bloqueio de tela. Toda vez: nada fica lembrado de um uso para o outro."

msgctxt "PhoneWindow"
msgid "This phone has no screen lock, so the item PIN is asked each time instead. Set a screen lock in Android's settings to use the fingerprint."
msgstr "Este celular não tem bloqueio de tela, então o PIN do item é pedido toda vez no lugar dele. Configure um bloqueio de tela nas configurações do Android para usar a digital."

msgctxt "PhoneWindow"
msgid "This phone has no screen lock, so the item password is asked each time instead. Set a screen lock in Android's settings to use the fingerprint."
msgstr "Este celular não tem bloqueio de tela, então a senha do item é pedida toda vez no lugar dele. Configure um bloqueio de tela nas configurações do Android para usar a digital."

msgctxt "PhoneWindow"
msgid "This phone has no screen lock, so nothing can ask for you: passwords, codes and cards don't show or copy until you set one in Android's settings, or turn this off."
msgstr "Este celular não tem bloqueio de tela, então nada pode pedir por você: senhas, códigos e cartões não aparecem nem são copiados até você configurar um nas configurações do Android, ou desativar isto."

msgctxt "PhoneWindow"
msgid "Nothing on this device can ask for a fingerprint or a screen lock, so nothing is asked here."
msgstr "Nada neste aparelho pode pedir uma digital ou um bloqueio de tela, então nada é pedido aqui."

msgctxt "PhoneWindow"
msgid "Ask for the fingerprint or screen lock every time"
msgstr "Pedir a digital ou o bloqueio de tela toda vez"

msgctxt "PhoneWindow"
msgid "Before each password shows or is copied"
msgstr "Antes de cada senha aparecer ou ser copiada"

msgctxt "PhoneWindow"
msgid "Show the note"
msgstr "Mostrar a nota"

msgctxt "PhoneWindow"
msgid "This phone has no screen lock, so the item PIN is asked each time instead."
msgstr "Este celular não tem bloqueio de tela, então o PIN do item é pedido toda vez no lugar dele."

msgctxt "PhoneWindow"
msgid "This phone has no screen lock, so the item password is asked each time instead."
msgstr "Este celular não tem bloqueio de tela, então a senha do item é pedida toda vez no lugar dele."

msgctxt "PhoneWindow"
msgid "Confirm"
msgstr "Confirmar"

msgctxt "Words"
msgid "Show the one-time code"
msgstr "Mostrar o código de uso único"

msgctxt "Messages"
msgid "This computer's security chip (TPM) no longer opens the Secret Key it kept for this vault: the chip was cleared, replaced or turned off. Type the Secret Key from your emergency kit. Once the vault opens, it's kept again."
msgstr "O chip de segurança (TPM) deste computador não abre mais a chave secreta que guardava para este cofre: o chip foi limpo, trocado ou desligado. Digite a chave secreta do seu kit de emergência. Assim que o cofre abrir, ela volta a ser guardada."

msgctxt "Messages"
msgid "Two different Secret Keys are kept for this vault on this computer: an older version of the app saved one. Type the Secret Key from your newest emergency kit."
msgstr "Duas chaves secretas diferentes estão guardadas para este cofre neste computador: uma versão mais antiga do aplicativo salvou uma delas. Digite a chave secreta do seu kit de emergência mais recente."

msgctxt "Messages"
msgid "The Secret Key kept on this computer couldn't be read just now ({}). Try again, or type it from your emergency kit."
msgstr "Não foi possível ler agora a chave secreta guardada neste computador ({}). Tente de novo ou digite a do seu kit de emergência."

msgctxt "Messages"
msgid "The Secret Key couldn't be kept on this computer just now ({}). The vault is open; if the next unlock asks for the Secret Key, type it from your emergency kit."
msgstr "Não foi possível guardar agora a chave secreta neste computador ({}). O cofre está aberto; se o próximo desbloqueio pedir a chave secreta, digite a do seu kit de emergência."

msgctxt "Messages"
msgid "Vault {} has already opened this vault on this computer, and this copy is older. If you didn't go back to an older version yourself, someone may have put back an old one with a known fault: get the newest in Settings → About → Check for updates."
msgstr "O Vault {} já abriu este cofre neste computador, e esta cópia é mais antiga. Se não foi você quem voltou para uma versão anterior, alguém pode ter posto de volta uma versão antiga com uma falha conhecida: pegue a mais nova em Configurações → Sobre → Procurar atualizações."

msgctxt "Messages"
msgid "The browser extension is older than this Vault accepts (it needs {} or later), so Vault doesn't answer it. Settings → Browser extension → Add to a browser writes the newest one into its folder; then reload it on the browser's extensions page."
msgstr "A extensão do navegador é mais antiga do que este Vault aceita (precisa ser a {} ou mais nova), então o Vault não responde a ela. Configurações → Extensão do navegador → Adicionar a um navegador grava a mais nova na pasta dela; depois recarregue-a na página de extensões do navegador."

msgctxt "PhoneWindow"
msgid "The app asks GitHub whether a newer version is out: one request, with nothing about you or your vault in it. Nothing else is sent unless you set it up (sync, the leak check, website icons). Updates can also come from your own sync server: Settings, About and updates."
msgstr "O app pergunta ao GitHub se saiu uma versão mais nova: um pedido, sem nada sobre você ou o seu cofre. Nada mais é enviado a menos que você configure (sincronização, verificação de vazamentos, ícones dos sites). As atualizações também podem vir do seu próprio servidor de sincronização: Configurações, Sobre e atualizações."

msgctxt "Words"
msgid "That password is too easy to guess to guard the file on its own: whoever gets the file can try guesses for as long as they like. Use a generated passphrase, or a longer password that isn't made of common words."
msgstr "Essa senha é fácil demais de adivinhar para proteger o arquivo sozinha: quem pegar o arquivo pode tentar palpites por quanto tempo quiser. Use uma frase-senha gerada, ou uma senha mais longa que não seja feita de palavras comuns."

msgctxt "Words"
msgid "Too many failed tries in a row: wait until the countdown ends, then try again."
msgstr "Tentativas erradas demais seguidas: espere a contagem terminar e tente de novo."

msgctxt "Words"
msgid "Remove this phone's copy after 10 failed tries?"
msgstr "Apagar a cópia deste celular após 10 tentativas erradas?"

msgctxt "Words"
msgid "After 10 failed tries in a row to unlock this vault here, this phone deletes its copy of the vault file, its unlock with the phone and the key in the phone's secure hardware behind it, the Secret Key kept on this phone, and this phone's sync key for the vault. Nothing is sent to your sync server: its copies stay, and your other devices keep the vault. To use it here again, join it again with an invite from another device."
msgstr "Após 10 tentativas erradas seguidas de abrir este cofre aqui, este celular apaga a cópia dele do arquivo do cofre, o desbloqueio com o celular e a chave no hardware seguro do celular por trás dele, a chave secreta guardada neste celular e a chave de sincronização deste celular para o cofre. Nada é enviado ao seu servidor de sincronização: as cópias dele ficam, e seus outros aparelhos continuam com o cofre. Para usá-lo aqui de novo, entre de novo com um convite de outro aparelho."

msgctxt "Words"
msgid "Turn it on"
msgstr "Ligar"

msgctxt "Words"
msgid "One failed try to unlock this vault on this phone since {}. If it wasn't you, someone may be guessing your master password."
msgstr "Uma tentativa errada de abrir este cofre neste celular desde {}. Se não foi você, alguém pode estar tentando adivinhar sua senha mestra."

msgctxt "Words"
msgid "{} failed tries to unlock this vault on this phone since {}. If they weren't yours, someone may be guessing your master password."
msgstr "{} tentativas erradas de abrir este cofre neste celular desde {}. Se não foram suas, alguém pode estar tentando adivinhar sua senha mestra."

msgctxt "Words"
msgid "This master password is easy to guess. Your Secret Key guards the vault too, but anyone who also gets it from a device has only this password left to find, and can try guesses for as long as they like. Six random words are far harder to guess."
msgstr "Esta senha mestra é fácil de adivinhar. Sua chave secreta também protege o cofre, mas quem também a tirar de um aparelho só precisa descobrir esta senha, e pode tentar palpites por quanto tempo quiser. Seis palavras aleatórias são muito mais difíceis de adivinhar."

msgctxt "Words"
msgid "This password turned up in data breaches ({} times): attackers try those first. Choose another one."
msgstr "Esta senha apareceu em vazamentos de dados ({} vezes): atacantes tentam essas primeiro. Escolha outra."

msgctxt "Words"
msgid "The breach check couldn't reach the service ({}). Nothing was sent except the first five characters of the password's fingerprint."
msgstr "A verificação de vazamentos não alcançou o serviço ({}). Nada foi enviado além dos cinco primeiros caracteres da impressão digital da senha."

msgctxt "Words"
msgid "This phone's copy of “{}” was removed after 10 failed tries to unlock it. The vault is still on your other devices and your sync server: join again with an invite to use it here."
msgstr "A cópia de “{}” neste celular foi apagada após 10 tentativas erradas de abri-lo. O cofre continua nos seus outros aparelhos e no seu servidor de sincronização: entre de novo com um convite para usá-lo aqui."

msgctxt "PasswordWarning"
msgid "Use a generated passphrase"
msgstr "Usar uma frase-senha gerada"

msgctxt "ConfirmSheet"
msgid "Check it against known data breaches first"
msgstr "Verificar antes em vazamentos de dados conhecidos"

msgctxt "ConfirmSheet"
msgid "Use a generated passphrase"
msgstr "Usar uma frase-senha gerada"

msgctxt "PhoneWindow"
msgid "{} failed tries in a row on this phone. To slow down guessing, the next one can start in {}."
msgstr "{} tentativas erradas seguidas neste celular. Para atrasar quem tenta adivinhar, a próxima pode começar em {}."

msgctxt "PhoneWindow"
msgid "Try again in {}"
msgstr "Tente de novo em {}"

msgctxt "PhoneWindow"
msgid "Check it against known data breaches first"
msgstr "Verificar antes em vazamentos de dados conhecidos"

msgctxt "PhoneWindow"
msgid "Go on without the check"
msgstr "Seguir sem a verificação"

msgctxt "PhoneWindow"
msgid "Keep this one"
msgstr "Manter esta"

msgctxt "PhoneWindow"
msgid "Failed unlocks"
msgstr "Tentativas erradas"

msgctxt "PhoneWindow"
msgid "After 5 failed tries in a row the next one waits, up to 15 minutes, even if the app is closed and opened again. With this on, the 10th failed try also deletes this phone's copy of the vault, its Secret Key here and its unlock with the phone; your sync server and your other devices keep the vault."
msgstr "Após 5 tentativas erradas seguidas a próxima espera, até 15 minutos, mesmo se o app for fechado e aberto de novo. Com isto ligado, a 10ª tentativa errada também apaga a cópia do cofre neste celular, a chave secreta dele aqui e o desbloqueio com o celular; seu servidor de sincronização e seus outros aparelhos continuam com o cofre."

msgctxt "PhoneWindow"
msgid "Remove this phone's copy after 10 failed tries"
msgstr "Apagar a cópia deste celular após 10 tentativas erradas"

msgctxt "PhoneWindow"
msgid "Asks for the master password to turn on"
msgstr "Pede a senha mestra para ligar"

msgctxt "Messages"
msgid "That password is too easy to guess to guard this file on its own: whoever gets the file can try guesses for as long as they like, with nothing else to stop them. Use a generated passphrase, or a longer password that isn't made of common words."
msgstr "Essa senha é fácil demais de adivinhar para proteger este arquivo sozinha: quem pegar o arquivo pode tentar palpites por quanto tempo quiser, sem nada mais que o impeça. Use uma frase-senha gerada, ou uma senha mais longa que não seja feita de palavras comuns."

msgctxt "Messages"
msgid "Too many failed tries in a row: wait until the countdown ends, then try again."
msgstr "Tentativas erradas demais seguidas: espere a contagem terminar e tente de novo."

msgctxt "Messages"
msgid "One failed try to unlock this vault on this computer since {}. If it wasn't you, someone may be guessing your master password."
msgstr "Uma tentativa errada de abrir este cofre neste computador desde {}. Se não foi você, alguém pode estar tentando adivinhar sua senha mestra."

msgctxt "Messages"
msgid "{} failed tries to unlock this vault on this computer since {}. If they weren't yours, someone may be guessing your master password."
msgstr "{} tentativas erradas de abrir este cofre neste computador desde {}. Se não foram suas, alguém pode estar tentando adivinhar sua senha mestra."

msgctxt "Messages"
msgid "Version {} of Vault is out: the download button in the title bar, or Settings → About, installs it."
msgstr "A versão {} do Vault saiu: o botão de download na barra de título, ou Configurações → Sobre, a instala."

msgctxt "Messages"
msgid "Vault can't replace itself in {}: that folder can't be written. Download the new version from its release page (the download button in the title bar has it)."
msgstr "O Vault não consegue se substituir em {}: essa pasta não pode ser gravada. Baixe a nova versão na página da versão (o botão de download na barra de título leva até ela)."

msgctxt "Messages"
msgid "The new version is in place but couldn't be started ({}). Start Vault again."
msgstr "A nova versão está no lugar, mas não pôde ser iniciada ({}). Abra o Vault de novo."

msgctxt "Words"
msgid "“{}” is in the trash: deleted for good after 30 days. The Trash filter brings it back."
msgstr "“{}” está na lixeira: é apagado de vez depois de 30 dias. O filtro Lixeira o traz de volta."

msgctxt "Words"
msgid "“{}” is back from the trash."
msgstr "“{}” voltou da lixeira."

msgctxt "PhoneWindow"
msgid "Trash"
msgstr "Lixeira"

msgctxt "PhoneWindow"
msgid "Move to the trash"
msgstr "Mover para a lixeira"

msgctxt "PhoneWindow"
msgid "Restore"
msgstr "Restaurar"

msgctxt "PhoneWindow"
msgid "Delete for good"
msgstr "Apagar de vez"

msgctxt "Messages"
msgid "SSH key"
msgstr "Chave SSH"

msgctxt "Messages"
msgid "Identity"
msgstr "Identidade"

msgctxt "Messages"
msgid "Tags are separated by commas: at most 32, each up to 40 characters."
msgstr "As etiquetas são separadas por vírgulas: no máximo 32, cada uma com até 40 caracteres."

msgctxt "Messages"
msgid "Type the expiry date as year-month-day, for example 2027-03-31."
msgstr "Digite a data de validade como ano-mês-dia, por exemplo 2027-03-31."

msgctxt "Messages"
msgid "“{}” is in the trash. It is deleted for good after 30 days; until then, Trash brings it back."
msgstr "“{}” está na lixeira. É apagado de vez depois de 30 dias; até lá, a Lixeira o traz de volta."

msgctxt "Messages"
msgid "“{}” is back from the trash."
msgstr "“{}” voltou da lixeira."

msgctxt "Messages"
msgid "“{}” is archived: kept, out of search, filling and health. Archive lists it."
msgstr "“{}” foi arquivado: guardado, fora da busca, do preenchimento e da saúde. O Arquivo o lista."

msgctxt "Messages"
msgid "“{}” is out of the archive."
msgstr "“{}” saiu do arquivo."

msgctxt "Messages"
msgid "The earlier version of “{}” is back; the one it replaced is kept among its earlier versions."
msgstr "A versão anterior de “{}” voltou; a que ela substituiu fica entre as versões anteriores."

msgctxt "Messages"
msgid "{} syncs with a newer version of Vault, so its copy can't be used here. Update this app: Settings → About → Check for updates."
msgstr "{} sincroniza com uma versão mais nova do Vault, então a cópia dele não pode ser usada aqui. Atualize este app: Configurações → Sobre → Procurar atualizações."

msgctxt "Messages"
msgid "A device syncs with a newer version of Vault, so its copy can't be used here. Update this app: Settings → About → Check for updates."
msgstr "Um dispositivo sincroniza com uma versão mais nova do Vault, então a cópia dele não pode ser usada aqui. Atualize este app: Configurações → Sobre → Procurar atualizações."

msgctxt "Messages"
msgid "{} still runs an older version of Vault, so its copy can't be used here. Update Vault on that device; it syncs again once it is updated."
msgstr "{} ainda usa uma versão mais antiga do Vault, então a cópia dele não pode ser usada aqui. Atualize o Vault nesse dispositivo; ele volta a sincronizar quando estiver atualizado."

msgctxt "Messages"
msgid "A device still runs an older version of Vault, so its copy can't be used here. Update Vault on that device; it syncs again once it is updated."
msgstr "Um dispositivo ainda usa uma versão mais antiga do Vault, então a cópia dele não pode ser usada aqui. Atualize o Vault nesse dispositivo; ele volta a sincronizar quando estiver atualizado."

msgctxt "Messages"
msgid "title"
msgstr "título"

msgctxt "Messages"
msgid "username"
msgstr "usuário"

msgctxt "Messages"
msgid "password"
msgstr "senha"

msgctxt "Messages"
msgid "websites"
msgstr "sites"

msgctxt "Messages"
msgid "notes"
msgstr "notas"

msgctxt "Messages"
msgid "one-time code"
msgstr "código de uso único"

msgctxt "Messages"
msgid "fields"
msgstr "campos"

msgctxt "Messages"
msgid "recovery codes"
msgstr "códigos de recuperação"

msgctxt "Messages"
msgid "other details"
msgstr "outros detalhes"

msgctxt "Words"
msgid "Clear the security log?"
msgstr "Apagar o registro de segurança?"

msgctxt "Words"
msgid "Every line goes, and one line says when it was cleared. This can't be undone."
msgstr "Todas as linhas saem, e uma linha diz quando foi apagado. Isso não pode ser desfeito."

msgctxt "Words"
msgid "A copy from a device not in this vault's list was not used. It may be an older copy put back, or come from a device that was removed."
msgstr "Uma cópia de um aparelho que não está na lista deste cofre não foi usada. Pode ser uma cópia antiga recolocada, ou vir de um aparelho que foi removido."

msgctxt "Words"
msgid "The copy from {} was not used. It may be an older copy put back, or come from a device that was removed. Settings, Sync says why."
msgstr "A cópia de {} não foi usada. Pode ser uma cópia antiga recolocada, ou vir de um aparelho que foi removido. Configurações, Sincronização diz por quê."

msgctxt "Words"
msgid "A copy from a device not in this vault's list couldn't be read."
msgstr "Uma cópia de um aparelho que não está na lista deste cofre não pôde ser lida."

msgctxt "Words"
msgid "The copy from {} couldn't be read. Settings, Sync says why."
msgstr "A cópia de {} não pôde ser lida. Configurações, Sincronização diz por quê."

msgctxt "PhoneWindow"
msgid "Security log"
msgstr "Registro de segurança"

msgctxt "PhoneWindow"
msgid "What was done with this vault on this phone, newest first. Kept on this phone only, encrypted so that only the open vault reads it; no password is in it. Look here for anything you didn't do."
msgstr "O que foi feito com este cofre neste celular, do mais novo ao mais antigo. Guardado só neste celular, criptografado para que só o cofre aberto o leia; não há nenhuma senha nele. Procure aqui algo que você não fez."

msgctxt "PhoneWindow"
msgid "Nothing yet"
msgstr "Nada ainda"

msgctxt "PhoneWindow"
msgid "Show older ({})"
msgstr "Mostrar mais antigos ({})"

msgctxt "PhoneWindow"
msgid "Clear the log"
msgstr "Apagar o registro"

msgctxt "PhoneWindow"
msgid "Its copy wasn't used (found {}): {}"
msgstr "A cópia dele não foi usada (visto em {}): {}"

msgctxt "PhoneWindow"
msgid "Its copy couldn't be read (found {}): {}"
msgstr "A cópia dele não pôde ser lida (visto em {}): {}"

msgctxt "Messages"
msgid "Master password"
msgstr "Senha mestra"

msgctxt "Messages"
msgid "Vault switched to a desktop of its own, where other programs can't see the keys you type or the screen. Type your master password. Your desktop comes back right after."
msgstr "O Vault mudou para uma área de trabalho só dele, onde outros programas não veem as teclas que você digita nem a tela. Digite sua senha mestra. Sua área de trabalho volta logo em seguida."

msgctxt "Messages"
msgid "Enter unlocks · Esc goes back without unlocking · after 2 minutes it goes back by itself"
msgstr "Enter destranca · Esc volta sem destrancar · depois de 2 minutos volta sozinho"

msgctxt "Messages"
msgid "An entry that couldn't be read: it was altered, or written with another key"
msgstr "Um registro que não pôde ser lido: foi alterado, ou escrito com outra chave"

msgctxt "Messages"
msgid "Unlocked without the master password (Windows Hello or fingerprint)"
msgstr "Destrancado sem a senha mestra (Windows Hello ou digital)"

msgctxt "Messages"
msgid "Unlocked with the emergency kit's recovery parts, and a new master password set"
msgstr "Destrancado com as partes de recuperação do kit de emergência, e uma nova senha mestra definida"

msgctxt "Messages"
msgid "Unlocked with the master password"
msgstr "Destrancado com a senha mestra"

msgctxt "Messages"
msgid "An unlock without the master password failed"
msgstr "Uma tentativa de destrancar sem a senha mestra falhou"

msgctxt "Messages"
msgid "Recovery with the emergency kit failed: wrong parts"
msgstr "A recuperação com o kit de emergência falhou: partes erradas"

msgctxt "Messages"
msgid "A wrong master password was typed"
msgstr "Uma senha mestra errada foi digitada"

msgctxt "Messages"
msgid "The browser extension filled a login"
msgstr "A extensão do navegador preencheu um login"

msgctxt "Messages"
msgid "The browser extension had a password copied"
msgstr "A extensão do navegador pediu para copiar uma senha"

msgctxt "Messages"
msgid "The browser extension had a username copied"
msgstr "A extensão do navegador pediu para copiar um nome de usuário"

msgctxt "Messages"
msgid "The browser extension was given a one-time code"
msgstr "A extensão do navegador recebeu um código de uso único"

msgctxt "Messages"
msgid "The browser extension signed in with a passkey"
msgstr "A extensão do navegador entrou com uma chave de acesso"

msgctxt "Messages"
msgid "The browser extension showed a password in its window"
msgstr "A extensão do navegador mostrou uma senha na janela dela"

msgctxt "Messages"
msgid "The browser extension was given an item's details"
msgstr "A extensão do navegador recebeu os dados de um item"

msgctxt "Messages"
msgid "The browser extension changed a login's password"
msgstr "A extensão do navegador mudou a senha de um login"

msgctxt "Messages"
msgid "The browser extension saved a passkey"
msgstr "A extensão do navegador salvou uma chave de acesso"

msgctxt "Messages"
msgid "The browser extension saved a login"
msgstr "A extensão do navegador salvou um login"

msgctxt "Messages"
msgid "The browser extension was given a one-time code while the vault was locked"
msgstr "A extensão do navegador recebeu um código de uso único com o cofre trancado"

msgctxt "Messages"
msgid "The browser extension had a password copied while the vault was locked"
msgstr "A extensão do navegador pediu para copiar uma senha com o cofre trancado"

msgctxt "Messages"
msgid "The browser extension filled a login while the vault was locked"
msgstr "A extensão do navegador preencheu um login com o cofre trancado"

msgctxt "Messages"
msgid "The vault was exported ({})"
msgstr "O cofre foi exportado ({})"

msgctxt "Messages"
msgid "The emergency kit was shown"
msgstr "O kit de emergência foi mostrado"

msgctxt "Messages"
msgid "The emergency kit was saved as a file"
msgstr "O kit de emergência foi salvo como arquivo"

msgctxt "Messages"
msgid "The emergency kit was printed"
msgstr "O kit de emergência foi impresso"

msgctxt "Messages"
msgid "A device joined the sync: {}"
msgstr "Um aparelho entrou na sincronização: {}"

msgctxt "Messages"
msgid "A device was removed from the sync: {}"
msgstr "Um aparelho foi removido da sincronização: {}"

msgctxt "Messages"
msgid "The vault key renewed on another device was taken here"
msgstr "A chave do cofre renovada em outro aparelho passou a ser usada aqui"

msgctxt "Messages"
msgid "The vault key was renewed"
msgstr "A chave do cofre foi renovada"

msgctxt "Messages"
msgid "The log was cleared: what came before is gone"
msgstr "O registro foi apagado: o que havia antes não existe mais"

msgctxt "Messages"
msgid "The log started again: its key had been replaced, so what was written to it since couldn't be read"
msgstr "O registro recomeçou: a chave dele tinha sido trocada, então o que foi escrito nele desde então não pôde ser lido"

msgctxt "Messages"
msgid "The log started again: the one before couldn't be read"
msgstr "O registro recomeçou: o anterior não pôde ser lido"

msgctxt "Messages"
msgid "The master password was changed"
msgstr "A senha mestra foi trocada"

msgctxt "Messages"
msgid "Autofill filled a password"
msgstr "O preenchimento automático preencheu uma senha"

msgctxt "Messages"
msgid "Autofill filled a login"
msgstr "O preenchimento automático preencheu um login"

msgctxt "Messages"
msgid "A passkey signed in"
msgstr "Uma chave de acesso foi usada para entrar"

msgctxt "Messages"
msgid "Something this version of the app doesn't know"
msgstr "Algo que esta versão do app não conhece"

msgctxt "Messages"
msgid "{} on {}"
msgstr "{} em {}"

msgctxt "Messages"
msgid "The secure desktop couldn't be shown ({}). Type the master password in the field instead."
msgstr "A área de trabalho segura não pôde ser mostrada ({}). Digite a senha mestra no campo."

msgctxt "Messages"
msgid "A copy from a device not in this vault's list was not used. It may be an older copy put back, or come from a device that was removed."
msgstr "Uma cópia de um aparelho que não está na lista deste cofre não foi usada. Pode ser uma cópia antiga recolocada, ou vir de um aparelho que foi removido."

msgctxt "Messages"
msgid "The copy from {} was not used. It may be an older copy put back, or come from a device that was removed. Settings → Sync says why."
msgstr "A cópia de {} não foi usada. Pode ser uma cópia antiga recolocada, ou vir de um aparelho que foi removido. Configurações → Sincronização diz por quê."

msgctxt "Messages"
msgid "A copy from a device not in this vault's list couldn't be read."
msgstr "Uma cópia de um aparelho que não está na lista deste cofre não pôde ser lida."

msgctxt "Messages"
msgid "The copy from {} couldn't be read. Settings → Sync says why."
msgstr "A cópia de {} não pôde ser lida. Configurações → Sincronização diz por quê."

msgctxt "Messages"
msgid "No QR code with a one-time code key was found in that picture. Use a sharp screenshot of the whole code, or paste the setup key instead."
msgstr "Nenhum código QR com uma chave de código de uso único foi encontrado nessa imagem. Use uma captura nítida do código inteiro ou cole a chave de configuração."

msgctxt "Messages"
msgid "That picture couldn't be read: {}"
msgstr "Não foi possível ler essa imagem: {}"

msgctxt "Messages"
msgid "{n} passkey with its private key, which signs in without a password"
msgid_plural "{n} passkeys with their private keys, which sign in without a password"
msgstr[0] "{n} chave de acesso com sua chave privada, que entra sem senha"
msgstr[1] "{n} chaves de acesso com suas chaves privadas, que entram sem senha"

msgctxt "Messages"
msgid "The browser extension changed the rules for {}. Settings → Browser extension → Site rules shows them."
msgstr "A extensão do navegador mudou as regras de {}. Configurações → Extensão do navegador → Regras por site as mostra."

msgctxt "Messages"
msgid "Rules for {} added: choose what the extension doesn't do there."
msgstr "Regras para {} adicionadas: escolha o que a extensão não faz lá."

msgctxt "Messages"
msgid "A site said something about a passkey of “{}”: its page shows what, and lets you decide."
msgstr "Um site disse algo sobre uma chave de acesso de “{}”: a página dele mostra o quê, e deixa você decidir."

msgctxt "Messages"
msgid "Open the item's secrets first (the item lock), then decide."
msgstr "Abra primeiro os segredos do item (o bloqueio de itens) e depois decida."

msgctxt "Messages"
msgid "That isn't a site: type its address, such as example.com."
msgstr "Isso não é um site: digite o endereço dele, como example.com."

msgctxt "Messages"
msgid "A strong password for “{}” is ready, and the site's page for changing it is open. On its new-password field the browser extension offers that password; after you send the form, it offers to update the login here."
msgstr "Uma senha forte para “{}” está pronta, e a página do site para trocá-la está aberta. No campo de nova senha, a extensão do navegador oferece essa senha; depois que você enviar o formulário, ela oferece atualizar o login aqui."

msgctxt "Messages"
msgid "The site's page for changing the password of “{}” is open. Turn on the browser extension (Settings → Browser extension) and it offers a strong password there and updates the login; or edit the login here after you change it."
msgstr "A página do site para trocar a senha de “{}” está aberta. Ative a extensão do navegador (Configurações → Extensão do navegador) e ela oferece uma senha forte lá e atualiza o login; ou edite o login aqui depois de trocar."

msgctxt "Messages"
msgid "The browser extension filled a card"
msgstr "A extensão do navegador preencheu um cartão"

msgctxt "Messages"
msgid "The browser extension filled an address"
msgstr "A extensão do navegador preencheu um endereço"

msgctxt "Messages"
msgid "There's no window behind Vault to type into. Click into the program's field first, then come back here and choose Auto-type."
msgstr "Não há uma janela atrás do Vault para digitar. Clique primeiro no campo do programa, depois volte aqui e escolha Digitar."

msgctxt "Messages"
msgid "The SSH key “{}” signed for a program."
msgstr "A chave SSH “{}” assinou para um programa."

msgctxt "Messages"
msgid "Typed into “{}”."
msgstr "Digitado em “{}”."

msgctxt "Messages"
msgid "Auto-type stopped: “{}” changed or another window took the keyboard. Nothing more was typed."
msgstr "A digitação parou: “{}” mudou ou outra janela tomou o teclado. Nada mais foi digitado."

msgctxt "Messages"
msgid "Auto-type stopped: Ctrl, Alt, Shift or the Windows key was held. Let go and try again."
msgstr "A digitação parou: Ctrl, Alt, Shift ou a tecla Windows estava pressionada. Solte e tente de novo."

msgctxt "Messages"
msgid "Windows refused the typed keys for “{}”."
msgstr "O Windows recusou as teclas digitadas para “{}”."

msgctxt "Messages"
msgid "SSH_AUTH_SOCK copied: set it as an environment variable for your user, then open a new terminal."
msgstr "SSH_AUTH_SOCK copiado: defina-o como variável de ambiente do seu usuário e abra um novo terminal."

msgctxt "Messages"
msgid "An SSH key signed for {}"
msgstr "Uma chave SSH assinou para {}"

msgctxt "Messages"
msgid "An SSH key signed for a program"
msgstr "Uma chave SSH assinou para um programa"

msgctxt "Messages"
msgid "Auto-type typed a login into “{}”"
msgstr "A digitação automática digitou um login em “{}”"
msgctxt "Messages"
msgid "Type your master password: it's asked once each time the app starts. Windows Hello works after that."
msgstr "Digite sua senha mestra: ela é pedida uma vez sempre que o app inicia. Depois disso, o Windows Hello funciona."

msgctxt "Messages"
msgid "Type a domain of yours, such as example.com, whose every address reaches you."
msgstr "Digite um domínio seu, como example.com, em que todo endereço chega até você."

msgctxt "Messages"
msgid "Type your email address, such as you@example.com."
msgstr "Digite seu endereço de e-mail, como you@example.com."

msgctxt "Messages"
msgid "The vault command can't reach this app: {}"
msgstr "O comando vault não consegue chegar a este app: {}"
