msgctxt "PhoneWindow"
msgid "Open the vault you made on your computer: from its file, or through your vault server."
msgstr "Abra o cofre que você criou no computador: pelo arquivo ou pelo seu servidor de cofre."

msgctxt "PhoneWindow"
msgid "From its file"
msgstr "Do arquivo"

msgctxt "PhoneWindow"
msgid "Copy the .vault file to the phone (a USB cable, Quick Share, a folder you sync) and choose it. It works offline; sync can be turned on later in Settings."
msgstr "Copie o arquivo .vault para o celular (cabo USB, Compartilhamento rápido, uma pasta sincronizada) e escolha-o. Ele funciona sem internet; a sincronização pode ser ligada depois em Configurações."

msgctxt "PhoneWindow"
msgid "Choose the vault file"
msgstr "Escolher o arquivo do cofre"

msgctxt "PhoneWindow"
msgid "From your vault server"
msgstr "Do seu servidor de cofre"

msgctxt "PhoneWindow"
msgid "On the computer: Settings, Sync, Add a device. Paste the line it shows here."
msgstr "No computador: Configurações, Sincronização, Adicionar um aparelho. Cole aqui a linha que ele mostra."

msgctxt "PhoneWindow"
msgid "Fetching the vault…"
msgstr "Baixando o cofre…"

msgctxt "PhoneWindow"
msgid "Set up from the server"
msgstr "Configurar pelo servidor"

msgctxt "PhoneWindow"
msgid "Back to my vault"
msgstr "Voltar ao meu cofre"

msgctxt "PhoneWindow"
msgid "Neither the server nor the file opens the vault on its own: it also needs your master password and the Secret Key from your emergency kit."
msgstr "Nem o servidor nem o arquivo abrem o cofre sozinhos: ele também precisa da sua senha mestra e da chave secreta do seu kit de emergência."

msgctxt "PhoneWindow"
msgid "Your vault"
msgstr "Seu cofre"

msgctxt "PhoneWindow"
msgid "First time on this phone: it needs the Secret Key from your emergency kit, once."
msgstr "Primeira vez neste celular: ele precisa da chave secreta do seu kit de emergência, uma vez."

msgctxt "PhoneWindow"
msgid "Type your master password. The file you chose replaces the phone's copy once it opens."
msgstr "Digite sua senha mestra. O arquivo que você escolheu substitui a cópia do celular depois que abrir."

msgctxt "PhoneWindow"
msgid "Locked. Type your master password to open it."
msgstr "Trancado. Digite sua senha mestra para abrir."

msgctxt "PhoneWindow"
msgid "Secret Key"
msgstr "Chave secreta"

msgctxt "PhoneWindow"
msgid "Master password"
msgstr "Senha mestra"

