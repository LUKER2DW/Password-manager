# Brazilian Portuguese translation of the phone app (vault-mobile).
# Every text the phone shows is written in English in the .slint files, inside @tr(...).
# See ../../README.md for how the catalogue is made and checked.
msgid ""
msgstr ""
"Project-Id-Version: vault-mobile\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgctxt "Words"
msgid "That didn't open the vault. Check the master password (and the Secret Key, if you typed it)."
msgstr "Não foi possível abrir o cofre. Confira a senha mestra (e a chave secreta, se você a digitou)."

msgctxt "Words"
msgid "That file isn't a vault. Choose the .vault file from your computer."
msgstr "Este arquivo não é um cofre. Escolha o arquivo .vault do seu computador."

msgctxt "Words"
msgid "That isn't a Secret Key. It starts with S0- and is printed on your emergency kit."
msgstr "Isto não é uma chave secreta. Ela começa com S0- e está impressa no seu kit de emergência."

msgctxt "Words"
msgid "The vault file can't be read ({})."
msgstr "Não foi possível ler o arquivo do cofre ({})."

msgctxt "Words"
msgid "Give it a name first."
msgstr "Dê um nome primeiro."

msgctxt "Words"
msgid "Not saved ({}). Your change is still on screen: try again."
msgstr "Não salvo ({}). Sua alteração continua na tela: tente de novo."

msgctxt "Words"
msgid "That isn't it. Try again."
msgstr "Não é esse. Tente de novo."

msgctxt "Words"
msgid "This vault file is older than the one this phone opened last. Bring the newest copy from your computer."
msgstr "Este arquivo do cofre é mais antigo que o último que este celular abriu. Traga a cópia mais nova do seu computador."

msgctxt "Words"
msgid "This vault also needs its keyfile, which the phone app can't use yet."
msgstr "Este cofre também precisa do seu arquivo de chave, que o app do celular ainda não consegue usar."

msgctxt "Words"
msgid "That isn't a setup key for one-time codes. Paste the key the site shows under “Can't scan it?”."
msgstr "Isto não é uma chave de configuração para códigos de uso único. Cole a chave que o site mostra em “Não consegue escanear?”."

msgctxt "Words"
msgid "Pick at least one kind of character."
msgstr "Escolha pelo menos um tipo de caractere."

msgctxt "Words"
msgid "That isn't the current master password."
msgstr "Esta não é a senha mestra atual."

msgctxt "Words"
msgid "The two new passwords are different. Type them again."
msgstr "As duas novas senhas são diferentes. Digite-as de novo."

msgctxt "Words"
msgid "Use at least 12 characters. A few random words are easiest."
msgstr "Use pelo menos 12 caracteres. Algumas palavras aleatórias são o mais fácil."

msgctxt "Words"
msgid "The copy didn't pass its check, so it was deleted ({}). Try another place."
msgstr "A cópia não passou na conferência, então foi excluída ({}). Tente outro lugar."

msgctxt "Words"
msgid "That card number doesn't check out. Look at the digits again."
msgstr "Este número de cartão não confere. Veja os números de novo."

msgctxt "Words"
msgid "Write the expiry as MM/YY, for example 08/29."
msgstr "Escreva o vencimento como MM/AA, por exemplo 08/29."

msgctxt "Words"
msgid "The security code is the 3 or 4 digits on the card."
msgstr "O código de segurança são os 3 ou 4 números do cartão."

msgctxt "Words"
msgid "A card PIN is 4 to 12 digits."
msgstr "O PIN do cartão tem de 4 a 12 números."

msgctxt "Words"
msgid "Paste the setup key first: the codes are made from it."
msgstr "Cole a chave de configuração primeiro: os códigos são feitos a partir dela."

msgctxt "Words"
msgid "That isn't an SSH private key. Choose the key file itself (often id_ed25519 or id_rsa), not the .pub one."
msgstr "Isto não é uma chave privada SSH. Escolha o próprio arquivo da chave (muitas vezes id_ed25519 ou id_rsa), e não o .pub."

msgctxt "Words"
msgid "That file is too large: an item keeps files of up to 5 MB, and up to 10 of them."
msgstr "Este arquivo é grande demais: um item guarda arquivos de até 5 MB, e até 10 deles."

msgctxt "Words"
msgid "Fingerprint unlock didn't work ({})."
msgstr "O desbloqueio por digital não funcionou ({})."

msgctxt "Words"
msgid "That file can't be imported ({})."
msgstr "Não foi possível importar este arquivo ({})."

msgctxt "Words"
msgid "That isn't the file's password. Type it in the field above and choose the file again."
msgstr "Esta não é a senha do arquivo. Digite-a no campo acima e escolha o arquivo de novo."

msgctxt "Words"
msgid "The update couldn't be fetched ({})."
msgstr "Não foi possível baixar a atualização ({})."

msgctxt "Words"
msgid "Password copied. The clipboard is cleared in {} seconds."
msgstr "Senha copiada. A área de transferência será limpa em {} segundos."

msgctxt "Words"
msgid "Username copied."
msgstr "Usuário copiado."

msgctxt "Words"
msgid "Saved."
msgstr "Salvo."

msgctxt "Words"
msgid "“{}” deleted."
msgstr "“{}” excluído."

msgctxt "Words"
msgid "Code copied. The clipboard is cleared in {} seconds."
msgstr "Código copiado. A área de transferência será limpa em {} segundos."

msgctxt "Words"
msgid "Website copied."
msgstr "Site copiado."

msgctxt "Words"
msgid "Copied. The clipboard is cleared in {} seconds."
msgstr "Copiado. A área de transferência será limpa em {} segundos."

msgctxt "Words"
msgid "This phone's record of the vault's newest version couldn't be read, so it started again. The old file was kept."
msgstr "O registro deste celular sobre a versão mais nova do cofre não pôde ser lido, então começou de novo. O arquivo antigo foi guardado."

msgctxt "Words"
msgid "Synced: {} changes came from your other devices."
msgstr "Sincronizado: {} alterações vieram dos seus outros aparelhos."

msgctxt "Words"
msgid "Master password changed. Your other devices ask for the new one at their next unlock."
msgstr "Senha mestra trocada. Seus outros aparelhos pedem a nova no próximo desbloqueio."

msgctxt "Words"
msgid "Backup confirmed: {}. It was read back and opens with this vault's key."
msgstr "Cópia confirmada: {}. Foi lida de volta e abre com a chave deste cofre."

msgctxt "Words"
msgid "File saved."
msgstr "Arquivo salvo."

msgctxt "Words"
msgid "Copied."
msgstr "Copiado."

msgctxt "Words"
msgid "Fingerprint unlock is on for this vault."
msgstr "O desbloqueio por digital está ligado para este cofre."

msgctxt "Words"
msgid "“{}” removed: it gets nothing new from now on."
msgstr "“{}” removido: ele não recebe mais nada novo a partir de agora."

msgctxt "Words"
msgid "Fingerprint unlock was turned off because the master password changed. Turn it on again in Settings, Security."
msgstr "O desbloqueio por digital foi desligado porque a senha mestra mudou. Ligue de novo em Configurações, Segurança."

msgctxt "Words"
msgid "“{}” was removed from this phone."
msgstr "“{}” foi removido deste celular."

msgctxt "Words"
msgid "Backup server added: the vault syncs through both from now on."
msgstr "Servidor de backup adicionado: a partir de agora o cofre sincroniza pelos dois."

msgctxt "Words"
msgid "The server's address changed. This phone's key there stays the same."
msgstr "O endereço do servidor mudou. A chave deste celular lá continua a mesma."

msgctxt "Words"
msgid "{} logins saved from other apps while the vault was locked were added."
msgstr "{} logins salvos por outros apps enquanto o cofre estava trancado foram adicionados."

msgctxt "Words"
msgid "{} of your passwords turned up in a data breach since the last check. They are marked in the list: change them where you use them."
msgstr "{} das suas senhas apareceram em um vazamento de dados desde a última verificação. Elas estão marcadas na lista: troque-as onde você as usa."

