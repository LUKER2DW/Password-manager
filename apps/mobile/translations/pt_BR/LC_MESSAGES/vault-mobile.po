msgctxt "Words"
msgid "This phone's record of the vault's newest version couldn't be read, so it started again. The old file was kept."
msgstr "O registro deste celular sobre a versão mais nova do cofre não pôde ser lido, então começou de novo. O arquivo antigo foi guardado."

msgctxt "Words"
msgid "Synced: {} changes came from your other devices."
msgstr "Sincronizado: {} alterações vieram dos seus outros aparelhos."

msgctxt "Words"
msgid "Master password changed. Your other devices ask for the new one at their next unlock."
msgstr "Senha mestra trocada. Seus outros aparelhos pedem a nova no próximo desbloqueio."

msgctxt "Words"
msgid "Backup confirmed: {}. It was read back and opens with this vault's key."
msgstr "Cópia confirmada: {}. Foi lida de volta e abre com a chave deste cofre."

msgctxt "Words"
msgid "File saved."
msgstr "Arquivo salvo."

msgctxt "Words"
msgid "Copied."
msgstr "Copiado."

msgctxt "Words"
msgid "“{}” removed: it gets nothing new from now on."
msgstr "“{}” removido: ele não recebe mais nada novo a partir de agora."

msgctxt "Words"
msgid "“{}” was removed from this phone."
msgstr "“{}” foi removido deste celular."

msgctxt "Words"
msgid "Backup server added: the vault syncs through both from now on."
msgstr "Servidor de backup adicionado: a partir de agora o cofre sincroniza pelos dois."

msgctxt "Words"
msgid "The server's address changed. This phone's key there stays the same."
msgstr "O endereço do servidor mudou. A chave deste celular lá continua a mesma."

msgctxt "Words"
msgid "{} logins saved from other apps while the vault was locked were added."
msgstr "{} logins salvos por outros apps enquanto o cofre estava trancado foram adicionados."

msgctxt "Words"
msgid "{} of your passwords turned up in a data breach since the last check. They are marked in the list: change them where you use them."
msgstr "{} das suas senhas apareceram em um vazamento de dados desde a última verificação. Elas estão marcadas na lista: troque-as onde você as usa."

