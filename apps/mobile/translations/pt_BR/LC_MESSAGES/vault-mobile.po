msgctxt "PhoneWindow"
msgid "A copy of the vault, a newer copy, another manager's export"
msgstr "Uma cópia do cofre, uma cópia mais nova, a exportação de outro gerenciador"

msgctxt "PhoneWindow"
msgid "Off: this vault works offline"
msgstr "Desligado: este cofre funciona sem internet"

msgctxt "PhoneWindow"
msgid "Theme, language, background, website icons"
msgstr "Tema, idioma, fundo, ícones dos sites"

msgctxt "PhoneWindow"
msgid "Version {} is ready"
msgstr "A versão {} está pronta"

msgctxt "PhoneWindow"
