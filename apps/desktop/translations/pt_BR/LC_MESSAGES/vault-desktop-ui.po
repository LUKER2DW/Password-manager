# Brazilian Portuguese translation of the desktop app.
# A start: the notification area menu, the auto-lock countdown and the language setting.
# Every other text falls back to English until it is translated here (see ../../README.md).
msgid ""
msgstr ""
"Project-Id-Version: vault-desktop-ui\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

