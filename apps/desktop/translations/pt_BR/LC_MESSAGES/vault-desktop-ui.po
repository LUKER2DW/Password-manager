msgctxt "Messages"
msgid "Word list added: {}."
msgstr "Lista de palavras adicionada: {}."

msgctxt "Messages"
msgid "Leak check done: none of your passwords is in a known breach."
msgstr "Verificação de vazamentos concluída: nenhuma das suas senhas está em um vazamento conhecido."

msgctxt "Messages"
msgid "Leak check done: {} found in known breaches. Change them first."
msgstr "Verificação de vazamentos concluída: {} encontradas em vazamentos conhecidos. Troque-as primeiro."

msgctxt "Messages"
msgid "Opened {}. Export the passwords as CSV there, then choose the file here."
msgstr "{} aberto. Exporte as senhas como CSV lá e depois escolha o arquivo aqui."

msgctxt "Messages"
msgid "Unlock protection changed. Unlocking now takes about {} s on this computer."
msgstr "A proteção do destrancamento mudou. Destrancar agora leva cerca de {} s neste computador."

msgctxt "Messages"
msgid "Unlock protection changed (about {} s per unlock here). Windows Hello was turned off: turn it on again in Settings."
msgstr "A proteção do destrancamento mudou (cerca de {} s por destrancamento aqui). O Windows Hello foi desligado: ligue-o de novo em Configurações."

msgctxt "Messages"
