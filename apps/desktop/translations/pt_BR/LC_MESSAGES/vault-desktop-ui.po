msgstr "Código de recuperação copiado. Marque-o como usado depois de entrar. A área de transferência será limpa em {} segundos."

msgctxt "Messages"
msgid "Kit saved to {}. Keep the file private, or delete it once printed."
msgstr "Kit salvo em {}. Mantenha o arquivo em segredo, ou exclua-o depois de impresso."

msgctxt "Messages"
msgid "Password history cleared."
msgstr "Histórico de senhas limpo."

msgctxt "Messages"
msgid "Old password copied. The clipboard clears in {} seconds."
msgstr "Senha antiga copiada. A área de transferência será limpa em {} segundos."

