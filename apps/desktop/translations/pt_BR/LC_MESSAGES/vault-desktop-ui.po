msgctxt "ItemLockDialog"
msgid "Save the item lock?"
msgstr "Salvar a trava de itens?"

msgctxt "ItemLockDialog"
msgid "The master password is asked before a locked item's secrets show. Nothing extra is encrypted."
msgstr "A senha mestra é pedida antes de mostrar os segredos de um item trancado. Nada a mais é criptografado."

msgctxt "ItemLockDialog"
msgid "A PIN opens locked items, and their secrets are encrypted with a key only it opens. Forget both it and your master password, and they can't be recovered."
msgstr "Um PIN abre os itens trancados, e os segredos deles são criptografados com uma chave que só ele abre. Se você esquecer o PIN e a senha mestra, os itens não poderão ser recuperados."

msgctxt "ItemLockDialog"
msgid "A password of its own opens locked items, and their secrets are encrypted with a key only it opens. Forget both it and your master password, and they can't be recovered."
msgstr "Uma senha própria abre os itens trancados, e os segredos deles são criptografados com uma chave que só ela abre. Se você esquecer essa senha e a senha mestra, os itens não poderão ser recuperados."

msgctxt "ItemLockDialog"
msgid "Every item is locked."
msgstr "Todos os itens estão trancados."

msgctxt "ItemLockDialog"
msgid "Only items marked “Lock this item's secrets” are locked."
msgstr "Somente os itens marcados com “Trancar os segredos deste item” ficam trancados."

