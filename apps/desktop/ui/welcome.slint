// Onboarding (new vault), unlock and recovery.
//
// All three share one layout: a side panel on the left (brand, where you are, what is set up)
// and the form centered in the space on the right.

import { Theme, Sketch } from "theme.slint";
import { Messages, RecentVault } from "model.slint";
import { Button, QuietButton, SecretField, Check, Choice, MarkStroke, Hint, Rule, Logo } from "widgets.slint";
import { KitSlip, PdfPassword } from "kit.slint";
import { Glyph } from "icons.slint";

component StepMark inherits HorizontalLayout {
    in property <int> number;
    in property <string> text;
    in property <bool> active;
    in property <bool> done;
    spacing: 12px;
    alignment: start;
    Rectangle {
        width: 22px;
        height: 30px;
        if root.done: Path {
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Sketch.check;
            stroke: Theme.accent-stroke;
            stroke-width: 2px;
            fill: transparent;
        }
        if !root.done: Text {
            text: root.number;
            font-size: Theme.body;
            font-weight: 600;
            color: root.active ? Theme.ink : Theme.faint;
        }
    }
    Rectangle {
        width: label.preferred-width;
        height: 30px;
        label := Text {
            x: 0;
            text: root.text;
            font-size: Theme.body;
            color: root.active || root.done ? Theme.ink : Theme.faint;
        }
        MarkStroke {
            x: -2px;
            y: parent.height - 6px;
            width: label.preferred-width + 4px;
            reveal: root.active ? 1 : 0;
            animate reveal { duration: Theme.sweep; easing: ease-out; }
        }
    }
}

component Heading inherits Text {
    font-size: Theme.headline;
    font-weight: 300;
    color: Theme.ink;
    wrap: word-wrap;
}

component Prose inherits Text {
    font-size: Theme.body;
    color: Theme.graphite;
    wrap: word-wrap;
}

component ErrorLine inherits Text {
    in property <int> code;
    in property <string> detail;
    text: Messages.error(root.code, root.detail);
    font-size: Theme.body;
    color: Theme.seal;
    wrap: word-wrap;
    visible: root.code != 0;
    height: root.code != 0 ? self.preferred-height : 0px;
}

// One line of "what is true here": a check when it is, a hollow dot when it isn't (yet).
component Fact inherits HorizontalLayout {
    in property <string> text;
    in property <bool> ok: true;
    // With an icon, the icon leads (faint when the fact isn't true yet) and a check follows.
    in property <string> icon;
    spacing: 10px;
    VerticalLayout {
        alignment: start;
        padding-top: 1px;
        Rectangle {
            width: 16px;
            height: 16px;
            if root.icon != "": Glyph {
                name: root.icon;
                tint: root.ok ? Theme.accent-stroke : Theme.faint;
                width: 16px;
                height: 16px;
            }
            if root.ok && root.icon == "": Path {
                width: 15px;
                height: 15px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Sketch.check;
                stroke: Theme.accent-stroke;
                stroke-width: 2px;
                fill: transparent;
            }
            if !root.ok && root.icon == "": Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                border-width: 1.5px;
                border-color: Theme.faint;
            }
        }
    }
    Text {
        text: root.text;
        font-size: Theme.small;
        color: root.ok ? Theme.graphite : Theme.faint;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
    if root.icon != "" && root.ok: VerticalLayout {
        alignment: start;
        padding-top: 2px;
        Path {
            width: 13px;
            height: 13px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Sketch.check;
            stroke: Theme.accent-stroke;
            stroke-width: 2px;
            fill: transparent;
        }
    }
}

// A quiet link with an icon (secondary ways out of a form).
component LinkButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback clicked;
    accessible-role: button;
    accessible-label: root.text;
    forward-focus: focus;
    height: 32px;
    min-width: row.preferred-width;
    border-radius: Theme.radius;
    background: touch.has-hover || focus.has-focus ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Glyph {
                name: root.icon;
                tint: touch.has-hover ? Theme.ink : Theme.graphite;
                width: 15px;
                height: 15px;
            }
        }
        Text {
            text: root.text;
            font-size: Theme.small;
            color: touch.has-hover ? Theme.ink : Theme.graphite;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

// Left side panel: brand at the top, then whatever the screen puts in it.
component SidePanel inherits Rectangle {
    // With `scene`, the vault wall shows faintly at the bottom of the panel.
    in property <bool> scene;
    background: Theme.panel;
    min-width: 340px;
    max-width: 440px;
    horizontal-stretch: 0.6;
    clip: true;

    if root.scene: Image {
        width: parent.width;
        height: parent.height;
        source: Theme.dark ? @image-url("brand/lock-scene.svg") : @image-url("brand/lock-scene-light.svg");
        image-fit: cover;
        opacity: 0.45;
    }
    if root.scene: Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(180deg, Theme.panel 0%, Theme.panel 35%, Theme.panel.with-alpha(0.4) 75%, Theme.panel.with-alpha(0.1) 100%);
    }

    VerticalLayout {
        padding: 40px;
        padding-bottom: 36px;
        spacing: 0px;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Logo {
                small: true;
                width: 28px;
                height: 28px;
            }
            Text {
                text: "Vault";
                font-size: Theme.lead;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
            }
        }
        @children
    }
}

// The right side: content centered in the free space, at a comfortable reading width.
// With `scene`, the space behind is the vault's wall of safe-deposit boxes (brand/lock-scene*.svg,
// a few drawers pulled open) and the form sits on a card in front of it.
component FormArea inherits Rectangle {
    in property <length> form-width: 400px;
    in property <bool> scene;
    property <length> pad: root.scene ? 36px : 0px;
    horizontal-stretch: 1;
    background: Theme.canvas;
    clip: true;
    if root.scene: Image {
        width: parent.width;
        height: parent.height;
        source: Theme.dark ? @image-url("brand/lock-scene.svg") : @image-url("brand/lock-scene-light.svg");
        image-fit: cover;
        opacity: 0.55;
    }
    HorizontalLayout {
        padding: 48px;
        alignment: center;
        VerticalLayout {
            min-width: 280px + 2 * root.pad;
            preferred-width: root.form-width + 2 * root.pad;
            max-width: root.form-width + 2 * root.pad;
            alignment: center;
            Rectangle {
                if root.scene: Rectangle {
                    for i in 5: Rectangle {
                        x: -(i + 1) * 3px;
                        y: -(i + 1) * 3px + 6px;
                        width: parent.width + (i + 1) * 6px;
                        height: parent.height + (i + 1) * 6px;
                        border-radius: 12px + (i + 1) * 3px;
                        background: Theme.dark ? #00000009 : #1F2A3D03;
                    }
                }
                if root.scene: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: Theme.sheet;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.rule;
                }
                VerticalLayout {
                    padding: root.pad;
                    @children
                }
            }
        }
    }
}

component Spacer inherits Rectangle {
    vertical-stretch: 1;
}

// Pick one of the vaults this computer has opened, open another file, or create a new vault.
component VaultChooser inherits VerticalLayout {
    in property <[RecentVault]> vaults;
    in property <bool> can-go-back: true;
    // While the vault shown is being unlocked or created, no other one is chosen: what that
    // work brings back belongs to this one.
    in property <bool> busy;
    callback pick(int);
    callback forget(int);
    callback open-file();
    callback new-file();
    callback back();

    spacing: 14px;
    Heading { text: @tr("Choose a vault"); }
    Prose {
        text: @tr("Vaults opened on this computer. Each one has its own master password and Secret Key.");
    }
    VerticalLayout {
        spacing: 4px;
        for vault[index] in root.vaults: Rectangle {
            height: 56px;
            border-radius: Theme.radius;
            background: vault.current ? Theme.selected : row-touch.has-hover && !vault.missing ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: vault.name;
            row-touch := TouchArea {
                mouse-cursor: vault.missing ? MouseCursor.default : MouseCursor.pointer;
                clicked => {
                    if (!vault.missing && !root.busy) { root.pick(index); }
                }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Path {
                        width: 16px;
                        height: 18px;
                        viewbox-width: 64;
                        viewbox-height: 72;
                        commands: Sketch.padlock;
                        stroke: vault.missing ? Theme.faint : Theme.accent-stroke;
                        stroke-width: 1.3px;
                        fill: transparent;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: vault.name;
                        font-size: Theme.body;
                        font-weight: 600;
                        color: vault.missing ? Theme.faint : Theme.ink;
                        overflow: elide;
                    }
                    Text {
                        text: vault.missing ? @tr("File not found: {}", vault.location) : vault.location;
                        font-size: Theme.small;
                        color: Theme.faint;
                        overflow: elide;
                    }
                }
                if vault.current: Text {
                    text: @tr("selected");
                    font-size: Theme.small;
                    color: Theme.graphite;
                    vertical-alignment: center;
                }
                if !vault.current: VerticalLayout {
                    alignment: center;
                    QuietButton {
                        text: @tr("Remove from list");
                        tint: Theme.faint;
                        clicked => { root.forget(index); }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        spacing: 8px;
        QuietButton {
            text: @tr("Open a vault file…");
            outlined: true;
            enabled: !root.busy;
            clicked => { root.open-file(); }
        }
        QuietButton {
            text: @tr("Create a new vault…");
            outlined: true;
            enabled: !root.busy;
            clicked => { root.new-file(); }
        }
    }
    if root.can-go-back: HorizontalLayout {
        alignment: start;
        QuietButton {
            text: @tr("Back");
            tint: Theme.graphite;
            clicked => { root.back(); }
        }
    }
}

export component OnboardingScreen inherits Rectangle {
    in-out property <int> step: 1;
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    in property <string> suggestion;
    in property <bool> recovered: false;
    in property <string> kit-vault-id;
    in property <string> kit-secret-key;
    // The password of the kit's saved files (CRYPTO.md §3.10).
    in property <string> kit-pdf-password;
    in property <string> kit-part-a;
    in property <string> kit-part-b;
    in property <string> kit-part-c;
    in property <string> kit-path;
    in-out property <bool> kit-saved;
    // On paper: the keys printed (true) or empty boxes to write them in by hand.
    in-out property <bool> kit-filled: true;
    callback new-parts-now();
    // Item lock, chosen before the vault is created: 0 PIN, 1 another password, 2 master
    // password, 3 none for now.
    in-out property <int> guard: 0;
    in-out property <bool> guard-all: true;
    in-out property <bool> guard-hello: true;
    in property <bool> quick-available;
    callback back();
    callback import();
    callback create();
    callback suggest();
    callback use-suggestion();
    callback finish();
    callback print-kit();
    callback save-kit();
    callback save-parts-apart();
    callback copy-pdf-password();
    // Vault chooser
    in property <[RecentVault]> vaults;
    in-out property <bool> choosing;
    callback pick-vault(int);
    callback forget-vault(int);
    callback open-vault-file();
    callback new-vault-file();

    background: Theme.canvas;

    HorizontalLayout {
        SidePanel {
            Rectangle { height: 56px; }
            Text {
                text: root.recovered ? @tr("Recovered") : @tr("New vault");
                font-size: Theme.headline;
                font-weight: 300;
                color: Theme.ink;
            }
            Rectangle { height: 20px; }
            if !root.recovered: StepMark {
                number: 1;
                text: @tr("Master password");
                active: root.step == 1;
                done: root.step > 1;
            }
            if !root.recovered: StepMark {
                number: 2;
                text: @tr("Item lock");
                active: root.step == 2;
                done: root.step > 2;
            }
            StepMark {
                number: root.recovered ? 1 : 3;
                text: @tr("Emergency kit");
                active: root.step == 3;
                done: root.step > 3;
            }
            if !root.recovered: StepMark {
                number: 4;
                text: @tr("Your passwords");
                active: root.step == 4;
            }
            Spacer { }
            VerticalLayout {
                spacing: 12px;
                vertical-stretch: 0;
                Fact { text: @tr("Everything is encrypted on this computer before it is saved."); }
                Fact { text: @tr("Opening it takes your master password plus a Secret Key the app creates."); }
                Fact { text: @tr("Nothing is sent anywhere."); }
                Fact { text: @tr("The item lock asks again before a password shows, even with the vault open."); }
                Fact { text: @tr("Your emergency kit is the way back in if you forget the password."); }
            }
        }
        Rectangle { width: 1px; background: Theme.rule; }

        if root.step == 1: FormArea {
            form-width: 460px;
            if root.choosing: VaultChooser {
                vaults: root.vaults;
                busy: root.busy;
                pick(i) => { root.pick-vault(i); }
                forget(i) => { root.forget-vault(i); }
                open-file => { root.open-vault-file(); }
                new-file => { root.new-vault-file(); }
                back => { root.choosing = false; }
            }
            if !root.choosing: VerticalLayout {
                spacing: 18px;

                Heading { text: @tr("Choose a master password"); }
                Prose {
                    text: @tr("It's the only password you'll need to remember. Nobody can reset it for you, so pick one you won't forget.");
                }
                master := SecretField {
                    field: 0;
                    eye: true;
                    label: @tr("Master password");
                    required: true;
                    hint: @tr("Something you'll remember that nobody could guess: several random words work best (try Suggest a passphrase). At least 12 characters. You'll type it every time you unlock, and it can't be reset.");
                    error: root.error-code == 4 || root.error-code == 5;
                    accepted => { confirm.focus(); }
                }
                confirm := SecretField {
                    field: 1;
                    eye: true;
                    label: @tr("Type it again");
                    required: true;
                    error: root.error-code == 4;
                    accepted => { root.create(); }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    QuietButton {
                        icon: root.suggestion == "" ? "sparkle" : "refresh";
                        text: root.suggestion == "" ? @tr("Suggest a passphrase") : @tr("Suggest another");
                        clicked => { root.suggest(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        Hint {
                            text: @tr("Six random words from the EFF word list: about 77 bits of entropy, far beyond guessing, and easier to remember than a jumble of symbols.");
                        }
                    }
                }
                if root.suggestion != "": Rectangle {
                    height: suggestion-layout.preferred-height;
                    border-radius: Theme.radius;
                    background: Theme.panel;
                    suggestion-layout := VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            text: root.suggestion;
                            font-family: Theme.mono-font;
                            font-size: Theme.lead;
                            color: Theme.ink;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 12px;
                            QuietButton {
                                text: @tr("Use this passphrase");
                                clicked => { root.use-suggestion(); }
                            }
                            Prose {
                                text: @tr("Learn it by heart before you continue.");
                                font-size: Theme.small;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                ErrorLine {
                    code: root.error-code;
                    detail: root.error-detail;
                }
                Button {
                    text: @tr("Continue");
                    clicked => { root.create(); }
                }
                HorizontalLayout {
                    alignment: start;
                    QuietButton {
                        text: @tr("I already have a vault: open it");
                        tint: Theme.graphite;
                        clicked => { root.choosing = true; }
                    }
                }
            }
        }

        if root.step == 2: FormArea {
            form-width: 500px;
            VerticalLayout {
                spacing: 18px;

                Heading { text: @tr("Lock your items"); }
                Prose {
                    text: @tr("With the vault open, each password, code and hidden field still asks for one quick check before it shows, is copied or is filled in the browser. Names, usernames and websites stay visible. One right answer opens locked items for 5 minutes.");
                }
                Choice {
                    options: [@tr("PIN"), @tr("Another password"), @tr("Master password")];
                    selected <=> root.guard;
                }
                Prose {
                    font-size: Theme.small;
                    text: root.guard == 0 ? @tr("Recommended. Locked secrets are encrypted with a key only the PIN opens, so a program that reads the open vault from memory still can't read them. Use 6 to 8 digits.")
                        : root.guard == 1 ? @tr("Locked secrets are encrypted with a key only this password opens. At least 6 characters, different from your master password.")
                        : @tr("You type your master password again. A check only: nothing extra is encrypted.");
                }
                if root.guard < 2: SecretField {
                    field: 12;
                    eye: true;
                    label: root.guard == 0 ? @tr("PIN: 4 to 8 digits") : @tr("Item password: at least 6 characters");
                    required: true;
                    error: root.error-code == 36;
                    accepted => { root.create(); }
                }
                Check {
                    text: @tr("Lock every item (otherwise only items you mark)");
                    checked <=> root.guard-all;
                }
                if root.guard < 2 && root.quick-available: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Check {
                        text: @tr("Open locked items with Windows Hello too");
                        checked <=> root.guard-hello;
                    }
                    VerticalLayout {
                        alignment: center;
                        Hint {
                            text: @tr("Your face, fingerprint or Windows PIN opens locked items on this computer, in the app and in the browser extension. Creating the vault asks Windows Hello once.");
                        }
                    }
                }
                ErrorLine {
                    code: root.error-code;
                    detail: root.error-detail;
                }
                HorizontalLayout {
                    HorizontalLayout {
                        alignment: start;
                        spacing: 12px;
                        Button {
                            text: @tr("Create vault");
                            busy-text: @tr("Creating your vault…");
                            busy: root.busy;
                            clicked => { root.create(); }
                        }
                        if !root.busy: QuietButton {
                            text: @tr("Back");
                            tint: Theme.graphite;
                            clicked => { root.back(); }
                        }
                    }
                    // No item lock for now: a plain way out, on its own at the right.
                    HorizontalLayout {
                        alignment: end;
                        if !root.busy: QuietButton {
                            text: @tr("Set up later");
                            outlined: true;
                            tint: Theme.graphite;
                            clicked => {
                                root.guard = 3;
                                root.create();
                            }
                        }
                    }
                }
                if !root.busy: Prose {
                    font-size: Theme.small;
                    text: @tr("Set up later creates the vault without an item lock. You can turn it on any time in Settings → Item lock.");
                }
            }
        }

        if root.step == 3: FormArea {
            form-width: 560px;
            VerticalLayout {
                spacing: 18px;

                Heading { text: @tr("Save your emergency kit"); }
                Prose {
                    text: root.recovered
                        ? @tr("You have a new Secret Key, and the recovery parts you used no longer work. Print the new kit.")
                        : @tr("If you lose this computer or forget your master password, these keys are the only way back in. Print the kit, and keep the Secret Key and each recovery part in different safe places.");
                }
                if root.recovered && root.kit-part-a == "": HorizontalLayout {
                    alignment: start;
                    Button {
                        text: @tr("Make new recovery parts");
                        busy: root.busy;
                        busy-text: @tr("Working…");
                        clicked => { root.new-parts-now(); }
                    }
                }
                KitSlip {
                    vault-id: root.kit-vault-id;
                    secret-key: root.kit-secret-key;
                    part-a: root.kit-part-a;
                    part-b: root.kit-part-b;
                    part-c: root.kit-part-c;
                    vault-path: root.kit-path;
                }
                Choice {
                    options: [@tr("Print the keys"), @tr("Print empty boxes to fill in by hand")];
                    selected: root.kit-filled ? 0 : 1;
                    changed(index) => { root.kit-filled = index == 0; }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    QuietButton {
                        text: @tr("Print");
                        outlined: true;
                        clicked => { root.print-kit(); }
                    }
                    QuietButton {
                        text: @tr("Save as PDF…");
                        clicked => { root.save-kit(); }
                    }
                    if root.kit-part-a != "": QuietButton {
                        text: @tr("Save each part apart…");
                        clicked => { root.save-parts-apart(); }
                    }
                }
                PdfPassword {
                    password: root.kit-pdf-password;
                    can-copy: true;
                    copy => { root.copy-pdf-password(); }
                }
                Check {
                    text: @tr("I wrote these down and keep them somewhere safe");
                    checked <=> root.kit-saved;
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: root.recovered ? @tr("Open my vault") : @tr("Continue");
                        enabled: root.kit-saved;
                        clicked => {
                            if root.recovered {
                                root.finish();
                            } else {
                                root.step = 4;
                            }
                        }
                    }
                }
            }
        }

        if root.step == 4: FormArea {
            form-width: 500px;
            VerticalLayout {
                spacing: 18px;

                Heading { text: @tr("Bring your passwords along"); }
                Prose {
                    text: @tr("Already keep passwords in a browser or another password manager? Import them now and they are encrypted into this vault. Nothing is sent anywhere.");
                }
                VerticalLayout {
                    spacing: 10px;
                    Fact { text: @tr("Chrome, Edge, Brave and Firefox, read directly on this computer"); }
                    Fact { text: @tr("Bitwarden, 1Password, KeePass and others, from their export files"); }
                    Fact { text: @tr("You review every login before anything is added"); }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 12px;
                    Button {
                        text: @tr("Import passwords");
                        clicked => { root.import(); }
                    }
                    QuietButton {
                        text: @tr("Skip for now");
                        tint: Theme.graphite;
                        clicked => { root.finish(); }
                    }
                }
                Prose {
                    font-size: Theme.small;
                    text: @tr("You can import later from Import & export in the menu.");
                }
            }
        }
    }
}

export component UnlockScreen inherits Rectangle {
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    in property <bool> needs-secret-key;
    // The vault has recovery parts: two of them can stand in for the Secret Key.
    in property <bool> can-use-parts;
    in-out property <bool> use-parts;
    callback choose-part-picture();
    // The vault uses a keyfile; `keyfile-path` is where it is (remembered, or just chosen).
    in property <bool> needs-keyfile;
    in property <string> keyfile-path;
    callback choose-keyfile();
    in property <string> vault-path;
    // Windows Hello: usable on this computer / set up for this vault / prompt open now.
    in property <bool> quick-available;
    in property <bool> quick-unlock;
    in property <bool> quick-waiting;
    callback unlock();
    callback quick();
    callback forgot();
    // Vault chooser
    in property <[RecentVault]> vaults;
    in-out property <bool> choosing;
    callback pick-vault(int);
    callback forget-vault(int);
    callback open-vault-file();
    callback new-vault-file();


    property <bool> hello-first: root.quick-unlock && !root.needs-secret-key;

    background: Theme.canvas;

    HorizontalLayout {
        SidePanel {
            scene: Theme.lock-backdrop == 2 || Theme.lock-backdrop == 3;
            Spacer { }
            Logo {
                width: 120px;
                height: 120px;
            }
            Rectangle { height: 26px; }
            Text {
                text: @tr("Locked");
                font-size: Theme.display;
                font-weight: 300;
                color: Theme.ink;
            }
            Rectangle { height: 8px; }
            Prose {
                text: @tr("Everything inside is encrypted on this computer.");
            }
            Rectangle { height: 18px; }
            // Which vault this is.
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    height: 30px;
                    max-width: 340px;
                    border-radius: 15px;
                    background: Theme.dark ? #FFFFFF08 : #1F2A3D0A;
                    border-width: 1px;
                    border-color: Theme.rule;
                    HorizontalLayout {
                        padding-left: 11px;
                        padding-right: 14px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Glyph {
                                name: "vault";
                                tint: Theme.graphite;
                                width: 14px;
                                height: 14px;
                            }
                        }
                        Text {
                            text: root.vault-path;
                            font-size: Theme.small;
                            color: Theme.graphite;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
            Spacer { }
            // What is set up on this computer, on a quiet card.
            Rectangle {
                vertical-stretch: 0;
                border-radius: 10px;
                background: Theme.dark ? #0F141BB0 : #FFFFFFB0;
                border-width: 1px;
                border-color: Theme.rule;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Fact {
                        icon: "key";
                        text: root.needs-secret-key
                            ? @tr("This computer needs your Secret Key once")
                            : @tr("Secret Key saved on this computer");
                        ok: !root.needs-secret-key;
                    }
                    if root.quick-available: Fact {
                        icon: "shield";
                        text: root.quick-unlock
                            ? @tr("Windows Hello is set up")
                            : @tr("Windows Hello is off (Settings → Locking)");
                        ok: root.quick-unlock;
                    }
                    Fact {
                        icon: "clock";
                        text: @tr("Locks itself when you step away");
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.rule; }

        FormArea {
            form-width: 420px;
            scene: Theme.lock-backdrop == 1 || Theme.lock-backdrop == 3;
            if root.choosing: VaultChooser {
                vaults: root.vaults;
                busy: root.busy;
                pick(i) => { root.pick-vault(i); }
                forget(i) => { root.forget-vault(i); }
                open-file => { root.open-vault-file(); }
                new-file => { root.new-vault-file(); }
                back => { root.choosing = false; }
            }
            if !root.choosing: VerticalLayout {
                spacing: 16px;

                VerticalLayout {
                    spacing: 6px;
                    Heading { text: @tr("Unlock your vault"); }
                    if !root.needs-secret-key: Prose {
                        text: root.hello-first
                            ? @tr("Use Windows Hello, or your master password.")
                            : @tr("Type your master password to open it.");
                    }
                }
                if root.hello-first: VerticalLayout {
                    spacing: 18px;
                    Button {
                        text: @tr("Unlock with Windows Hello");
                        busy-text: @tr("Waiting for Windows Hello…");
                        busy: root.quick-waiting;
                        enabled: !root.busy;
                        clicked => { root.quick(); }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Rule { }
                        }
                        Text {
                            text: @tr("or use your master password");
                            font-size: Theme.small;
                            color: Theme.faint;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Rule { }
                        }
                    }
                }
                if root.needs-secret-key && !root.use-parts: VerticalLayout {
                    spacing: 12px;
                    Prose {
                        text: @tr("This computer hasn't opened this vault before. Type the Secret Key from your emergency kit once; it will be remembered here.");
                    }
                    SecretField {
                        field: 2;
                        label: @tr("Secret Key");
                        required: true;
                        eye: true;
                        cells: true;
                        hint: @tr("From your emergency kit: S0- and four groups of seven characters. Dashes, spaces and capitals don't matter.");
                        placeholder: "S0-";
                        error: root.error-code == 2 || root.error-code == 3;
                        accepted => { password.focus(); }
                    }
                    if root.can-use-parts: HorizontalLayout {
                        alignment: start;
                        LinkButton {
                            icon: "lifebuoy";
                            text: @tr("Lost the Secret Key? Use two recovery parts");
                            clicked => { root.use-parts = true; }
                        }
                    }
                }
                if root.needs-secret-key && root.use-parts: VerticalLayout {
                    spacing: 12px;
                    Prose {
                        text: @tr("Type any two of your three recovery parts. They bring back the Secret Key, which this computer then remembers. Your master password is still needed.");
                    }
                    SecretField {
                        field: 16;
                        label: @tr("A recovery part");
                        required: true;
                        eye: true;
                        cells: true;
                        hint: @tr("A0-, B0- or C0- and four groups of seven characters. Which two, their order, dashes, spaces and capitals don't matter.");
                        placeholder: "A0-";
                        error: root.error-code == 44 || root.error-code == 45 || root.error-code == 46 || root.error-code == 48;
                    }
                    SecretField {
                        field: 17;
                        label: @tr("Another part");
                        required: true;
                        eye: true;
                        cells: true;
                        placeholder: "B0-";
                        error: root.error-code == 44 || root.error-code == 45 || root.error-code == 46 || root.error-code == 48;
                        accepted => { password.focus(); }
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 4px;
                        LinkButton {
                            icon: "folder";
                            text: @tr("Read a part from a file…");
                            clicked => { root.choose-part-picture(); }
                        }
                        LinkButton {
                            icon: "key";
                            text: @tr("Type the Secret Key instead");
                            clicked => { root.use-parts = false; }
                        }
                    }
                }
                password := SecretField {
                    field: 0;
                    label: @tr("Master password");
                    icon: "key";
                    required: true;
                    eye: true;
                    error: root.error-code == 1;
                    init => { self.focus(); }
                    accepted => { root.unlock(); }
                }
                if root.needs-keyfile: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: @tr("Keyfile");
                        font-size: Theme.small;
                        color: Theme.graphite;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: Theme.control-height;
                            border-radius: Theme.radius;
                            background: Theme.field;
                            border-width: 1px;
                            border-color: root.error-code == 32 || root.error-code == 33 ? Theme.seal : Theme.rule;
                            Text {
                                x: 12px;
                                width: parent.width - 24px;
                                text: root.keyfile-path != "" ? root.keyfile-path : @tr("No file chosen");
                                font-size: Theme.small;
                                color: root.keyfile-path != "" ? Theme.ink : Theme.faint;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            QuietButton {
                                outlined: true;
                                text: @tr("Choose…");
                                clicked => { root.choose-keyfile(); }
                            }
                        }
                    }
                }
                ErrorLine {
                    code: root.error-code;
                    detail: root.error-detail;
                }
                // One yellow button per screen: with Windows Hello on, it is the Hello one.
                if !root.hello-first: Button {
                    text: @tr("Unlock");
                    busy-text: @tr("Unlocking…");
                    busy: root.busy;
                    clicked => { root.unlock(); }
                }
                if root.hello-first: QuietButton {
                    text: root.busy && !root.quick-waiting ? @tr("Unlocking…") : @tr("Unlock with password");
                    outlined: true;
                    enabled: !root.busy;
                    clicked => { root.unlock(); }
                }
                Rule { }
                HorizontalLayout {
                    spacing: 4px;
                    LinkButton {
                        icon: "lifebuoy";
                        text: @tr("Forgot it? Use your emergency kit");
                        clicked => { root.forgot(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    LinkButton {
                        icon: "swap";
                        text: @tr("Use another vault");
                        clicked => { root.choosing = true; }
                    }
                }
            }
        }
    }
}

export component RecoverScreen inherits Rectangle {
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    // Three recovery parts; false for a vault that still has the Recovery Key of an older kit.
    in property <bool> with-parts: true;
    // 1: the parts (checked before going on), 2: the new master password.
    in-out property <int> step: 1;
    callback check-parts();
    callback choose-part-picture();
    callback recover();
    callback back();

    background: Theme.canvas;

    HorizontalLayout {
        SidePanel {
            scene: Theme.lock-backdrop == 2 || Theme.lock-backdrop == 3;
            Rectangle { height: 56px; }
            Text {
                text: @tr("Recover access");
                font-size: Theme.headline;
                font-weight: 300;
                color: Theme.ink;
            }
            Rectangle { height: 20px; }
            StepMark { number: 1; text: root.with-parts ? @tr("Recovery parts") : @tr("Recovery Key"); active: root.step == 1; }
            StepMark { number: 2; text: @tr("New master password"); active: root.step == 2; }
            StepMark { number: 3; text: @tr("New emergency kit"); }
            Spacer { }
            VerticalLayout {
                spacing: 12px;
                vertical-stretch: 0;
                Fact { text: @tr("Your items stay exactly as they are."); }
                Fact { text: @tr("You get a new Secret Key; the old one stops working."); }
                Fact { text: root.with-parts ? @tr("Recovery parts work once: you make new ones at the end.") : @tr("Your Recovery Key keeps working."); }
            }
        }
        Rectangle { width: 1px; background: Theme.rule; }

        FormArea {
            form-width: 420px;
            scene: Theme.lock-backdrop == 1 || Theme.lock-backdrop == 3;
            VerticalLayout {
                spacing: 16px;

                Heading { text: @tr("Use your emergency kit"); }
                Prose {
                    text: !root.with-parts ? @tr("Type the Recovery Key from your emergency kit, then choose a new master password.")
                        : root.step == 1 ? @tr("Type the three recovery parts from your emergency kit.")
                        : @tr("The parts are right. Choose a new master password.");
                }
                if root.with-parts && root.step == 1: VerticalLayout {
                    spacing: 12px;
                    SecretField {
                        field: 16;
                        label: @tr("Part A");
                        required: true;
                        eye: true;
                        cells: true;
                        hint: @tr("A0-, B0- and C0- and four groups of seven characters. Their order, dashes, spaces and capitals don't matter.");
                        placeholder: "A0-";
                        error: root.error-code == 44 || root.error-code == 45 || root.error-code == 46 || root.error-code == 48;
                    }
                    SecretField {
                        field: 17;
                        label: @tr("Part B");
                        required: true;
                        eye: true;
                        cells: true;
                        placeholder: "B0-";
                        error: root.error-code == 44 || root.error-code == 45 || root.error-code == 46 || root.error-code == 48;
                    }
                    SecretField {
                        field: 18;
                        label: @tr("Part C");
                        required: true;
                        eye: true;
                        cells: true;
                        placeholder: "C0-";
                        error: root.error-code == 44 || root.error-code == 45 || root.error-code == 46 || root.error-code == 48 || root.error-code == 47;
                        accepted => { root.check-parts(); }
                    }
                    HorizontalLayout {
                        alignment: start;
                        LinkButton {
                            icon: "folder";
                            text: @tr("Read a part from a file…");
                            clicked => { root.choose-part-picture(); }
                        }
                    }
                    ErrorLine {
                        code: root.error-code;
                        detail: root.error-detail;
                    }
                    Button {
                        text: @tr("Continue");
                        busy-text: @tr("Checking…");
                        busy: root.busy;
                        clicked => { root.check-parts(); }
                    }
                }
                if !root.with-parts: SecretField {
                    field: 3;
                    eye: true;
                    label: @tr("Recovery Key");
                    required: true;
                    hint: @tr("Copy it from your emergency kit: the longer key, starting with R0- and nine groups of six characters. Dashes, spaces and capitals don't matter.");
                    placeholder: "R0-";
                    error: root.error-code == 8;
                }
                if !root.with-parts || root.step == 2: VerticalLayout {
                    spacing: 16px;
                    SecretField {
                        field: 0;
                        label: @tr("New master password");
                        required: true;
                        eye: true;
                        error: root.error-code == 4 || root.error-code == 5;
                    }
                    SecretField {
                        field: 1;
                        label: @tr("Type it again");
                        required: true;
                        eye: true;
                        error: root.error-code == 4;
                        accepted => { root.recover(); }
                    }
                    ErrorLine {
                        code: root.error-code;
                        detail: root.error-detail;
                    }
                    Button {
                        text: @tr("Recover vault");
                        busy-text: @tr("Recovering…");
                        busy: root.busy;
                        clicked => { root.recover(); }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    if root.with-parts && root.step == 2: QuietButton {
                        text: @tr("Back to the parts");
                        tint: Theme.graphite;
                        clicked => { root.step = 1; }
                    }
                    QuietButton {
                        text: @tr("Back to unlock");
                        tint: Theme.graphite;
                        clicked => { root.back(); }
                    }
                }
            }
        }
    }
}
