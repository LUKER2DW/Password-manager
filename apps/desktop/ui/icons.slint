// The colour of each kind of field.
export global FieldColors {
    public pure function of(name: string) -> color {
        if (name == "key") { return Theme.dark ? #E7C54B : #A67C00; }
        if (name == "user" || name == "mail") { return Theme.dark ? #74A9FF : #2D6BD0; }
        if (name == "globe" || name == "clock" || name == "browser") { return Theme.dark ? #4FC6B7 : #1A8A7D; }
        if (name == "card") { return Theme.dark ? #B38FFF : #6D45C6; }
        if (name == "calendar") { return Theme.dark ? #FFA25E : #BF5E1A; }
        if (name == "shield") { return Theme.dark ? #72C291 : #2E7D55; }
        if (name == "pin") { return Theme.dark ? #FF82B8 : #C03B78; }
        if (name == "list" || name == "download") { return Theme.dark ? #FFB75A : #A86A0E; }
        if (name == "tag" || name == "sliders") { return Theme.dark ? #9DAAFF : #4C5CC2; }
        if (name == "warning" || name == "leaked") { return Theme.seal; }
        if (name == "reused") { return Theme.dark ? #FF82B8 : #C03B78; }
        if (name == "expired") { return Theme.dark ? #FFA25E : #BF5E1A; }
        if (name == "heart") { return Theme.dark ? #FF7A85 : #C2333F; }
        if (name == "star") { return Theme.dark ? #E7C54B : #A67C00; }
        if (name == "sparkle") { return Theme.dark ? #B38FFF : #6D45C6; }
        if (name == "lifebuoy") { return Theme.dark ? #FFA25E : #BF5E1A; }
        if (name == "swap" || name == "stack") { return Theme.dark ? #74A9FF : #2D6BD0; }
        if (name == "qr" || name == "fingerprint") { return Theme.dark ? #4FC6B7 : #1A8A7D; }
        if (name == "image") { return Theme.dark ? #FF82B8 : #C03B78; }
        return Theme.graphite;
    }
}

// Choices for a folder's look: its icon and colour (index 0 = the default colour of the icon).
export global FolderLook {
    out property <[string]> icons: ["folder", "star", "heart", "globe", "mail", "key", "card", "lock", "gear", "user", "tag", "note", "clock", "shield", "vault", "sparkle", "bank", "cart", "gamepad", "code", "terminal", "server", "cloud", "wifi", "home", "briefcase", "chat", "music", "plane", "phone", "database", "lifebuoy"];
    out property <[color]> colors: [
        Theme.graphite, #4C8DF6, #8B6CF0, #2BB07F, #F08A3C, #E0569A, #23A6C9, #E05252, #D9B23A,
    ];
    public pure function tint(icon: string, color: int) -> color {
        if (color <= 0 || color >= self.colors.length) { return FieldColors.of(icon == "" ? "folder" : icon); }
        return self.colors[color];
    }
}

// The look of a chosen line icon (an item's, or a vault's on the phone): every icon has a
// colour of its own and sits on a soft tile of it; the icon's colour and its tile's can be
// chosen from `colors` instead (0 = the icon's own; the same list for both). view.rs keeps the
// choice as `name:colour:tile`.
export global IconLook {
    out property <[color]> colors: [
        transparent, #4C8DF6, #8B6CF0, #2BB07F, #F08A3C, #E0569A, #23A6C9, #E05252, #D9B23A, #F4F6F8,
    ];
    // The last colour is white: on a white tile the icon keeps its own colour.
    out property <int> white: 9;
    public pure function own(name: string) -> color {
        let c = name == "folder" || name == "vault" || name == "key" || name == "star" ? #E7C54B
            : name == "heart" ? #FF7A85
            : name == "globe" || name == "clock" || name == "wifi" ? #4FC6B7
            : name == "mail" || name == "user" || name == "server" || name == "chat" ? #74A9FF
            : name == "card" || name == "sparkle" || name == "gamepad" ? #B38FFF
            : name == "lock" || name == "gear" || name == "tag" || name == "phone" ? #9DAAFF
            : name == "note" || name == "database" ? #FFB75A
            : name == "shield" || name == "bank" || name == "terminal" ? #72C291
            : name == "cart" || name == "home" || name == "lifebuoy" ? #FFA25E
            : name == "code" || name == "plane" ? #5CC8E8
            : name == "cloud" ? #8EC5FF
            : name == "briefcase" ? #D9A066
            : name == "music" ? #FF82B8
            : FieldColors.of(name);
        return Theme.dark ? c : c.darker(45%);
    }
    // The icon's colour: chosen, or white on a chosen tile, or its own.
    public pure function ink(name: string, color: int, background: int) -> color {
        if (color > 0 && color < self.colors.length) { return self.colors[color]; }
        if (background > 0 && background < self.colors.length && background != self.white) { return #FFFFFF; }
        return self.own(name);
    }
    // The tile under it: chosen, or a soft wash of the icon's colour.
    public pure function tile(name: string, color: int, background: int) -> color {
        if (background > 0 && background < self.colors.length) { return self.colors[background]; }
        return self.ink(name, color, 0).transparentize(0.8);
    }
}

export component Glyph inherits Path {
    in property <string> name;
    in property <color> tint: FieldColors.of(root.name);
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.tint;
    stroke-width: 2px * self.width / 24px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    commands: root.name == "expired" ? Glyphs.expired
        : root.name == "reused" ? Glyphs.reused
        : root.name == "old" ? Glyphs.old
        : root.name == "leaked" ? Glyphs.leaked
        : root.name == "key" ? Glyphs.key
        : root.name == "user" ? Glyphs.user
        : root.name == "mail" ? Glyphs.mail
        : root.name == "globe" ? Glyphs.globe
        : root.name == "card" ? Glyphs.card
        : root.name == "calendar" ? Glyphs.calendar
        : root.name == "shield" ? Glyphs.shield
        : root.name == "windows" ? Glyphs.windows
        : root.name == "pin" ? Glyphs.pin
        : root.name == "clock" ? Glyphs.clock
        : root.name == "note" ? Glyphs.note
        : root.name == "list" ? Glyphs.list
        : root.name == "history" ? Glyphs.history
        : root.name == "tag" ? Glyphs.tag
        : root.name == "folder" ? Glyphs.folder
        : root.name == "warning" ? Glyphs.warning
        : root.name == "heart" ? Glyphs.heart
        : root.name == "download" ? Glyphs.download
        : root.name == "printer" ? Glyphs.printer
        : root.name == "browser" ? Glyphs.browser
        : root.name == "vault" ? Glyphs.vault
        : root.name == "sliders" ? Glyphs.sliders
        : root.name == "trash" ? Glyphs.trash
        : root.name == "copy" ? Glyphs.copy
        : root.name == "external" ? Glyphs.external
        : root.name == "arrow-up" ? Glyphs.arrow-up
        : root.name == "arrow-down" ? Glyphs.arrow-down
        : root.name == "pencil" ? Glyphs.pencil
        : root.name == "star" ? Glyphs.star
        : root.name == "gear" ? Glyphs.gear
        : root.name == "lock" ? Glyphs.lock
        : root.name == "swap" ? Glyphs.swap
        : root.name == "lifebuoy" ? Glyphs.lifebuoy
        : root.name == "sparkle" ? Glyphs.sparkle
        : root.name == "stack" ? Glyphs.stack
        : root.name == "refresh" ? Glyphs.refresh
        : root.name == "exit" ? Glyphs.exit
        : root.name == "terminal" ? Glyphs.terminal
        : root.name == "paperclip" ? Glyphs.paperclip
        : root.name == "qr" ? Glyphs.qr
        : root.name == "fingerprint" ? Glyphs.fingerprint
        : root.name == "image" ? Glyphs.image
        : root.name == "eye" ? Glyphs.eye
        : root.name == "bank" ? Glyphs.bank
        : root.name == "cart" ? Glyphs.cart
        : root.name == "gamepad" ? Glyphs.gamepad
        : root.name == "code" ? Glyphs.code
        : root.name == "server" ? Glyphs.server
        : root.name == "cloud" ? Glyphs.cloud
        : root.name == "wifi" ? Glyphs.wifi
        : root.name == "home" ? Glyphs.home
        : root.name == "briefcase" ? Glyphs.briefcase
        : root.name == "chat" ? Glyphs.chat
        : root.name == "music" ? Glyphs.music
        : root.name == "plane" ? Glyphs.plane
        : root.name == "phone" ? Glyphs.phone
        : root.name == "database" ? Glyphs.database
        : root.name == "unlocked" ? Glyphs.unlocked
        : root.name == "plus" ? Glyphs.plus
        : root.name == "eye-off" ? Glyphs.eye-off
        : root.name == "palette" ? Glyphs.palette
        : root.name == "close" ? Glyphs.close
        : root.name == "sidebar" ? Glyphs.sidebar
        : root.name == "search" ? Glyphs.search
        : root.name == "chevron-down" ? Glyphs.chevron-down
        : root.name == "chevron-left" ? Glyphs.chevron-left
        : root.name == "chevron-right" ? Glyphs.chevron-right
        : root.name == "bell" ? Glyphs.bell
        : Glyphs.tag;
}

// A field's icon in its colour (just the line drawing, no tile behind it).
export component FieldIcon inherits Rectangle {
    in property <string> name;
    in property <length> size: 26px;
    width: root.size;
    height: root.size;
    Glyph {
        width: root.size * 0.72;
        height: root.size * 0.72;
        name: root.name;
    }
}

// A card network's mark, simplified (not the official artwork).
// brand: 0 unknown, 1 Visa, 2 Mastercard, 3 American Express, 4 Elo, 5 Hipercard, 6 Discover,
// 7 Diners Club, 8 JCB, 9 Maestro.
export component BrandMark inherits Rectangle {
    in property <int> brand;
    in property <length> size: 40px;
    width: root.size;
    height: root.size * 0.64;
    border-radius: root.size * 0.12;
    clip: true;
    background: root.brand == 1 ? #FFFFFF
        : root.brand == 2 || root.brand == 9 ? #FFFFFF
        : root.brand == 3 ? #1F72CD
        : root.brand == 4 ? #111111
        : root.brand == 5 ? #B3131B
        : root.brand == 6 ? #FFFFFF
        : root.brand == 7 ? #0A6EB4
        : root.brand == 8 ? #FFFFFF
        : Theme.dark ? #3B4757 : #CBD3DD;
    border-width: (root.brand == 1 || root.brand == 2 || root.brand == 6 || root.brand == 8 || root.brand == 9) && !Theme.dark ? 1px : 0px;
    border-color: Theme.rule;
    accessible-role: image;

    if root.brand == 1: Text {
        text: "VISA";
        font-size: root.size * 0.3;
        font-weight: 900;
        font-italic: true;
        color: #1A1F71;
    }
    if root.brand == 2 || root.brand == 9: Rectangle {
        property <length> d: root.size * 0.36;
        Rectangle {
            x: parent.width / 2 - root.size * 0.29;
            width: parent.d;
            height: parent.d;
            border-radius: parent.d / 2;
            background: root.brand == 2 ? #EB001B : #0099DF;
        }
        Rectangle {
            x: parent.width / 2 - root.size * 0.07;
            width: parent.d;
            height: parent.d;
            border-radius: parent.d / 2;
            background: (root.brand == 2 ? #F79E1B : #ED0006).with-alpha(0.88);
        }
    }
    if root.brand == 3: Text {
        text: "AMEX";
        font-size: root.size * 0.24;
        font-weight: 800;
        color: #FFFFFF;
    }
    if root.brand == 4: HorizontalLayout {
        alignment: center;
        spacing: root.size * 0.04;
        Text {
            text: "elo";
            font-size: root.size * 0.3;
            font-weight: 800;
            color: #FFFFFF;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            spacing: root.size * 0.03;
            for c in [#FFCB05, #00A4E0, #EF4123]: Rectangle {
                width: root.size * 0.07;
                height: root.size * 0.07;
                border-radius: root.size * 0.035;
                background: c;
            }
        }
    }
    if root.brand == 5: Text {
        text: "Hiper";
        font-size: root.size * 0.24;
        font-weight: 800;
        font-italic: true;
        color: #FFFFFF;
    }
    if root.brand == 6: HorizontalLayout {
        alignment: center;
        spacing: root.size * 0.03;
        Text {
            text: "DISC";
            font-size: root.size * 0.2;
            font-weight: 800;
            color: #231F20;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.size * 0.16;
                height: root.size * 0.16;
                border-radius: root.size * 0.08;
                background: #F48120;
            }
        }
    }
    if root.brand == 7: Text {
        text: "Diners";
        font-size: root.size * 0.2;
        font-weight: 700;
        color: #FFFFFF;
    }
    if root.brand == 8: HorizontalLayout {
        padding: root.size * 0.08;
        spacing: root.size * 0.03;
        for pair in [{ c: #0E4C96, t: "J" }, { c: #E21836, t: "C" }, { c: #00843D, t: "B" }]: Rectangle {
            border-radius: root.size * 0.05;
            background: pair.c;
            Text {
                text: pair.t;
                font-size: root.size * 0.22;
                font-weight: 800;
                color: #FFFFFF;
            }
        }
    }
    if root.brand == 0: Path {
        width: parent.width * 0.6;
        height: parent.height * 0.8;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Glyphs.card;
        stroke: Theme.dark ? #E3E8EF : #3B4757;
        stroke-width: 1.6px;
        fill: transparent;
    }
}

