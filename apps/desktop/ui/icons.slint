// Where an import comes from: the brand's own icon where Simple Icons has it, a drawn mark
// otherwise (Chrome in its four colours, Edge, Proton Pass, NordPass, a plain file). Order of
// vault_import::Source::ALL: 0 Chrome, 1 Edge, 2 Firefox, 3 Brave, 4 Opera,
// 5 Opera GX, 6 Vivaldi, 7 Safari, 8 Bitwarden, 9 1Password, 10 LastPass, 11 KeePass,
// 12 Dashlane, 13 Proton Pass, 14 NordPass, 15 any CSV/JSON file.
export component SourceMark inherits Rectangle {
    in property <int> source;
    in property <length> size: 24px;
    width: root.size;
    height: root.size;
    accessible-role: image;

    // Round marks
    if root.source == 0: Rectangle {
        Path {
            width: root.size; height: root.size;
            viewbox-width: 24; viewbox-height: 24;
            commands: "M12 12 L3.34 7 A10 10 0 0 1 20.66 7 Z";
            fill: #DB4437;
        }
        Path {
            width: root.size; height: root.size;
            viewbox-width: 24; viewbox-height: 24;
            commands: "M12 12 L20.66 7 A10 10 0 0 1 12 22 Z";
            fill: #F4B400;
        }
        Path {
            width: root.size; height: root.size;
            viewbox-width: 24; viewbox-height: 24;
            commands: "M12 12 L12 22 A10 10 0 0 1 3.34 7 Z";
            fill: #0F9D58;
        }
        Rectangle { width: root.size * 0.4; height: self.width; border-radius: self.width / 2; background: #FFFFFF; }
        Rectangle { width: root.size * 0.3; height: self.width; border-radius: self.width / 2; background: #4285F4; }
    }
    if root.source == 1: Rectangle {
        width: root.size * 0.86; height: self.width; border-radius: self.width / 2;
        background: @linear-gradient(135deg, #2BC28A 0%, #0C59A4 100%);
        Text { text: "e"; color: #FFFFFF; font-size: root.size * 0.58; font-weight: 800; }
    }
    if root.source == 14: Rectangle {
        width: root.size * 0.86; height: self.width; border-radius: self.width / 2;
        background: #3DBFA8;
        if root.source == 14: Text { text: "N"; color: #FFFFFF; font-size: root.size * 0.5; font-weight: 800; }
    }

    // Square marks
    if root.source == 13 || root.source == 15: Rectangle {
        width: root.size * 0.88; height: self.width; border-radius: self.width * 0.24;
        background: root.source == 13 ? #6D4AFF : (Theme.dark ? #3B4757 : #CBD3DD);
        if root.source == 13: Path {
            width: parent.width * 0.66; height: parent.height * 0.66;
            viewbox-width: 24; viewbox-height: 24;
            commands: Glyphs.key;
            stroke: #FFFFFF; stroke-width: 2.2px; fill: transparent;
        }
        if root.source == 15: Path {
            width: parent.width * 0.66; height: parent.height * 0.66;
            viewbox-width: 24; viewbox-height: 24;
            commands: Glyphs.note;
            stroke: Theme.ink; stroke-width: 1.8px; fill: transparent;
        }
    }

    // Official icons, in each brand's colour.
    if root.source == 2: Path {
        width: root.size; height: root.size;
        viewbox-width: 24; viewbox-height: 24;
        commands: BrandPaths.pfirefoxbrowser;
        fill: #FF7139;
    }
    if root.source == 3: Path {
        width: root.size; height: root.size;
        viewbox-width: 24; viewbox-height: 24;
        commands: BrandPaths.pbrave;
        fill: #FB542B;
    }
    if root.source == 4: Path {
        width: root.size; height: root.size;
        viewbox-width: 24; viewbox-height: 24;
        commands: BrandPaths.popera;
        fill: #FF1B2D;
    }
    if root.source == 5: Path {
        width: root.size; height: root.size;
        viewbox-width: 24; viewbox-height: 24;
        commands: BrandPaths.poperagx;
        fill: #EE2950;
    }
    if root.source == 6: Path {
        width: root.size; height: root.size;
        viewbox-width: 24; viewbox-height: 24;
        commands: BrandPaths.pvivaldi;
        fill: #EF3939;
    }
    if root.source == 7: Path {
        width: root.size; height: root.size;
        viewbox-width: 24; viewbox-height: 24;
        commands: BrandPaths.psafari;
        fill: #006CFF;
    }
    if root.source == 8: Path {
        width: root.size; height: root.size;
        viewbox-width: 24; viewbox-height: 24;
        commands: BrandPaths.pbitwarden;
        fill: #175DDC;
    }
    if root.source == 9: Path {
        width: root.size; height: root.size;
        viewbox-width: 24; viewbox-height: 24;
        commands: BrandPaths.p1password;
        fill: #3B66BC;
    }
    if root.source == 10: Path {
        width: root.size; height: root.size;
        viewbox-width: 24; viewbox-height: 24;
        commands: BrandPaths.plastpass;
        fill: #D32D27;
    }
    if root.source == 11: Path {
        width: root.size; height: root.size;
        viewbox-width: 24; viewbox-height: 24;
        commands: BrandPaths.pkeepassxc;
        fill: #6CAC4D;
    }
    if root.source == 12: Path {
        width: root.size; height: root.size;
        viewbox-width: 24; viewbox-height: 24;
        commands: BrandPaths.pdashlane;
        fill: Theme.ink;
    }
}

// Picks one import source from a group (`first` … `first + count - 1` of `sources`), each
// shown with its mark; browsers also say whether they are on this computer.
export component SourcePicker inherits VerticalLayout {
    in property <string> label;
    in property <[SourceRow]> sources;
    in property <int> first;
    in property <int> count: 8;
    in-out property <int> selected: -1;
    callback changed(int);
    spacing: 6px;

    Text {
        text: root.label;
        font-size: Theme.small;
        color: Theme.graphite;
    }
    well := Rectangle {
        height: Theme.control-height + 4px;
        border-radius: Theme.radius;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.rule;
        accessible-role: combobox;
        accessible-label: root.label;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 10px;
            if root.selected >= 0: VerticalLayout {
                alignment: center;
                SourceMark { source: root.selected; size: 22px; }
            }
            Text {
                horizontal-stretch: 1;
                text: root.selected >= 0 ? root.sources[root.selected].name : @tr("Choose…");
                font-size: Theme.body;
                color: root.selected >= 0 ? Theme.ink : Theme.graphite;
                vertical-alignment: center;
                overflow: elide;
            }
            Path {
                width: 10px;
                height: 6px;
                y: (parent.height - self.height) / 2;
                viewbox-width: 10;
                viewbox-height: 6;
                commands: "M1 1 L5 5 L9 1";
                stroke: Theme.graphite;
                stroke-width: 1.4px;
                fill: transparent;
            }
        }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { list.show(); }
        }
        list := PopupWindow {
            y: well.height + 4px;
            width: well.width;
            close-policy: close-on-click;
            Rectangle {
                background: Theme.sheet;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.rule;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000055;
                VerticalLayout {
                    padding: 4px;
                    for k in root.count: opt := Rectangle {
                        property <int> index: root.first + k;
                        height: 38px;
                        border-radius: Theme.radius - 2px;
                        background: option-touch.has-hover ? Theme.hover : self.index == root.selected ? Theme.selected : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                SourceMark { source: opt.index; size: 22px; }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: root.sources[opt.index].name;
                                font-size: Theme.body;
                                color: Theme.ink;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if root.sources[opt.index].browser: Text {
                                text: root.sources[opt.index].installed ? @tr("on this computer") : "";
                                font-size: Theme.small;
                                color: Theme.good;
                                vertical-alignment: center;
                            }
                        }
                        option-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.selected = parent.index;
                                root.changed(parent.index);
                            }
                        }
                    }
                }
            }
        }
    }
}
