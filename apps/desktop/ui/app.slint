    in property <string> totp-code;
    in property <int> totp-left;
    in property <[string]> detail-urls;
    in property <string> detail-notes;
    in property <[DetailField]> detail-fields;
    in property <string> detail-folder;
    in property <int> detail-codes-total;
    in property <[FileRow]> detail-files;
    callback file-save(int);
