    in property <bool> ed-ssh-has-key;
    in property <string> ed-ssh-public;
    in property <string> ed-ssh-fingerprint;
    in property <string> ed-ssh-type;
    // A key brought in waits for its passphrase (typed in the editor, then `ssh-open`).
    in property <bool> ed-ssh-waiting;
    in property <[FileRow]> ed-files;
    in property <[PasskeyRow]> ed-passkeys;
    callback passkey-remove(int);
    callback ssh-generate();
    callback ssh-load();
    callback ssh-paste();
    callback ssh-open();
    callback file-add();
    callback file-remove(int);
    in property <int> detail-codes-left;
    in property <[CodeRow]> detail-codes;
    callback show-codes();
    callback hide-codes();
    callback copy-code(int);
    callback toggle-code-used(int);
    in-out property <bool> notes-shown;
    in-out property <bool> confirming-delete;
    callback edit-item();
    callback toggle-favorite();
    callback delete-item();
    callback reveal();
    callback conceal();
    callback copy-username();
    callback copy-password();
    callback copy-totp();
    callback copy-field(int);
    in property <int> revealed-field: -1;
    in property <string> revealed-field-value;
    callback reveal-field(int);
    callback open-url(int);
    callback copy-url(int);
    in property <int> detail-brand;
    in property <bool> detail-username-is-email;
    in property <int> detail-strength-bits;
    in property <int> detail-strength-score;
    in property <int> detail-weakness;
    in property <int> detail-reused-by;
    in property <int> detail-age-unit;
    in property <int> detail-age-amount;
    in property <int> detail-history-count;
    in property <[HistoryRow]> detail-history;
    in property <bool> detail-history-shown;
    callback show-history();
    callback hide-history();
    callback reveal-history(int);
    callback copy-history(int);
    callback clear-history();

    // ---- editor ----
    in property <bool> editing-item;
    in property <bool> editor-is-new;
    in property <string> editor-password-shown;
    in-out property <int> ed-kind;
    in-out property <string> ed-title;
    in-out property <string> ed-username;
    in-out property <string> ed-url;
    // The site's icon for what the editor's Website field says.
    in property <image> ed-site-icon;
    in property <bool> ed-has-site-icon;
    callback ed-url-changed();
    changed ed-url => { root.ed-url-changed(); }
    in-out property <string> ed-icon-url;
    // A line icon chosen for the item ("" = automatic) and its colours (IconLook).
    in-out property <string> ed-glyph;
    in-out property <int> ed-glyph-color;
    in-out property <int> ed-glyph-bg;
    in-out property <string> ed-totp;
    in-out property <string> ed-notes;
    in-out property <bool> ed-favorite;
    in-out property <bool> ed-reprompt;
    in property <[string]> ed-folder-options: [""];
    in-out property <int> ed-folder;
    in-out property <string> ed-recovery-codes;
    in-out property <string> ed-card-number;
    in-out property <string> ed-card-expiry;
    in-out property <string> ed-card-code;
    in property <string> ed-card-brand;
    in property <int> ed-card-brand-mark;
    in property <int> ed-strength-bits;
    in property <int> ed-crack-unit;
    in property <int> ed-crack-amount;
    in property <int> ed-weakness;
    in property <[EditField]> ed-fields;
    callback card-number-edited(string);
    callback field-edited(int, bool, string);
    callback field-hidden(int, bool);
    callback field-remove(int);
    callback field-add();
    callback save-item();
    callback cancel-edit();
    callback toggle-show-password();
    callback generate-for-item();
    // The generator's options are open under the password (closed each time the editor opens).
    in-out property <bool> ed-gen-open;

    // ---- generator ----
    in property <string> gen-result;
    in property <int> gen-bits;
    in property <int> gen-crack-unit;
    in property <int> gen-crack-amount;
    in property <int> gen-crack-comparison;
    in-out property <int> gen-mode;
    in-out property <int> gen-length: 24;
    in-out property <int> gen-words: 6;
    in-out property <bool> gen-lowercase: true;
    in-out property <bool> gen-uppercase: true;
    in-out property <bool> gen-digits: true;
    in-out property <bool> gen-symbols: true;
    in-out property <bool> gen-avoid-ambiguous;
    in-out property <bool> gen-extended;
    in-out property <string> gen-also-use;
    in-out property <string> gen-never-use;
    in-out property <int> gen-min-lowercase;
    in-out property <int> gen-min-uppercase;
    in-out property <int> gen-min-digits;
    in-out property <int> gen-min-symbols;
    in property <int> gen-alphabet;
    in-out property <int> gen-word-case;
    in-out property <bool> gen-number;
    in-out property <string> gen-separator: "-";
    in property <[string]> gen-wordlists: [""];
    in-out property <int> gen-wordlist;
    in property <bool> gen-wordlist-removable;
    callback regenerate();
    callback copy-generated();
    callback use-generated();
    callback add-wordlist();
    callback remove-wordlist();

    // ---- settings ----
    // The category shown (SettingsPage), and the dialog open over the window (its kinds are
    // listed there; 0 = none). Opened and closed through the app, which clears the error and
    // the dialog's secure fields.
    in-out property <int> settings-section;
    in-out property <int> settings-dialog;
    callback open-settings-dialog(int);
    callback close-settings-dialog();
    // A dialog's action, once the master password it asked for checks out (kinds 5 to 9).
    callback confirm-settings(int);
    in-out property <bool> browser-saves: true;
    in-out property <bool> browser-passkeys: true;
    // Warnings about a page that isn't a password's site, or only looks like a saved one.
    in-out property <bool> browser-warnings: true;
    in-out property <bool> browser-fill-notices: true;
    // Every password, code or passkey the extension uses asks first (Settings).
    in-out property <bool> browser-always-asks: true;
    // What it can ask for: 1 Windows Hello, 2 the item lock's PIN or password, 3 both, 0 none.
    in property <int> browser-ask-way;
    in-out property <bool> backdrop-on: true;
    in property <string> app-version;
    // Settings → Browser extension → Add to a browser: the installed browsers (the default
    // one first), adding to one (by its index), opening the extension's folder, and the steps
    // shown for the browser chosen (ExtensionStepsDialog: its name, whether it is Firefox, its
    // extensions page, the folder, whether the browser started and the path was copied).
    in property <[ExtensionBrowser]> extension-browsers;
    in-out property <int> extension-browser;
    callback add-extension(int);
    callback open-extension-folder();
    // What is in use (SettingsPage: 0 built in, 1 a GitHub release, 2 the person's folder),
    // choosing such a folder, and going back to GitHub's releases.
    in property <int> extension-source;
    in property <string> extension-version;
    in property <string> extension-local;
    callback choose-extension-folder();
    callback use-extension-release();
    in-out property <bool> extension-steps;
    in property <string> extension-steps-browser;
    in property <bool> extension-steps-firefox;
    in property <string> extension-steps-page;
    in property <string> extension-steps-folder;
    in property <bool> extension-steps-started;
    in property <bool> extension-steps-copied;
    // Settings → About → Check for updates (see SettingsPage).
    in property <int> update-state;
    in property <string> update-version;
    in property <string> update-detail;
    in-out property <bool> update-checks;
    callback check-updates();
    callback open-release();
    // The update installing itself (controller/updates.rs): 0 nothing under way, 1 checking the
    // release's signed manifest, 2 downloading (install-done-kb of install-total-kb), 3 checking
    // the program's SHA-256, 4 putting it in place, 5 installed (install-version; a restart
    // uses it), 6 failed (install-failure: 1 the folder can't be written, 2 refused, 3 the
    // network, 4 the swap; install-detail says more).
    in property <int> install-step;
    in property <int> install-done-kb;
    in property <int> install-total-kb;
    in property <string> install-version;
    in property <int> install-failure;
    in property <int> install-failed-at;
    in property <string> install-detail;
    in-out property <bool> update-install: true;
    in-out property <bool> update-panel;
    in-out property <bool> restart-asking;
    callback install-update();
    callback restart-now();
    // The title bar's toolbar: the sidebar hidden (kept on this computer), the vault menu (and
    // where it opens), the vault's icon on this computer and its initial, the file's own
    // name, and a request to focus the search (counted up).
    in-out property <bool> sidebar-hidden;
    callback toggle-sidebar();
    in-out property <bool> vault-menu;
    in-out property <length> vault-menu-x;
    in property <string> vault-icon;
    in property <string> vault-initial;
    in property <string> vault-stem;
    callback vault-icon-chosen(string);
    callback choose-vault-icon();
    in property <int> focus-search;
    callback search-now();
    // The title bar's alerts: what in the open vault asks for something (Password health's
    // leaked, weak and reused passwords and expired cards; sync failing, waiting for the item
    // lock, or a vault key renewed elsewhere). The bell shows only while there is one.
    in-out property <bool> alerts-panel;
    // 0–4 a Password health group (as its filter), 10 Settings → Sync.
    callback open-alert(int);
    property <int> alert-count: root.screen != Screen.vault ? 0
        : root.health-counts[0] + root.health-counts[1] + root.health-counts[2] + root.health-counts[4]
            + (root.sync-state == 3 ? 1 : 0) + (root.sync-waiting > 0 ? 1 : 0) + (root.sync-key-renewed ? 1 : 0);
    property <bool> alert-urgent: root.health-counts[0] > 0 || root.sync-state == 3 || root.sync-key-renewed;
    in-out property <int> auto-lock-minutes: 5;
    in-out property <int> clipboard-seconds: 20;
    in-out property <bool> website-icons;
    in-out property <bool> leak-watch;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> lock-with-windows: true;
    // How this computer keeps the open vault's Secret Key (CRYPTO.md §2.2.1): 1 under the
    // security chip, 2 by Windows alone, 0 not known yet (or not kept).
    in property <int> secret-key-kept;
    in-out property <bool> start-at-sign-in;
    in-out property <bool> start-in-tray: true;
    in-out property <bool> browser-locked-fill: true;
    in property <[GeneratedRow]> gen-history;
    in property <bool> gen-history-locked;
    callback gen-reveal-history(int);
    callback gen-copy-history(int);
    callback gen-clear-history();
    in-out property <bool> browser-extension;
    in property <string> vault-file-name;
    in-out property <string> vault-name-edit;
    in-out property <int> history-limit: 10;
    in property <int> vault-folders;
    // Argon2id cost of the vault: memory in MiB and passes.
    in property <int> kdf-memory;
    in property <int> kdf-passes;
    in property <int> vault-recovery;
    callback vault-settings-changed();
    callback settings-changed();
    // The first screen's switch for the look for updates: that setting alone.
    callback first-update-checks(bool);
    callback start-at-sign-in-changed(bool);
    callback appearance-changed(bool);
    // 0 follows Windows, then src/i18n.rs → LANGUAGES in order.
    in-out property <int> language;
    callback language-changed(int);
    callback change-password();
    in-out property <int> kdf-level: 1;
    in property <int> kdf-current: 1;
    in-out property <int> kdf-method;
    in property <int> kdf-current-method;
    in property <bool> kdf-failed;
    in property <string> unlock-time;
    callback change-kdf();
    callback show-kit();
    callback hide-kit();
    callback new-parts();
    callback renew-key();
    callback save-part-picture();
    callback open-kit();
    callback print-kit();
    // ---- import & export ----
    in property <int> import-stage;
    in property <[SourceRow]> import-sources;
    in property <[string]> import-source-names: [""];
    in-out property <int> import-source: -1;
    in property <string> import-file;
    in property <[ImportRow]> import-rows;
    in property <int> import-selected;
    in property <int> import-duplicates;
    in property <string> import-warnings;
    in property <int> import-added;
    in-out property <int> import-target;
    in property <[string]> import-folders: [""];
    in-out property <int> import-folder;
    in-out property <string> import-new-folder;
    in property <bool> import-plaintext;
    in-out property <int> export-format;
    // What the export being asked for leaves out and writes as plain text, and whether that
    // was counted again after it was confirmed (ExportDialog).
    in property <ExportCounts> export-counts;
    in property <bool> export-recounted;
    callback open-transfer();
    callback pick-source(int);
    callback open-browser();
    in property <bool> import-direct-supported;
    in-out property <int> import-browser-method;
    in property <[string]> import-browser-profiles;
    in-out property <int> import-browser-profile;
    callback import-direct();
    callback import-choose();
    callback import-open();
    callback import-toggle(int, bool);
    callback import-select-all(bool);
    callback import-confirm();
    callback import-cancel();
    callback import-wipe();
    callback export-backup();
    callback export-ask();
    callback export-cancel();
    callback export-plain();
    callback save-kit();
    callback save-parts-apart();

    if root.screen == Screen.onboarding: OnboardingScreen {
        y: root.title-height;
        height: root.height - root.title-height;
        step <=> root.onboarding-step;
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        suggestion: root.suggestion;
        recovered: root.recovered;
        kit-vault-id: root.vault-id;
        kit-secret-key: root.kit-secret-key;
        kit-pdf-password: root.kit-pdf-password;
        copy-pdf-password => { root.copy-kit-pdf-password(); }
        kit-part-a: root.kit-part-a;
        kit-part-b: root.kit-part-b;
        kit-part-c: root.kit-part-c;
        kit-path: root.vault-path;
        kit-saved <=> root.kit-saved;
        kit-filled <=> root.kit-filled;
        new-parts-now => { root.new-parts-now(); }
        guard <=> root.onboarding-guard;
        guard-all <=> root.guard-all;
        guard-hello <=> root.guard-hello;
        quick-available: root.quick-unlock-available;
        update-checks <=> root.update-checks;
        update-checks-changed(on) => { root.first-update-checks(on); }
        back => { root.onboarding-step = 1; }
        create => { root.create-vault(); }
        suggest => { root.suggest-passphrase(); }
        gen-open <=> root.onboarding-options;
        gen-mode <=> root.gen-mode;
        gen-length <=> root.gen-length;
        gen-words <=> root.gen-words;
        gen-lowercase <=> root.gen-lowercase;
        gen-uppercase <=> root.gen-uppercase;
        gen-digits <=> root.gen-digits;
        gen-symbols <=> root.gen-symbols;
        gen-avoid-ambiguous <=> root.gen-avoid-ambiguous;
        gen-word-case <=> root.gen-word-case;
        gen-number <=> root.gen-number;
        gen-separator <=> root.gen-separator;
        use-suggestion => { root.use-suggestion(); }
        finish => { root.finish-onboarding(); }
        import => { root.finish-onboarding-import(); }
        vaults: root.recent-vaults;
        choosing <=> root.choosing-vault;
        pick-vault(i) => { root.pick-vault(i); }
        forget-vault(i) => { root.forget-vault(i); }
        open-vault-file => { root.open-vault-file(); }
        new-vault-file => { root.new-vault-file(); }

        print-kit => { root.print-kit(); }
        save-kit => { root.save-kit(); }
        save-parts-apart => { root.save-parts-apart(); }
    }

    if root.screen == Screen.unlock: UnlockScreen {
        y: root.title-height;
        height: root.height - root.title-height;
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        needs-secret-key: root.needs-secret-key;
        can-use-parts: root.can-use-parts;
        use-parts <=> root.use-parts;
        choose-part-picture => { root.choose-part-picture(); }
        needs-keyfile: root.needs-keyfile;
        keyfile-path: root.keyfile-path;
        choose-keyfile => { root.choose-keyfile(); }
        vault-path: root.vault-path;
        quick-available: root.quick-unlock-available;
        quick-unlock: root.quick-unlock-on;
        quick-waiting: root.quick-waiting;
        unlock-failed: root.unlock-failed;
        unlock-wait: root.unlock-wait;
        unlock => { root.unlock(); }
        quick => { root.quick-unlock(); }
        forgot => { root.show-recovery(); }
        vaults: root.recent-vaults;
        choosing <=> root.choosing-vault;
        pick-vault(i) => { root.pick-vault(i); }
        forget-vault(i) => { root.forget-vault(i); }
        open-vault-file => { root.open-vault-file(); }
        new-vault-file => { root.new-vault-file(); }

    }

    if root.screen == Screen.recover: RecoverScreen {
        y: root.title-height;
        height: root.height - root.title-height;
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        with-parts: root.recover-with-parts;
        step <=> root.recover-step;
        check-parts => { root.check-parts(); }
        choose-part-picture => { root.choose-part-picture(); }
        recover => { root.recover(); }
        back => { root.back-to-unlock(); }
    }

    if root.screen == Screen.vault: HorizontalLayout {
        y: root.title-height;
        height: root.height - root.title-height;
        if !root.sidebar-hidden: VaultIndex {
            width: 216px;
            category: root.category;
            counts: root.counts;
            folders: root.folders;
            totp-count: root.totp-count;
            health-count: root.health-total;
            panel: root.panel;
            open-health => { root.open-health(); }
            new-folder => { root.new-folder(); }
            edit-folder(i) => { root.edit-folder(i); }
            folder-menu(i, x, y) => {
                root.menu-folder = i;
                root.menu-x = x;
                root.menu-y = y;
                folder-menu.show();
            }
            move-folder(from, to) => { root.move-folder(from, to); }
            select-category(c) => { root.select-category(c); }
            open-generator => { root.open-generator(); }
            open-settings => { root.open-settings(); }
            open-kit => { root.open-kit(); }
            open-transfer => { root.open-transfer(); }
            open-authenticator => { root.open-authenticator(); }
        }
        // Tool pages (generator, health, kit, import, settings, authenticator) take the whole
        // width next to the index; the item list belongs to browsing items only.
        if !root.sidebar-hidden: Rectangle { width: 1px; background: Theme.rule; }
        if root.panel == Panel.detail || root.panel == Panel.editor: ItemList {
            width: 320px;
            items: root.items;
            selected: root.selected;
            total: root.total-items;
