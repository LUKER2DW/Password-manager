            // Quieter behind the pages than beside them: it must not pull the eye from what the
            // page holds.
            if Theme.backdrop == 1 || Theme.backdrop == 4: Backdrop {
                width: parent.width;
                height: parent.height;
                strength: Theme.backdrop == 4 ? 0.26 : 0.34;
