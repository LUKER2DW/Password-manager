                crack-unit: root.gen-crack-unit;
                crack-amount: root.gen-crack-amount;
                crack-comparison: root.gen-crack-comparison;
                editing: root.editing-item;
                mode <=> root.gen-mode;
                length <=> root.gen-length;
                words <=> root.gen-words;
                lowercase <=> root.gen-lowercase;
                uppercase <=> root.gen-uppercase;
                digits <=> root.gen-digits;
                symbols <=> root.gen-symbols;
                avoid-ambiguous <=> root.gen-avoid-ambiguous;
                extended <=> root.gen-extended;
                also-use <=> root.gen-also-use;
                never-use <=> root.gen-never-use;
                min-lowercase <=> root.gen-min-lowercase;
                min-uppercase <=> root.gen-min-uppercase;
                min-digits <=> root.gen-min-digits;
                min-symbols <=> root.gen-min-symbols;
                alphabet: root.gen-alphabet;
                word-case <=> root.gen-word-case;
                number <=> root.gen-number;
                separator <=> root.gen-separator;
                wordlists: root.gen-wordlists;
                wordlist <=> root.gen-wordlist;
                wordlist-removable: root.gen-wordlist-removable;
                error-code: root.error-code;
                error-detail: root.error-detail;
                history: root.gen-history;
                history-locked: root.gen-history-locked;
                check: root.detail-check;
                hello: root.guard-hello-on;
                busy: root.busy;
                unlock => { root.unlock-item(); }
                unlock-hello => { root.unlock-item-hello(); }
                reveal-history(i) => { root.gen-reveal-history(i); }
                copy-history(i) => { root.gen-copy-history(i); }
                clear-history => { root.gen-clear-history(); }
                regenerate => { root.regenerate(); }
                copy => { root.copy-generated(); }
                use-for-item => { root.use-generated(); }
                add-wordlist => { root.add-wordlist(); }
                remove-wordlist => { root.remove-wordlist(); }
            }
            if root.panel == Panel.settings: SettingsPage {
                error-code: root.error-code;
                error-detail: root.error-detail;
                busy: root.busy;
                dark: Theme.dark;
                vault-path: root.vault-path;
                vault-id: root.vault-id;
                section <=> root.settings-section;
                open-dialog(kind) => { root.open-settings-dialog(kind); }
                app-version: root.app-version;
                update-state: root.update-state;
                update-version: root.update-version;
                update-detail: root.update-detail;
                update-checks <=> root.update-checks;
                check-updates => { root.check-updates(); }
                open-release => { root.open-release(); }
                update-install <=> root.update-install;
                install-step: root.install-step;
                install-done-kb: root.install-done-kb;
                install-total-kb: root.install-total-kb;
                install-version: root.install-version;
                install-failure: root.install-failure;
                install-failed-at: root.install-failed-at;
                install-detail: root.install-detail;
                install-update => { root.install-update(); }
                restart-now => { root.restart-asking = true; }
                vault-icon: root.vault-icon;
                vault-initial: root.vault-initial;
                vault-icon-chosen(icon) => { root.vault-icon-chosen(icon); }
                extension-browsers: root.extension-browsers;
                extension-browser <=> root.extension-browser;
                add-extension(index) => { root.add-extension(index); }
                open-extension-folder => { root.open-extension-folder(); }
                extension-source: root.extension-source;
                extension-version: root.extension-version;
                extension-local: root.extension-local;
                choose-extension-folder => { root.choose-extension-folder(); }
                use-extension-release => { root.use-extension-release(); }
                auto-lock-minutes <=> root.auto-lock-minutes;
                lock-with-windows <=> root.lock-with-windows;
                secret-key-kept: root.secret-key-kept;
                clipboard-seconds <=> root.clipboard-seconds;
                website-icons <=> root.website-icons;
                leak-watch <=> root.leak-watch;
                close-to-tray <=> root.close-to-tray;
                start-at-sign-in <=> root.start-at-sign-in;
                start-in-tray <=> root.start-in-tray;
                backdrop-on <=> root.backdrop-on;
                browser-locked-fill <=> root.browser-locked-fill;
                browser-extension <=> root.browser-extension;
                browser-saves <=> root.browser-saves;
                browser-passkeys <=> root.browser-passkeys;
                browser-warnings <=> root.browser-warnings;
