            folder-has-image: root.folder-has-image;
            edit-folder => { root.edit-folder(root.category - 100); }
            delete-folder => { root.ask-delete-folder(root.category - 100); }
            item-menu(index, x, y) => {
                root.select(index);
                root.menu-x = x;
                root.menu-y = y;
                item-menu.show();
            }
            search-text <=> root.search-text;
            focus-search: root.focus-search;
            search(text) => { root.search(text); }
            select(index) => { root.select(index); }
