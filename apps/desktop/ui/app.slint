                print-kit => { root.print-kit(); }
                save-kit => { root.save-kit(); }
                save-parts-apart => { root.save-parts-apart(); }
            }

            if root.notice-code != 0: Notice {
                x: parent.width - self.width - 28px;
                y: parent.height - self.height - 24px - (root.lock-warning-seconds > 0 ? 64px : 0px);
                text: root.notice-code == 124 ? Messages.failed-unlocks(root.notice-count, root.notice-arg)
                    : Messages.notice(root.notice-code, root.notice-arg);
            }
            if root.lock-warning-seconds > 0: LockWarning {
                x: parent.width - self.width - 28px;
                y: parent.height - self.height - 24px;
                seconds: root.lock-warning-seconds;
                stay => { root.stay-unlocked(); }
            }
        }
    }

    if root.screen == Screen.vault && root.parts-used: PartsUsedDialog {
        width: root.width;
        height: root.height;
        decided(make) => {
            root.parts-used = false;
            if (make) { root.new-parts-now(); }
        }
    }

    if root.screen == Screen.vault && root.pairing-code != "": PairingDialog {
        width: root.width;
        height: root.height;
        code: root.pairing-code;
        code-chars: root.pairing-code-chars;
        needs-password: root.pairing-needs-password;
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        decided(allow) => { root.pairing-decided(allow); }
    }

    if root.screen == Screen.vault && root.folder-dialog >= 0: FolderDialog {
        width: root.width;
        height: root.height;
        mode: root.folder-dialog;
        name <=> root.fd-name;
        icon <=> root.fd-icon;
        color-index <=> root.fd-color;
        link <=> root.fd-link;
        preview: root.fd-preview;
        has-preview: root.fd-has-preview;
        preview-state: root.fd-preview-state;
        item-count: root.fd-items;
        error-code: root.error-code;
