                file-remove(i) => { root.file-remove(i); }
                // Only to change an item: a new one is sealed when the item lock next opens.
                needs-check: !root.editor-is-new && root.guard-encrypts && !root.secrets-open && (root.guard-current-all || root.ed-reprompt);
                check: root.detail-check;
