                field-remove(i) => { root.field-remove(i); }
                field-add => { root.field-add(); }
                save => { root.save-item(); }
                cancel => { root.cancel-edit(); }
                toggle-show-password => { root.toggle-show-password(); }
                generate-password => { root.generate-for-item(); }
                gen-mode <=> root.gen-mode;
                gen-length <=> root.gen-length;
                gen-words <=> root.gen-words;
                gen-lowercase <=> root.gen-lowercase;
                gen-uppercase <=> root.gen-uppercase;
                gen-digits <=> root.gen-digits;
