                kit-part-a: root.kit-part-a;
                kit-part-b: root.kit-part-b;
                kit-part-c: root.kit-part-c;
                vault-recovery: root.vault-recovery;
                kit-filled <=> root.kit-filled;
                confirming-new-key <=> root.kit-confirming-new-parts;
                confirming-renew <=> root.kit-confirming-renew;
                asking-kit <=> root.kit-asking;
                part-c-pictured: root.kit-part-c-pictured;
                leave-c-out <=> root.kit-leave-c-out;
