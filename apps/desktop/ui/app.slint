                error-detail: root.error-detail;
                unlock => { root.unlock-item(); }
                lock-secrets => { root.lock-secrets(); }
                add-code => { root.new-item(); }
            }
            if root.panel == Panel.transfer: TransferPage {
                error-code: root.error-code;
                error-detail: root.error-detail;
                busy: root.busy;
                import-stage: root.import-stage;
                sources: root.import-sources;
                source-names: root.import-source-names;
                source <=> root.import-source;
                import-file: root.import-file;
                import-rows: root.import-rows;
                import-selected: root.import-selected;
                import-duplicates: root.import-duplicates;
                import-warnings: root.import-warnings;
                import-added: root.import-added;
                import-target <=> root.import-target;
                import-folders: root.import-folders;
                import-folder <=> root.import-folder;
                import-new-folder <=> root.import-new-folder;
