import { Theme, Sketch, Secrets } from "theme.slint";
// The monospace font, built in (see Theme.mono-font).
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-SemiBold.ttf";
import { FileRow, PasskeyRow, Screen, Panel, ItemRow, DetailField, FolderRow, CodeRow, AuthRow, RecentVault, EditField, HistoryRow, GeneratedRow, HealthRow, ImportRow, ExportCounts, SourceRow, DeviceLine, ExtensionBrowser, Messages, ItemLock } from "model.slint";
import { OnboardingScreen, UnlockScreen, RecoverScreen } from "welcome.slint";
import { VaultIndex, ItemList, VaultMark } from "vault.slint";
import { DetailPage, EditorPage, GeneratorPage, SettingsPage, KitPage, TransferPage, AuthenticatorPage, HealthPage, UpdateCard } from "pages.slint";
import { FolderDialog, PairingDialog, PartsUsedDialog, ConfirmDialog, MasterPasswordDialog, TakeKeyDialog, ItemLockDialog, ServerJoinDialog, ServerAddressDialog, ExportDialog, WebDavDialog, BackupServerDialog, InviteDialog, ExtensionStepsDialog } from "dialogs.slint";
import { MenuCard, MenuEntry, MenuRule, Backdrop } from "widgets.slint";
import { Glyph, FieldColors } from "icons.slint";
import { NewPassword } from "review.slint";
// A second window: the notification area icon's menu (src/tray.rs).
export { TrayMenu } from "tray.slint";

export { Theme, Sketch, Secrets, Screen, Panel, ItemRow, DetailField, FolderRow, CodeRow, AuthRow, RecentVault, EditField, HistoryRow, HealthRow, ImportRow, ExportCounts, SourceRow, DeviceLine, ExtensionBrowser, Messages, ItemLock, NewPassword }

// Confirmation messages ("Copied", "Saved"): bottom-right, out of the way of page content.
component Notice inherits Rectangle {
    in property <string> text;
    height: label.preferred-height + 22px;
    width: Math.min(label.preferred-width + 36px, 420px);
    border-radius: Theme.radius;
    background: Theme.dark ? #2A3442 : #1F2A3D;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000050;
    label := Text {
        x: 18px;
        width: parent.width - 36px;
        text: root.text;
        font-size: Theme.body;
        color: #EEF1F5;
        wrap: word-wrap;
    }
}

// One of the title bar's three buttons, with the system's own glyphs drawn on a 10 px square:
// 0 minimize (a line), 1 maximize (a box), 2 restore (two boxes), 3 close (a cross, on red
// when pointed at).
component WindowButton inherits Rectangle {
    in property <int> glyph;
    callback clicked();
    width: 46px;
    background: touch.pressed ? (root.glyph == 3 ? #C42B1CCC : Theme.selected)
        : touch.has-hover ? (root.glyph == 3 ? #C42B1C : Theme.hover)
        : transparent;
    accessible-role: button;
    accessible-label: root.glyph == 0 ? @tr("Minimize") : root.glyph == 1 ? @tr("Maximize") : root.glyph == 2 ? @tr("Restore") : @tr("Close");
    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.glyph == 0 ? "M0 5.5 L10 5.5"
            : root.glyph == 1 ? "M0.5 0.5 L9.5 0.5 L9.5 9.5 L0.5 9.5 Z"
            : root.glyph == 2 ? "M2.5 2.5 L2.5 0.5 L9.5 0.5 L9.5 7.5 L7.5 7.5 M0.5 2.5 L7.5 2.5 L7.5 9.5 L0.5 9.5 Z"
            : "M0.5 0.5 L9.5 9.5 M9.5 0.5 L0.5 9.5";
        stroke: root.glyph == 3 && touch.has-hover ? #FFFFFF : Theme.ink;
        stroke-width: 1px;
        fill: transparent;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A short label under a toolbar button: what it does, and its shortcut.
component Tip inherits Rectangle {
    in property <string> text;
    width: label.preferred-width + 18px;
    height: label.preferred-height + 10px;
    border-radius: Theme.radius - 2px;
    background: Theme.dark ? #2A3442 : #1F2A3D;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000050;
    label := Text {
        text: root.text;
        font-size: Theme.small;
        color: #EEF1F5;
    }
}

// A button of the title bar's toolbar: a line icon, and its tip a moment after the pointer
// rests on it. `tip-end` lines the tip's right edge up with the button's (the buttons on the
// right, so the tip stays inside the window).
component ToolButton inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <bool> tip-end;
    in property <color> tint: Theme.graphite;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: Theme.radius;
    background: root.active ? Theme.selected : root.enabled && touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-enabled: root.enabled;
    property <bool> hovered: touch.has-hover;
    property <bool> tip-shown;
    changed hovered => {
        if (!self.hovered) {
            self.tip-shown = false;
        }
    }
    Glyph {
        width: 16px;
        height: 16px;
        name: root.icon;
        tint: root.enabled ? root.tint : Theme.faint;
    }
    @children
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.tip-shown = false;
            root.clicked();
        }
    }
    Timer {
        interval: 550ms;
        running: root.hovered && !root.tip-shown;
        triggered => { root.tip-shown = true; }
    }
    if root.tip-shown && root.tip != "": Tip {
        x: root.tip-end ? root.width - self.width : 0px;
        y: root.height + 6px;
        text: root.tip;
    }
}

// One alert in the title bar's panel: what, a word on what to do, and a click that goes there.
component AlertRow inherits Rectangle {
    in property <string> icon;
    in property <color> tint;
    in property <string> text;
    in property <string> hint;
    callback clicked();
    height: 50px;
    border-radius: Theme.radius - 2px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Glyph {
                width: 18px;
                height: 18px;
                name: root.icon;
                tint: root.tint;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.text;
                font-size: Theme.body;
                font-weight: 600;
                color: Theme.ink;
                overflow: elide;
            }
            Text {
                text: root.hint;
                font-size: Theme.small;
                color: Theme.graphite;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Glyph {
                width: 12px;
                height: 12px;
                name: "chevron-right";
                tint: Theme.faint;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// A hairline between groups of the toolbar.
component ToolRule inherits VerticalLayout {
    alignment: center;
    padding-left: 5px;
    padding-right: 5px;
    Rectangle {
        width: 1px;
        height: 18px;
        background: Theme.rule;
    }
}

// The window's own title bar (the window has no frame of the system's), with the app's
// toolbar in it: drag an empty part to move the window (the system's own move, so it snaps
// to the screen's edges), double-click it to maximize or restore it.
//
// Left: the sidebar, back and forward, then the vault (its icon and name; the menu to switch).
// Right: search, new item, sync, the update, lock, then the window's buttons. On the lock and
// welcome screens only what means something there: the vault on the lock screen, the update.
// Nothing here shows or copies a secret.
component TitleBar inherits Rectangle {
    in property <bool> maximized;
    in property <Screen> screen;
    in property <bool> sidebar-shown;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    // The vault: the file's name while locked, the vault's own once open.
    in property <string> vault-label;
    in property <string> vault-icon;
    in property <string> vault-initial;
    in property <bool> vault-menu-open;
    in property <bool> sync-on;
    in property <int> sync-state;
    // The update (see AppWindow's update-…): told, installing (1–4), installed (5), failed (6).
    in property <bool> update-out;
    in property <int> install-step;
    in property <float> install-progress;
    in property <bool> update-panel-open;
    // Alerts (only while there are some): how many, whether one is urgent (a leaked password, a
    // sync that failed), and the panel open.
    in property <int> alert-count;
    in property <bool> alert-urgent;
    in property <bool> alerts-open;
    callback alerts();
    callback drag();
    callback toggle-maximized();
    callback minimize();
    callback close();
    callback toggle-sidebar();
    callback go-back();
    callback go-forward();
    callback vault-menu(length);
    callback search();
    callback new-item();
    callback lock();
    callback sync-now();
    callback update-panel();
    // When the last press on the bar was, to tell a double-click (the system's move takes the
    // second click otherwise).
    property <duration> pressed-at: -1s;
    property <bool> open: root.screen == Screen.vault;
    property <bool> update-shown: root.update-out || root.install-step > 0;
    background: Theme.canvas;
    accessible-role: groupbox;
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                if (root.pressed-at >= 0s && animation-tick() - root.pressed-at < 400ms) {
                    root.pressed-at = -1s;
                    root.toggle-maximized();
                } else {
                    root.pressed-at = animation-tick();
                    root.drag();
                }
            }
        }
    }
    HorizontalLayout {
        padding-left: 6px;
        spacing: 2px;
        if !root.open: HorizontalLayout {
            padding-left: 6px;
            padding-right: 8px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Image {
                    width: 16px;
                    height: 16px;
                    source: @image-url("brand/icon-64.png");
                }
            }
            if root.screen != Screen.unlock: Text {
                text: @tr("Vault");
                font-size: Theme.small;
                color: Theme.graphite;
                vertical-alignment: center;
            }
        }
        if root.open: VerticalLayout {
            alignment: center;
            ToolButton {
                icon: "sidebar";
                tip: root.sidebar-shown ? @tr("Hide the sidebar (Ctrl+B)") : @tr("Show the sidebar (Ctrl+B)");
                clicked => { root.toggle-sidebar(); }
            }
        }
        if root.open: VerticalLayout {
            alignment: center;
            ToolButton {
                icon: "chevron-left";
                tip: @tr("Back (Alt+Left)");
                enabled: root.can-go-back;
                tint: Theme.ink;
                clicked => { root.go-back(); }
            }
        }
        if root.open: VerticalLayout {
            alignment: center;
            ToolButton {
                icon: "chevron-right";
                tip: @tr("Forward (Alt+Right)");
                enabled: root.can-go-forward;
                tint: Theme.ink;
                clicked => { root.go-forward(); }
            }
        }
        if root.open: ToolRule { }
        if root.vault-label != "" && (root.open || root.screen == Screen.unlock): VerticalLayout {
            alignment: center;
            Rectangle {
                width: chip.preferred-width;
                height: 32px;
                border-radius: Theme.radius;
                background: root.vault-menu-open ? Theme.selected : chip-touch.has-hover ? Theme.hover : transparent;
                accessible-role: button;
                accessible-label: @tr("Vault: {}. Switch vault", root.vault-label);
                chip := HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        VaultMark {
                            icon: root.vault-icon;
                            initial: root.vault-initial;
                        }
                    }
                    Text {
                        text: root.vault-label;
                        max-width: 280px;
                        font-size: Theme.body;
                        font-weight: 600;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        Glyph {
                            width: 12px;
                            height: 12px;
                            name: "chevron-down";
                            tint: Theme.graphite;
                        }
                    }
                }
                chip-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.vault-menu(self.absolute-position.x); }
                }
            }
        }
        // The empty middle: it drags the window (the bar's own touch area is under it).
        Rectangle { horizontal-stretch: 1; }
        if root.open: VerticalLayout {
            alignment: center;
            ToolButton {
                icon: "search";
                tip: @tr("Search (Ctrl+F)");
                tip-end: true;
                clicked => { root.search(); }
            }
        }
        if root.open: VerticalLayout {
            alignment: center;
            ToolButton {
                icon: "plus";
                tip: @tr("New item (Ctrl+N)");
                tip-end: true;
                clicked => { root.new-item(); }
            }
        }
        if root.open && (root.sync-on || root.update-shown || root.alert-count > 0): ToolRule { }
        if root.open && root.alert-count > 0: VerticalLayout {
            alignment: center;
            ToolButton {
                icon: "bell";
                tip: @tr("{n} alert" | "{n} alerts" % root.alert-count);
                tip-end: true;
                active: root.alerts-open;
                tint: Theme.ink;
                clicked => { root.alerts(); }
                Rectangle {
                    x: parent.width - self.width - 2px;
                    y: 2px;
                    width: Math.max(14px, badge.preferred-width + 8px);
                    height: 14px;
                    border-radius: 7px;
                    background: root.alert-urgent ? Theme.seal : Theme.graphite;
                    badge := Text {
                        text: root.alert-count > 9 ? "9+" : root.alert-count;
                        font-size: 9px;
                        font-weight: 700;
                        color: Theme.canvas;
                    }
                }
            }
        }
        if root.open && root.sync-on: VerticalLayout {
            alignment: center;
            ToolButton {
                icon: "refresh";
                tip: root.sync-state == 2 ? @tr("Syncing…") : root.sync-state == 3 ? @tr("Sync failed: sync now") : @tr("Sync now");
                tip-end: true;
                enabled: root.sync-state != 2;
                tint: root.sync-state == 3 ? Theme.seal : Theme.graphite;
                clicked => { root.sync-now(); }
            }
        }
        if root.update-shown: VerticalLayout {
            alignment: center;
            ToolButton {
                icon: "download";
                tip: root.install-step == 5 ? @tr("Update installed: restart to use it")
                    : root.install-step == 6 ? @tr("The update failed")
                    : root.install-step > 0 ? @tr("Updating…")
                    : @tr("An update is out");
                tip-end: true;
                active: root.update-panel-open;
                tint: root.install-step == 6 ? Theme.seal : Theme.ink;
                clicked => { root.update-panel(); }
                // Downloading: how far, a thin line under the icon. Installed: one yellow dot.
                if root.install-step >= 1 && root.install-step <= 4: Rectangle {
                    x: 7px;
                    y: parent.height - 6px;
                    width: parent.width - 14px;
                    height: 2px;
                    border-radius: 1px;
                    background: Theme.rule;
                    Rectangle {
                        x: 0px;
                        width: parent.width * Math.clamp(root.install-progress, 0, 1);
                        height: parent.height;
                        border-radius: 1px;
                        background: Theme.ink;
                    }
                }
                if root.install-step == 5 || (root.install-step == 0 && root.update-out): Rectangle {
                    x: parent.width - 11px;
                    y: 5px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.install-step == 5 ? Theme.marker : Theme.graphite;
                }
            }
        }
        if root.open: VerticalLayout {
            alignment: center;
            ToolButton {
                icon: "lock";
                tip: @tr("Lock now (Ctrl+L)");
                tip-end: true;
                clicked => { root.lock(); }
            }
        }
        Rectangle { width: 6px; }
        WindowButton { glyph: 0; clicked => { root.minimize(); } }
        WindowButton { glyph: root.maximized ? 2 : 1; clicked => { root.toggle-maximized(); } }
        WindowButton { glyph: 3; clicked => { root.close(); } }
    }
}

// An edge or corner of the window that resizes it (the system's own resize): `direction` as
// in `Controller::window_resize`, 0 east, 1 north, 2 north-east, 3 north-west, 4 south,
// 5 south-east, 6 south-west, 7 west.
component ResizeEdge inherits TouchArea {
    in property <int> direction;
    callback resize(int);
    mouse-cursor: root.direction == 0 || root.direction == 7 ? MouseCursor.ew-resize
        : root.direction == 1 || root.direction == 4 ? MouseCursor.ns-resize
        : root.direction == 2 || root.direction == 6 ? MouseCursor.nesw-resize
        : MouseCursor.nwse-resize;
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            root.resize(root.direction);
        }
    }
}

// Shortly before the auto-lock: how long is left, and a button that keeps the vault open.
component LockWarning inherits Rectangle {
    in property <int> seconds;
    callback stay();
    height: 50px;
    // Icon, words and button, with their gaps and the padding on both sides.
    width: label.preferred-width + stay-label.preferred-width + 100px;
    border-radius: Theme.radius;
    background: Theme.dark ? #2A3442 : #1F2A3D;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000050;
    HorizontalLayout {
        x: 16px;
        width: parent.width - 26px;
        height: parent.height;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Glyph {
                width: 18px;
                height: 18px;
                name: "lock";
                tint: Theme.marker;
            }
        }
        label := Text {
            text: @tr("The vault locks in {n} second" | "The vault locks in {n} seconds" % root.seconds);
            font-size: Theme.body;
            color: #EEF1F5;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 30px;
                width: stay-label.preferred-width + 20px;
                border-radius: Theme.radius;
                background: stay-touch.has-hover ? #FFFFFF26 : #FFFFFF14;
                stay-label := Text {
                    text: @tr("Stay unlocked");
                    font-size: Theme.body;
                    font-weight: 600;
                    color: #EEF1F5;
                }
                stay-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.stay(); }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: @tr("Vault");
    icon: @image-url("brand/icon-64.png");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 940px;
    min-height: 620px;
    background: Theme.canvas;
    default-font-family: Theme.ui-font;
    default-font-size: Theme.body;
    // The window draws its own title bar (TitleBar): the screens start below it.
    no-frame: true;
    property <length> title-height: 40px;
    in property <bool> window-maximized;
    // The emergency kit page's "Issue new parts" and "Show my kit", asked in dialogs, and
    // Import & export's "Export…".
    in-out property <bool> kit-confirming-new-parts;
    // "Renew the vault key", asked in a dialog with the master password.
    in-out property <bool> kit-confirming-renew;
    // Part C saved in a picture (since the parts were shown), and whether the printed kit
    // leaves it out then.
    in property <bool> kit-part-c-pictured;
    in-out property <bool> kit-leave-c-out: true;
    in-out property <bool> kit-asking;
    in-out property <bool> export-asking;
    callback window-drag();
    callback window-resize(int);
    callback window-minimize();
    callback window-toggle-maximized();
    callback window-close();

    // ---- shared state ----
    in property <Screen> screen: Screen.unlock;
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    in property <int> notice-code;
    in property <string> notice-arg;
    // A number some notices need besides their argument (failed unlocks: how many).
    in property <int> notice-count;
    // The generator's options under the new vault's suggested master password, unfolded.
    in-out property <bool> onboarding-options;
    // Failed unlocks in a row on this computer, and the seconds before the next may start.
    in property <int> unlock-failed;
    in property <int> unlock-wait;
    // Seconds left before the auto-lock, while the countdown shows (0 = hidden).
    in property <int> lock-warning-seconds;
    callback stay-unlocked();
    in property <string> vault-path;
    in property <string> vault-id;

    // ---- onboarding / recovery ----
    in-out property <int> onboarding-step: 1;
    in-out property <int> onboarding-guard: 0;
    in property <bool> recovered;
    in property <string> suggestion;
    in property <string> kit-secret-key;
    // The password of the kit's saved PDF files (CRYPTO.md §3.10), while the kit is shown.
    in property <string> kit-pdf-password;
    // The kit page's keys and PDF password wait for the item lock (closed until told).
    in property <bool> kit-keys-locked: true;
    callback copy-kit-pdf-password();
    // Recovery parts A, B and C, only right after they are issued.
    in property <string> kit-part-a;
    in property <string> kit-part-b;
    in property <string> kit-part-c;
    in-out property <bool> kit-saved;
    // The kit on paper: the keys printed, or empty boxes to write them in by hand.
    in-out property <bool> kit-filled: true;
    // Recovery in two steps (the parts, checked; then the new password), and new parts made
    // right after a recovery used the old ones.
    in-out property <int> recover-step: 1;
    callback check-parts();
    callback new-parts-now();
    // Recovery parts were just used to open the vault: they no longer work, a new kit is offered.
    in-out property <bool> parts-used;
    callback create-vault();
    callback finish-onboarding-import();
    callback suggest-passphrase();
    callback use-suggestion();
    callback finish-onboarding();

    // ---- choosing among vaults ----
    in property <[RecentVault]> recent-vaults;
    in-out property <bool> choosing-vault;
    callback pick-vault(int);
    callback forget-vault(int);
    callback open-vault-file();
    callback new-vault-file();
    callback switch-vault();

    // ---- unlock / recover ----
    in property <bool> needs-secret-key;
    // Two recovery parts may stand in for the Secret Key on the unlock screen.
    in property <bool> can-use-parts;
    in-out property <bool> use-parts;
    // The recovery screen asks for parts (or, for a vault with an older kit, the Recovery Key).
    in property <bool> recover-with-parts: true;
    callback choose-part-picture();
    in property <bool> needs-keyfile;
    // Where the vault's keyfile is (unlock screen and settings).
    in-out property <string> keyfile-path;
    callback choose-keyfile();
    in property <bool> keyfile-on;
    in property <bool> keyfile-failed;
    // File for the next keyfile action (filled by the file dialog).
    in-out property <string> keyfile-target;
    callback keyfile-action(int);
    // The selected item's secrets wait for a check (0 master password, 1 PIN, 2 password).
    in property <bool> detail-locked;
    in property <int> detail-check;
    in-out property <bool> guard-all;
    in-out property <int> guard-check;
    in property <int> guard-current-check;
    in property <bool> guard-failed;
    callback save-guard();
    callback unlock-item();
    // Item lock right now: its check passed (every locked item is open); it encrypts the
    // secrets (PIN or password); it covers every item.
    in property <bool> secrets-open;
    in property <bool> guard-encrypts;
    in property <bool> guard-current-all;
    // The selected item is guarded and open; the Authenticator has hidden / opened codes.
    in property <bool> detail-guarded-open;
    in property <bool> auth-locked;
    in property <bool> auth-guarded-open;
    callback lock-secrets();
    // Windows Hello for the item lock: usable right now / chosen in Settings.
    in property <bool> guard-hello-on;
    in-out property <bool> guard-hello;
    callback unlock-item-hello();
    // Browser extension: the code of a connection waiting for an answer ("" = none);
    // whether one is connected.
    // Not shown: non-empty while a connection waits (see PairingDialog).
    in property <string> pairing-code;
    // The code's characters, shown one per box.
    in property <[string]> pairing-code-chars;
    in property <bool> pairing-needs-password: true;
    in-out property <bool> browser-paired;
    callback pairing-decided(bool);
    callback forget-pairing();
    // Sync: the folder or address ("" = off), what happened last (SyncState in
    // controller/syncing.rs), minutes since the last round (-1 never), why it failed, how
    // many items wait for the item lock, this computer's name and the other devices'.
    in property <string> sync-folder;
    in-out property <int> sync-state;
    in property <int> sync-minutes: -1;
    in property <string> sync-detail;
    in property <int> sync-waiting;
    in property <string> sync-devices;
    in property <string> sync-this-device;
    // The kind of place (0 off, 1 folder, 2 server, 3 WebDAV), the setup form open (0 none,
    // 1 server, 2 WebDAV) and its fields, the other devices by name (for Remove), the one
    // whose Remove waits for a second click (-1 none), an invite to show.
    in property <int> sync-kind;
    in-out property <int> sync-form;
    in-out property <string> sync-address;
    // The server's certificate pin, typed apart from its address.
    in-out property <string> sync-pin;
    in-out property <string> sync-invite-typed;
    in-out property <string> sync-user;
    in property <string> sync-setup-error;
    in property <bool> sync-busy;
    in property <[DeviceLine]> sync-others;
    in-out property <int> sync-removing: -1;
    in property <string> sync-invite;
    in property <image> sync-invite-qr;
    // A backup server synced too (see SettingsPage).
    in property <string> sync-backup;
    in property <string> sync-main-down;
    in property <string> sync-backup-down;
    in-out property <bool> sync-backup-form;
    // The vault key renewed on another device, and the devices still on the key this one
    // renewed or took (see SettingsPage); dialog 14 takes the new key.
    in property <bool> sync-key-renewed;
    in property <int> sync-key-behind;
    callback sync-take-key();
    in-out property <string> sync-backup-address;
    in-out property <string> sync-backup-invite;
    callback sync-join-backup();
    callback sync-remove-backup();
    // Change the address (Settings dialogs 12, the server, and 13, the backup): the fields,
    // filled with the address in use and its pin.
    in-out property <string> sync-new-address;
    in-out property <string> sync-new-pin;
    callback sync-change-address(bool);
    callback sync-choose();
    callback sync-now();
    callback sync-stop();
    callback sync-join-server();
    callback sync-use-webdav();
    callback sync-add-device();
    callback sync-hide-invite();
    callback sync-remove(int);
    // Windows Hello: usable on this computer / set up for this vault / prompt open now.
    in property <bool> quick-unlock-available;
    in-out property <bool> quick-unlock-on;
    in property <bool> quick-waiting;
    callback unlock();
    callback quick-unlock();
    callback quick-unlock-toggled(bool);
    callback show-recovery();
    callback recover();
    callback back-to-unlock();

    // ---- vault ----
    in property <Panel> panel: Panel.detail;
    in property <[ItemRow]> items;
    in property <int> selected: -1;
    in property <int> total-items;
    in property <int> category;
    in property <[int]> counts: [0, 0, 0, 0, 0];
    in property <[FolderRow]> folders;
    in property <int> totp-count;
    in property <string> vault-name;
    // ---- password health ----
    in property <[HealthRow]> health-rows;
    in property <[int]> health-counts: [0, 0, 0, 0, 0];
    in property <int> health-total: -1;
    in property <int> health-logins;
    in property <int> health-score;
    in property <bool> leaks-checked;
    in property <bool> leaks-checking;
    in-out property <int> health-filter: -1;
    callback open-health();
    callback health-filter-changed(int);
    callback check-leaks();
    callback health-open(int);
    // ---- authenticator ----
    in property <[AuthRow]> auth-rows;
    in-out property <string> auth-search;
    callback open-authenticator();
    callback auth-search-changed(string);
    callback auth-copy(int);
    callback auth-open(int);
    // The folder being browsed (category >= 100), or "".
    in property <string> folder-name;
    in property <string> folder-icon;
    in property <int> folder-color;
    in property <image> folder-image;
    in property <bool> folder-has-image;
    // Folder dialog: -1 closed, 0 new, 1 settings, 2 delete?
    in-out property <int> folder-dialog: -1;
    in-out property <string> fd-name;
    in-out property <string> fd-icon;
    in-out property <int> fd-color;
    in-out property <string> fd-link;
    in property <image> fd-preview;
    in property <bool> fd-has-preview;
    in property <int> fd-preview-state;
    in property <int> fd-items;
    callback new-folder();
    callback edit-folder(int);
    callback ask-delete-folder(int);
    callback move-folder(int, int);
    callback folder-dialog-save();
    callback folder-dialog-fetch();
    callback folder-dialog-delete();
    callback folder-dialog-cancel();
    // Back and forward through the places visited (also mouse buttons 4/5 and Alt+arrows).
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    callback go-back();
    callback go-forward();
    // Right-click menus: where they open and which folder they are for.
    property <length> menu-x;
    property <length> menu-y;
    property <int> menu-folder;
    in-out property <string> search-text;
    callback search(string);
    callback select-category(int);
    callback select(int);
    callback new-item();
    callback open-generator();
    callback open-settings();
    callback lock();

    // ---- detail ----
    in property <bool> has-selection;
    in property <string> detail-title;
    in property <int> detail-kind;
    in property <image> detail-icon;
    in property <bool> detail-has-icon;
    in property <string> detail-initial;
    in property <color> detail-tint;
    in property <string> detail-glyph;
    in property <int> detail-glyph-color;
    in property <int> detail-glyph-bg;
