        save => { root.folder-dialog-save(); }
        fetch-preview => { root.folder-dialog-fetch(); }
        delete => { root.folder-dialog-delete(); }
        ask-delete => { root.folder-dialog = 2; }
        cancel => { root.folder-dialog-cancel(); }
    }

    // ---- Settings' dialogs: each asks before a sensitive change, the master password where
    // it matters, and stays open (busy, or with what went wrong) until the change is made.
    property <bool> in-settings: root.screen == Screen.vault && root.panel == Panel.settings;
    property <string> kdf-chosen: ["Argon2id", "scrypt", "PBKDF2-SHA-256"][root.kdf-method]
        + " · " + [@tr("Light"), @tr("Standard"), @tr("Strong"), @tr("Maximum")][root.kdf-level];
    property <string> removing-name: root.sync-removing >= 0 && root.sync-removing < root.sync-others.length
        ? root.sync-others[root.sync-removing].name : "";

    if root.screen == Screen.vault && root.panel == Panel.kit && root.kit-asking: ConfirmDialog {
        width: root.width;
        height: root.height;
        title: @tr("Show your emergency kit?");
        text: @tr("It shows your Secret Key (and the recovery parts, right after they are issued). Make sure no one can see your screen.");
        action: @tr("Show my kit");
        asks-master: true;
        field: 5;
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        confirmed => { root.show-kit(); }
        cancelled => { root.kit-asking = false; }
    }
    if root.screen == Screen.vault && root.panel == Panel.transfer && root.export-asking: ExportDialog {
        width: root.width;
        height: root.height;
        format: root.export-format;
        counts: root.export-counts;
        recounted: root.export-recounted;
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        confirmed => { root.export-plain(); }
        cancelled => { root.export-cancel(); }
    }
    if root.screen == Screen.vault && root.panel == Panel.kit && root.kit-confirming-new-parts: ConfirmDialog {
        width: root.width;
        height: root.height;
        title: @tr("Issue new recovery parts?");
        text: @tr("The recovery parts (or Recovery Key) of your old kits will stop working. Print the new kit right after, and keep each part in a different place.");
        action: @tr("Issue new parts");
        danger: true;
        asks-master: true;
        field: 5;
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        confirmed => { root.new-parts(); }
        cancelled => { root.kit-confirming-new-parts = false; }
    }
    if root.screen == Screen.vault && root.panel == Panel.kit && root.kit-confirming-renew: ConfirmDialog {
        width: root.width;
        height: root.height;
        title: @tr("Renew the vault key?");
        text: @tr("The vault gets a new key, a new Secret Key and a new kit; the master password stays. The old kit, the old Secret Key and every older copy of the file (a backup, a stolen copy) stop opening it, and what changes from now on is out of their reach. Each of your other devices asks once for the new Secret Key. Print the new kit right after.");
        action: @tr("Renew the key");
        danger: true;
        asks-master: true;
        field: 5;
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        confirmed => { root.renew-key(); }
        cancelled => { root.kit-confirming-renew = false; }
    }
    if root.in-settings && root.settings-dialog == 1: MasterPasswordDialog {
        width: root.width;
        height: root.height;
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        confirmed => { root.change-password(); }
        cancelled => { root.close-settings-dialog(); }
    }
    if root.in-settings && root.settings-dialog == 2: ConfirmDialog {
        width: root.width;
        height: root.height;
        title: @tr("Change the unlock protection?");
        text: @tr("The vault's password lock is written again with {}. Your items stay as they are; every device that opens the vault then needs that much memory and time per unlock. Windows Hello turns off until you turn it on again.", root.kdf-chosen);
        action: @tr("Apply");
        asks-master: true;
        field: 9;
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        confirmed => { root.change-kdf(); }
        cancelled => { root.close-settings-dialog(); }
    }
    if root.in-settings && root.settings-dialog == 3: ItemLockDialog {
        width: root.width;
        height: root.height;
        check: root.guard-check;
        current-check: root.guard-current-check;
        all: root.guard-all;
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        confirmed => { root.save-guard(); }
        cancelled => { root.close-settings-dialog(); }
    }
    if root.in-settings && (root.settings-dialog == 4 || root.settings-dialog == 10 || root.settings-dialog == 11): ConfirmDialog {
        width: root.width;
        height: root.height;
        title: root.settings-dialog == 4 ? @tr("Make a keyfile?")
            : root.settings-dialog == 10 ? @tr("Use another file as the keyfile?")
            : @tr("Remove the keyfile?");
        text: root.settings-dialog == 4 ? @tr("A new file with a random key is written where you choose, and from then on the vault opens only with your master password and that file. Keep a second copy apart from it: losing it locks you out. Windows Hello turns off until you turn it on again.")
            : root.settings-dialog == 10 ? @tr("Any file that never changes, not even by one byte, can be the keyfile: from then on the vault opens only with your master password and that file. Keep a copy apart from it. Windows Hello turns off until you turn it on again.")
            : @tr("The vault opens with your master password alone again. The file itself is left where it is. Windows Hello turns off until you turn it on again.");
        action: root.settings-dialog == 4 ? @tr("Choose where to save it…")
            : root.settings-dialog == 10 ? @tr("Choose the file…")
            : @tr("Remove the keyfile");
        danger: root.settings-dialog == 11;
        asks-master: true;
        field: 10;
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        confirmed => { root.keyfile-action(root.settings-dialog == 4 ? 0 : root.settings-dialog == 10 ? 1 : 2); }
        cancelled => { root.close-settings-dialog(); }
    }
    if root.in-settings && root.settings-dialog >= 5 && root.settings-dialog <= 9: ConfirmDialog {
        width: root.width;
        height: root.height;
        title: root.settings-dialog == 5 ? @tr("Stop syncing this vault here?")
            : root.settings-dialog == 6 ? @tr("Remove {}?", root.removing-name)
            : root.settings-dialog == 7 ? @tr("Add a device?")
            : root.settings-dialog == 8 ? @tr("Remove the backup server?")
            : @tr("Disconnect the browser extension?");
        text: root.settings-dialog == 5 ? @tr("This computer stops syncing and forgets its key for the server (or the WebDAV password). The copies already there stay, and your other devices keep syncing. You can join again later.")
            : root.settings-dialog == 6 ? @tr("It leaves the vault's list of devices: every device refuses its copies from its next sync, and its copy and key leave the server. It keeps only what it already had, which opens only with your master password and Secret Key. It can join again later as a new device, with a new invite.")
            : root.settings-dialog == 7 ? @tr("The server makes an invite that works once, for an hour: a QR code to scan on the phone, or a line to paste on another computer. Whoever has it can put a sealed copy of the vault on that device; it opens only with your master password and Secret Key.")
            : root.settings-dialog == 8 ? @tr("This computer stops syncing through it and forgets its key there. Its copy there is left, and the main place goes on as before.")
            : @tr("It can't ask for logins any more until it is connected again, which asks for the master password and the code its window shows.");
        action: root.settings-dialog == 5 ? @tr("Stop syncing")
            : root.settings-dialog == 6 ? @tr("Remove")
            : root.settings-dialog == 7 ? @tr("Make an invite")
            : root.settings-dialog == 8 ? @tr("Remove the backup")
            : @tr("Disconnect");
        danger: root.settings-dialog != 7;
        asks-master: root.settings-dialog != 8;
        field: 20;
        busy: root.busy || root.sync-busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        confirmed => { root.confirm-settings(root.settings-dialog); }
        cancelled => { root.close-settings-dialog(); }
    }
    if root.in-settings && root.settings-dialog == 14: TakeKeyDialog {
        width: root.width;
        height: root.height;
        busy: root.busy || root.sync-busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        confirmed => { root.sync-take-key(); }
        cancelled => { root.close-settings-dialog(); }
    }
    if root.in-settings && (root.settings-dialog == 12 || root.settings-dialog == 13): ServerAddressDialog {
        width: root.width;
        height: root.height;
        backup: root.settings-dialog == 13;
        address <=> root.sync-new-address;
        pin <=> root.sync-new-pin;
        busy: root.sync-busy;
        problem: root.sync-setup-error;
        confirmed => { root.sync-change-address(root.settings-dialog == 13); }
        cancelled => { root.close-settings-dialog(); }
    }
    if root.in-settings && root.sync-kind == 0 && root.sync-form == 1: ServerJoinDialog {
        width: root.width;
        height: root.height;
        address <=> root.sync-address;
        pin <=> root.sync-pin;
        invite <=> root.sync-invite-typed;
        busy: root.sync-busy;
        problem: root.sync-setup-error;
        confirmed => { root.sync-join-server(); }
        cancelled => { root.sync-form = 0; }
    }
    if root.in-settings && root.sync-kind == 0 && root.sync-form == 2: WebDavDialog {
        width: root.width;
        height: root.height;
        address <=> root.sync-address;
        user <=> root.sync-user;
        busy: root.sync-busy;
        problem: root.sync-setup-error;
        confirmed => { root.sync-use-webdav(); }
        cancelled => { root.sync-form = 0; }
    }
    if root.in-settings && root.sync-backup-form: BackupServerDialog {
        width: root.width;
        height: root.height;
        address <=> root.sync-backup-address;
        invite <=> root.sync-backup-invite;
        busy: root.sync-busy;
        problem: root.sync-setup-error;
        confirmed => { root.sync-join-backup(); }
        cancelled => { root.sync-backup-form = false; }
    }
    if root.in-settings && root.extension-steps: ExtensionStepsDialog {
        width: root.width;
        height: root.height;
        browser: root.extension-steps-browser;
        firefox: root.extension-steps-firefox;
        page: root.extension-steps-page;
        folder: root.extension-steps-folder;
        started: root.extension-steps-started;
        copied: root.extension-steps-copied;
        link-on: root.browser-extension;
        open-folder => { root.open-extension-folder(); }
        done => { root.extension-steps = false; }
    }
    if root.in-settings && root.sync-invite != "": InviteDialog {
        width: root.width;
        height: root.height;
        line: root.sync-invite;
        qr: root.sync-invite-qr;
        done => { root.sync-hide-invite(); }
    }

    // Right-click on a folder in the index.
    folder-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 210px;
        close-policy: close-on-click;
        MenuCard {
            MenuEntry {
                text: @tr("Open");
                icon: "folder";
                clicked => { root.select-category(100 + root.menu-folder); }
            }
            MenuEntry {
                text: @tr("Folder settings…");
                icon: "pencil";
                clicked => { root.edit-folder(root.menu-folder); }
            }
            MenuRule { }
            MenuEntry {
                text: @tr("Move up");
                icon: "arrow-up";
                enabled: root.menu-folder > 0;
                clicked => { root.move-folder(root.menu-folder, root.menu-folder - 1); }
            }
            MenuEntry {
                text: @tr("Move down");
                icon: "arrow-down";
                enabled: root.menu-folder < root.folders.length - 1;
                clicked => { root.move-folder(root.menu-folder, root.menu-folder + 1); }
            }
            MenuRule { }
            MenuEntry {
                text: @tr("Delete folder…");
                icon: "trash";
                danger: true;
                clicked => { root.ask-delete-folder(root.menu-folder); }
            }
        }
    }

    // Right-click on an item in the list (the item is selected first).
    item-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 230px;
        close-policy: close-on-click;
        MenuCard {
            MenuEntry {
                text: root.detail-kind == 1 ? @tr("Copy name on card") : @tr("Copy username");
                icon: "user";
                enabled: root.detail-username != "";
                clicked => { root.copy-username(); }
            }
            MenuEntry {
                text: root.detail-kind == 1 ? @tr("Copy PIN") : @tr("Copy password");
                icon: "key";
                enabled: root.detail-has-password && !root.detail-locked;
                clicked => { root.copy-password(); }
            }
            MenuEntry {
                text: @tr("Copy one-time code");
                icon: "clock";
                enabled: root.totp-code != "" && !root.detail-locked;
                clicked => { root.copy-totp(); }
            }
            MenuEntry {
                text: @tr("Open website");
                icon: "external";
                enabled: root.detail-urls.length > 0;
                clicked => { root.open-url(0); }
            }
            MenuRule { }
            MenuEntry {
                text: @tr("Edit");
                icon: "pencil";
                enabled: !root.detail-locked;
                clicked => { root.edit-item(); }
            }
            MenuEntry {
                text: root.detail-favorite ? @tr("Remove from favorites") : @tr("Add to favorites");
                icon: "star";
                clicked => { root.toggle-favorite(); }
            }
            MenuRule { }
            MenuEntry {
                text: @tr("Delete…");
                icon: "trash";
                danger: true;
                enabled: !root.detail-locked;
                clicked => { root.confirming-delete = true; }
            }
        }
    }
    // The update installed: restart into it now, or later (the next start runs it).
    if root.restart-asking: ConfirmDialog {
        width: root.width;
        height: root.height;
        title: @tr("Version {} is installed. Restart now?", root.install-version);
        text: root.screen == Screen.vault
            ? @tr("Vault locks first, exactly as Lock now does, and opens again in the new version. Later, nothing changes until the next start.")
            : @tr("Vault opens again in the new version. Later, nothing changes until the next start.");
        action: @tr("Restart");
        cancel-text: @tr("Later");
        confirmed => { root.restart-now(); }
        cancelled => { root.restart-asking = false; }
    }
    // The window's own title bar, over everything (a dialog's shade leaves it, as the
    // system's would), and its edges for resizing while it isn't maximized.
    TitleBar {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.title-height;
        maximized: root.window-maximized;
        screen: root.screen;
        sidebar-shown: !root.sidebar-hidden;
        can-go-back: root.can-go-back;
        can-go-forward: root.can-go-forward;
        vault-label: root.screen == Screen.vault && root.vault-name != "" ? root.vault-name : root.vault-stem;
        vault-icon: root.vault-icon;
        vault-initial: root.vault-initial;
        vault-menu-open: root.vault-menu;
        sync-on: root.sync-folder != "";
        sync-state: root.sync-state;
        update-out: root.update-state == 3;
        install-step: root.install-step;
        install-progress: root.install-step > 2 ? 1 : root.install-total-kb > 0 ? root.install-done-kb / root.install-total-kb : 0;
        update-panel-open: root.update-panel;
        alert-count: root.alert-count;
        alert-urgent: root.alert-urgent;
        alerts-open: root.alerts-panel;
        alerts => {
            root.vault-menu = false;
            root.update-panel = false;
            root.alerts-panel = !root.alerts-panel;
        }
        drag => { root.window-drag(); }
        toggle-maximized => { root.window-toggle-maximized(); }
        minimize => { root.window-minimize(); }
        close => { root.window-close(); }
        toggle-sidebar => { root.toggle-sidebar(); }
        go-back => { root.go-back(); }
        go-forward => { root.go-forward(); }
        vault-menu(x) => {
            root.update-panel = false;
            root.alerts-panel = false;
            root.vault-menu-x = x;
            root.vault-menu = !root.vault-menu;
        }
        search => { root.search-now(); }
        new-item => { root.new-item(); }
        lock => { root.lock(); }
        sync-now => { root.sync-now(); }
        update-panel => {
            root.vault-menu = false;
            root.alerts-panel = false;
            root.update-panel = !root.update-panel;
        }
    }

    // The vault menu, under the vault's name in the title bar: the vaults this computer opened,
    // another file, a new vault, and this vault's icon here.
    if root.vault-menu: TouchArea {
        y: root.title-height;
        width: root.width;
        height: root.height - root.title-height;
        clicked => { root.vault-menu = false; }
    }
    if root.vault-menu: Rectangle {
        x: Math.max(8px, Math.min(root.vault-menu-x, root.width - self.width - 8px));
        y: root.title-height - 2px;
        width: 330px;
        height: vault-card.preferred-height;
        TouchArea { }
        vault-card := MenuCard {
            width: parent.width;
            HorizontalLayout {
                padding-left: 10px;
                height: 28px;
                Text {
                    text: @tr("Vaults on this computer");
                    font-size: Theme.small;
                    font-weight: 600;
                    color: Theme.faint;
                    vertical-alignment: center;
                }
            }
            for vault[index] in root.recent-vaults: Rectangle {
                height: 44px;
                border-radius: Theme.radius - 2px;
                background: !vault.missing && row-touch.has-hover ? Theme.hover : transparent;
                accessible-role: button;
                accessible-label: vault.name;
                accessible-enabled: !vault.missing;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        width: 16px;
                        Glyph {
                            width: 15px;
                            height: 15px;
                            name: "vault";
                            tint: vault.missing ? Theme.faint : Theme.graphite;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        horizontal-stretch: 1;
                        Text {
                            text: vault.name;
                            font-size: Theme.body;
                            font-weight: vault.current ? 600 : 400;
                            color: vault.missing ? Theme.faint : Theme.ink;
                            overflow: elide;
                        }
                        Text {
                            text: vault.missing ? @tr("Not found: {}", vault.location) : vault.location;
                            font-size: Theme.small;
                            color: Theme.faint;
                            overflow: elide;
                        }
                    }
                    if vault.current: VerticalLayout {
                        alignment: center;
                        Path {
                            width: 14px;
                            height: 14px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M20 6 L9 17 L4 12";
                            stroke: Theme.accent-stroke;
                            stroke-width: 2.2px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                            fill: transparent;
                        }
                    }
                }
                row-touch := TouchArea {
                    enabled: !vault.missing;
                    mouse-cursor: vault.missing ? MouseCursor.default : MouseCursor.pointer;
                    clicked => {
                        root.vault-menu = false;
                        root.pick-vault(index);
                    }
                }
            }
            MenuRule { }
            MenuEntry {
                text: @tr("Open a vault file…");
                icon: "folder";
                clicked => {
                    root.vault-menu = false;
                    root.open-vault-file();
                }
            }
            MenuEntry {
                text: @tr("New vault…");
                icon: "plus";
                clicked => {
                    root.vault-menu = false;
                    root.new-vault-file();
                }
            }
            if root.screen == Screen.vault: MenuRule { }
            if root.screen == Screen.vault: MenuEntry {
                text: @tr("Icon on this computer…");
                icon: "palette";
                clicked => {
                    root.vault-menu = false;
                    root.choose-vault-icon();
                }
            }
        }
    }

    // The alerts' panel, under the bell: each one opens where it is dealt with.
    if root.alerts-panel && root.alert-count > 0: TouchArea {
        y: root.title-height;
        width: root.width;
        height: root.height - root.title-height;
        clicked => { root.alerts-panel = false; }
    }
    if root.alerts-panel && root.alert-count > 0: Rectangle {
        x: root.width - self.width - 8px;
        y: root.title-height - 2px;
        width: 380px;
        height: alerts-card.preferred-height;
        TouchArea { }
        alerts-card := MenuCard {
            width: parent.width;
            HorizontalLayout {
                padding-left: 10px;
                height: 28px;
                Text {
                    text: @tr("Alerts");
                    font-size: Theme.small;
                    font-weight: 600;
                    color: Theme.faint;
                    vertical-alignment: center;
                }
            }
            if root.health-counts[0] > 0: AlertRow {
                icon: "leaked";
                tint: Theme.seal;
                text: @tr("{n} password found in leaks" | "{n} passwords found in leaks" % root.health-counts[0]);
                hint: @tr("Change it on its site first, then here.");
                clicked => { root.alerts-panel = false; root.open-alert(0); }
            }
            if root.sync-state == 3: AlertRow {
                icon: "refresh";
                tint: Theme.seal;
                text: @tr("Sync failed");
                hint: root.sync-detail != "" ? root.sync-detail : @tr("Settings → Sync says why.");
                clicked => { root.alerts-panel = false; root.open-alert(10); }
            }
            if root.sync-key-renewed: AlertRow {
                icon: "key";
                tint: Theme.seal;
                text: @tr("The vault key was renewed on another device");
                hint: @tr("Settings → Sync takes the new one.");
                clicked => { root.alerts-panel = false; root.open-alert(10); }
            }
            if root.health-counts[1] > 0: AlertRow {
                icon: "key";
                tint: FieldColors.of("expired");
                text: @tr("{n} weak password" | "{n} weak passwords" % root.health-counts[1]);
                hint: @tr("Easy to guess: the generator makes strong ones.");
                clicked => { root.alerts-panel = false; root.open-alert(1); }
            }
            if root.health-counts[2] > 0: AlertRow {
                icon: "reused";
                tint: FieldColors.of("reused");
                text: @tr("{n} password used more than once" | "{n} passwords used more than once" % root.health-counts[2]);
                hint: @tr("One leak opens every site that shares it.");
                clicked => { root.alerts-panel = false; root.open-alert(2); }
            }
            if root.health-counts[4] > 0: AlertRow {
                icon: "expired";
                tint: FieldColors.of("expired");
                text: @tr("{n} card expired" | "{n} cards expired" % root.health-counts[4]);
                hint: @tr("Put in its new date, or delete it.");
                clicked => { root.alerts-panel = false; root.open-alert(4); }
            }
            if root.sync-waiting > 0: AlertRow {
                icon: "lock";
                tint: Theme.graphite;
                text: @tr("{n} change waits for the item lock" | "{n} changes wait for the item lock" % root.sync-waiting);
                hint: @tr("Settings → Sync: open the item lock to let them in.");
                clicked => { root.alerts-panel = false; root.open-alert(10); }
            }
        }
    }

    // The update's panel, under its button in the title bar: what it is doing, step by step.
    if root.update-panel: TouchArea {
        y: root.title-height;
        width: root.width;
        height: root.height - root.title-height;
        clicked => { root.update-panel = false; }
    }
    if root.update-panel: Rectangle {
        x: root.width - self.width - 8px;
        y: root.title-height - 2px;
        width: 400px;
        height: update-card.preferred-height;
        TouchArea { }
        update-card := MenuCard {
            width: parent.width;
            UpdateCard {
                padding: 12px;
                version: root.update-version;
                told: root.update-state == 3;
                step: root.install-step;
                done-kb: root.install-done-kb;
                total-kb: root.install-total-kb;
                installed: root.install-version;
                failure: root.install-failure;
                failed-at: root.install-failed-at;
                detail: root.install-detail;
                install => { root.install-update(); }
                restart => {
                    root.update-panel = false;
                    root.restart-asking = true;
                }
                open-release => { root.open-release(); }
            }
        }
    }
    if !root.window-maximized: ResizeEdge { direction: 7; x: 0px; y: 8px; width: 5px; height: root.height - 16px; resize(d) => { root.window-resize(d); } }
    if !root.window-maximized: ResizeEdge { direction: 0; x: root.width - 5px; y: 8px; width: 5px; height: root.height - 16px; resize(d) => { root.window-resize(d); } }
    if !root.window-maximized: ResizeEdge { direction: 1; x: 8px; y: 0px; width: root.width - 16px - 3 * 46px; height: 4px; resize(d) => { root.window-resize(d); } }
    if !root.window-maximized: ResizeEdge { direction: 4; x: 8px; y: root.height - 5px; width: root.width - 16px; height: 5px; resize(d) => { root.window-resize(d); } }
    if !root.window-maximized: ResizeEdge { direction: 3; x: 0px; y: 0px; width: 8px; height: 8px; resize(d) => { root.window-resize(d); } }
    if !root.window-maximized: ResizeEdge { direction: 6; x: 0px; y: root.height - 8px; width: 8px; height: 8px; resize(d) => { root.window-resize(d); } }
    if !root.window-maximized: ResizeEdge { direction: 5; x: root.width - 8px; y: root.height - 8px; width: 8px; height: 8px; resize(d) => { root.window-resize(d); } }
}
