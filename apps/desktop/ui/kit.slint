import { Theme } from "theme.slint";
import { Hint, QuietButton, Rule } from "widgets.slint";

component KitLine inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> value;
    in property <bool> large: false;
    // A key: drawn, but kept out of the accessibility tree (UI Automation).
    in property <bool> secret: false;
    // Drawn as dots (`mask`) until the person asks to see it.
    in property <bool> masked: false;
    in property <string> mask;
    spacing: 5px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text {
            text: root.label;
            font-size: Theme.small;
            color: #5F6B7D;
            vertical-alignment: center;
        }
        if root.hint != "": VerticalLayout {
            alignment: center;
            Hint { text: root.hint; }
        }
    }
    Text {
        text: root.masked ? root.mask : root.value;
        accessible-label: root.secret ? @tr("{}: shown on screen, not read aloud", root.label) : root.value;
        font-family: Theme.mono-font;
        font-size: root.large ? Theme.title : Theme.body;
        color: #1F2A3D;
        wrap: word-wrap;
    }
}

// The emergency kit as a slip of paper. It stays light in both themes, because it is the one
// screen meant to be copied onto paper — and the only place the handwriting font appears.
export component KitSlip inherits Rectangle {
    in property <string> vault-id;
    in property <string> secret-key;
    // Parts A, B and C, only right after they are issued.
    in property <string> part-a;
    in property <string> part-b;
    in property <string> part-c;
    in property <string> vault-path;
    // The Secret Key and the parts drawn as dots (the kit page shows them on request, for a
    // few seconds); printing and saving are not affected.
    in property <bool> masked: false;

    background: #F7F5EE;
    border-radius: 4px;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000040;
    min-height: layout.preferred-height;

    // Paper: a fine texture over the slip's colour (brand/paper-texture.png, made for this app;
    // it repeats without seams).
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        border-radius: root.border-radius;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("brand/paper-texture.png");
            horizontal-tiling: repeat;
            vertical-tiling: repeat;
            accessible-role: none;
        }
    }

    layout := VerticalLayout {
        padding: 26px;
        spacing: 16px;

        HorizontalLayout {
            Text {
                text: @tr("Emergency kit");
                font-size: Theme.title;
                font-weight: 600;
                color: #1F2A3D;
                horizontal-stretch: 1;
            }
            Text {
                text: @tr("keep on paper, away from the computer");
                font-family: Theme.hand-font;
                font-size: Theme.body;
                color: #5F6B7D;
                vertical-alignment: center;
            }
        }
        Rectangle { height: 1px; background: #D9D5C9; }

        KitLine {
            label: @tr("Secret Key");
            value: root.secret-key;
            secret: true;
            large: true;
            masked: root.masked;
            mask: "S0-•••••••-•••••••-•••••••-•••••••";
        }
        if root.part-a != "": VerticalLayout {
            spacing: 5px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: @tr("Recovery parts");
                    font-size: Theme.small;
                    color: #5F6B7D;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Hint { text: @tr("Keep each part in a different place. They aren't stored anywhere, so this is the only time they are shown, and each kit's parts work once."); }
                }
            }
            for part[index] in [root.part-a, root.part-b, root.part-c]: Text {
                text: !root.masked ? part
                    : index == 0 ? "A0-•••••••-•••••••-•••••••-•••••••"
                    : index == 1 ? "B0-•••••••-•••••••-•••••••-•••••••"
                    : "C0-•••••••-•••••••-•••••••-•••••••";
                accessible-label: @tr("Recovery part: shown on screen, not read aloud");
                font-family: Theme.mono-font;
                font-size: Theme.body;
                color: #1F2A3D;
            }
        }
        KitLine {
            label: @tr("Vault ID");
            value: root.vault-id;
        }
        VerticalLayout {
            spacing: 4px;
            Text {
                text: @tr("Master password");
                font-size: Theme.small;
                color: #5F6B7D;
            }
            Rectangle {
                height: 26px;
                Text {
                    x: 0;
                    text: @tr("write it here, by hand");
                    font-family: Theme.hand-font;
                    font-size: Theme.body;
                    color: #9AA5B3;
                }
            }
            Rectangle { height: 1px; background: #1F2A3D; }
        }
        if root.vault-path != "": Text {
            text: @tr("Vault file: {}", root.vault-path);
            font-size: Theme.small;
            color: #5F6B7D;
            wrap: word-wrap;
        }
    }
}

// The password of the kit's PDF files (CRYPTO.md §3.10), next to the actions that write
// them: the PDF viewer asks for it before it opens or prints one. On the kit page it is dots
// until shown (for 15 seconds) and its buttons wait for the item lock; in the onboarding's
// kit step it shows as the keys do.
export component PdfPassword inherits VerticalLayout {
    in property <string> password;
    // Drawn as dots until the person asks to see it.
    in property <bool> masked: false;
    // A button that shows and hides it (`toggle`), and one that copies it (`copy`).
    in property <bool> can-show: false;
    in property <bool> can-copy: false;
    callback toggle();
    callback copy();
    spacing: 4px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text {
            text: @tr("PDF password");
            font-size: Theme.small;
            color: Theme.graphite;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Hint { text: @tr("Four words, in small letters, with or without the spaces between them. It stays the same while the kit does: new recovery parts or a new Secret Key give a new one."); }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Text {
            text: root.masked ? "•••••• •••••• •••••• ••••••" : root.password;
            // Drawn, but kept out of the accessibility tree (UI Automation), as the keys are.
            accessible-label: @tr("PDF password: shown on screen, not read aloud");
            font-family: Theme.mono-font;
            font-size: Theme.body;
            color: Theme.ink;
            vertical-alignment: center;
        }
        if root.can-show: QuietButton {
            outlined: true;
            icon: root.masked ? "eye" : "eye-off";
            text: root.masked ? @tr("Show for 15 seconds") : @tr("Hide");
            clicked => { root.toggle(); }
        }
        if root.can-copy: QuietButton {
            outlined: true;
            icon: "copy";
            text: @tr("Copy");
            clicked => { root.copy(); }
        }
    }
    Text {
        text: @tr("Printing and Save as PDF make files that open only with this password: type it in the PDF viewer to open or print one. Someone who copies such a file, or opens it while you're away from the computer, sees nothing without it.");
        font-size: Theme.small;
        color: Theme.graphite;
        wrap: word-wrap;
    }
}
