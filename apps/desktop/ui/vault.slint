// The unlocked vault: index on the left, item list in the middle.

import { ListView } from "std-widgets.slint";
import { Theme, Sketch } from "theme.slint";
import { ItemRow, FolderRow, Panel, Messages } from "model.slint";
import { Button, QuietButton, LineField, MarkStroke, ItemIcon, Backdrop } from "widgets.slint";
import { BrandMark, Glyph, FolderLook, FieldColors } from "icons.slint";

// The index's own colours: every entry a colour of its own, none shared with another entry
// (the fields keep FieldColors). Folders without a colour of their own take `folder`.
global IndexColors {
    public pure function of(name: string) -> color {
        if (name == "stack") { return Theme.dark ? #74A9FF : #2D6BD0; }
        if (name == "star") { return Theme.dark ? #E7C54B : #A67C00; }
        if (name == "key") { return Theme.dark ? #5FC8E8 : #1C7FA0; }
        if (name == "card") { return Theme.dark ? #9DAAFF : #4C5CC2; }
        if (name == "note") { return Theme.dark ? #72C291 : #2E7D55; }
        if (name == "terminal") { return Theme.dark ? #B5D86A : #5E8A1A; }
        if (name == "fingerprint") { return Theme.dark ? #4FC6B7 : #1A8A7D; }
        if (name == "clock") { return Theme.dark ? #FF82B8 : #C03B78; }
        if (name == "folder") { return Theme.dark ? #D9B38C : #8A6239; }
        if (name == "heart") { return Theme.dark ? #FF7A85 : #C2333F; }
        if (name == "sparkle") { return Theme.dark ? #B38FFF : #6D45C6; }
        if (name == "lifebuoy") { return Theme.dark ? #FFA25E : #BF5E1A; }
        if (name == "swap") { return Theme.dark ? #E07BE0 : #A3389F; }
        if (name == "gear") { return Theme.dark ? #A9B8CC : #56657A; }
        return FieldColors.of(name);
    }
}

component IndexTab inherits Rectangle {
    in property <string> text;
    // icons.slint name; "" for none.
    in property <string> icon;
    in property <color> icon-tint: IndexColors.of(root.icon);
    // A downloaded picture shown instead of the icon (folders with a picture link).
    in property <image> image;
    in property <bool> has-image;
    in property <int> count: -1;
    // Folders: a pencil on hover opens their settings, a right click opens their menu, and they
    // can be dragged up or down to reorder them.
    in property <bool> editable;
    callback edit();
    callback context(length, length);
    callback dragging(length);
    callback dropped(length);
    in property <bool> active;
    // While a folder is dragged: dim the one being moved, mark where it will land.
    in property <bool> lifted;
    in property <int> drop-mark; // 0 none, -1 above, 1 below
    callback clicked;

    accessible-role: tab;
    accessible-label: root.text;
    height: 34px;
    border-radius: Theme.radius;
    background: touch.has-hover && !root.active && !root.lifted ? Theme.hover : transparent;
    opacity: root.lifted ? 0.45 : 1;

    property <bool> moved;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.icon != "" || root.has-image: VerticalLayout {
            alignment: center;
            if root.has-image: Image {
                width: 16px;
                height: 16px;
                source: root.image;
                image-fit: contain;
            }
            if !root.has-image: Glyph {
                width: 16px;
                height: 16px;
                name: root.icon;
                tint: root.icon-tint;
                opacity: root.active ? 1 : 0.8;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            label := Text {
                x: 0;
                width: parent.width;
                text: root.text;
                font-size: Theme.body;
                font-weight: root.active ? 600 : 400;
                color: root.active ? Theme.ink : Theme.graphite;
                overflow: elide;
            }
            MarkStroke {
                x: -2px;
                y: parent.height / 2 + 9px;
                width: Math.min(label.preferred-width, parent.width) + 4px;
                variant: 1;
                reveal: root.active ? 1 : 0;
                animate reveal { duration: Theme.sweep; easing: ease-out; }
            }
        }
        // Keeps the count's place while the pencil shows, so nothing jumps.
        if root.count >= 0: Rectangle {
            width: root.editable ? 22px : count-text.preferred-width;
            count-text := Text {
                x: parent.width - self.width;
                text: root.count;
                font-size: Theme.small;
                color: Theme.faint;
                vertical-alignment: center;
                opacity: root.editable && touch.has-hover && !root.moved ? 0 : 1;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: root.moved ? MouseCursor.grabbing : MouseCursor.pointer;
        clicked => {
            if (!root.moved) {
                root.clicked();
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.editable) {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.moved = false;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.moved) {
                root.dropped(self.mouse-y - self.pressed-y);
                root.moved = false;
            }
        }
        moved => {
            if (root.editable && self.pressed) {
                if (!root.moved && Math.abs(self.mouse-y - self.pressed-y) > 6px) {
                    root.moved = true;
                }
                if (root.moved) {
                    root.dragging(self.mouse-y - self.pressed-y);
                }
            }
        }
        // Inside the row's touch area, so hovering the pencil keeps the row hovered (a sibling
        // on top would take the hover away, hide itself and flicker).
        if root.editable && touch.has-hover && !root.moved: Rectangle {
            x: parent.width - self.width - 4px;
            y: (parent.height - self.height) / 2;
            width: 26px;
            height: 26px;
            border-radius: Theme.radius;
            background: pencil-touch.has-hover ? Theme.selected : transparent;
            accessible-role: button;
            accessible-label: @tr("Edit folder");
            Glyph { width: 14px; height: 14px; name: "pencil"; tint: Theme.graphite; }
            pencil-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.edit(); }
            }
        }
    }
    if root.drop-mark != 0: Rectangle {
        x: 6px;
        y: root.drop-mark < 0 ? -2px : parent.height;
        width: parent.width - 12px;
        height: 2px;
        border-radius: 1px;
        background: Theme.marker;
    }
}

// The vault's mark (the title bar, its menu, Settings → This vault): the icon chosen for it on
// this computer, or its name's initial, on a small rounded tile.
export component VaultMark inherits Rectangle {
    in property <string> icon;
    in property <string> initial;
    width: 22px;
    height: 22px;
    border-radius: Math.round(self.height / 4px) * 1px;
    background: Theme.selected;
    border-width: 1px;
    border-color: Theme.rule;
    if root.icon != "": Glyph {
        width: root.width * 0.62;
        height: root.height * 0.62;
        name: root.icon;
        tint: FolderLook.tint(root.icon, 0);
    }
    if root.icon == "": Text {
        text: root.initial != "" ? root.initial : "V";
        font-size: root.height * 0.52;
        font-weight: 700;
        color: Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ListRow inherits Rectangle {
    in property <ItemRow> item;
    in property <bool> selected;
    callback clicked;
    callback context(length, length);

    accessible-role: list-item;
    accessible-label: root.item.title;
    height: 58px;

    Rectangle {
        x: 10px;
        width: parent.width - 20px;
        y: 2px;
        height: parent.height - 4px;
        border-radius: Theme.radius;
        background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
        animate background { duration: Theme.quick; }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                width: 34px;
                if root.item.has-icon || root.item.glyph != "" || root.item.kind != 1 || root.item.brand == 0: ItemIcon {
                    icon: root.item.icon;
                    has-icon: root.item.has-icon;
                    initial: root.item.initial;
                    tint: root.item.tint;
                    kind: root.item.kind;
                    glyph: root.item.glyph;
                    glyph-color: root.item.glyph-color;
                    glyph-bg: root.item.glyph-bg;
                }
                if !root.item.has-icon && root.item.glyph == "" && root.item.kind == 1 && root.item.brand != 0: BrandMark {
                    brand: root.item.brand;
                    size: 34px;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                Text {
                    text: root.item.title;
                    font-size: Theme.body;
                    font-weight: 600;
                    color: Theme.ink;
                    overflow: elide;
                }
                Text {
                    text: root.item.subtitle != "" ? root.item.subtitle : Messages.kind-name(root.item.kind);
                    font-size: Theme.small;
                    color: Theme.graphite;
                    overflow: elide;
                }
            }
            if root.item.favorite: VerticalLayout {
                alignment: center;
                Path {
                    width: 13px;
                    height: 13px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Sketch.star;
                    stroke: Theme.accent-stroke;
                    stroke-width: 1.4px;
                    fill: transparent;
                }
            }
        }
        touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                    root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
}

export component VaultIndex inherits Rectangle {
    in property <int> category;
    in property <[int]> counts;
    in property <[FolderRow]> folders;
    in property <int> totp-count;
    in property <int> health-count;
    in property <Panel> panel;
    callback open-health();
    callback new-folder();
    callback edit-folder(int);
    callback folder-menu(int, length, length);
    callback move-folder(int, int);
    callback select-category(int);
    callback open-generator();
    callback open-settings();
    callback open-kit();
    callback open-transfer();
    callback open-authenticator();

    background: Theme.panel;
    property <bool> browsing: root.panel != Panel.generator && root.panel != Panel.settings && root.panel != Panel.kit && root.panel != Panel.transfer && root.panel != Panel.authenticator && root.panel != Panel.health;
    // Folder being dragged (-1 none) and where it would land.
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    // A tab and the 2px gap below it.
    property <length> tab-step: 36px;
    function target(from: int, dy: length) -> int {
        Math.clamp(from + Math.round(dy / root.tab-step), 0, root.folders.length - 1)
    }

    if Theme.backdrop >= 2: Backdrop {
        width: parent.width;
        height: parent.height;
        strength: Theme.backdrop == 4 ? 0.45 : 0.6;
    }

    VerticalLayout {
        padding: 18px;
        spacing: 2px;
        // Categories and folders scroll together when there are many folders.
        Flickable {
            vertical-stretch: 1;
            content-height: tabs.preferred-height;
            interactive: root.drag-from < 0;
            tabs := VerticalLayout {
                spacing: 2px;
                alignment: start;
                IndexTab { text: @tr("All items"); icon: "stack"; count: root.counts[0]; active: root.category == 0 && root.browsing; clicked => { root.select-category(0); } }
                IndexTab { text: @tr("Favorites"); icon: "star"; count: root.counts[1]; active: root.category == 1 && root.browsing; clicked => { root.select-category(1); } }
                IndexTab { text: @tr("Logins"); icon: "key"; count: root.counts[2]; active: root.category == 2 && root.browsing; clicked => { root.select-category(2); } }
                IndexTab { text: @tr("Cards"); icon: "card"; count: root.counts[3]; active: root.category == 3 && root.browsing; clicked => { root.select-category(3); } }
                IndexTab { text: @tr("Secure notes"); icon: "note"; count: root.counts[4]; active: root.category == 4 && root.browsing; clicked => { root.select-category(4); } }
                IndexTab { text: @tr("SSH keys"); icon: "terminal"; count: root.counts[5]; active: root.category == 5 && root.browsing; clicked => { root.select-category(5); } }
                IndexTab { text: @tr("Passkeys"); icon: "fingerprint"; count: root.counts[6]; active: root.category == 6 && root.browsing; clicked => { root.select-category(6); } }
                IndexTab { text: @tr("Identities"); icon: "user"; count: root.counts[7]; active: root.category == 7 && root.browsing; clicked => { root.select-category(7); } }
                if root.counts[8] > 0 || root.category == 8: IndexTab { text: @tr("Templates"); icon: "copy"; count: root.counts[8]; active: root.category == 8 && root.browsing; clicked => { root.select-category(8); } }
                if root.counts[9] > 0 || root.category == 9: IndexTab { text: @tr("Archive"); icon: "database"; count: root.counts[9]; active: root.category == 9 && root.browsing; clicked => { root.select-category(9); } }
                if root.counts[10] > 0 || root.category == 10: IndexTab { text: @tr("Trash"); icon: "trash"; count: root.counts[10]; active: root.category == 10 && root.browsing; clicked => { root.select-category(10); } }
                IndexTab { text: @tr("Authenticator"); icon: "clock"; count: root.totp-count; active: root.panel == Panel.authenticator; clicked => { root.open-authenticator(); } }

                Rectangle { height: 16px; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    height: 26px;
                    Text {
                        text: @tr("Folders");
                        font-size: Theme.small;
                        font-weight: 600;
                        color: Theme.faint;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    add := Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: Theme.radius;
                        background: add-touch.has-hover ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: @tr("New folder");
                        Text {
                            text: "+";
                            font-size: Theme.lead;
                            color: Theme.graphite;
                        }
                        add-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.new-folder(); }
                        }
                    }
                }
                for folder[index] in root.folders: IndexTab {
                    text: folder.name;
                    icon: folder.icon != "" ? folder.icon : "folder";
                    icon-tint: folder.color > 0 ? FolderLook.tint(folder.icon, folder.color) : IndexColors.of(folder.icon != "" ? folder.icon : "folder");
                    image: folder.image;
                    has-image: folder.has-image;
                    editable: true;
                    edit => { root.edit-folder(index); }
                    context(x, y) => { root.folder-menu(index, x, y); }
                    count: folder.count;
                    active: root.category == 100 + index && root.browsing;
                    lifted: root.drag-from == index;
                    drop-mark: root.drag-from < 0 || root.drag-to != index || root.drag-to == root.drag-from ? 0
                        : root.drag-to < root.drag-from ? -1 : 1;
                    dragging(dy) => {
                        root.drag-from = index;
                        root.drag-to = root.target(index, dy);
                    }
                    dropped(dy) => {
                        let to = root.target(index, dy);
                        root.drag-from = -1;
                        root.drag-to = -1;
                        if (to != index) {
                            root.move-folder(index, to);
                        }
                    }
                    clicked => { root.select-category(100 + index); }
                }
                if root.folders.length == 0: HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: @tr("Group items, e.g. all your Google accounts. Click + to add one.");
                        font-size: Theme.small;
                        color: Theme.faint;
                        wrap: word-wrap;
                    }
                }
            }
        }
        Rectangle { height: 12px; }
        IndexTab { text: @tr("Password health"); icon: "heart"; count: root.health-count; active: root.panel == Panel.health; clicked => { root.open-health(); } }
        IndexTab { text: @tr("Password generator"); icon: "sparkle"; active: root.panel == Panel.generator; clicked => { root.open-generator(); } }
        IndexTab { text: @tr("Emergency kit"); icon: "lifebuoy"; active: root.panel == Panel.kit; clicked => { root.open-kit(); } }
        IndexTab { text: @tr("Import & export"); icon: "swap"; active: root.panel == Panel.transfer; clicked => { root.open-transfer(); } }
        IndexTab { text: @tr("Settings"); icon: "gear"; active: root.panel == Panel.settings; clicked => { root.open-settings(); } }
    }
}

export component ItemList inherits Rectangle {
    in property <[ItemRow]> items;
    in property <int> selected;
    in property <int> total;
    // Name of the folder being browsed, or "" when browsing a category.
    in property <string> folder-name;
    in property <string> folder-icon;
    in property <int> folder-color;
    in property <image> folder-image;
    in property <bool> folder-has-image;
    callback edit-folder();
    callback delete-folder();
    in-out property <string> search-text;
    // Counted up when the search is to take the focus (the toolbar, Ctrl+F).
    in property <int> focus-search;
    changed focus-search => { search-field.focus(); }
    callback search(string);
    callback select(int);
    callback item-menu(int, length, length);
    callback new-item();

    background: Theme.panel;

    if Theme.backdrop == 3 || Theme.backdrop == 4: Backdrop {
        width: parent.width;
        height: parent.height;
        strength: Theme.backdrop == 4 ? 0.45 : 0.6;
    }

    VerticalLayout {
        padding-top: 20px;
        padding-bottom: 10px;
        spacing: 12px;
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 10px;
            search-field := LineField {
                horizontal-stretch: 1;
                placeholder: @tr("Search");
                text <=> root.search-text;
                edited(text) => { root.search(text); }
            }
            Button {
                text: @tr("New item");
                clicked => { root.new-item(); }
            }
        }
        // Folder header: its look and name, with its settings and delete.
        if root.folder-name != "": HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 22px;
            padding-right: 20px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                if root.folder-has-image: Image {
                    width: 18px;
                    height: 18px;
                    source: root.folder-image;
                    image-fit: contain;
                }
                if !root.folder-has-image: Glyph {
                    width: 18px;
                    height: 18px;
                    name: root.folder-icon != "" ? root.folder-icon : "folder";
                    tint: FolderLook.tint(root.folder-icon, root.folder-color);
                }
            }
            Text {
                text: root.folder-name;
                font-size: Theme.lead;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            QuietButton {
                text: @tr("Edit");
                tint: Theme.graphite;
                clicked => { root.edit-folder(); }
            }
            QuietButton {
                text: @tr("Delete");
                tint: Theme.graphite;
                clicked => { root.delete-folder(); }
            }
        }

        if root.items.length == 0: VerticalLayout {
            padding-left: 22px;
            padding-right: 22px;
            alignment: start;
            Text {
                text: root.total == 0
                    ? @tr("Nothing here yet. Add your first login with New item, or bring everything over from another password manager in Import & export.")
                    : root.search-text != "" ? @tr("Nothing matches “{}”.", root.search-text)
                    : root.folder-name != "" ? @tr("This folder is empty. Choose it in an item's Folder box to file the item here.")
                    : @tr("Nothing here yet.");
                font-size: Theme.body;
                color: Theme.graphite;
                wrap: word-wrap;
            }
        }
        if root.items.length > 0: ListView {
            vertical-stretch: 1;
            for item[index] in root.items: ListRow {
                item: item;
                selected: index == root.selected;
                clicked => { root.select(index); }
                context(x, y) => { root.item-menu(index, x, y); }
            }
        }
    }
}
