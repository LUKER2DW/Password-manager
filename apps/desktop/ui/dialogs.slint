// Dialogs that open over the whole window.

import { Theme } from "theme.slint";
import { ExportCounts, Messages } from "model.slint";
import { Button, QuietButton, LineField, Hint, SecretField, Choice } from "widgets.slint";
import { Glyph, FolderLook, FieldColors } from "icons.slint";
import { NewPassword, PasswordReview, LeakCheckBox } from "review.slint";

// The dimmed backdrop and a centered card. Clicks outside the card do nothing (the dialog closes
// with its own buttons or Escape), so a stray click can't throw away what was typed.
component Modal inherits Rectangle {
    in property <length> card-width: 480px;
    // Off when a field inside takes the focus itself (its keys still reach Escape here).
    in property <bool> focus-on-open: true;
    callback dismissed();
    background: #0000008C;
    TouchArea { }
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            reject
        }
        Rectangle {
            x: (root.width - self.width) / 2;
            y: Math.max(24px, (root.height - self.height) / 2);
            width: root.card-width;
            height: card.preferred-height;
            background: Theme.sheet;
            border-radius: Theme.radius + 4px;
            border-width: 1px;
            border-color: Theme.rule;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: #00000070;
            card := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                @children
            }
        }
    }
    init => {
        if (root.focus-on-open) {
            keys.focus();
        }
    }
}

// Create a folder, change its name and look, or confirm deleting it.
//   mode 0 = new folder, 1 = folder settings, 2 = delete?
// A browser extension asks to be connected: the person checks the code and types the master
// password, or refuses.
// `compare`: the extension and the app agreed on the key (ECDH) and both show the same code,
// which the person compares (a program in between makes them differ). Otherwise an older
// extension was handed its key: whatever asked knows that code, so the person types the one
// the extension's window shows and the dialog never shows it.
export component PairingDialog inherits Modal {
    in property <string> code;
    // The code's characters, one per box (the dash goes between the fourth and the fifth).
    in property <[string]> code-chars;
    in property <bool> needs-password;
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    callback decided(bool);
    focus-on-open: false;
    dismissed => { root.decided(false); }
    Text {
        text: @tr("Connect the browser extension?");
        font-size: Theme.title;
        color: Theme.ink;
    }
    Text {
        text: @tr("The browser extension on this computer asks to fill logins from this vault. Connect it only if you just clicked “Connect” in the extension and its window shows this same code:");
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    Rectangle {
        height: 64px;
        accessible-role: text;
        accessible-label: @tr("Code: {}", root.code);
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            for char[index] in root.code-chars: HorizontalLayout {
                spacing: 6px;
                if index == 4: VerticalLayout {
                    alignment: center;
                    padding-left: 4px;
                    padding-right: 4px;
                    Rectangle {
                        width: 14px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: Theme.graphite;
                    }
                }
                Rectangle {
                    width: 40px;
                    height: 54px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.rule;
                    background: Theme.field;
                    Text {
                        text: char;
                        font-family: Theme.mono-font;
                        font-size: 26px;
                        font-weight: 600;
                        color: Theme.ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    if root.needs-password: SecretField {
        field: 14;
        eye: true;
        label: @tr("Master password");
        icon: "key";
        required: true;
        error: root.error-code == 11 || root.error-code == 34;
        accepted => { root.decided(true); }
    }
    if root.error-code != 0: Text {
        text: Messages.error(root.error-code, root.error-detail);
        font-size: Theme.small;
        color: Theme.seal;
        wrap: word-wrap;
    }
    Text {
        text: @tr("If you didn't ask for this, refuse: something else is trying to reach your vault.");
        font-size: Theme.small;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            QuietButton {
                text: @tr("Refuse");
                clicked => { root.decided(false); }
            }
        }
        Button {
            text: @tr("Connect");
            busy-text: @tr("Checking…");
            busy: root.busy;
            clicked => { root.decided(true); }
        }
    }
}

// Recovery parts just brought back the Secret Key: they no longer work (each kit's parts
// work once). A new kit is offered at once.
export component PartsUsedDialog inherits Modal {
    callback decided(bool);
    dismissed => { root.decided(false); }
    Text {
        text: @tr("Your recovery parts were used");
        font-size: Theme.title;
        color: Theme.ink;
    }
    Text {
        text: @tr("They brought back your Secret Key, and now they no longer work. Make a new emergency kit and print it, so you have a way back in again.");
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            QuietButton {
                text: @tr("Later");
                clicked => { root.decided(false); }
            }
        }
        Button {
            text: @tr("Make a new kit");
            clicked => { root.decided(true); }
        }
    }
}

export component FolderDialog inherits Modal {
    in property <int> mode;
    in-out property <string> name;
    // Icon name ("" = plain folder) and colour index.
    in-out property <string> icon;
    in-out property <int> color-index;
    // A website or picture link whose picture replaces the icon.
    in-out property <string> link;
    in property <image> preview;
    in property <bool> has-preview;
    // 0 nothing asked yet, 1 looking, 2 found, 3 not found.
    in property <int> preview-state;
    in property <int> error-code;
    in property <string> error-detail;
    in property <int> item-count;
    // Which browsers reach its items (S18): 0 every paired one, 1 none, 2 only the one
    // connected now (offered while one is).
    in-out property <int> browser;
    in property <bool> paired;
    callback save();
    callback fetch-preview();
    callback delete();
    callback ask-delete();
    callback cancel();

    card-width: root.mode == 2 ? 440px : 500px;
    focus-on-open: root.mode == 2;
    dismissed => { root.cancel(); }

    Text {
        text: root.mode == 0 ? @tr("New folder") : root.mode == 1 ? @tr("Folder settings") : @tr("Delete this folder?");
        font-size: Theme.title;
        font-weight: 600;
        color: Theme.ink;
    }

    if root.mode == 2: Text {
        text: root.item-count == 0
            ? @tr("“{}” is empty. Deleting it can't be undone.", root.name)
            : root.item-count == 1
            ? @tr("“{}” holds 1 item. It stays in your vault, just without a folder.", root.name)
            : @tr("“{}” holds {} items. They stay in your vault, just without a folder.", root.name, root.item-count);
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    if root.mode == 2: HorizontalLayout {
        alignment: end;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            QuietButton {
                text: @tr("Keep it");
                clicked => { root.cancel(); }
            }
        }
        Button {
            text: @tr("Delete folder");
            danger: true;
            clicked => { root.delete(); }
        }
    }

    if root.mode != 2: HorizontalLayout {
        spacing: 14px;
        // What the folder will look like in the index.
        VerticalLayout {
            alignment: end;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: Theme.radius + 2px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.rule;
                if root.has-preview: Image {
                    width: 28px;
                    height: 28px;
                    source: root.preview;
                    image-fit: contain;
                }
                if !root.has-preview: Glyph {
                    width: 22px;
                    height: 22px;
                    name: root.icon != "" ? root.icon : "folder";
                    tint: FolderLook.tint(root.icon, root.color-index);
                }
            }
        }
        LineField {
            horizontal-stretch: 1;
            label: @tr("Name");
            icon: "tag";
            required: true;
            placeholder: @tr("e.g. Google accounts");
            error: root.error-code == 30;
            text <=> root.name;
            accepted => { root.save(); }
            init => { self.focus(); }
        }
    }

    if root.mode != 2: VerticalLayout {
        spacing: 8px;
        opacity: root.has-preview ? 0.45 : 1;
        Text {
            text: root.has-preview ? @tr("Icon (the picture below is used instead)") : @tr("Icon");
            font-size: Theme.small;
            color: Theme.graphite;
        }
        for row in 4: HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for k in 8: Rectangle {
                property <string> glyph: FolderLook.icons[row * 8 + k];
                property <bool> chosen: (root.icon == "" ? "folder" : root.icon) == self.glyph;
                width: 34px;
                height: 34px;
                border-radius: Theme.radius;
                background: self.chosen ? Theme.selected : icon-touch.has-hover ? Theme.hover : transparent;
                border-width: self.chosen ? 1px : 0px;
                border-color: Theme.marker;
                accessible-role: button;
                accessible-label: self.glyph;
                Glyph {
                    width: 17px;
                    height: 17px;
                    name: parent.glyph;
                    tint: FolderLook.tint(parent.glyph, root.color-index);
                }
                icon-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.icon = parent.glyph == "folder" ? "" : parent.glyph; }
                }
            }
        }
        Text {
            text: @tr("Colour");
            font-size: Theme.small;
            color: Theme.graphite;
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for c[i] in FolderLook.colors: Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                border-width: i == root.color-index ? 2px : 0px;
                border-color: Theme.ink;
                accessible-role: button;
                accessible-label: i == 0 ? @tr("Default colour") : @tr("Colour {}", i);
                Rectangle {
                    width: 15px;
                    height: 15px;
                    border-radius: 7.5px;
                    background: i == 0 ? FieldColors.of(root.icon == "" ? "folder" : root.icon) : c;
                }
                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.color-index = i; }
                }
            }
        }
    }

    if root.mode != 2: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            LineField {
                horizontal-stretch: 1;
                label: @tr("Picture from a website or link");
                icon: "globe";
                hint: @tr("Type a website (github.com) to use its own icon, or a link to a PNG, JPEG, WebP, GIF or ICO picture. It is downloaded once, from that address only, and kept encrypted with your vault. Leave it empty to use the icon above.");
                placeholder: @tr("github.com or https://…/logo.png");
                error: root.error-code == 28 || root.error-code == 29;
                text <=> root.link;
                accepted => { root.fetch-preview(); }
            }
            VerticalLayout {
                alignment: end;
                QuietButton {
                    outlined: true;
                    text: root.preview-state == 1 ? @tr("Looking…") : @tr("Preview");
                    enabled: root.link != "" && root.preview-state != 1;
                    clicked => { root.fetch-preview(); }
                }
            }
        }
        if root.preview-state == 3 && root.error-code == 0: Text {
            text: @tr("No picture found there yet. Saving keeps the link and tries again later.");
            font-size: Theme.small;
            color: Theme.graphite;
            wrap: word-wrap;
        }
    }

    if root.mode != 2: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: @tr("The browser extension");
                font-size: Theme.small;
                color: Theme.graphite;
                vertical-alignment: center;
            }
            Hint {
                text: @tr("Kept out, the extension never gets this folder's items: not listed, not filled, not compared. Only this browser: the extension connected now gets them, and no other, here or on another computer, even one connected again later.");
            }
        }
        Choice {
            options: root.paired || root.browser == 2
                ? [@tr("Reaches its items"), @tr("Kept out"), @tr("Only this browser")]
                : [@tr("Reaches its items"), @tr("Kept out")];
            selected <=> root.browser;
        }
    }

    if root.mode != 2 && root.error-code != 0 && root.error-code != 30: Text {
        text: Messages.error(root.error-code, root.error-detail);
        font-size: Theme.small;
        color: Theme.seal;
        wrap: word-wrap;
    }

    if root.mode != 2: HorizontalLayout {
        spacing: 8px;
        if root.mode == 1: VerticalLayout {
            alignment: center;
            QuietButton {
                text: @tr("Delete folder…");
                tint: Theme.seal;
                clicked => { root.ask-delete(); }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            QuietButton {
                text: @tr("Cancel");
                clicked => { root.cancel(); }
            }
        }
        Button {
            text: root.mode == 0 ? @tr("Create folder") : @tr("Save");
            clicked => { root.save(); }
        }
    }
}

// An error line in a dialog: no room taken while there is nothing to say.
component DialogError inherits Text {
    in property <int> code;
    in property <string> detail;
    in property <string> words;
    text: root.words != "" ? root.words : Messages.error(root.code, root.detail);
    visible: root.code != 0 || root.words != "";
    height: root.code != 0 || root.words != "" ? self.preferred-height : 0px;
    font-size: Theme.small;
    color: Theme.seal;
    wrap: word-wrap;
}

// The buttons at the bottom of a dialog: Cancel, and the action (red when it can't be undone).
component DialogButtons inherits HorizontalLayout {
    in property <string> action;
    in property <string> busy-text: @tr("Checking…");
    in property <string> cancel-text: @tr("Cancel");
    in property <bool> busy;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback confirmed();
    callback cancelled();
    alignment: end;
    spacing: 8px;
    VerticalLayout {
        alignment: center;
        QuietButton {
            text: root.cancel-text;
            enabled: !root.busy;
            clicked => { root.cancelled(); }
        }
    }
    Button {
        text: root.action;
        busy-text: root.busy-text;
        busy: root.busy;
        danger: root.danger;
        enabled: root.enabled;
        clicked => { root.confirmed(); }
    }
}

// Asks before a sensitive change in Settings, with the master password where it matters
// (`field`: the secure field it is typed in). The dialog stays open while the check runs and
// shows what went wrong; the app closes it once the change is made.
export component ConfirmDialog inherits Modal {
    in property <string> title;
    in property <string> text;
    in property <string> action;
    // The button that leaves it as it is.
    in property <string> cancel-text: @tr("Cancel");
    in property <bool> danger;
    in property <bool> asks-master;
    in property <int> field: 20;
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    callback confirmed();
    callback cancelled();
    card-width: 500px;
    focus-on-open: !root.asks-master;
    dismissed => { if (!root.busy) { root.cancelled(); } }
    Text {
        text: root.title;
        font-size: Theme.title;
        color: Theme.ink;
        wrap: word-wrap;
    }
    Text {
        text: root.text;
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    if root.asks-master: SecretField {
        field: root.field;
        eye: true;
        label: @tr("Master password");
        icon: "key";
        required: true;
        error: root.error-code == 11 || root.error-code == 34;
        accepted => { root.confirmed(); }
        init => { self.focus(); }
    }
    DialogError { code: root.error-code; detail: root.error-detail; }
    DialogButtons {
        action: root.action;
        cancel-text: root.cancel-text;
        busy: root.busy;
        danger: root.danger;
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }
    }
}

// Settings → Sync, once another device renewed the vault key: its new Secret Key (from the
// new kit) and the master password.
export component TakeKeyDialog inherits Modal {
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    callback confirmed();
    callback cancelled();
    card-width: 540px;
    focus-on-open: false;
    dismissed => { if (!root.busy) { root.cancelled(); } }
    Text {
        text: @tr("Use the renewed vault key");
        font-size: Theme.title;
        color: Theme.ink;
    }
    Text {
        text: @tr("Another device renewed the vault key and printed a new kit. Type the Secret Key from that kit, and your master password: this computer then keeps the new key and syncs again. Windows Hello turns off until you turn it on again.");
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    SecretField {
        field: 2;
        label: @tr("New Secret Key");
        required: true;
        eye: true;
        cells: true;
        placeholder: "S0-";
        error: root.error-code == 2 || root.error-code == 3 || root.error-code == 61;
        init => { self.focus(); }
    }
    SecretField {
        field: 20;
        eye: true;
        label: @tr("Master password");
        icon: "key";
        required: true;
        error: root.error-code == 11 || root.error-code == 34 || root.error-code == 61;
        accepted => { root.confirmed(); }
    }
    DialogError { code: root.error-code; detail: root.error-detail; }
    DialogButtons {
        action: @tr("Use the new key");
        busy-text: @tr("Working…");
        busy: root.busy;
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }
    }
}

// Settings → Security → Change master password.
export component MasterPasswordDialog inherits Modal {
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    callback confirmed();
    callback cancelled();
    card-width: 520px;
    focus-on-open: false;
    dismissed => { if (!root.busy) { root.cancelled(); } }
    Text {
        text: @tr("Change the master password");
        font-size: Theme.title;
        color: Theme.ink;
    }
    Text {
        text: @tr("Your items, Secret Key and recovery parts stay the same. Your other devices ask for the new one at their next unlock, once they have synced. Windows Hello turns off until you turn it on again.");
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    SecretField {
        field: 5;
        eye: true;
        label: @tr("Current master password");
        icon: "key";
        required: true;
        error: root.error-code == 11;
        init => { self.focus(); }
    }
    SecretField {
        field: 6;
        eye: true;
        label: @tr("New master password");
        required: true;
        error: root.error-code == 4 || root.error-code == 5;
    }
    SecretField {
        field: 7;
        eye: true;
        label: @tr("Type it again");
        required: true;
        error: root.error-code == 4;
        accepted => { root.confirmed(); }
    }
    LeakCheckBox { }
    PasswordReview { place: 3; field: 6; }
    DialogError { code: root.error-code; detail: root.error-detail; }
    DialogButtons {
        action: @tr("Change master password");
        busy-text: @tr("Working…");
        busy: root.busy;
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }
    }
}

// Settings → Security → Save item lock: the new PIN or password (when that is the check) and
// the master password.
export component ItemLockDialog inherits Modal {
    // 0 master password, 1 PIN, 2 another password: chosen, and the one in use now.
    in property <int> check;
    in property <int> current-check;
    in property <bool> all;
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    callback confirmed();
    callback cancelled();
    card-width: 520px;
    focus-on-open: false;
    dismissed => { if (!root.busy) { root.cancelled(); } }
    Text {
        text: @tr("Save the item lock?");
        font-size: Theme.title;
        color: Theme.ink;
    }
    Text {
        text: (root.check == 0 ? @tr("The master password is asked before a locked item's secrets show. Nothing extra is encrypted.")
                : root.check == 1 ? @tr("A PIN opens locked items, and their secrets are encrypted with a key only it opens. Forget both it and your master password, and they can't be recovered.")
                : @tr("A password of its own opens locked items, and their secrets are encrypted with a key only it opens. Forget both it and your master password, and they can't be recovered."))
            + " " + (root.all ? @tr("Every item is locked.") : @tr("Only items marked “Lock this item's secrets” are locked."));
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    if root.check != 0: SecretField {
        field: 12;
        eye: true;
        label: root.check == 1
            ? (root.current-check == 1 ? @tr("New PIN (leave empty to keep the current one)") : @tr("PIN: 4 to 8 digits"))
            : (root.current-check == 2 ? @tr("New item password (leave empty to keep the current one)") : @tr("Item password: at least 6 characters"));
        icon: "pin";
        required: root.check != root.current-check;
        error: root.error-code == 36;
        init => { self.focus(); }
    }
    PasswordReview { place: 5; field: 12; }
    master := SecretField {
        field: 13;
        eye: true;
        label: @tr("Current master password");
        icon: "key";
        required: true;
        error: root.error-code == 11 || root.error-code == 34;
        accepted => { root.confirmed(); }
    }
    DialogError { code: root.error-code; detail: root.error-detail; }
    DialogButtons {
        action: @tr("Save item lock");
        busy-text: @tr("Working…");
        busy: root.busy;
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }
    }
    init => {
        if (root.check == 0) {
            master.focus();
        }
    }
}

// Settings → Sync → Use a server: its address, its certificate's pin when it has its own
// HTTPS, and an invite; or the one vaultsync: line, which holds all three.
export component ServerJoinDialog inherits Modal {
    in-out property <string> address;
    in-out property <string> pin;
    in-out property <string> invite;
    in property <bool> busy;
    in property <string> problem;
    callback confirmed();
    callback cancelled();
    card-width: 560px;
    focus-on-open: false;
    dismissed => { if (!root.busy) { root.cancelled(); } }
    Text {
        text: @tr("Sync through your vault server");
        font-size: Theme.title;
        color: Theme.ink;
    }
    Text {
        text: @tr("The server gets only sealed copies of the vault and this computer's public key. Paste the vaultsync: line (vault-server invite prints one, and so does Add a device on a device that already syncs): it holds the address, the pin and the invite. Or type them apart.");
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    LineField {
        label: @tr("Server address, or the whole vaultsync: line");
        icon: "server";
        placeholder: "https://vault.your-network.ts.net";
        text <=> root.address;
        hint: @tr("Where your vault-server answers: https://, or http:// with a Tailscale address (100.x.y.z).");
        init => { self.focus(); }
    }
    LineField {
        label: @tr("Certificate pin (only for the server's own HTTPS)");
        icon: "shield";
        mono: true;
        placeholder: @tr("Leave empty behind Tailscale or a domain");
        text <=> root.pin;
        hint: @tr("vault-server serve --tls prints it after pin=: 64 letters and digits. With it this computer trusts that server's certificate and no other.");
    }
    LineField {
        label: @tr("Invite");
        icon: "qr";
        mono: true;
        text <=> root.invite;
        hint: @tr("The 32 letters and digits from vault-server invite, or a whole vaultsync: line. It works once, and it doesn't open the vault.");
        accepted => { root.confirmed(); }
    }
    DialogError { words: root.problem; }
    DialogButtons {
        action: @tr("Join");
        busy-text: @tr("Joining…");
        busy: root.busy;
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }
    }
}

// Settings → Sync → Change the address (of the server, or of the backup server): the same
// server, reached another way. This computer's key and its place there stay.
export component ServerAddressDialog inherits Modal {
    in property <bool> backup;
    in-out property <string> address;
    in-out property <string> pin;
    in property <bool> busy;
    in property <string> problem;
    callback confirmed();
    callback cancelled();
    card-width: 560px;
    focus-on-open: false;
    dismissed => { if (!root.busy) { root.cancelled(); } }
    Text {
        text: root.backup ? @tr("The backup server's address") : @tr("The server's address");
        font-size: Theme.title;
        color: Theme.ink;
    }
    Text {
        text: @tr("For the same server reached another way: it moved to another computer with its data folder, or it now answers through Tailscale or a domain of its own. This computer keeps its key there, and the new address is kept only once the server answers at it with this vault. For another server, join that one with an invite.");
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    LineField {
        label: @tr("Server address");
        icon: "server";
        placeholder: "https://vault.your-network.ts.net";
        text <=> root.address;
        init => { self.focus(); }
    }
    LineField {
        label: @tr("Certificate pin (only for the server's own HTTPS)");
        icon: "shield";
        mono: true;
        placeholder: @tr("Leave empty behind Tailscale or a domain");
        text <=> root.pin;
        hint: @tr("vault-server serve --tls prints it after pin=: 64 letters and digits. Keep it as it is when the server moved with its data folder; empty it when the server is now reached through Tailscale or a domain.");
        accepted => { root.confirmed(); }
    }
    DialogError { words: root.problem; }
    DialogButtons {
        action: @tr("Save the address");
        busy-text: @tr("Checking…");
        busy: root.busy;
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }
    }
}

// Import & export → Export…: what an export needs before it is written: the master password,
// and for one protected by a password, that password twice. Plain JSON and CSV say plainly
// that they aren't encrypted. Every one says what it leaves out, and a plain one what anyone
// who gets the file reads, counted on this vault.
export component ExportDialog inherits Modal {
    // 1 JSON, 2 CSV, 3 protected by a password (.vaultx).
    in property <int> format;
    in property <ExportCounts> counts;
    // The counts changed when it was confirmed (the master password opened locked items, or
    // the vault changed since): shown, and confirmed again.
    in property <bool> recounted;
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    callback confirmed();
    callback cancelled();
    card-width: 520px;
    focus-on-open: false;
    dismissed => { if (!root.busy) { root.cancelled(); } }
    Text {
        // JSON and CSV alike hold every item's password (a note's, a card's PIN, an SSH key).
        text: root.format == 3 ? @tr("Save a protected export?")
            : @tr("Export every password unencrypted?");
        font-size: Theme.title;
        color: Theme.ink;
        wrap: word-wrap;
    }
    Text {
        text: root.format == 3
            ? @tr("Every item in one file, attached files and passkeys included, encrypted with a password you choose here. Whoever has the file and that password can sign in with those passkeys, so make it long. Import reads it back, here or on another computer; without that password nobody can, you included.")
            : @tr("The file holds the passwords in plain text: anyone or any program that gets it reads them, and malware looks for exactly these files. Use it only to move to another password manager, then delete it.");
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    // Always there (empty = no height): wrapped text shown by an `if` is measured as one line.
    Text {
        text: Messages.export-notes(root.counts);
        height: self.text == "" ? 0px : self.preferred-height;
        font-size: Theme.body;
        color: Theme.ink;
        wrap: word-wrap;
    }
    Text {
        text: root.recounted ? @tr("This was counted again: locked items could be opened, or the vault changed. Choose Export… again to make the file.") : "";
        height: self.text == "" ? 0px : self.preferred-height;
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    SecretField {
        field: 5;
        eye: true;
        label: @tr("Master password");
        icon: "key";
        required: true;
        error: root.error-code == 11 || root.error-code == 34;
        init => { self.focus(); }
        accepted => {
            if (root.format != 3) { root.confirmed(); }
        }
    }
    if root.format == 3: SecretField {
        field: 6;
        eye: true;
        label: @tr("Password for this file");
        hint: @tr("It alone guards the file: whoever gets the file can try guesses for as long as they like. A password that is easy to guess is refused; six random words are not.");
        icon: "key";
        error: root.error-code == 4 || root.error-code == 5 || root.error-code == 73;
    }
    if root.format == 3: SecretField {
        field: 7;
        eye: true;
        label: @tr("Type it again");
        icon: "key";
        error: root.error-code == 4;
        accepted => { root.confirmed(); }
    }
    if root.format == 3: HorizontalLayout {
        alignment: start;
        QuietButton {
            icon: "sparkle";
            outlined: true;
            text: @tr("Use a generated passphrase");
            enabled: !root.busy;
            clicked => { NewPassword.use-passphrase(6); }
        }
    }
    DialogError { code: root.error-code; detail: root.error-detail; }
    DialogButtons {
        action: @tr("Export…");
        busy: root.busy;
        danger: root.format != 3;
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }
    }
}

// Settings → Sync → Use WebDAV: the folder's address, the user and the password.
export component WebDavDialog inherits Modal {
    in-out property <string> address;
    in-out property <string> user;
    in property <bool> busy;
    in property <string> problem;
    callback confirmed();
    callback cancelled();
    card-width: 560px;
    focus-on-open: false;
    dismissed => { if (!root.busy) { root.cancelled(); } }
    Text {
        text: @tr("Sync through WebDAV");
        font-size: Theme.title;
        color: Theme.ink;
    }
    Text {
        text: @tr("A folder on your WebDAV host (Nextcloud, a NAS). The vault's sealed copies go in a folder of their own inside it.");
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    LineField {
        label: @tr("WebDAV address");
        icon: "cloud";
        placeholder: "https://cloud.example.com/remote.php/dav/files/you/Vault";
        text <=> root.address;
        init => { self.focus(); }
    }
    LineField {
        label: @tr("User name");
        icon: "user";
        text <=> root.user;
    }
    SecretField {
        field: 15;
        eye: true;
        label: @tr("Password");
        hint: @tr("Kept in Windows Credential Manager on this computer, never in the vault. An app password from your host is better than your account's own.");
        accepted => { root.confirmed(); }
    }
    DialogError { words: root.problem; }
    DialogButtons {
        action: @tr("Connect");
        busy-text: @tr("Connecting…");
        busy: root.busy;
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }
    }
}

// Settings → Sync → Add a backup server: its address and an invite from it.
export component BackupServerDialog inherits Modal {
    in-out property <string> address;
    in-out property <string> invite;
    in property <bool> busy;
    in property <string> problem;
    callback confirmed();
    callback cancelled();
    card-width: 560px;
    focus-on-open: false;
    dismissed => { if (!root.busy) { root.cancelled(); } }
    Text {
        text: @tr("Add a backup server");
        font-size: Theme.title;
        color: Theme.ink;
    }
    Text {
        text: @tr("A second server keeps a copy too. While the main one is down the vault syncs through it, and the main one catches up as soon as it is back. On the backup server run vault-server invite, then give its address and the invite here.");
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    LineField {
        label: @tr("Backup server address");
        icon: "server";
        placeholder: "https://backup.your-network.ts.net";
        text <=> root.address;
        hint: @tr("Where the second vault-server answers: https://, http:// with a Tailscale address (100.x.y.z), or the address vault-server serve --tls printed, with its #pin= part.");
        init => { self.focus(); }
    }
    LineField {
        label: @tr("Invite");
        icon: "qr";
        mono: true;
        text <=> root.invite;
        hint: @tr("The 32 letters and digits from vault-server invite on the backup server, or a vaultsync: line from it. It works once, and it doesn't open the vault.");
        accepted => { root.confirmed(); }
    }
    DialogError { words: root.problem; }
    DialogButtons {
        action: @tr("Join the backup server");
        busy-text: @tr("Joining…");
        busy: root.busy;
        confirmed => { root.confirmed(); }
        cancelled => { root.cancelled(); }
    }
}

// One step of what to do in a browser: its number and what to do.
component Step inherits HorizontalLayout {
    in property <string> number;
    in property <string> text;
    spacing: 10px;
    Text {
        text: root.number;
        width: 18px;
        font-size: Theme.body;
        font-family: Theme.mono-font;
        color: Theme.graphite;
    }
    Text {
        text: root.text;
        horizontal-stretch: 1;
        font-size: Theme.body;
        color: Theme.ink;
        wrap: word-wrap;
    }
}

// Settings → Browser extension → Add to a browser: the browser opened on its extensions page
// (or the page to open in it), the folder's path copied, and the steps there. Chromium-based
// browsers load the folder ("Load unpacked"); Firefox loads it as a temporary add-on, which it
// keeps only until it closes (one that stays must be signed by Mozilla).
export component ExtensionStepsDialog inherits Modal {
    in property <string> browser;
    in property <bool> firefox;
    // The browser's extensions page, and the folder to load.
    in property <string> page;
    in property <string> folder;
    // The browser started on that page; the folder's path is on the clipboard.
    in property <bool> started;
    in property <bool> copied;
    // The browser link is on (Settings → Browser extension): the extension can reach the app.
    in property <bool> link-on;
    callback open-folder();
    callback done();
    card-width: 580px;
    dismissed => { root.done(); }
    Text {
        text: @tr("Add the extension to {}", root.browser);
        font-size: Theme.title;
        color: Theme.ink;
        wrap: word-wrap;
    }
    Text {
        text: root.started && root.copied ? @tr("{} opened on its extensions page, {}, and the folder's path is copied.", root.browser, root.page)
            : root.started ? @tr("{} opened on its extensions page, {}.", root.browser, root.page)
            : root.copied ? @tr("Open {} in {}. The folder's path is copied.", root.page, root.browser)
            : @tr("Open {} in {}.", root.page, root.browser);
        font-size: Theme.body;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    Step {
        number: "1";
        text: root.firefox ? @tr("Choose “Load Temporary Add-on…”.") : @tr("Turn on “Developer mode”, a switch at the top of the page.");
    }
    Step {
        number: "2";
        text: root.firefox ? @tr("Paste the folder's path into the file box (Ctrl+V), press Enter, then pick manifest.json.")
            : @tr("Choose “Load unpacked”, paste the folder's path into the folder box (Ctrl+V) and choose “Select Folder”.");
    }
    Step {
        number: "3";
        text: root.link-on ? @tr("Pin the extension to the toolbar, open it and choose Connect.")
            : @tr("Turn on “Let the browser extension connect to this app” on this page, then pin the extension to the toolbar, open it and choose Connect.");
    }
    Rectangle {
        background: Theme.panel;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.rule;
        height: path.preferred-height + 16px;
        path := Text {
            x: 12px;
            width: parent.width - 24px;
            text: root.folder;
            font-size: Theme.small;
            font-family: Theme.mono-font;
            color: Theme.ink;
            wrap: char-wrap;
            vertical-alignment: center;
        }
    }
    Text {
        text: root.firefox ? @tr("Firefox keeps an add-on loaded this way only until it closes: one that stays must be signed by Mozilla, which this one isn't yet. Add it again after Firefox restarts.")
            : @tr("Leave the folder where it is: Vault writes each new version of the extension into it, and the extension reloads itself to take it.");
        font-size: Theme.small;
        color: Theme.graphite;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            QuietButton {
                icon: "folder";
                text: @tr("Open the folder");
                clicked => { root.open-folder(); }
            }
        }
        Button {
            text: @tr("Done");
            clicked => { root.done(); }
        }
    }
}

// The invite another device joins with: its QR code and its line.
export component InviteDialog inherits Modal {
    in property <string> line;
    in property <image> qr;
    callback done();
    card-width: 560px;
    dismissed => { root.done(); }
    Text {
        text: @tr("Add a device");
        font-size: Theme.title;
        color: Theme.ink;
    }
    HorizontalLayout {
        spacing: 16px;
        Rectangle {
            width: 168px;
            height: 168px;
            background: white;
            border-radius: Theme.radius;
            Image {
                width: 160px;
                height: 160px;
                source: root.qr;
                image-rendering: pixelated;
            }
        }
        VerticalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: @tr("Scan this on the phone, or paste the line below into Invite on the other device. It works once, for an hour. It doesn't open the vault: that still takes your master password and Secret Key.");
                font-size: Theme.body;
                color: Theme.ink;
                wrap: word-wrap;
            }
            Text {
                text: root.line;
                font-size: Theme.small;
                font-family: Theme.mono-font;
                color: Theme.graphite;
                wrap: char-wrap;
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        Button {
            text: @tr("Done");
            clicked => { root.done(); }
        }
    }
}
