// Data shapes shared between Rust and the UI, plus every user-facing message.
// Rust only sends codes; the words live here so they can be translated (@tr).

export enum Screen { onboarding, unlock, recover, vault }
export enum Panel { detail, editor, generator, settings, kit, transfer, authenticator, health }

// A file attached to an item: its name and size ("12 KB").
// Another device that syncs the vault, in Settings → Sync: its name, and whether it has no
// copy where the vault syncs now (it synced through another place, or hasn't joined here).
export struct DeviceLine {
    name: string,
    away: bool,
    // Its copy couldn't be used (SYNC.md §8): why, and when that was found ("" when it could).
    problem: string,
    problem-at: string,
    // Read but refused (otherwise it couldn't be read).
    refused: bool,
}

// A browser the extension can be added to (Settings → Browser extension), and whether it is
// the one that opens web links.
export struct ExtensionBrowser {
    name: string,
    // Its brand's mark (SourceMark in icons.slint).
    mark: int,
    is-default: bool,
}

// A site the browser extension has rules for (Settings → Browser extension → Site rules),
// kept on this computer: its host and its switches, and the hosts of other sites whose frames
// in its pages may get a card ("" for none).
export struct SiteRuleRow {
    site: string,
    never-save: bool,
    no-card: bool,
    never-fill: bool,
    no-passkeys: bool,
    card-frames: string,
}

export struct FileRow {
    name: string,
    size: string,
}

// A login's passkey: the site it signs in to, the account, and when it was made.
export struct PasskeyRow {
    site: string,
    user: string,
    created: string,
    // What its site said through the browser (the Signal API): 0 nothing, 1 it no longer
    // knows this passkey, 2 the account is named `signal-name` now.
    signal: int,
    signal-name: string,
}

export struct ItemRow {
    title: string,
    subtitle: string,
    kind: int,        // 0 login, 1 card, 2 note, 3 passkey
    favorite: bool,
    icon: image,      // website icon, when downloaded
    has-icon: bool,
    initial: string,  // fallback letter
    tint: color,      // fallback background, stable per site
    brand: int,       // cards: network mark (icons.slint BrandMark), 0 unknown
    glyph: string,    // a line icon chosen for it ("" = none), and its colours (IconLook)
    glyph-color: int,
    glyph-bg: int,
}

// An earlier password of the item shown (Password history).
export struct HistoryRow {
    password: string, // filled only while shown
    date: string,     // when it stopped being the password
}

// An earlier version of the item shown (Earlier versions, format v11), oldest first.
export struct VersionRow {
    date: string,     // when it stopped being the current version
    changes: [int],   // what the change after it altered (Messages.change-name)
}

// A password made by the generator and used (Generator page, newest first).
export struct GeneratedRow {
    password: string, // filled only while shown
    site: string,     // the site it was made for, "" when made in the app
    date: string,
}

// One line of the security log (Settings → Security, newest first; the phone's too). `kind` is
// one of vault_platform::security_log::kind; `kind == 0` is an entry that couldn't be read.
export struct SecurityLine {
    kind: int,
    at: string,
    site: string,
    title: string,
    detail: string,
}

// One problem found by the password health check.
export struct HealthRow {
    title: string,
    subtitle: string,
    kind: int,
    brand: int,
    icon: image,
    has-icon: bool,
    initial: string,
    tint: color,
    problem: int,     // 1 leaked, 2 weak, 3 reused, 4 old, 5 expired card or expiry date
    detail: string,   // how many breaches, or the expiry date
    count: int,       // how many other logins share the password
    weakness: int,    // why it is weak (Messages.weakness); problem 5: 1 for an expiry date
    age-unit: int,    // how long ago the password was set (Messages.ago)
    age-amount: int,
    has-site: bool,   // a login with a website: its page for changing the password is offered
}

// One entry of the file being imported, for review. Nothing secret.
export struct ImportRow {
    include: bool,
    title: string,
    username: string,
    site: string,
    folder: string,
    kind: int,
    has-password: bool,
    has-totp: bool,
    duplicate: bool,
}

// What an export leaves out, keeps in another form and writes as plain text
// (vault_import::export_report), counted before it is made. Counts only, nothing secret.
export struct ExportCounts {
    // Not in the file. `dates`: when items were made and changed (CSV has none).
    attachments: int,
    passkeys: int,
    earlier-passwords: int,
    extra-websites: int,
    dates: bool,
    // In the file, in another form: hidden fields without their mark, lists of recovery codes
    // as text, items as another kind.
    hidden-marks: int,
    recovery-code-lists: int,
    kinds-changed: int,
    // As plain text: 0 for an export protected by a password.
    passwords: int,
    otp-secrets: int,
    hidden-fields: int,
    recovery-codes: int,
    notes: int,
    // Passwords and code secrets a spreadsheet would read as a formula (CSV).
    formula-like: int,
    // Passkeys with their private keys, as plain text (the Credential Exchange file).
    readable-passkeys: int,
}

// A place to import from (browser or password manager).
export struct SourceRow {
    name: string,
    browser: bool,
    installed: bool,
    initial: string,
    tint: color,
}

// A folder in the index. The index's `category` is 100 + the folder's position when selected.
export struct FolderRow {
    name: string,
    count: int,
    icon: string,     // icons.slint name; "" = the plain folder
    color: int,       // FolderLook colour index; 0 = default
    image: image,     // the picture from its link, once downloaded
    has-image: bool,
}

// An extra field in the editor.
export struct EditField {
    name: string,
    value: string,
    hidden: bool,
}

// A vault file this computer has opened (lock screen chooser).
export struct RecentVault {
    name: string,      // file name without extension
    location: string,  // folder
    current: bool,     // the one selected now
    missing: bool,     // the file isn't there anymore
}

// One entry on the Authenticator page.
export struct AuthRow {
    title: string,
    subtitle: string,
    code: string,      // grouped, e.g. "123 456"
    left: int,         // seconds until the next code
    period: int,       // usually 30
    kind: int,
    icon: image,
    has-icon: bool,
    initial: string,
    tint: color,
    locked: bool,      // the item's secrets are locked: no code to show or copy
    glyph: string,     // a line icon chosen for it, and its colours
    glyph-color: int,
    glyph-bg: int,
}

// One recovery code on the item page (filled only while the codes are shown).
export struct CodeRow {
    code: string,
    used: bool,
}

export struct DetailField {
    label: string,
    value: string,
    sensitive: bool,
    index: int,       // position in the item's fields (what Copy copies)
    warning: bool,    // e.g. an expired card date
    icon: string,     // icons.slint name
    hideable: bool,   // hidden or masked: offers Show
}

// The item lock as every lock box shows it (set from Rust, controller.rs sync_guard_state).
export global ItemLock {
    // A newer item lock set on another device waits here until the locked items can move to
    // it: 0 none, 1 it opens with a PIN, 2 with a password, 3 with nothing more (turned off,
    // or the master password as the check: only this computer's own lock is to be opened).
    in-out property <int> waiting;
}

export global Messages {
    // The secure desktop's prompt (vault_platform::secure_desktop), drawn by Windows, not
    // Slint: 0 its title, 1 what it is, 2 its keys.
    public pure function secure-prompt(part: int) -> string {
        if (part == 0) { return @tr("Master password"); }
        if (part == 1) { return @tr("Vault switched to a desktop of its own, where other programs can't see the keys you type or the screen. Type your master password. Your desktop comes back right after."); }
        if (part == 2) { return @tr("Enter unlocks · Esc goes back without unlocking · after 2 minutes it goes back by itself"); }
        return "";
    }

    // What a security log entry says (SecurityLine): what happened, then where.
    public pure function security-event(kind: int, detail: string) -> string {
        if (kind == 0) { return @tr("An entry that couldn't be read: it was altered, or written with another key"); }
        if (kind == 1 && detail == "device") { return @tr("Unlocked without the master password (Windows Hello or fingerprint)"); }
        if (kind == 1 && detail == "recovery") { return @tr("Unlocked with the emergency kit's recovery parts, and a new master password set"); }
        if (kind == 1) { return @tr("Unlocked with the master password"); }
        if (kind == 2 && detail == "device") { return @tr("An unlock without the master password failed"); }
        if (kind == 2 && detail == "recovery") { return @tr("Recovery with the emergency kit failed: wrong parts"); }
        if (kind == 2) { return @tr("A wrong master password was typed"); }
        if (kind == 3 && detail == "login") { return @tr("The browser extension filled a login"); }
        if (kind == 3 && detail == "password") { return @tr("The browser extension had a password copied"); }
        if (kind == 3 && detail == "username") { return @tr("The browser extension had a username copied"); }
        if (kind == 3 && detail == "code") { return @tr("The browser extension was given a one-time code"); }
        if (kind == 3 && detail == "passkey") { return @tr("The browser extension signed in with a passkey"); }
        if (kind == 3 && detail == "card") { return @tr("The browser extension filled a card"); }
        if (kind == 3 && detail == "identity") { return @tr("The browser extension filled an address"); }
        if (kind == 3 && detail == "shown") { return @tr("The browser extension showed a password in its window"); }
        if (kind == 3) { return @tr("The browser extension was given an item's details"); }
        if (kind == 4 && detail == "update") { return @tr("The browser extension changed a login's password"); }
        if (kind == 4 && detail == "passkey") { return @tr("The browser extension saved a passkey"); }
        if (kind == 4) { return @tr("The browser extension saved a login"); }
        if (kind == 5 && detail == "code") { return @tr("The browser extension was given a one-time code while the vault was locked"); }
        if (kind == 5 && detail == "password") { return @tr("The browser extension had a password copied while the vault was locked"); }
        if (kind == 5) { return @tr("The browser extension filled a login while the vault was locked"); }
        if (kind == 6) { return @tr("The vault was exported ({})", detail); }
        if (kind == 7) { return @tr("The emergency kit was shown"); }
        if (kind == 8) { return @tr("The emergency kit was saved as a file"); }
        if (kind == 9) { return @tr("The emergency kit was printed"); }
        if (kind == 10) { return @tr("A device joined the sync: {}", detail); }
        if (kind == 11) { return @tr("A device was removed from the sync: {}", detail); }
        if (kind == 12 && detail == "taken") { return @tr("The vault key renewed on another device was taken here"); }
        if (kind == 12) { return @tr("The vault key was renewed"); }
        if (kind == 13) { return @tr("The log was cleared: what came before is gone"); }
        if (kind == 14 && detail == "key") { return @tr("The log started again: its key had been replaced, so what was written to it since couldn't be read"); }
        if (kind == 14) { return @tr("The log started again: the one before couldn't be read"); }
        if (kind == 15) { return @tr("The master password was changed"); }
        if (kind == 16 && detail == "password") { return @tr("Autofill filled a password"); }
        if (kind == 16) { return @tr("Autofill filled a login"); }
        if (kind == 17) { return @tr("A passkey signed in"); }
        if (kind == 18 && detail != "") { return @tr("An SSH key signed for {}", detail); }
        if (kind == 18) { return @tr("An SSH key signed for a program"); }
        if (kind == 19) { return @tr("Auto-type typed a login into “{}”", detail); }
        return @tr("Something this version of the app doesn't know");
    }

    // Where a security log entry happened: the site and the item, when it has them.
    public pure function security-where(site: string, title: string) -> string {
        if (site != "" && title != "") { return @tr("{} on {}", title, site); }
        if (site != "") { return site; }
        return title;
    }

    // The notification area icon and its menu.
    out property <string> tray-tooltip: @tr("Vault");
    // What Explorer calls a .vault file (its "Type" column).
    out property <string> vault-file-type: @tr("Password vault");

    // What a change to an item altered (`view::version_changes`).
    public pure function change-name(code: int) -> string {
        if (code == 1) { return @tr("title"); }
        if (code == 2) { return @tr("username"); }
        if (code == 3) { return @tr("password"); }
        if (code == 4) { return @tr("websites"); }
        if (code == 5) { return @tr("notes"); }
        if (code == 6) { return @tr("one-time code"); }
        if (code == 7) { return @tr("fields"); }
        if (code == 8) { return @tr("recovery codes"); }
        return @tr("other details");
    }

    public pure function kind-name(kind: int) -> string {
        if (kind == 1) { return @tr("Card"); }
        if (kind == 2) { return @tr("Secure note"); }
        if (kind == 3) { return @tr("Passkey"); }
        if (kind == 4) { return @tr("SSH key"); }
        if (kind == 5) { return @tr("Identity"); }
        return @tr("Login");
    }

    public pure function error(code: int, detail: string) -> string {
        if (code == 0) { return ""; }
        if (code == 150) { return @tr("That isn't a site: type its address, such as example.com."); }
        if (code == 1) { return @tr("That master password doesn't open this vault. Check Caps Lock and try again."); }
        if (code == 2) { return @tr("That Secret Key has a typo. Compare it with your emergency kit, group by group."); }
        if (code == 3) { return @tr("A Secret Key starts with S0- followed by four groups of seven characters."); }
        if (code == 4) { return @tr("The two passwords are different. Type them again."); }
        if (code == 5) { return @tr("Use at least 12 characters. A passphrase of random words is easiest."); }
        if (code == 73) { return @tr("That password is too easy to guess to guard this file on its own: whoever gets the file can try guesses for as long as they like, with nothing else to stop them. Use a generated passphrase, or a longer password that isn't made of common words."); }
        if (code == 74) { return @tr("Too many failed tries in a row: wait until the countdown ends, then try again."); }
        if (code == 6) { return @tr("This vault file is older than one this computer has already opened ({}). Someone may have swapped it for an old copy. Restore the newest file before continuing.", detail); }
        if (code == 7) { return @tr("The vault file couldn't be read or written: {}", detail); }
        if (code == 8) { return @tr("That Recovery Key doesn't open this vault. It starts with R0- and has nine groups."); }
        if (code == 44) { return @tr("These parts don't open this vault. Check each one, and that they all come from your latest kit."); }
        if (code == 45) { return @tr("One part has a typo, or isn't a recovery part: each starts with A0-, B0- or C0- followed by four groups of seven characters."); }
        if (code == 46) { return @tr("Two of these are the same part. Use different ones: A, B or C."); }
        if (code == 47) { return @tr("That picture doesn't give a recovery part: {}", detail); }
        if (code == 48) { return @tr("This vault has no recovery parts: its kit has a Secret Key to type, or the Recovery Key of an older kit."); }
        if (code == 49) { return @tr("Part C couldn't be hidden in that picture: {}", detail); }
        if (code == 50) { return @tr("The backup didn't pass its check, so it was deleted ({}). Try another place: a full or failing drive may be the cause.", detail); }
        if (code == 51) { return @tr("That file is too large: an item keeps files of up to 5 MB, and up to 10 of them."); }
        if (code == 52) { return @tr("That isn't an SSH private key. Choose the key file itself (often id_ed25519 or id_rsa), not the .pub one."); }
        if (code == 53) { return @tr("That is the public key. The private one is the file of the same name without .pub (often id_ed25519 or id_rsa)."); }
        if (code == 54) { return @tr("This form of key isn't read here (PuTTY's .ppk, or an older encrypted form). ssh-keygen -p -f with the key's file writes it in OpenSSH's form; then bring that."); }
        if (code == 55) { return @tr("That passphrase doesn't open the key. Try again."); }
        if (code == 60) { return @tr("That opened the new item lock, set on another device. Now type the PIN or password this computer asked for until now: then the locked items move to the new lock."); }
        if (code == 61) { return @tr("That Secret Key and master password open none of the renewed copies. Use the Secret Key of the kit made when the vault key was renewed."); }
        if (code == 62) { return @tr("This computer couldn't keep the new Secret Key ({}), so nothing was changed.", detail); }
        if (code == 63) { return @tr("This computer couldn't keep the new Secret Key ({}), and the vault file now opens only with it: keep the new emergency kit at hand, it is asked at the next unlock.", detail); }
        if (code == 64) { return @tr("Windows didn't take the change to starting at sign-in ({}). The check shows what Windows will do.", detail); }
        if (code == 65) { return @tr("That folder is copied to the cloud by {}: the kit's keys would leave this computer. Choose a folder on this computer or a USB drive, or print the kit. Nothing was saved.", detail); }
        if (code == 66) { return @tr("That folder already holds part {}. Keep each recovery part in a different place: two of them bring back the Secret Key, three open the vault. Nothing was saved.", detail); }
        if (code == 67) { return @tr("Another request to connect came while this one waited, so this is a new code. Connect only if the extension shows this same code; if it doesn't, refuse."); }
        if (code == 9) { return @tr("Give the item a title."); }
        if (code == 10) { return @tr("The one-time code secret isn't valid. Paste the otpauth:// link or the key shown by the website."); }
        if (code == 11) { return @tr("The current master password is wrong."); }
        if (code == 140) { return @tr("No QR code with a one-time code key was found in that picture. Use a sharp screenshot of the whole code, or paste the setup key instead."); }
        if (code == 141) { return @tr("That picture couldn't be read: {}", detail); }
        if (code == 12) { return @tr("The clipboard isn't available right now. Try again."); }
        if (code == 19) { return @tr("That file couldn't be imported: {}", detail); }
        if (code == 20) { return @tr("That card number has a typo: check the digits (12 to 19, as printed on the card)."); }
        if (code == 21) { return @tr("Write the expiry date as MM/YY, for example 08/29."); }
        if (code == 22) { return @tr("The security code is the 3 digits on the back (4 on the front for American Express)."); }
        if (code == 23) { return @tr("A PIN is 4 to 12 digits, the one your bank gave you."); }
        if (code == 25) { return @tr("That word list couldn't be used: it needs at least 500 different words, one per line. {}", detail); }
        if (code == 26) { return @tr("The leak check couldn't reach the service: {}. Nothing was sent except the first five characters of each password's fingerprint.", detail); }
        if (code == 27) { return @tr("A vault name has at most 60 characters."); }
        if (code == 28) { return @tr("Type a website (example.com) or a link to a picture (https://example.com/logo.png)."); }
        if (code == 30) { return @tr("Type a folder name."); }
        if (code == 32) { return @tr("This vault also needs its keyfile. Choose the file (plug in the drive it is on first)."); }
        if (code == 33) { return @tr("That file can't be used as a keyfile: {}", detail); }
        if (code == 34) { return @tr("That master password and keyfile don't open this vault. Check Caps Lock, and that it is the right file."); }
        if (code == 35) { return detail == "1" ? @tr("That isn't it. One more wrong try locks the vault.") : @tr("That isn't it. {} tries left before the vault locks.", detail); }
        if (code == 36) { return @tr("A PIN has 4 to 8 digits; an item password at least 6 characters."); }
        if (code == 41) { return @tr("Paste the setup key the site shows for its authenticator app (often under “Can't scan it?”), or an otpauth:// link."); }
        if (code == 40) { return @tr("Filling while the vault is locked uses Windows Hello: turn it on in Settings → Item lock first (with a PIN or another password)."); }
        if (code == 39) { return @tr("Windows Hello no longer opens the item lock on this computer (its PIN or password was changed). Use the PIN, then turn Windows Hello on again in Settings → Item lock."); }
        if (code == 38) { return @tr("Vault couldn't find its own program file, which the browsers start for the extension, so the extension can't be connected."); }
        if (code == 42) { return @tr("The browser extension can't reach this window: its channel is already in use, by another window of the app or by another program. Close the other window, then turn the extension setting off and on again."); }
        if (code == 151) { return @tr("There's no window behind Vault to type into. Click into the program's field first, then come back here and choose Auto-type."); }
        if (code == 37) { return @tr("Locked secrets are in the way. Open the item lock first: type its PIN or password on a locked item or on the Authenticator page, then try again."); }

        if (code == 24) { return @tr("The vault file was changed outside this window (another window or program). Your last change was not saved: lock and unlock to load the newest version, then make it again."); }
        if (code == 14) { return @tr("Windows Hello couldn't open the vault ({}). Use your master password.", detail); }
        if (code == 15) { return @tr("The master password changed, so Windows Hello was turned off on this computer. Unlock with the master password, then turn it on again in Settings."); }
        if (code == 16) { return @tr("It's been {} days: type your master password this time, so you keep remembering it. Windows Hello works again right after.", detail); }
        if (code == 18) { return @tr("Windows Hello was reset on this computer, so this vault's key is gone. Unlock with the master password, then turn Windows Hello on again in Settings."); }
        if (code == 17) { return @tr("Windows Hello isn't set up on this computer. Set it up in Windows Settings → Accounts → Sign-in options, or use your master password."); }
        if (code == 70) { return @tr("The browser extension's folder couldn't be written ({}). Try again; if it keeps failing, close the browser first.", detail); }
        if (code == 71) { return @tr("The browser extension's folder couldn't be opened ({}).", detail); }
        if (code == 72) { return @tr("That folder can't be used as the browser extension ({}). It needs a manifest.json at its top and no links.", detail); }
        if (code == 90) { return @tr("This computer's security chip (TPM) no longer opens the Secret Key it kept for this vault: the chip was cleared, replaced or turned off. Type the Secret Key from your emergency kit. Once the vault opens, it's kept again."); }
        if (code == 91) { return @tr("Two different Secret Keys are kept for this vault on this computer: an older version of the app saved one. Type the Secret Key from your newest emergency kit."); }
        if (code == 92) { return @tr("The Secret Key kept on this computer couldn't be read just now ({}). Try again, or type it from your emergency kit.", detail); }
        if (code == 93) { return @tr("Tags are separated by commas: at most 32, each up to 40 characters."); }
        if (code == 94) { return @tr("Type the expiry date as year-month-day, for example 2027-03-31."); }
        if (code == 95) { return @tr("The secure desktop couldn't be shown ({}). Type the master password in the field instead.", detail); }
        return @tr("Something went wrong: {}", detail);
    }

    // Units from view.rs → crack.
    public pure function crack-time(unit: int, n: int) -> string {
        if (unit == 0) { return @tr("Cracked almost instantly"); }
        if (unit == 1) { return @tr("About {n} second to crack" | "About {n} seconds to crack" % n); }
        if (unit == 2) { return @tr("About {n} minute to crack" | "About {n} minutes to crack" % n); }
        if (unit == 3) { return @tr("About {n} hour to crack" | "About {n} hours to crack" % n); }
        if (unit == 4) { return @tr("About {n} day to crack" | "About {n} days to crack" % n); }
        if (unit == 5) { return @tr("About {n} year to crack" | "About {n} years to crack" % n); }
        if (unit == 6) { return @tr("About {n} thousand years to crack" | "About {n} thousand years to crack" % n); }
        if (unit == 7) { return @tr("About {n} million years to crack" | "About {n} million years to crack" % n); }
        if (unit == 8) { return @tr("About {n} billion years to crack" | "About {n} billion years to crack" % n); }
        // Past the age of the universe, counted in ages of the universe so it keeps growing.
        if (unit == 9 && n <= 1) { return @tr("About as long to crack as the universe has existed"); }
        if (unit == 9) { return @tr("About {} times the age of the universe to crack", n); }
        if (unit == 10) { return @tr("About {} thousand times the age of the universe to crack", n); }
        if (unit == 11) { return @tr("About {} million times the age of the universe to crack", n); }
        if (unit == 12) { return @tr("About {} billion times the age of the universe to crack", n); }
        if (unit == 13) { return @tr("About {} trillion times the age of the universe to crack", n); }
        return @tr("About a 1 followed by {} zeros times the age of the universe to crack", n);
    }

    // Codes from view.rs → crack_comparison.
    public pure function crack-comparison(code: int) -> string {
        if (code == 1) { return @tr("Faster than you can read this."); }
        if (code == 2) { return @tr("Gone before you finish this sentence."); }
        if (code == 3) { return @tr("About one coffee break."); }
        if (code == 4) { return @tr("Done before the end of a workday."); }
        if (code == 5) { return @tr("About as long as a holiday. Not great."); }
        if (code == 6) { return @tr("Years of guessing — but a determined attacker can wait."); }
        if (code == 7) { return @tr("If they'd started when the first iPhone came out, they'd still be at it."); }
        if (code == 8) { return @tr("If they'd started when the Web went public, they'd still be at it."); }
        if (code == 9) { return @tr("If they'd started at the first Moon landing, they'd still be at it."); }
        if (code == 10) { return @tr("If they'd started with the first steam engines, they'd still be at it."); }
        if (code == 11) { return @tr("If they'd started when Gutenberg printed his first page, they'd still be at it."); }
        if (code == 12) { return @tr("If they'd started when the Vikings reached America, they'd still be at it."); }
        if (code == 13) { return @tr("If they'd started while Julius Caesar ruled Rome, they'd still be at it."); }
        if (code == 14) { return @tr("If they'd started while the pyramids were being built, they'd still be at it."); }
        if (code == 15) { return @tr("If they'd started with the very first farmers, they'd still be at it."); }
        if (code == 16) { return @tr("If they'd started with the first humans, they'd still be at it."); }
        if (code == 17) { return @tr("If they'd started when the dinosaurs died out, they'd still be at it."); }
        if (code == 18) { return @tr("If they'd started when the Earth formed, they'd still be at it."); }
        if (code == 19) { return @tr("The universe is only 13.8 billion years old."); }
        if (code == 20) { return @tr("The last stars in the sky would burn out before it's found."); }
        if (code == 21) { return @tr("Even with computers a billion times faster, it would outlast the universe."); }
        if (code == 22) { return @tr("There are more possible passwords like it than atoms in the whole Earth."); }
        if (code == 23) { return @tr("There are more possible passwords like it than atoms in the observable universe."); }
        return "";
    }

    // How many failed unlocks there were on this computer before the right one, and since
    // when (notice 124).
    public pure function failed-unlocks(count: int, since: string) -> string {
        if (count == 1) { return @tr("One failed try to unlock this vault on this computer since {}. If it wasn't you, someone may be guessing your master password.", since); }
        return @tr("{} failed tries to unlock this vault on this computer since {}. If they weren't yours, someone may be guessing your master password.", count, since);
    }

    public pure function notice(code: int, arg: string) -> string {
        if (code == 1) { return @tr("Password copied. The clipboard clears in {} seconds.", arg); }
        if (code == 2) { return @tr("Username copied."); }
        if (code == 3) { return @tr("Code copied. The clipboard clears in {} seconds.", arg); }
        if (code == 4) { return @tr("Clipboard cleared."); }
        if (code == 5) { return @tr("Saved."); }
        if (code == 6) { return @tr("Deleted {}.", arg); }
        if (code == 7) { return @tr("Master password changed."); }
        if (code == 8) { return @tr("New recovery parts issued. The old ones no longer work: print the new kit now."); }
        if (code == 60) { return @tr("Part C is hidden in {}. It was read back to check. Keep that file as it is: a resized or converted copy loses the part.", arg); }
        if (code == 61) { return @tr("Part {} read from the picture.", arg); }
        if (code == 62) { return @tr("The main sync server isn't answering ({}). The vault keeps syncing through the backup server.", arg); }
        if (code == 63) { return @tr("The main sync server answers again and has caught up."); }
        if (code == 64) { return @tr("The backup sync server isn't answering ({}). The vault keeps syncing through the main one.", arg); }
        if (code == 65) { return @tr("The backup sync server answers again and has caught up."); }
        if (code == 66) { return @tr("This computer joined the backup server. The vault syncs through both from now on."); }
        if (code == 70) { return @tr("The new address answers with this vault: it is the one used from now on."); }
        if (code == 68) { return @tr("A passkey for “{}” was saved from the browser.", arg); }
        if (code == 69) { return @tr("Signed in with the passkey of “{}” in the browser.", arg); }
        if (code == 67) { return @tr("{} of your passwords turned up in a data breach since the last check. See Password health and change them where you use them.", arg); }
        if (code == 9) { return @tr("Settings saved."); }
        if (code == 10) { return @tr("Copied. The clipboard clears in {} seconds.", arg); }
        if (code == 11) { return @tr("Generated password copied. The clipboard clears in {} seconds.", arg); }
        if (code == 12) { return @tr("Windows Hello is on. Next time, unlock with your face, fingerprint or PIN."); }
        if (code == 13) { return @tr("Windows Hello is off for this vault."); }
        if (code == 14) { return @tr("Windows Hello wasn't turned on: {}.", arg); }
        if (code == 15) { return @tr("Master password changed. Windows Hello was turned off; turn it on again below."); }
        if (code == 16) { return arg == "1" ? @tr("Kit opened for printing: type the PDF password to open it. The file is wiped when the vault locks.") : @tr("Kit opened for printing. The file is wiped when the vault locks."); }
        if (code == 19) { return @tr("Imported {} items.", arg); }
        if (code == 20) { return @tr("Backup confirmed: {}. It was read back, matches the vault file and opens with this vault's key.", arg); }
        if (code == 21) { return @tr("Exported to {}. It isn't encrypted: delete it once it's imported elsewhere.", arg); }
        if (code == 22) { return @tr("The export file was overwritten and deleted."); }
        if (code == 23) { return arg == "" ? @tr("Not saved: the vault file was changed outside this window. Lock and unlock to load the newest version.") : @tr("Not saved: {}", arg); }
        if (code == 18) { return @tr("Recovery code copied. Mark it as used once you've signed in. The clipboard clears in {} seconds.", arg); }
        if (code == 17) { return @tr("Kit saved to {}. Keep the file private, or delete it once printed.", arg); }
        if (code == 24) { return @tr("Password history cleared."); }
        if (code == 25) { return @tr("Old password copied. The clipboard clears in {} seconds.", arg); }
        if (code == 26) { return @tr("Vault settings saved."); }
        if (code == 27) { return @tr("Word list added: {}.", arg); }
        if (code == 28) { return arg == "0" ? @tr("Leak check done: none of your passwords is in a known breach.") : @tr("Leak check done: {} found in known breaches. Change them first.", arg); }
        if (code == 29) { return @tr("Opened {}. Export the passwords as CSV there, then choose the file here.", arg); }
        if (code == 30) { return @tr("Unlock protection changed. Unlocking now takes about {} s on this computer.", arg); }
        if (code == 31) { return @tr("Unlock protection changed (about {} s per unlock here). Windows Hello was turned off: turn it on again in Settings.", arg); }
        if (code == 32) { return @tr("Folder deleted. Its items are still in All items."); }
        if (code == 33) { return @tr("Website copied."); }
        if (code == 34) { return @tr("Couldn't open {} in a browser.", arg); }
        if (code == 35) { return @tr("Keyfile set: the vault now needs {} together with your master password. Keep a copy somewhere safe. Windows Hello, if it was on, is off until you turn it on again.", arg); }
        if (code == 36) { return @tr("The vault no longer needs a keyfile. Windows Hello, if it was on, is off until you turn it on again."); }
        if (code == 37) { return @tr("Item lock saved."); }
        if (code == 38) { return @tr("Too many wrong tries: the vault locked itself. Unlock it with your master password."); }
        if (code == 39) { return @tr("Secrets locked again."); }
        if (code == 40) { return @tr("“{}” was handed to the browser extension.", arg); }
        if (code == 41) { return @tr("Browser extension connected."); }
        if (code == 42) { return @tr("Browser extension disconnected. It has to ask again to connect."); }
        if (code == 43) { return @tr("Saved “{}” from the browser.", arg); }
        if (code == 44) { return @tr("History of generated passwords cleared."); }
        if (code == 46) { return arg == "1" ? @tr("A login saved from the browser while the vault was locked is in your vault now.") : @tr("{} logins saved from the browser while the vault was locked are in your vault now.", arg); }
        if (code == 45) { return @tr("The browser extension can now fill with Windows Hello while the vault is locked."); }
        if (code == 47) { return @tr("This computer's record of the newest version of each vault couldn't be read, so it started again (the old file was kept as state.json.unreadable). An older copy of a vault is noticed again once its newest version has been opened here."); }
        if (code == 49) { return arg == "1" ? @tr("Leak check: one locked login wasn't checked, because the item lock keeps its password closed. None of the others is in a known breach. Open the item lock, then check again.") : @tr("Leak check: {} locked logins weren't checked, because the item lock keeps their passwords closed. None of the others is in a known breach. Open the item lock, then check again.", arg); }
        if (code == 50) { return @tr("Leak check done: {} found in known breaches. Change them first. Locked logins weren't checked: open the item lock, then check again.", arg); }
        if (code == 52) { return @tr("Synced: {} changes came from your other devices.", arg); }
        if (code == 53) { return @tr("{} items were changed here and on another device. The newer version was kept, and the other password is in each item's history.", arg); }
        if (code == 54) { return @tr("{} items were changed here and on another device, behind the item lock. Open the item lock to keep both passwords; until then this computer keeps its own version.", arg); }
        if (code == 55) { return @tr("The master password, keyfile or Recovery Key was changed on another device. Use that one the next time you unlock."); }
        if (code == 56 && arg == "") { return @tr("A copy from a device not in this vault's list was not used. It may be an older copy put back, or come from a device that was removed."); }
        if (code == 56) { return @tr("The copy from {} was not used. It may be an older copy put back, or come from a device that was removed. Settings → Sync says why.", arg); }
        if (code == 134 && arg == "") { return @tr("A copy from a device not in this vault's list couldn't be read."); }
        if (code == 134) { return @tr("The copy from {} couldn't be read. Settings → Sync says why.", arg); }
        if (code == 58) { return @tr("This computer joined the server. The vault syncs through it from now on."); }
        if (code == 59) { return @tr("{} was removed. Every device refuses its copies from its next sync; it keeps only what it already had, which opens only with your master password and Secret Key.", arg); }
        if (code == 57) { return @tr("This computer was removed from the vault on another device, so it no longer syncs."); }
        if (code == 51) { return @tr("Updated the password of “{}” from the browser. The old one is in its history.", arg); }
        if (code == 48) { return @tr("This computer couldn't record the vault's newest version ({}), so an older copy put in its place may not be noticed.", arg); }
        if (code == 80) { return @tr("The item lock was changed on another device. A locked item, or Settings → Item lock, says what to type here: until then, this computer keeps its own lock, and some changes from that device wait."); }
        if (code == 81) { return @tr("The item lock changed on another device is in use here now. Locked items closed again: they open with its PIN or password."); }
        if (code == 82) { return @tr("The vault locked before the item lock was saved, so it was not changed. Windows Hello for locked items, if it was being set up, is off until the item lock is saved again."); }
        if (code == 83) { return @tr("Filling while the vault is locked needs setting up again after this update: open a locked item with Windows Hello once, or turn the option off and on in Settings → Browser extension."); }
        if (code == 84) { return arg == "1" ? @tr("A login saved from the browser while the vault was locked waits for the item lock: a locked login for that site has the same username. Open the item lock to add its new password.") : @tr("{} logins saved from the browser while the vault was locked wait for the item lock: locked logins for those sites have the same usernames. Open the item lock to add their new passwords.", arg); }
        if (code == 85) { return arg == "1" ? @tr("The vault key was renewed: the old kit, the old Secret Key and older copies of the file no longer open it. Print the new kit now. Windows Hello is off until you turn it on again.") : @tr("The vault key was renewed: the old kit, the old Secret Key and older copies of the file no longer open it. Print the new kit now."); }
        if (code == 86) { return arg == "1" ? @tr("This computer uses the renewed vault key now and syncs again. Windows Hello is off until you turn it on again.") : @tr("This computer uses the renewed vault key now and syncs again."); }
        if (code == 87) { return @tr("The vault key was renewed on another device. Settings → Sync asks once for the new Secret Key, from the new emergency kit."); }
        if (code == 89) { return @tr("Version {} of Vault is out: the download button in the title bar, or Settings → About, installs it.", arg); }
        if (code == 130) { return @tr("Vault can't replace itself in {}: that folder can't be written. Download the new version from its release page (the download button in the title bar has it).", arg); }
        if (code == 131) { return @tr("The new version is in place but couldn't be started ({}). Start Vault again.", arg); }
        if (code == 90) { return @tr("Windows now starts this copy of Vault when you sign in, instead of {}.", arg); }
        if (code == 91) { return @tr("{} recovery parts saved, each in a file of its own. Keep them in different places.", arg); }
        if (code == 92) { return @tr("Another program changed how the browser reaches Vault. Vault put it back and ignored that request. If you didn't install something like that, check this computer."); }
        if (code == 97) { return @tr("Another program changed the browser extension's files. Vault put them back: restart the browser so it runs them as Vault wrote them. If you didn't install something like that, check this computer."); }
        if (code == 99) { return @tr("Vault didn't take the browser extension of GitHub's release {}. It keeps the one it has.", arg); }
        if (code == 98) { return @tr("Vault couldn't check the browser extension's files ({}). It tries again in a few minutes; if this keeps coming back, restart the browser, then Vault.", arg); }
        if (code == 88) { return @tr("The vault key was renewed, but the vault locked before the new kit showed. Open Emergency kit and issue new recovery parts: the ones made then can't be shown again."); }
        if (code == 144) { return @tr("A strong password for “{}” is ready, and the site's page for changing it is open. On its new-password field the browser extension offers that password; after you send the form, it offers to update the login here.", arg); }
        if (code == 145) { return @tr("The site's page for changing the password of “{}” is open. Turn on the browser extension (Settings → Browser extension) and it offers a strong password there and updates the login; or edit the login here after you change it.", arg); }
        if (code == 142) { return @tr("A site said something about a passkey of “{}”: its page shows what, and lets you decide.", arg); }
        if (code == 143) { return @tr("Open the item's secrets first (the item lock), then decide."); }
        if (code == 140) { return @tr("The browser extension changed the rules for {}. Settings → Browser extension → Site rules shows them.", arg); }
        if (code == 141) { return @tr("Rules for {} added: choose what the extension doesn't do there.", arg); }
        if (code == 123) { return @tr("PDF password copied. The clipboard clears in {} seconds.", arg); }
        if (code == 125) { return @tr("“{}” is in the trash. It is deleted for good after 30 days; until then, Trash brings it back.", arg); }
        if (code == 126) { return @tr("“{}” is back from the trash.", arg); }
        if (code == 127) { return @tr("“{}” is archived: kept, out of search, filling and health. Archive lists it.", arg); }
        if (code == 128) { return @tr("“{}” is out of the archive.", arg); }
        if (code == 129) { return @tr("The earlier version of “{}” is back; the one it replaced is kept among its earlier versions.", arg); }
        if (code == 132) { return arg != "" ? @tr("{} syncs with a newer version of Vault, so its copy can't be used here. Update this app: Settings → About → Check for updates.", arg) : @tr("A device syncs with a newer version of Vault, so its copy can't be used here. Update this app: Settings → About → Check for updates."); }
        if (code == 133) { return arg != "" ? @tr("{} still runs an older version of Vault, so its copy can't be used here. Update Vault on that device; it syncs again once it is updated.", arg) : @tr("A device still runs an older version of Vault, so its copy can't be used here. Update Vault on that device; it syncs again once it is updated."); }
        if (code == 150) { return @tr("The SSH key “{}” signed for a program.", arg); }
        if (code == 152) { return @tr("Typed into “{}”.", arg); }
        if (code == 153) { return @tr("Auto-type stopped: “{}” changed or another window took the keyboard. Nothing more was typed.", arg); }
        if (code == 154) { return @tr("Auto-type stopped: Ctrl, Alt, Shift or the Windows key was held. Let go and try again."); }
        if (code == 155) { return @tr("Windows refused the typed keys for “{}”.", arg); }
        if (code == 151) { return @tr("SSH_AUTH_SOCK copied: set it as an environment variable for your user, then open a new terminal."); }
        if (code == 120) { return @tr("The Secret Key couldn't be kept on this computer just now ({}). The vault is open; if the next unlock asks for the Secret Key, type it from your emergency kit.", arg); }
        if (code == 121) { return @tr("Vault {} has already opened this vault on this computer, and this copy is older. If you didn't go back to an older version yourself, someone may have put back an old one with a known fault: get the newest in Settings → About → Check for updates.", arg); }
        if (code == 122) { return @tr("The browser extension is older than this Vault accepts (it needs {} or later), so Vault doesn't answer it. Settings → Browser extension → Add to a browser writes the newest one into its folder; then reload it on the browser's extensions page.", arg); }
        return "";
    }

    // One more entry of a list: "a, b".
    pure function listed(list: string, entry: string) -> string {
        return entry == "" ? list : list == "" ? entry : list + ", " + entry;
    }
    // What an export leaves out, as a list ("" = nothing).
    public pure function export-left-out(c: ExportCounts) -> string {
        let files = c.attachments > 0 ? @tr("{n} attached file" | "{n} attached files" % c.attachments) : "";
        let passkeys = root.listed(files, c.passkeys > 0 ? @tr("{n} passkey" | "{n} passkeys" % c.passkeys) : "");
        let earlier = root.listed(passkeys, c.earlier-passwords > 0 ? @tr("{n} earlier password" | "{n} earlier passwords" % c.earlier-passwords) : "");
        let websites = root.listed(earlier, c.extra-websites > 0 ? @tr("{n} website after an item's first" | "{n} websites after an item's first" % c.extra-websites) : "");
        return root.listed(websites, c.dates ? @tr("the dates of the items") : "");
    }
    // What it keeps in another form.
    public pure function export-changed(c: ExportCounts) -> string {
        let marks = c.hidden-marks > 0 ? @tr("{n} hidden field not marked hidden" | "{n} hidden fields not marked hidden" % c.hidden-marks) : "";
        let codes = root.listed(marks, c.recovery-code-lists > 0 ? @tr("{n} list of recovery codes as text" | "{n} lists of recovery codes as text" % c.recovery-code-lists) : "");
        return root.listed(codes, c.kinds-changed > 0 ? @tr("{n} item as another kind" | "{n} items as another kind" % c.kinds-changed) : "");
    }
    // What it writes as plain text.
    public pure function export-readable(c: ExportCounts) -> string {
        let passwords = c.passwords > 0 ? @tr("{n} password" | "{n} passwords" % c.passwords) : "";
        let secrets = root.listed(passwords, c.otp-secrets > 0 ? @tr("{n} one-time code secret" | "{n} one-time code secrets" % c.otp-secrets) : "");
        let fields = root.listed(secrets, c.hidden-fields > 0 ? @tr("{n} hidden field" | "{n} hidden fields" % c.hidden-fields) : "");
        let codes = root.listed(fields, c.recovery-codes > 0 ? @tr("{n} recovery code" | "{n} recovery codes" % c.recovery-codes) : "");
        let notes = root.listed(codes, c.notes > 0 ? @tr("the notes of {n} item" | "the notes of {n} items" % c.notes) : "");
        return root.listed(notes, c.readable-passkeys > 0 ? @tr("{n} passkey with its private key, which signs in without a password" | "{n} passkeys with their private keys, which sign in without a password" % c.readable-passkeys) : "");
    }
    // All of it, a paragraph each, as the export dialog shows it before anything is written.
    public pure function export-notes(c: ExportCounts) -> string {
        let left-out = root.export-left-out(c);
        let changed = root.export-changed(c);
        let readable = root.export-readable(c);
        let missing = left-out == "" ? "" : @tr("Not in this file: {}.", left-out);
        let kept = changed == "" ? missing : missing + (missing == "" ? "" : "\n") + @tr("In another form: {}.", changed);
        let plain = readable == "" ? kept : kept + (kept == "" ? "" : "\n") + @tr("Readable by anyone with this file: {}.", readable);
        return c.formula-like == 0 ? plain : plain + (plain == "" ? "" : "\n")
            + @tr("Don't open this file in a spreadsheet: {n} password or code secret starts like a formula, and a spreadsheet may run it." | "Don't open this file in a spreadsheet: {n} passwords or code secrets start like a formula, and a spreadsheet may run them." % c.formula-like);
    }

    // What to type while a newer item lock waits from another device (ItemLock.waiting).
    public pure function guard-waiting(waiting: int) -> string {
        if (waiting == 1) { return @tr("The item lock was changed on another device. To move the locked items to it, type its new PIN here, and the PIN or password this computer asked for until now (either one first)."); }
        if (waiting == 2) { return @tr("The item lock was changed on another device. To move the locked items to it, type its new password here, and the PIN or password this computer asked for until now (either one first)."); }
        if (waiting == 3) { return @tr("The item lock was turned off, or changed to the master password, on another device. Open the item lock here once and the locked items follow it."); }
        return "";
    }

    // "3 months ago". unit: 0 today, 1 days, 2 months, 3 years.
    public pure function ago(unit: int, n: int) -> string {
        if (unit == 0) { return @tr("today"); }
        if (unit == 1) { return @tr("{n} day ago" | "{n} days ago" % n); }
        if (unit == 2) { return @tr("{n} month ago" | "{n} months ago" % n); }
        return @tr("{n} year ago" | "{n} years ago" % n);
    }

    // Why a password is easy to guess (codes from the strength estimator, see view.rs).
    public pure function weakness(code: int) -> string {
        if (code == 1) { return @tr("Keyboard patterns like qwerty are among the first guesses."); }
        if (code == 2) { return @tr("Repeats like aaa or abcabc are easy to guess."); }
        if (code == 3) { return @tr("This is one of the most used passwords."); }
        if (code == 4) { return @tr("This is a common password with small changes."); }
        if (code == 5) { return @tr("Sequences like abc or 1234 are easy to guess."); }
        if (code == 6) { return @tr("Dates and years are easy to guess."); }
        if (code == 7) { return @tr("A single word is easy to guess."); }
        if (code == 8) { return @tr("Names and surnames are easy to guess."); }
        if (code == 9) { return @tr("Too short and predictable."); }
        return "";
    }
}
