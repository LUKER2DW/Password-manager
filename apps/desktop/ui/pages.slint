// Right-hand pages of the vault: item detail, editor, generator, settings.

import { ScrollView } from "std-widgets.slint";
import { Theme, Sketch } from "theme.slint";
import { DetailField, FileRow, PasskeyRow, CodeRow, AuthRow, EditField, HistoryRow, VersionRow, GeneratedRow, HealthRow, ImportRow, SourceRow, DeviceLine, ExtensionBrowser, Messages, ItemLock, SecurityLine } from "model.slint";
import { FieldIcon, Glyph, BrandMark, FieldColors, SourceMark, SourcePicker, IconLook, FolderLook } from "icons.slint";
import { Button, QuietButton, EyeButton, LineField, NotesField, SecretField, Check, Stepper, Choice, Rule, Hint, ItemIcon, Slider, Dropdown } from "widgets.slint";
import { KitSlip, PdfPassword } from "kit.slint";
import { StrengthMeter } from "strength.slint";
import { VaultMark } from "vault.slint";

component PageTitle inherits Text {
    font-size: Theme.headline;
    font-weight: 300;
    color: Theme.ink;
    wrap: word-wrap;
}

component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> hint;
    spacing: 8px;
    alignment: start;
    Text {
        text: root.text;
        font-size: Theme.lead;
        font-weight: 600;
        color: Theme.ink;
        vertical-alignment: center;
    }
    if root.hint != "": VerticalLayout {
        alignment: center;
        Hint { text: root.hint; }
    }
}

component Prose inherits Text {
    font-size: Theme.body;
    color: Theme.graphite;
    wrap: word-wrap;
}

component ErrorText inherits Text {
    in property <int> code;
    in property <string> detail;
    text: Messages.error(root.code, root.detail);
    visible: root.code != 0;
    // Takes no space when there is nothing to say.
    height: root.code != 0 ? self.preferred-height : 0px;
    font-size: Theme.body;
    color: Theme.seal;
    wrap: word-wrap;
}

// One labelled value on the item page, with its actions on the right.
component FieldRow inherits VerticalLayout {
    in property <string> label;
    // Icon name from icons.slint ("key", "user"…).
    in property <string> icon: "tag";
    in property <string> hint;
    in property <string> value;
    in property <bool> mono: false;
    in property <bool> large: false;
    // Shown in red (an expired card, for example).
    in property <bool> warning: false;
    // A website: the value is a link that opens in the browser.
    in property <bool> link: false;
    // A secret (a password, a code, a sensitive field): drawn, but kept out of the
    // accessibility tree, which any program of this user can read through UI Automation.
    in property <bool> secret: false;
    callback activated();
    spacing: 0px;
    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        HorizontalLayout {
            width: 186px;
            spacing: 10px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                FieldIcon { name: root.icon; size: 26px; }
            }
            Text {
                text: root.label;
                font-size: Theme.body;
                color: Theme.graphite;
                vertical-alignment: center;
            }
            if root.hint != "": VerticalLayout {
                alignment: center;
                Hint { text: root.hint; }
            }
        }
        if !root.link: Text {
            horizontal-stretch: 1;
            text: root.value;
            accessible-label: root.secret ? @tr("{}: shown on screen, not read aloud", root.label) : root.value;
            font-family: root.mono ? Theme.mono-font : Theme.ui-font;
            font-size: root.large ? Theme.title : Theme.body;
            color: root.warning ? Theme.seal : Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.link: Rectangle {
            horizontal-stretch: 1;
            link-text := Text {
                x: 0;
                width: Math.min(self.preferred-width, parent.width);
                text: root.value;
                font-size: Theme.body;
                color: link-touch.has-hover ? Theme.accent-stroke : Theme.ink;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: button;
                accessible-label: root.value;
            }
            Rectangle {
                x: 0;
                y: parent.height / 2 + 10px;
                width: link-text.width;
                height: 1px;
                background: link-touch.has-hover ? Theme.accent-stroke : Theme.rule;
            }
            link-touch := TouchArea {
                x: 0;
                width: link-text.width;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.activated(); }
            }
        }
        @children
    }
    Rule { }
}

// Where the item lock's PIN, password or master password is typed. One right answer opens
// every locked item until they are locked again.
component LockBox inherits Rectangle {
    in property <int> check;
    in property <string> text;
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    // Windows Hello can open the lock too.
    in property <bool> hello;
    callback unlock();
    callback unlock-hello();
    border-radius: Theme.radius + 2px;
    border-width: 1px;
    border-color: Theme.rule;
    background: Theme.panel;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                FieldIcon { name: "lock"; size: 26px; }
            }
            Text {
                text: @tr("Secrets locked");
                font-size: Theme.lead;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.text;
            font-size: Theme.small;
            color: Theme.graphite;
            wrap: word-wrap;
        }
        // A newer item lock from another device waits: what to type for the move. Written
        // out (not under an `if`), so the box measures its wrapped lines.
        Text {
            text: Messages.guard-waiting(ItemLock.waiting);
            visible: ItemLock.waiting != 0;
            height: ItemLock.waiting != 0 ? self.preferred-height : 0px;
            font-size: Theme.small;
            color: Theme.ink;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            SecretField {
                width: root.check == 1 ? 180px : 320px;
                field: 11;
                eye: true;
                placeholder: root.check == 1 ? @tr("PIN") : root.check == 2 ? @tr("Item password") : @tr("Master password");
                error: root.error-code == 35;
                accepted => { root.unlock(); }
                init => { self.focus(); }
            }
            Button {
                text: @tr("Unlock");
                busy-text: @tr("Checking…");
                busy: root.busy;
                clicked => { root.unlock(); }
            }
            if root.hello: VerticalLayout {
                alignment: center;
                QuietButton {
                    outlined: true;
                    text: @tr("Use Windows Hello");
                    enabled: !root.busy;
                    clicked => { root.unlock-hello(); }
                }
            }
        }
        if root.error-code != 0: Text {
            text: Messages.error(root.error-code, root.error-detail);
            font-size: Theme.small;
            color: Theme.seal;
            wrap: word-wrap;
        }
    }
}

export component DetailPage inherits Rectangle {
    in property <bool> has-item;
    in property <string> title;
    in property <int> kind;
    in property <bool> favorite;
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> initial;
    in property <color> tint;
    // A line icon chosen for the item, and its colours (IconLook).
    in property <string> glyph;
    in property <int> glyph-color;
    in property <int> glyph-bg;
    in property <string> username;
    in property <bool> has-password;
    in property <string> revealed-password;
    in property <int> reveal-left;
    in property <string> totp-code;
    in property <int> totp-left;
    in property <[string]> urls;
    in property <string> notes;
    in property <[DetailField]> fields;
    // Files attached to the item (none while it is locked).
    in property <[FileRow]> files;
    callback file-save(int);
    // The login's passkeys (who and where show while it is locked too).
    in property <[PasskeyRow]> passkeys;
    in property <string> folder;
    in property <int> codes-total;
    in property <int> codes-left;
    // Filled only while the codes are shown.
    in property <[CodeRow]> codes;
    in-out property <bool> notes-shown;
    in-out property <bool> confirming-delete;
    in property <int> brand;
    in property <bool> username-is-email;
    // Password health, shown under the password.
    in property <int> strength-bits;
    in property <int> strength-score;
    in property <int> weakness;
    in property <int> reused-by;
    in property <int> age-unit;
    in property <int> age-amount;
    // Earlier passwords: count always, rows only while shown.
    in property <int> history-count;
    in property <[HistoryRow]> history;
    in property <bool> history-shown;
    callback show-history();
    callback hide-history();
    callback reveal-history(int);
    callback copy-history(int);
    callback clear-history();
    callback edit();
    callback toggle-favorite();
    // Puts the item in the trash (`delete-for-good` deletes one already there).
    callback delete();
    // Format v11: the trash, the archive, templates, tags, expiry, earlier versions.
    in property <bool> trashed;
    in property <bool> archived;
    in property <bool> template;
    in property <bool> no-browser;
    in property <string> tags;
    in property <string> expires;
    in property <bool> expired;
    in property <[VersionRow]> versions;
    in-out property <bool> versions-shown;
    callback restore-item();
    callback delete-for-good();
    callback toggle-archive();
    callback new-from-template();
    callback restore-version(int);
    callback reveal();
    callback conceal();
    callback copy-username();
    callback copy-password();
    callback copy-totp();
    callback copy-field(int);
    callback show-codes();
    callback hide-codes();
    callback copy-code(int);
    callback toggle-code-used(int);
    // One hidden extra field (card number, security code, a hidden field) shown on request.
    in property <int> revealed-field: -1;
    in property <string> revealed-field-value;
    callback reveal-field(int);
    callback open-url(int);
    callback copy-url(int);
    // The item's secrets (password, codes, hidden fields) wait for a check; `check` says which:
    // 0 the master password, 1 a PIN, 2 another password.
    in property <bool> locked;
    in property <int> check;
    // The item is guarded and its secrets are open now: offer to lock them again.
    in property <bool> guarded-open;
    in property <bool> hello;
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    callback unlock-item();
    callback unlock-item-hello();
    callback lock-secrets();

    if !root.has-item: VerticalLayout {
        padding: 48px;
        alignment: start;
        Prose {
            text: @tr("Pick an item on the left, or add a new one.");
        }
    }

    if root.has-item: ScrollView {
        // No sideways scrolling: the page is as wide as the window, and what it holds wraps.
        content-width: self.visible-width;
        VerticalLayout {
            padding: 44px;
            padding-right: 48px;
            spacing: 0px;
            alignment: start;

            HorizontalLayout {
                padding-bottom: 22px;
                spacing: 16px;
                VerticalLayout {
                    alignment: center;
                    if root.glyph != "" || root.kind != 1 || root.brand == 0: ItemIcon {
                        size: 48px;
                        icon: root.icon;
                        has-icon: root.has-icon;
                        initial: root.initial;
                        tint: root.tint;
                        kind: root.kind;
                        glyph: root.glyph;
                        glyph-color: root.glyph-color;
                        glyph-bg: root.glyph-bg;
                    }
                    if root.glyph == "" && root.kind == 1 && root.brand != 0: BrandMark {
                        brand: root.brand;
                        size: 64px;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    alignment: center;
                    PageTitle { text: root.title; }
                    Text {
                        text: root.folder != ""
                            ? @tr("{} · in {}", Messages.kind-name(root.kind), root.folder)
                            : Messages.kind-name(root.kind);
                        font-size: Theme.small;
                        color: Theme.graphite;
                    }
                    if root.trashed || root.archived || root.template || root.no-browser: Text {
                        text: root.trashed ? @tr("In the trash: deleted for good 30 days after it was put there.")
                            : root.archived ? @tr("Archived: kept, but out of search, filling and health.")
                            : root.template ? @tr("A template: new items can start from it.")
                            : @tr("Kept out of the browser.");
                        font-size: Theme.small;
                        color: root.trashed ? Theme.seal : Theme.graphite;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: start;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: Theme.radius;
                        background: star-touch.has-hover ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: root.favorite ? @tr("Remove from favorites") : @tr("Add to favorites");
                        Path {
                            width: 20px;
                            height: 20px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Sketch.star;
                            stroke: root.favorite ? Theme.accent-stroke : Theme.graphite;
                            stroke-width: 1.5px;
                            fill: transparent;
                        }
                        star-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-favorite(); }
                        }
                    }
                }
            }
            Rule { }

            if root.username != "": FieldRow {
                label: root.kind == 1 ? @tr("Name on card") : root.username-is-email ? @tr("Email") : @tr("Username");
                icon: root.username-is-email ? "mail" : "user";
                value: root.username;
                QuietButton {
                    text: @tr("Copy");
                    clicked => { root.copy-username(); }
                }
            }

            if root.locked: VerticalLayout {
                padding-top: 14px;
                padding-bottom: 14px;
                LockBox {
                    check: root.check;
                    text: root.check == 1 ? @tr("The password, codes and hidden fields of this item open with your PIN. One right PIN opens every locked item for 5 minutes.")
                        : root.check == 2 ? @tr("The password, codes and hidden fields of this item open with your item password. It opens every locked item for 5 minutes.")
                        : @tr("The password, codes and hidden fields of this item open with your master password. It opens every locked item for 5 minutes.");
                    busy: root.busy;
                    error-code: root.error-code;
                    error-detail: root.error-detail;
                    hello: root.hello;
                    unlock-hello => { root.unlock-item-hello(); }
                    unlock => { root.unlock-item(); }
                }
            }

            if root.has-password: FieldRow {
                label: root.kind == 1 ? @tr("PIN") : root.kind == 4 ? @tr("Private key") : @tr("Password");
                icon: root.kind == 1 ? "pin" : root.kind == 4 ? "terminal" : "key";
                value: root.revealed-password != "" ? root.revealed-password : "••••••••••••";
                secret: true;
                mono: root.revealed-password != "";
                if root.revealed-password != "": Text {
                    text: @tr("hides in {} s", root.reveal-left);
                    font-size: Theme.small;
                    color: Theme.faint;
                    vertical-alignment: center;
                }
                EyeButton {
                    open: root.revealed-password != "";
                    clicked => {
                        if (root.revealed-password != "") { root.conceal(); } else { root.reveal(); }
                    }
                }
                QuietButton {
                    text: @tr("Copy");
                    clicked => { root.copy-password(); }
                }
            }
            // How safe the password is, and when it last changed.
            if root.has-password && root.kind == 0: HorizontalLayout {
                padding-top: 2px;
                padding-bottom: 12px;
                padding-left: 198px;
                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        height: 18px;
                        HorizontalLayout {
                            spacing: 3px;
                            for i in 4: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 22px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: i < Math.max(1, root.strength-score)
                                        ? (root.strength-score >= 4 ? Theme.good : root.strength-score >= 3 ? Theme.marker : Theme.seal)
                                        : Theme.rule;
                                }
                            }
                        }
                        Text {
                            text: root.strength-score >= 4 ? @tr("Strong")
                                : root.strength-score == 3 ? @tr("Good")
                                : root.strength-score == 2 ? @tr("Weak")
                                : @tr("Very weak");
                            font-size: Theme.small;
                            color: root.strength-score >= 3 ? Theme.graphite : Theme.seal;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "·";
                            font-size: Theme.small;
                            color: Theme.faint;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.age-unit < 0 ? "" : @tr("changed {}", Messages.ago(root.age-unit, root.age-amount));
                            font-size: Theme.small;
                            color: Theme.faint;
                            vertical-alignment: center;
                        }
                    }
                    if root.weakness != 0: Text {
                        text: Messages.weakness(root.weakness);
                        font-size: Theme.small;
                        color: Theme.seal;
                        wrap: word-wrap;
                    }
                    if root.reused-by > 0: Text {
                        text: @tr("Also used by {n} other item: a leak at one site opens both." | "Also used by {n} other items: a leak at one site opens them all." % root.reused-by);
                        font-size: Theme.small;
                        color: Theme.seal;
                        wrap: word-wrap;
                    }
                }
            }
            if root.history-count > 0: FieldRow {
                label: @tr("Password history");
                icon: "history";
                value: @tr("{n} earlier password" | "{n} earlier passwords" % root.history-count);
                EyeButton {
                    open: root.history-shown;
                    clicked => {
                        if (root.history-shown) { root.hide-history(); } else { root.show-history(); }
                    }
                }
            }
            if root.history-shown: VerticalLayout {
                padding-top: 6px;
                padding-bottom: 10px;
                spacing: 2px;
                for entry[index] in root.history: Rectangle {
                    height: 36px;
                    border-radius: Theme.radius;
                    background: entry-touch.has-hover ? Theme.hover : transparent;
                    entry-touch := TouchArea { }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 4px;
                        spacing: 10px;
                        Text {
                            width: 176px;
                            text: entry.date;
                            font-size: Theme.small;
                            color: Theme.graphite;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: entry.password != "" ? entry.password : "••••••••••••";
                            font-family: entry.password != "" ? Theme.mono-font : Theme.ui-font;
                            font-size: Theme.body;
                            color: Theme.ink;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        EyeButton {
                            open: entry.password != "";
                            tint: Theme.graphite;
                            clicked => { root.reveal-history(index); }
                        }
                        QuietButton {
                            text: @tr("Copy");
                            clicked => { root.copy-history(index); }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    padding-top: 4px;
                    QuietButton {
                        text: @tr("Clear history");
                        tint: Theme.seal;
                        clicked => { root.clear-history(); }
                    }
                }
            }

            if root.totp-code != "": FieldRow {
                label: @tr("One-time code");
                icon: "clock";
                hint: @tr("The code for two-step sign-in, made from the secret saved in this item. It changes every 30 seconds.");
                value: root.totp-code;
                secret: true;
                mono: true;
                large: true;
                Text {
                    text: @tr("{} s", root.totp-left);
                    font-size: Theme.small;
                    color: root.totp-left <= 5 ? Theme.seal : Theme.faint;
                    vertical-alignment: center;
                }
                QuietButton {
                    text: @tr("Copy");
                    clicked => { root.copy-totp(); }
                }
            }

            for url[index] in root.urls: FieldRow {
                label: @tr("Website");
                icon: "globe";
                value: url;
                link: true;
                activated => { root.open-url(index); }
                QuietButton {
                    text: @tr("Open");
                    clicked => { root.open-url(index); }
                }
                QuietButton {
                    text: @tr("Copy");
                    clicked => { root.copy-url(index); }
                }
            }

            for field in root.fields: field-row := FieldRow {
                property <bool> shown: field.index == root.revealed-field && root.revealed-field-value != "";
                label: field.label;
                icon: field.icon;
                value: self.shown ? root.revealed-field-value : field.sensitive ? "••••••••" : field.value;
                secret: field.sensitive;
                mono: self.shown;
                warning: field.warning;
                if field-row.shown: Text {
                    text: @tr("hides in {} s", root.reveal-left);
                    font-size: Theme.small;
                    color: Theme.faint;
                    vertical-alignment: center;
                }
                if field.hideable: EyeButton {
                    open: field-row.shown;
                    clicked => { root.reveal-field(field.index); }
                }
                QuietButton {
                    text: @tr("Copy");
                    clicked => { root.copy-field(field.index); }
                }
            }

            if root.codes-total > 0: FieldRow {
                label: @tr("Recovery codes");
                icon: "list";
                value: root.codes-left == 0
                    ? @tr("All {} used — get new ones from the site", root.codes-total)
                    : @tr("{} of {} left", root.codes-left, root.codes-total);
                EyeButton {
                    open: root.codes.length > 0;
                    clicked => {
                        if (root.codes.length > 0) { root.hide-codes(); } else { root.show-codes(); }
                    }
                }
            }
            if root.codes.length > 0: VerticalLayout {
                padding-top: 6px;
                padding-bottom: 10px;
                spacing: 2px;
                for code[index] in root.codes: Rectangle {
                    height: 36px;
                    border-radius: Theme.radius;
                    background: code-touch.has-hover ? Theme.hover : transparent;
                    code-touch := TouchArea { }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 4px;
                        spacing: 10px;
                        Text {
                            width: 26px;
                            text: index + 1;
                            font-size: Theme.small;
                            color: Theme.faint;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            code-text := Text {
                                x: 0;
                                text: code.code;
                                accessible-label: @tr("Recovery code {}: shown on screen, not read aloud", index + 1);
                                font-family: Theme.mono-font;
                                font-size: Theme.body;
                                color: code.used ? Theme.faint : Theme.ink;
                                vertical-alignment: center;
                            }
                            // Spent codes are struck through.
                            if code.used: Rectangle {
                                x: 0;
                                y: parent.height / 2;
                                width: code-text.preferred-width;
                                height: 1px;
                                background: Theme.faint;
                            }
                        }
                        QuietButton {
                            text: code.used ? @tr("Mark unused") : @tr("Mark used");
                            tint: Theme.graphite;
                            clicked => { root.toggle-code-used(index); }
                        }
                        if !code.used: QuietButton {
                            text: @tr("Copy");
                            clicked => { root.copy-code(index); }
                        }
                    }
                }
            }

            if root.files.length > 0: VerticalLayout {
                spacing: 6px;
                padding-top: 6px;
                Text { text: @tr("Files"); font-size: Theme.small; color: Theme.graphite; }
                for file[index] in root.files: HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Glyph { width: 16px; height: 16px; name: "paperclip"; tint: Theme.graphite; }
                    }
                    Text {
                        text: file.name;
                        font-size: Theme.body;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                    }
                    Text { text: file.size; font-size: Theme.small; color: Theme.graphite; vertical-alignment: center; }
                    QuietButton { text: @tr("Save…"); clicked => { root.file-save(index); } }
                }
            }

            // Passkeys: the browser extension signs in to their site with them.
            if root.passkeys.length > 0: VerticalLayout {
                spacing: 6px;
                padding-top: 6px;
                Text { text: @tr("Passkeys"); font-size: Theme.small; color: Theme.graphite; }
                for passkey in root.passkeys: HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Glyph { width: 16px; height: 16px; name: "key"; tint: Theme.graphite; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: passkey.user != "" ? passkey.user : @tr("No account name");
                            font-size: Theme.body;
                            color: Theme.ink;
                            overflow: elide;
                            min-width: 0px;
                        }
                        Text {
                            text: passkey.site;
                            font-size: Theme.small;
                            color: Theme.graphite;
                            overflow: elide;
                            min-width: 0px;
                        }
                    }
                    Text {
                        text: @tr("Saved {}", passkey.created);
                        font-size: Theme.small;
                        color: Theme.graphite;
                        vertical-alignment: center;
                    }
                }
            }

            // Notes read like every other fact: label on the left, the eye on the right, and
            // the text under the row while it is shown.
            if root.notes != "": FieldRow {
                label: @tr("Notes");
                icon: "note";
                value: root.notes-shown ? "" : @tr("Hidden");
                EyeButton {
                    open: root.notes-shown;
                    clicked => { root.notes-shown = !root.notes-shown; }
                }
            }
            if root.notes != "" && root.notes-shown: VerticalLayout {
                padding-top: 6px;
                padding-bottom: 10px;
                Text {
                    text: root.notes;
                    accessible-label: @tr("Notes: shown on screen, not read aloud");
                    font-size: Theme.body;
                    color: Theme.ink;
                    wrap: word-wrap;
                }
            }

            if root.tags != "": FieldRow {
                label: @tr("Tags");
                icon: "list";
                value: root.tags;
            }
            if root.expires != "": FieldRow {
                label: @tr("Expires");
                icon: "clock";
                value: root.expired ? @tr("{} (expired)", root.expires) : root.expires;
                warning: root.expired;
            }

            // Earlier versions of the whole item, kept on every change (format v11).
            if root.versions.length > 0: FieldRow {
                label: @tr("Earlier versions");
                icon: "history";
                value: @tr("{n} earlier version" | "{n} earlier versions" % root.versions.length);
                EyeButton {
                    open: root.versions-shown;
                    clicked => { root.versions-shown = !root.versions-shown; }
                }
            }
            if root.versions-shown && root.versions.length > 0: VerticalLayout {
                padding-top: 6px;
                padding-bottom: 10px;
                spacing: 2px;
                for version[index] in root.versions: Rectangle {
                    height: 36px;
                    border-radius: Theme.radius;
                    background: version-touch.has-hover ? Theme.hover : transparent;
                    version-touch := TouchArea { }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 4px;
                        spacing: 10px;
                        Text {
                            width: 176px;
                            text: version.date;
                            font-size: Theme.small;
                            color: Theme.graphite;
                            vertical-alignment: center;
                        }
                        // What the next change altered, one word each.
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: @tr("then changed:");
                                font-size: Theme.small;
                                color: Theme.faint;
                                vertical-alignment: center;
                            }
                            for change in version.changes: Text {
                                text: Messages.change-name(change);
                                font-size: Theme.body;
                                color: Theme.ink;
                                vertical-alignment: center;
                            }
                        }
                        QuietButton {
                            text: @tr("Restore");
                            enabled: !root.locked && !root.trashed;
                            clicked => { root.restore-version(index); }
                        }
                    }
                }
            }

            Rectangle { height: 26px; }

            if !root.confirming-delete && !root.trashed: HorizontalLayout {
                alignment: start;
                spacing: 6px;
                if root.guarded-open: QuietButton {
                    outlined: true;
                    text: @tr("Lock");
                    clicked => { root.lock-secrets(); }
                }
                QuietButton {
                    outlined: true;
                    text: @tr("Edit");
                    enabled: !root.locked;
                    clicked => { root.edit(); }
                }
                if root.template: QuietButton {
                    outlined: true;
                    text: @tr("New item from it");
                    clicked => { root.new-from-template(); }
                }
                QuietButton {
                    outlined: true;
                    text: root.archived ? @tr("Take out of the archive") : @tr("Archive");
                    clicked => { root.toggle-archive(); }
                }
                QuietButton {
                    outlined: true;
                    text: @tr("Move to the trash");
                    tint: Theme.seal;
                    enabled: !root.locked;
                    clicked => { root.delete(); }
                }
            }
            if !root.confirming-delete && root.trashed: HorizontalLayout {
                alignment: start;
                spacing: 6px;
                QuietButton {
                    outlined: true;
                    text: @tr("Restore");
                    clicked => { root.restore-item(); }
                }
                QuietButton {
                    outlined: true;
                    text: @tr("Delete for good");
                    tint: Theme.seal;
                    enabled: !root.locked;
                    clicked => { root.confirming-delete = true; }
                }
            }
            if root.confirming-delete: VerticalLayout {
                spacing: 12px;
                Text {
                    text: @tr("Delete “{}” for good? This can't be undone.", root.title);
                    font-size: Theme.body;
                    color: Theme.ink;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Button {
                        text: @tr("Delete for good");
                        danger: true;
                        clicked => { root.delete-for-good(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        QuietButton {
                            text: @tr("Keep it");
                            clicked => { root.confirming-delete = false; }
                        }
                    }
                }
            }
        }
    }
}

// What goes between the words of a passphrase: the usual ones as buttons, and a small box
// for anything else, on one line (the one chosen is outlined).
component SeparatorPicker inherits VerticalLayout {
    in-out property <string> separator;
    callback changed();
    property <bool> preset: root.separator == "-" || root.separator == "." || root.separator == "_" || root.separator == "/" || root.separator == " " || root.separator == "";
    // What is typed in the box (kept apart so a button can empty it).
    property <string> custom;
    init => {
        if (!root.preset) {
            root.custom = root.separator;
        }
    }
    // Set from elsewhere (the other generator, saved options): the box follows.
    changed separator => {
        if (!root.preset && root.custom != root.separator) {
            root.custom = root.separator;
        }
    }
    spacing: 6px;
    Text {
        text: @tr("Between the words");
        font-size: Theme.small;
        color: Theme.graphite;
    }
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for choice in [{ shown: "-", value: "-" }, { shown: ".", value: "." }, { shown: "_", value: "_" }, { shown: "/", value: "/" }, { shown: @tr("space"), value: " " }, { shown: @tr("nothing"), value: "" }]: VerticalLayout {
            alignment: center;
            QuietButton {
                text: choice.shown;
                outlined: root.separator == choice.value;
                clicked => {
                    root.separator = choice.value;
                    root.custom = "";
                    root.changed();
                }
            }
        }
        LineField {
            width: 120px;
            placeholder: @tr("Other…");
            mono: true;
            text <=> root.custom;
            edited(text) => {
                root.separator = text;
                root.changed();
            }
        }
    }
}

// The generator's main options, opened under an item's password by Generate (and under the
// suggested master password of a new vault): characters or words, the length, and what goes
// in. Every change makes a new password at once.
export component QuickGenerator inherits Rectangle {
    in-out property <int> mode;
    in-out property <int> length;
    in-out property <int> words;
    in-out property <bool> lowercase;
    in-out property <bool> uppercase;
    in-out property <bool> digits;
    in-out property <bool> symbols;
    in-out property <bool> avoid-ambiguous;
    in-out property <int> word-case;
    in-out property <bool> number;
    in-out property <string> separator;
    callback changed();
    callback close();

    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.rule;
    background: Theme.panel;
    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            Choice {
                options: [@tr("Random characters"), @tr("Words (passphrase)")];
                selected <=> root.mode;
                changed => { root.changed(); }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                QuietButton {
                    text: @tr("Hide options");
                    tint: Theme.graphite;
                    clicked => { root.close(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 14px;
            Text {
                text: root.mode == 0 ? @tr("Length") : @tr("Words");
                font-size: Theme.body;
                color: Theme.ink;
                vertical-alignment: center;
                width: 64px;
            }
            if root.mode == 0: Slider {
                label: @tr("Length");
                minimum: 8;
                maximum: 64;
                value <=> root.length;
                changed => { root.changed(); }
            }
            if root.mode == 1: Slider {
                label: @tr("Words");
                minimum: 3;
                maximum: 12;
                value <=> root.words;
                changed => { root.changed(); }
            }
            Text {
                text: root.mode == 0 ? root.length : root.words;
                font-size: Theme.lead;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
                horizontal-alignment: right;
                width: 36px;
            }
        }
        if root.mode == 0: HorizontalLayout {
            spacing: 18px;
            alignment: start;
            Check { text: @tr("A–Z"); checked <=> root.uppercase; toggled => { root.changed(); } }
            Check { text: @tr("a–z"); checked <=> root.lowercase; toggled => { root.changed(); } }
            Check { text: @tr("0–9"); checked <=> root.digits; toggled => { root.changed(); } }
            Check { text: @tr("!@#$ symbols"); checked <=> root.symbols; toggled => { root.changed(); } }
            Check { text: @tr("No look-alikes"); checked <=> root.avoid-ambiguous; toggled => { root.changed(); } }
        }
        if root.mode == 1: VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 16px;
                Dropdown {
                    horizontal-stretch: 1;
                    label: @tr("Word case");
                    options: [@tr("lower case"), @tr("UPPER CASE"), @tr("Title Case"), @tr("MIXED case")];
                    selected <=> root.word-case;
                    changed => { root.changed(); }
                }
                VerticalLayout {
                    alignment: end;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        height: Theme.control-height;
                        Check { text: @tr("Add a digit to one word"); checked <=> root.number; toggled => { root.changed(); } }
                    }
                }
            }
            SeparatorPicker {
                separator <=> root.separator;
                changed => { root.changed(); }
            }
        }
        Text {
            text: @tr("More options (extra characters, characters to leave out, your own word lists) are on the Password generator page.");
            font-size: Theme.small;
            color: Theme.faint;
            wrap: word-wrap;
        }
    }
}

export component EditorPage inherits Rectangle {
    in property <bool> is-new;
    // Saving seals this item's secrets and the item lock is closed: its PIN or password is
    // asked here (1 PIN, 2 password).
    in property <bool> needs-check;
    in property <int> check;
    in property <int> error-code;
    in property <string> error-detail;
    in property <string> password-shown;
    in-out property <int> kind;
    in-out property <string> title;
    in-out property <string> username;
    in-out property <string> url;
    // The site's icon for what the Website field says (when icons are on and it was found).
    in property <image> site-icon;
    in property <bool> has-site-icon;
    // A website whose icon stands for this item ("" = the item's own website).
    in-out property <string> icon-url;
    // Or a line icon in colours of its own ("" = automatic); the choices open from a button.
    in-out property <string> glyph;
    in-out property <int> glyph-color;
    in-out property <int> glyph-bg;
    property <bool> icons-open;
    in-out property <string> totp;
    in-out property <string> notes;
    in-out property <bool> favorite;
    in-out property <bool> reprompt;
    // Format v11: tags (comma-separated), an expiry date (YYYY-MM-DD), kept out of the
    // browser, a template.
    in-out property <string> tags;
    in-out property <string> expires;
    in-out property <bool> no-browser;
    in-out property <bool> template;
    // "No folder" first, then every folder; `folder` indexes this list.
    in property <[string]> folder-options;
    in-out property <int> folder;
    in-out property <string> recovery-codes;
    in-out property <string> card-number;
    in-out property <string> card-expiry;
    in-out property <string> card-code;
    in property <string> card-brand;
    in property <int> card-brand-mark;
    in property <[EditField]> fields;
    // An SSH key (kind 4): its private key stays in Rust; the page shows its public half.
    in property <bool> ssh-has-key;
    in property <string> ssh-public;
    in property <string> ssh-fingerprint;
    in property <string> ssh-type;
    in property <bool> ssh-waiting;
    callback ssh-generate();
    callback ssh-load();
    callback ssh-paste();
    callback ssh-open();
    // Files attached to the item.
    in property <[FileRow]> files;
    callback file-add();
    callback file-remove(int);
    // The login's passkeys: one taken out here is gone when the item is saved.
    in property <[PasskeyRow]> passkeys;
    callback passkey-remove(int);
    // Strength of the password being typed (logins only; 0 bits = empty).
    in property <int> strength-bits;
    in property <int> crack-unit;
    in property <int> crack-amount;
    in property <int> weakness;
    callback card-number-edited(string);
    callback field-edited(int, bool, string);  // index, true = name / false = value, text
    callback field-hidden(int, bool);
    callback field-remove(int);
    callback field-add();
    callback save();
    callback cancel();
    callback toggle-show-password();
    callback generate-password();
    // The generator's options, shared with the generator page (opened under the password by
    // Generate).
    in-out property <int> gen-mode;
    in-out property <int> gen-length;
    in-out property <int> gen-words;
    in-out property <bool> gen-lowercase;
    in-out property <bool> gen-uppercase;
    in-out property <bool> gen-digits;
    in-out property <bool> gen-symbols;
    in-out property <bool> gen-avoid-ambiguous;
    in-out property <int> gen-word-case;
    in-out property <bool> gen-number;
    in-out property <string> gen-separator;
    in-out property <bool> gen-open;

    ScrollView {
        // No sideways scrolling: the page is as wide as the window, and what it holds wraps.
        content-width: self.visible-width;
        VerticalLayout {
            padding: 40px;
            padding-right: 48px;
            spacing: 16px;
            alignment: start;

            // The title, then the kinds under it: six of them need the whole width.
            VerticalLayout {
                spacing: 10px;
                PageTitle {
                    text: root.is-new ? @tr("New item") : @tr("Edit item");
                }
                // 3 is a login made for its two-step codes only (no password).
                Choice {
                    options: [@tr("Login"), @tr("Card"), @tr("Secure note"), @tr("Authenticator"), @tr("SSH key"), @tr("Identity")];
                    selected <=> root.kind;
                }
            }
            HorizontalLayout {
                spacing: 16px;
                LineField {
                    horizontal-stretch: 2;
                    label: @tr("Title");
                    // An authenticator item takes the service's name from its setup key.
                    required: root.kind != 3;
                    icon: "tag";
                    placeholder: root.kind == 1 ? @tr("Visa ending 4242") : root.kind == 2 ? @tr("Home Wi-Fi") : root.kind == 3 ? @tr("Taken from the setup key") : @tr("GitHub");
                    text <=> root.title;
                    error: root.error-code == 9;
                }
                Dropdown {
                    horizontal-stretch: 1;
                    label: @tr("Folder");
                    icon: "folder";
                    empty-text: @tr("No folder");
                    options: root.folder-options;
                    selected <=> root.folder;
                }
            }
            // Its picture: automatic (its site's icon, else its initial), or a line icon in
            // colours of its own, the same as on the phone.
            VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    // Automatic: the site's icon when there is one, else a picture's sign (the
                    // initial comes once it is saved).
                    ItemIcon {
                        size: 34px;
                        icon: root.site-icon;
                        has-icon: root.glyph == "" && root.has-site-icon;
                        glyph: root.glyph != "" ? root.glyph : "image";
                        glyph-color: root.glyph != "" ? root.glyph-color : 0;
                        glyph-bg: root.glyph != "" ? root.glyph-bg : 0;
                    }
                    Text {
                        text: root.glyph == "" ? @tr("Icon: automatic (the site's icon, or the first letter)") : @tr("Icon: a line icon");
                        font-size: Theme.body;
                        color: Theme.ink;
                        vertical-alignment: center;
                    }
                    QuietButton {
                        text: root.icons-open ? @tr("Done") : @tr("Choose…");
                        icon: root.icons-open ? "" : "palette";
                        outlined: true;
                        clicked => { root.icons-open = !root.icons-open; }
                    }
                    if root.glyph != "": QuietButton {
                        text: @tr("Back to automatic");
                        clicked => {
                            root.glyph = "";
                            root.glyph-color = 0;
                            root.glyph-bg = 0;
                        }
                    }
                }
                if root.icons-open: VerticalLayout {
                    spacing: 12px;
                    // The icons, sixteen to a row, each in its own colour.
                    for row in 2: HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        for k in 16: Rectangle {
                            property <string> name: FolderLook.icons[row * 16 + k];
                            width: 36px;
                            height: 36px;
                            border-radius: Theme.radius;
                            background: root.glyph == self.name ? Theme.selected : glyph-touch.has-hover ? Theme.hover : transparent;
                            border-width: root.glyph == self.name ? 1px : 0px;
                            border-color: Theme.marker;
                            accessible-role: button;
                            accessible-label: self.name;
                            Glyph { width: 20px; height: 20px; name: parent.name; tint: IconLook.own(parent.name); }
                            glyph-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.glyph = parent.name; }
                            }
                        }
                    }
                    // Its colour and its tile's: its own (the ringed dot), or one of these.
                    for which in 2: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text {
                            width: 110px;
                            text: which == 0 ? @tr("Icon colour") : @tr("Tile colour");
                            font-size: Theme.small;
                            color: Theme.graphite;
                            vertical-alignment: center;
                        }
                        for c[i] in IconLook.colors: Rectangle {
                            property <bool> chosen: (which == 0 ? root.glyph-color : root.glyph-bg) == i;
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            border-width: self.chosen ? 2px : 0px;
                            border-color: Theme.marker;
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                border-width: 1px;
                                border-color: Theme.rule;
                                background: i != 0 ? c
                                    : which == 0 ? IconLook.own(root.glyph == "" ? "folder" : root.glyph)
                                    : IconLook.tile(root.glyph == "" ? "folder" : root.glyph, root.glyph-color, 0);
                                if i == 0: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.sheet; }
                            }
                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    if (root.glyph == "") { root.glyph = "folder"; }
                                    if (which == 0) { root.glyph-color = i; } else { root.glyph-bg = i; }
                                }
                            }
                        }
                    }
                }
            }
            if root.kind != 2: HorizontalLayout {
                spacing: 16px;
                LineField {
                    horizontal-stretch: 1;
                    label: root.kind == 1 ? @tr("Name on card") : root.kind == 3 ? @tr("Account") : root.kind == 4 ? @tr("User or comment") : root.kind == 5 ? @tr("Full name") : @tr("Username or email");
                    icon: "user";
                    placeholder: root.kind == 1 || root.kind == 5 ? "" : @tr("you@example.com");
                    text <=> root.username;
                }
                // The item's icon comes from its website: a card's is its bank's site. Next to
                // the address, the site's icon, to see at once which site it is.
                LineField {
                    horizontal-stretch: 1;
                    label: @tr("Website");
                    icon: "globe";
                    placeholder: root.kind == 1 ? @tr("The bank's site, for its icon") : "https://";
                    text <=> root.url;
                }
                if root.has-site-icon: VerticalLayout {
                    alignment: end;
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: Theme.radius;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: Theme.rule;
                        accessible-role: image;
                        accessible-label: @tr("The site's icon");
                        Image {
                            width: 22px;
                            height: 22px;
                            source: root.site-icon;
                            image-fit: contain;
                        }
                    }
                }
            }
            if root.kind == 3: LineField {
                label: @tr("Setup key");
                icon: "clock";
                required: true;
                hint: @tr("When you turn on two-step sign-in, the site shows a QR code and a text key, often under “Can't scan it?” or “Enter a setup key”. Paste that key here, or an otpauth:// link. The 6-digit codes then appear on the Authenticator page.");
                placeholder: @tr("otpauth:// link or key, e.g. JBSW Y3DP EHPK 3PXP");
                mono: true;
                error: root.error-code == 10 || root.error-code == 41;
                text <=> root.totp;
            }
            if root.kind == 1: HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 10px;
                        LineField {
                            horizontal-stretch: 1;
                            label: @tr("Card number");
                            icon: "card";
                            placeholder: "1234 5678 9012 3456";
                            mono: true;
                            error: root.error-code == 20;
                            text <=> root.card-number;
                            edited(text) => { root.card-number-edited(text); }
                        }
                        // The network, recognised from the first digits as they are typed.
                        VerticalLayout {
                            alignment: end;
                            Rectangle {
                                height: Theme.control-height;
                                width: 56px;
                                BrandMark {
                                    brand: root.card-brand-mark;
                                    size: 52px;
                                    opacity: root.card-number == "" ? 0.35 : 1;
                                    animate opacity { duration: Theme.quick; }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.card-brand;
                        font-size: Theme.small;
                        color: Theme.graphite;
                        height: root.card-brand != "" ? self.preferred-height : 0px;
                    }
                }
                VerticalLayout {
                    alignment: start;
                    width: 140px;
                    LineField {
                        label: @tr("Expires");
                        icon: "calendar";
                        placeholder: @tr("MM/YY");
                        mono: true;
                        error: root.error-code == 21;
                        text <=> root.card-expiry;
                    }
                }
            }
            if root.kind == 0 || root.kind == 1: HorizontalLayout {
                spacing: 16px;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    SecretField {
                        horizontal-stretch: 1;
                        field: 4;
                        label: root.kind == 1 ? @tr("PIN") : @tr("Password");
                        icon: root.kind == 1 ? "pin" : "key";
                        placeholder: root.kind == 1 ? @tr("Digits only, as the bank gave it") : "";
                        error: root.error-code == 23;
                        revealed: root.password-shown;
                    }
                    VerticalLayout {
                        alignment: end;
                        EyeButton {
                            open: root.password-shown != "";
                            clicked => { root.toggle-show-password(); }
                        }
                    }
                    // A card's PIN comes from the bank: there is nothing to generate.
                    if root.kind == 0: VerticalLayout {
                        alignment: end;
                        QuietButton {
                            icon: root.gen-open ? "refresh" : "sparkle";
                            text: root.gen-open ? @tr("Another") : @tr("Generate");
                            clicked => {
                                root.gen-open = true;
                                root.generate-password();
                            }
                        }
                    }
                }
                if root.kind == 1: LineField {
                    width: 140px;
                    label: @tr("Security code");
                    icon: "shield";
                    placeholder: "CVV";
                    mono: true;
                    error: root.error-code == 22;
                    text <=> root.card-code;
                }
                if root.kind == 0: LineField {
                    horizontal-stretch: 1;
                    label: @tr("One-time code secret");
                    icon: "clock";
                    hint: @tr("Optional. Only for sites with two-step sign-in through an authenticator app. When you turn it on, the site shows a QR code and a text key (often under “Can't scan it?”): paste that key here, or an otpauth:// link. This item will then show the 6-digit codes.");
                    placeholder: @tr("otpauth:// link or key");
                    mono: true;
                    error: root.error-code == 10;
                    text <=> root.totp;
                }
            }
            if root.kind == 0 && root.gen-open: QuickGenerator {
                mode <=> root.gen-mode;
                length <=> root.gen-length;
                words <=> root.gen-words;
                lowercase <=> root.gen-lowercase;
                uppercase <=> root.gen-uppercase;
                digits <=> root.gen-digits;
                symbols <=> root.gen-symbols;
                avoid-ambiguous <=> root.gen-avoid-ambiguous;
                word-case <=> root.gen-word-case;
                number <=> root.gen-number;
                separator <=> root.gen-separator;
                changed => { root.generate-password(); }
                close => { root.gen-open = false; }
            }
            if root.kind == 0 && root.strength-bits > 0: StrengthMeter {
                compact: true;
                bits: root.strength-bits;
                crack-unit: root.crack-unit;
                crack-amount: root.crack-amount;
                weakness: root.weakness;
            }
            // An SSH key: the key in hand (its type, fingerprint and public half; the private
            // key stays in Rust), a passphrase asked once for a key that has one, and the ways
            // to get a key. It is kept without a passphrase: the vault protects it.
            if root.kind == 4: VerticalLayout {
                spacing: 10px;
                Rectangle {
                    border-radius: Theme.radius;
                    background: Theme.field;
                    border-width: 1px;
                    border-color: Theme.rule;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Glyph { width: 18px; height: 18px; name: "terminal"; tint: IconLook.own("terminal"); }
                            Text {
                                text: !root.ssh-has-key ? @tr("No key yet: make one here, or bring yours from a file or the clipboard.")
                                    : root.ssh-type != "" ? root.ssh-type : @tr("Private key");
                                font-size: Theme.body;
                                color: Theme.ink;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                        Text {
                            text: root.ssh-fingerprint;
                            font-family: Theme.mono-font;
                            font-size: Theme.small;
                            color: Theme.graphite;
                        }
                        Text {
                            text: root.ssh-has-key && root.ssh-public == "" ? @tr("Kept as it is; its public half couldn't be read.") : root.ssh-public;
                            font-family: Theme.mono-font;
                            font-size: Theme.small;
                            color: Theme.ink;
                            wrap: char-wrap;
                        }
                    }
                }
                if root.ssh-waiting: HorizontalLayout {
                    spacing: 8px;
                    SecretField {
                        horizontal-stretch: 1;
                        field: 19;
                        label: @tr("The key's passphrase");
                        hint: @tr("Asked once to open the key. The vault keeps the key without it: the vault itself protects it.");
                        icon: "key";
                        eye: true;
                        error: root.error-code == 55;
                        accepted => { root.ssh-open(); }
                    }
                    VerticalLayout {
                        alignment: end;
                        Button { text: @tr("Open the key"); clicked => { root.ssh-open(); } }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    QuietButton {
                        icon: "sparkle";
                        outlined: true;
                        text: root.ssh-has-key ? @tr("Make a new key") : @tr("Make a key (Ed25519)");
                        clicked => { root.ssh-generate(); }
                    }
                    QuietButton { icon: "folder"; text: @tr("Load from a file…"); clicked => { root.ssh-load(); } }
                    QuietButton { icon: "copy"; text: @tr("Paste"); clicked => { root.ssh-paste(); } }
                }
            }
            if root.kind == 0: NotesField {
                label: @tr("Recovery codes");
                icon: "list";
                hint: @tr("The single-use backup codes a site gives you when you turn on two-step sign-in (also called backup codes). They get you in if you lose your phone. Paste them all, one per line; numbering is removed. On the item page you can copy one and mark it as used.");
                placeholder: @tr("One per line, as the site shows them");
                mono: true;
                field-height: 96px;
                text <=> root.recovery-codes;
            }
            NotesField {
                label: @tr("Notes");
                icon: "note";
                text <=> root.notes;
            }
            // Files kept with the item: encrypted with it, and locked with it.
            VerticalLayout {
                spacing: 8px;
                if root.files.length > 0: Text { text: @tr("Files"); font-size: Theme.small; color: Theme.graphite; }
                for file[index] in root.files: HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Glyph { width: 16px; height: 16px; name: "paperclip"; tint: Theme.graphite; }
                    }
                    Text {
                        text: file.name;
                        font-size: Theme.body;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                    }
                    Text { text: file.size; font-size: Theme.small; color: Theme.graphite; vertical-alignment: center; }
                    QuietButton { icon: "trash"; text: @tr("Remove"); tint: Theme.graphite; clicked => { root.file-remove(index); } }
                }
                if root.passkeys.length > 0: Text { text: @tr("Passkeys"); font-size: Theme.small; color: Theme.graphite; }
                for passkey[index] in root.passkeys: HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Glyph { width: 16px; height: 16px; name: "key"; tint: Theme.graphite; }
                    }
                    Text {
                        text: passkey.user != "" ? passkey.user : @tr("No account name");
                        font-size: Theme.body;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                    }
                    Text { text: passkey.site; font-size: Theme.small; color: Theme.graphite; vertical-alignment: center; overflow: elide; }
                    QuietButton { icon: "trash"; text: @tr("Remove"); tint: Theme.graphite; clicked => { root.passkey-remove(index); } }
                }
                if root.passkeys.length > 0: Text {
                    text: @tr("A passkey removed here is gone once you save. The site still expects it until you remove it in the site's security settings too.");
                    font-size: Theme.small;
                    color: Theme.graphite;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    QuietButton { icon: "paperclip"; text: @tr("Attach a file…"); clicked => { root.file-add(); } }
                    VerticalLayout {
                        alignment: center;
                        Hint { text: @tr("Up to 10 files of 5 MB each. They are encrypted with the item and go wherever the vault goes, so large files make every save and sync slower."); }
                    }
                }
            }
            // Extra fields: anything the item needs that has no box of its own.
            VerticalLayout {
                spacing: 8px;
                if root.fields.length > 0: Text {
                    text: @tr("More fields");
                    font-size: Theme.small;
                    color: Theme.graphite;
                }
                for field[index] in root.fields: HorizontalLayout {
                    spacing: 10px;
                    LineField {
                        width: 180px;
                        placeholder: @tr("Name, e.g. Customer no.");
                        text: field.name;
                        edited(text) => { root.field-edited(index, true, text); }
                    }
                    LineField {
                        horizontal-stretch: 1;
                        placeholder: @tr("Value");
                        mono: field.hidden;
                        text: field.value;
                        edited(text) => { root.field-edited(index, false, text); }
                    }
                    VerticalLayout {
                        alignment: center;
                        Check {
                            text: @tr("Hidden");
                            checked: field.hidden;
                            toggled(on) => { root.field-hidden(index, on); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        QuietButton {
                            text: @tr("Remove");
                            tint: Theme.graphite;
                            clicked => { root.field-remove(index); }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    QuietButton {
                        text: @tr("+ Add a field");
                        tint: Theme.graphite;
                        clicked => { root.field-add(); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Check {
                    text: @tr("Lock this item's secrets");
                    checked <=> root.reprompt;
                }
                VerticalLayout {
                    alignment: center;
                    Hint {
                        text: @tr("For the accounts that matter most (bank, main email). The item still shows its name, username and website, but its password, codes and hidden fields open only after a second check: your master password, or the PIN or password chosen in Settings → Item lock. Editing and deleting need it too. Settings can also lock every item at once.");
                    }
                }
            }
            HorizontalLayout {
                spacing: 16px;
                LineField {
                    horizontal-stretch: 2;
                    label: @tr("Tags");
                    icon: "tag";
                    placeholder: @tr("work, bank");
                    text <=> root.tags;
                }
                LineField {
                    horizontal-stretch: 1;
                    label: @tr("Expires");
                    icon: "calendar";
                    placeholder: @tr("YYYY-MM-DD");
                    text <=> root.expires;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Check {
                    text: @tr("Keep out of the browser");
                    checked <=> root.no-browser;
                }
                VerticalLayout {
                    alignment: center;
                    Hint {
                        text: @tr("The browser extension never gets this item: not listed, not filled, not compared, not in the file for filling while locked. A folder can be kept out of the browser too (its settings).");
                    }
                }
                Rectangle { width: 16px; }
                Check {
                    text: @tr("Use as a template");
                    checked <=> root.template;
                }
                VerticalLayout {
                    alignment: center;
                    Hint {
                        text: @tr("A template is a shape for new items: its websites, tags, folder and fields, without its secrets. Templates are listed apart and never filled.");
                    }
                }
            }
            if root.needs-check: SecretField {
                field: 11;
                eye: true;
                label: root.check == 1 ? @tr("Item lock PIN, to save this locked item") : @tr("Item lock password, to save this locked item");
                required: true;
                error: root.error-code == 35 || root.error-code == 37;
            }
            ErrorText {
                code: root.error-code;
                detail: root.error-detail;
            }
            HorizontalLayout {
                spacing: 8px;
                Check {
                    text: @tr("Favorite");
                    checked <=> root.favorite;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    QuietButton {
                        text: @tr("Cancel");
                        clicked => { root.cancel(); }
                    }
                }
                Button {
                    text: @tr("Save");
                    clicked => { root.save(); }
                }
            }
        }
    }
}

export component GeneratorPage inherits Rectangle {
    in property <string> result;
    in property <int> bits;
    in property <int> crack-unit;
    in property <int> crack-amount;
    in property <int> crack-comparison;
    in property <bool> editing;
    in property <int> alphabet;
    in-out property <int> mode;
    in-out property <int> length;
    in-out property <int> words;
    in-out property <bool> lowercase;
    in-out property <bool> uppercase;
    in-out property <bool> digits;
    in-out property <bool> symbols;
    in-out property <bool> extended;
    in-out property <bool> avoid-ambiguous;
    in-out property <string> also-use;
    in-out property <string> never-use;
    in-out property <int> min-lowercase;
    in-out property <int> min-uppercase;
    in-out property <int> min-digits;
    in-out property <int> min-symbols;
    // Advanced options: minimums per kind, characters added or left out, look-alikes.
    property <bool> advanced: root.min-lowercase + root.min-uppercase + root.min-digits + root.min-symbols > 0 || root.also-use != "" || root.never-use != "";
    in-out property <int> word-case;
    in-out property <bool> number;
    in-out property <string> separator;
    in property <[string]> wordlists;
    in-out property <int> wordlist;
    in property <bool> wordlist-removable;
    in property <int> error-code;
    in property <string> error-detail;
    callback regenerate();
    callback copy();
    callback use-for-item();
    callback add-wordlist();
    callback remove-wordlist();
    // Passwords generated and used, newest first, behind the item lock when one is in use.
    in property <[GeneratedRow]> history;
    in property <bool> history-locked;
    in property <int> check;
    in property <bool> hello;
    in property <bool> busy;
    callback unlock();
    callback unlock-hello();
    callback reveal-history(int);
    callback copy-history(int);
    callback clear-history();

    ScrollView {
        // No sideways scrolling: the page is as wide as the window, and what it holds wraps.
        content-width: self.visible-width;
        VerticalLayout {
            padding: 40px;
            padding-right: 48px;
            spacing: 16px;
            alignment: start;

            PageTitle { text: @tr("Password generator"); }

            Rectangle {
                height: output.preferred-height + 20px;
                border-radius: Theme.radius;
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.rule;
                output := Text {
                    x: 16px;
                    width: parent.width - 32px;
                    text: root.result;
                    accessible-label: @tr("Generated password: shown on screen, not read aloud");
                    font-family: Theme.mono-font;
                    font-size: Theme.lead + 2px;
                    color: Theme.ink;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
            StrengthMeter {
                bits: root.bits;
                crack-unit: root.crack-unit;
                crack-amount: root.crack-amount;
                crack-comparison: root.crack-comparison;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Button {
                    text: @tr("Copy");
                    clicked => { root.copy(); }
                }
                VerticalLayout {
                    alignment: center;
                    QuietButton {
                        icon: "refresh";
                        text: @tr("Generate another");
                        clicked => { root.regenerate(); }
                    }
                }
                if root.editing: VerticalLayout {
                    alignment: center;
                    QuietButton {
                        text: @tr("Use for this item");
                        clicked => { root.use-for-item(); }
                    }
                }
            }

            Rule { }

            Choice {
                options: [@tr("Random characters"), @tr("Words (passphrase)")];
                selected <=> root.mode;
                changed => { root.regenerate(); }
            }

            // Length (or number of words): drag the bar.
            HorizontalLayout {
                spacing: 16px;
                Text {
                    text: root.mode == 0 ? @tr("Length") : @tr("Words");
                    font-size: Theme.body;
                    color: Theme.ink;
                    vertical-alignment: center;
                    width: 120px;
                }
                if root.mode == 0: Slider {
                    label: @tr("Length");
                    minimum: 4;
                    maximum: 128;
                    value <=> root.length;
                    changed => { root.regenerate(); }
                }
                if root.mode == 1: Slider {
                    label: @tr("Words");
                    minimum: 3;
                    maximum: 20;
                    value <=> root.words;
                    changed => { root.regenerate(); }
                }
                Text {
                    text: root.mode == 0 ? root.length : root.words;
                    font-size: Theme.lead;
                    font-weight: 600;
                    color: Theme.ink;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    width: 44px;
                }
            }

            if root.mode == 0: VerticalLayout {
                spacing: 14px;
                GridLayout {
                    spacing-horizontal: 24px;
                    spacing-vertical: 10px;
                    Row {
                        Check { text: @tr("A–Z capitals"); checked <=> root.uppercase; toggled => { root.regenerate(); } }
                        Check { text: @tr("a–z lowercase"); checked <=> root.lowercase; toggled => { root.regenerate(); } }
                    }
                    Row {
                        Check { text: @tr("0–9 digits"); checked <=> root.digits; toggled => { root.regenerate(); } }
                        Check { text: @tr("!@#$%^&* symbols"); checked <=> root.symbols; toggled => { root.regenerate(); } }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    QuietButton {
                        icon: "gear";
                        text: root.advanced ? @tr("Fewer options") : @tr("Advanced options");
                        clicked => { root.advanced = !root.advanced; }
                    }
                }
                if root.advanced: VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: @tr("For sites with rules: at least this many of each kind. The length grows if they need more room.");
                        font-size: Theme.small;
                        color: Theme.graphite;
                        wrap: word-wrap;
                    }
                    Stepper { label: @tr("At least, capitals"); value <=> root.min-uppercase; maximum: 64; changed => { root.regenerate(); } }
                    Stepper { label: @tr("At least, lowercase"); value <=> root.min-lowercase; maximum: 64; changed => { root.regenerate(); } }
                    Stepper { label: @tr("At least, digits"); value <=> root.min-digits; maximum: 64; changed => { root.regenerate(); } }
                    Stepper { label: @tr("At least, symbols"); value <=> root.min-symbols; maximum: 64; changed => { root.regenerate(); } }
                }
                if root.advanced: GridLayout {
                    spacing-horizontal: 24px;
                    spacing-vertical: 10px;
                    Row {
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Check { text: @tr("Extended ASCII (é ß ¿ µ…)"); checked <=> root.extended; toggled => { root.regenerate(); } }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("Adds 94 accented letters and signs (Latin-1). Stronger per character, but many sites refuse them and they are hard to type on another keyboard. Use only where you paste the password.");
                                }
                            }
                        }
                        Check { text: @tr("Leave out look-alikes (I l 1 O 0 o |)"); checked <=> root.avoid-ambiguous; toggled => { root.regenerate(); } }
                    }
                }
                if root.advanced: HorizontalLayout {
                    spacing: 16px;
                    LineField {
                        horizontal-stretch: 1;
                        label: @tr("Also use");
                        hint: @tr("Type extra characters to mix in, exactly as they should appear, for example ;:~ or ñ. At least one of them will be in the password.");
                        placeholder: @tr("e.g. ñ€");
                        mono: true;
                        text <=> root.also-use;
                        edited => { root.regenerate(); }
                    }
                    LineField {
                        horizontal-stretch: 1;
                        label: @tr("Never use");
                        hint: @tr("Type characters a site does not accept, for example <>'\"\\. They are left out even when a box above includes them.");
                        placeholder: @tr("e.g. <>'\"");
                        mono: true;
                        text <=> root.never-use;
                        edited => { root.regenerate(); }
                    }
                }
                Text {
                    text: @tr("{n} different character" | "{n} different characters" % root.alphabet);
                    font-size: Theme.small;
                    color: Theme.faint;
                }
            }

            if root.mode == 1: VerticalLayout {
                spacing: 14px;
                HorizontalLayout {
                    spacing: 16px;
                    Dropdown {
                        horizontal-stretch: 1;
                        label: @tr("Word case");
                        options: [@tr("lower case"), @tr("UPPER CASE"), @tr("Title Case"), @tr("MIXED case")];
                        selected <=> root.word-case;
                        changed => { root.regenerate(); }
                    }
                    VerticalLayout {
                        alignment: end;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            height: Theme.control-height;
                            Check { text: @tr("Add a digit to one word"); checked <=> root.number; toggled => { root.regenerate(); } }
                        }
                    }
                }
                SeparatorPicker {
                    separator <=> root.separator;
                    changed => { root.regenerate(); }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Dropdown {
                        horizontal-stretch: 1;
                        label: @tr("Word list");
                        options: root.wordlists;
                        selected <=> root.wordlist;
                        changed => { root.regenerate(); }
                    }
                    VerticalLayout {
                        alignment: end;
                        HorizontalLayout {
                            spacing: 4px;
                            height: Theme.control-height;
                            QuietButton {
                                text: @tr("Add a list…");
                                clicked => { root.add-wordlist(); }
                            }
                            if root.wordlist-removable: QuietButton {
                                text: @tr("Remove");
                                tint: Theme.seal;
                                clicked => { root.remove-wordlist(); }
                            }
                        }
                    }
                }
                Prose {
                    text: @tr("A word list is a text file with one word per line (Diceware lists with numbers work too). Use your own language's list for passphrases you can remember; it needs at least 500 different words.");
                    font-size: Theme.small;
                }
                ErrorText {
                    code: root.error-code;
                    detail: root.error-detail;
                }
            }

            Rule { }

            Text {
                text: @tr("Recently generated");
                font-size: Theme.lead;
                font-weight: 600;
                color: Theme.ink;
            }
            Prose {
                font-size: Theme.small;
                text: @tr("Passwords you copied or used from here or from the browser extension, newest first, in case a sign-up failed before you saved the login. Kept encrypted with this vault on this computer, at most 50.");
            }
            if root.history-locked && root.history.length > 0: LockBox {
                check: root.check;
                text: root.check == 1 ? @tr("They may be passwords of locked items. Your PIN shows them for 5 minutes.")
                    : root.check == 2 ? @tr("They may be passwords of locked items. Your item password shows them for 5 minutes.")
                    : @tr("They may be passwords of locked items. Your master password shows them for 5 minutes.");
                busy: root.busy;
                error-code: root.error-code;
                error-detail: root.error-detail;
                hello: root.hello;
                unlock => { root.unlock(); }
                unlock-hello => { root.unlock-hello(); }
            }
            if root.history.length == 0: Prose {
                text: @tr("Nothing yet.");
            }
            if !root.history-locked && root.history.length > 0: VerticalLayout {
                spacing: 2px;
                for entry[index] in root.history: Rectangle {
                    height: 36px;
                    border-radius: Theme.radius;
                    background: entry-touch.has-hover ? Theme.hover : transparent;
                    entry-touch := TouchArea { }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 4px;
                        spacing: 10px;
                        Text {
                            width: 150px;
                            text: entry.date;
                            font-size: Theme.small;
                            color: Theme.graphite;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            width: 150px;
                            text: entry.site != "" ? entry.site : @tr("In the app");
                            font-size: Theme.small;
                            color: Theme.graphite;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: entry.password != "" ? entry.password : "••••••••••••";
                            font-family: entry.password != "" ? Theme.mono-font : Theme.ui-font;
                            font-size: Theme.body;
                            color: Theme.ink;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        EyeButton {
                            open: entry.password != "";
                            tint: Theme.graphite;
                            clicked => { root.reveal-history(index); }
                        }
                        QuietButton {
                            text: @tr("Copy");
                            clicked => { root.copy-history(index); }
                        }
                    }
                }
            }
            if root.history.length > 0: HorizontalLayout {
                alignment: start;
                QuietButton {
                    text: @tr("Clear history");
                    tint: Theme.seal;
                    clicked => { root.clear-history(); }
                }
            }
        }
    }
}

// A settings group: a card with an icon, a title and a line about what it covers.
// The browser to add the extension to (Settings → Browser extension): the installed ones,
// each with its brand's mark, the default one first and said.
component BrowserPicker inherits VerticalLayout {
    in property <[ExtensionBrowser]> browsers;
    in-out property <int> selected;
    property <bool> picked: root.selected >= 0 && root.selected < root.browsers.length;
    spacing: 6px;
    Text {
        text: @tr("Browser");
        font-size: Theme.small;
        color: Theme.graphite;
    }
    well := Rectangle {
        height: Theme.control-height + 4px;
        border-radius: Theme.radius;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.rule;
        accessible-role: combobox;
        accessible-label: @tr("Browser");
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 10px;
            if root.picked: VerticalLayout {
                alignment: center;
                SourceMark { source: root.browsers[root.selected].mark; size: 22px; }
            }
            Text {
                horizontal-stretch: 1;
                text: root.picked ? root.browsers[root.selected].name : "";
                font-size: Theme.body;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.picked && root.browsers[root.selected].is-default: Text {
                text: @tr("your default browser");
                font-size: Theme.small;
                color: Theme.graphite;
                vertical-alignment: center;
            }
            Path {
                width: 10px;
                height: 6px;
                y: (parent.height - self.height) / 2;
                viewbox-width: 10;
                viewbox-height: 6;
                commands: "M1 1 L5 5 L9 1";
                stroke: Theme.graphite;
                stroke-width: 1.4px;
                fill: transparent;
            }
        }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { list.show(); }
        }
        list := PopupWindow {
            y: well.height + 4px;
            width: well.width;
            close-policy: close-on-click;
            Rectangle {
                background: Theme.sheet;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.rule;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000055;
                VerticalLayout {
                    padding: 4px;
                    for browser[index] in root.browsers: Rectangle {
                        height: 38px;
                        border-radius: Theme.radius - 2px;
                        background: option.has-hover ? Theme.hover : index == root.selected ? Theme.selected : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                SourceMark { source: browser.mark; size: 22px; }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: browser.name;
                                font-size: Theme.body;
                                color: Theme.ink;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if browser.is-default: Text {
                                text: @tr("your default browser");
                                font-size: Theme.small;
                                color: Theme.good;
                                vertical-alignment: center;
                            }
                        }
                        option := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.selected = index; }
                        }
                    }
                }
            }
        }
    }
}

component SettingsCard inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> summary;
    in property <string> hint;
    border-radius: Theme.radius + 2px;
    border-width: 1px;
    border-color: Theme.rule;
    background: Theme.panel;
    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: start;
                FieldIcon { name: root.icon; size: 32px; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: root.title;
                        font-size: Theme.lead;
                        font-weight: 600;
                        color: Theme.ink;
                        vertical-alignment: center;
                    }
                    if root.hint != "": VerticalLayout {
                        alignment: center;
                        Hint { text: root.hint; }
                    }
                }
                Text {
                    text: root.summary;
                    font-size: Theme.small;
                    color: Theme.graphite;
                    wrap: word-wrap;
                }
            }
        }
        @children
    }
}

// A label and value pair inside a settings card.
component Fact inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;
    spacing: 12px;
    Text {
        width: 170px;
        text: root.label;
        font-size: Theme.small;
        color: Theme.graphite;
    }
    Text {
        horizontal-stretch: 1;
        text: root.value;
        font-size: Theme.small;
        font-family: root.mono ? Theme.mono-font : Theme.ui-font;
        color: Theme.ink;
        wrap: word-wrap;
    }
}

// One category in the Settings sidebar: its icon, its name and a line about what is in it.
component SettingsTab inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> detail;
    in property <bool> current;
    callback clicked;
    height: 54px;
    border-radius: Theme.radius;
    background: root.current ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-description: root.detail;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Glyph {
                width: 18px;
                height: 18px;
                name: root.icon;
                tint: root.current ? Theme.ink : Theme.graphite;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                text: root.text;
                font-size: Theme.body;
                font-weight: root.current ? 600 : 400;
                color: Theme.ink;
                overflow: elide;
            }
            Text {
                text: root.detail;
                font-size: Theme.small;
                color: Theme.graphite;
                overflow: elide;
            }
        }
    }
    // The one open: a short yellow mark on its left edge.
    if root.current: Rectangle {
        x: 0px;
        y: 12px;
        width: 3px;
        height: parent.height - 24px;
        border-radius: 1.5px;
        background: Theme.marker;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// One step of the update: done (a tick), under way (a dot), failed (a cross) or still to come.
component StepLine inherits HorizontalLayout {
    in property <int> n;
    in property <int> step;
    in property <int> failed-at;
    in property <string> text;
    property <bool> done: root.step == 5 || (root.step >= 1 && root.step <= 4 && root.step > root.n) || (root.step == 6 && root.failed-at > root.n);
    property <bool> doing: root.step == root.n;
    property <bool> failed: root.step == 6 && root.failed-at == root.n;
    spacing: 8px;
    VerticalLayout {
        alignment: center;
        Path {
            width: 12px;
            height: 12px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.done ? "M20 6 L9 17 L4 12" : root.failed ? "M18 6 L6 18 M6 6 L18 18" : "M12 7a5 5 0 1 0 0 10a5 5 0 1 0 0-10z";
            stroke: root.failed ? Theme.seal : root.done || root.doing ? Theme.ink : Theme.faint;
            stroke-width: 2.6px;
            stroke-line-cap: round;
            stroke-line-join: round;
            fill: root.doing ? Theme.ink : transparent;
        }
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        font-size: Theme.small;
        font-weight: root.doing ? 600 : 400;
        color: root.failed ? Theme.seal : root.doing ? Theme.ink : root.done ? Theme.graphite : Theme.faint;
        overflow: elide;
    }
}

// The update, step by step (Settings → About, and the title bar's panel): the newer version
// told, its steps while it installs itself, what failed, and what to do next.
export component UpdateCard inherits VerticalLayout {
    // The newer version told, and whether one is (update-state 3).
    in property <string> version;
    in property <bool> told;
    // As AppWindow's install-… properties.
    in property <int> step;
    in property <int> done-kb;
    in property <int> total-kb;
    in property <string> installed;
    in property <int> failure;
    in property <int> failed-at;
    in property <string> detail;
    callback install();
    callback restart();
    callback open-release();
    property <float> done-mb: Math.round(root.done-kb / 102.4) / 10;
    property <float> total-mb: Math.round(root.total-kb / 102.4) / 10;
    property <int> percent: root.total-kb > 0 ? Math.round(root.done-kb * 100 / root.total-kb) : 0;
    spacing: 10px;
    Text {
        text: root.step == 5 ? @tr("Version {} is installed.", root.installed)
            : root.step == 6 ? @tr("Version {} wasn't installed.", root.version)
            : root.step > 0 ? @tr("Installing version {}…", root.version)
            : root.told ? @tr("Version {} is out.", root.version)
            : @tr("No update under way.");
        font-size: Theme.body;
        font-weight: 600;
        color: Theme.ink;
        wrap: word-wrap;
    }
    if root.step > 0: VerticalLayout {
        spacing: 6px;
        StepLine {
            n: 1;
            step: root.step;
            failed-at: root.failed-at;
            text: @tr("Checking the release's signed manifest");
        }
        StepLine {
            n: 2;
            step: root.step;
            failed-at: root.failed-at;
            text: root.step == 2 && root.total-kb > 0
                ? @tr("Downloading: {} of {} MB ({}%)", root.done-mb, root.total-mb, root.percent)
                : @tr("Downloading the program");
        }
        if root.step == 2: Rectangle {
            height: 3px;
            border-radius: 1.5px;
            background: Theme.rule;
            Rectangle {
                x: 0px;
                width: parent.width * (root.total-kb > 0 ? root.done-kb / root.total-kb : 0);
                height: parent.height;
                border-radius: 1.5px;
                background: Theme.ink;
            }
        }
        StepLine {
            n: 3;
            step: root.step;
            failed-at: root.failed-at;
            text: @tr("Checking its SHA-256 against the manifest");
        }
        StepLine {
            n: 4;
            step: root.step;
            failed-at: root.failed-at;
            text: @tr("Putting it in this program's place");
        }
    }
    Text {
        text: root.step == 6 && root.failure == 1 ? @tr("This program's folder ({}) can't be written, so Vault can't replace itself there. Download the new version from the release page and put it where you keep Vault.", root.detail)
            : root.step == 6 && root.failure == 2 ? @tr("What came isn't what the release's signed manifest lists ({}), so it wasn't used. Nothing was changed.", root.detail)
            : root.step == 6 && root.failure == 3 ? @tr("The download didn't finish ({}). Nothing was changed; try again, or Vault does at its next look.", root.detail)
            : root.step == 6 ? @tr("The new version couldn't be put in place ({}). This version was kept as it was.", root.detail)
            : root.step == 5 ? @tr("Restart Vault to use it. Until then this version keeps running, and the next start runs the new one.")
            : root.step == 0 && root.told ? @tr("Install it now: Vault downloads it, checks it against the release's signed manifest and puts it in this program's place. Your vault stays where it is.")
            : "";
        height: self.text == "" ? 0px : self.preferred-height;
        font-size: Theme.small;
        color: root.step == 6 ? Theme.seal : Theme.graphite;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        height: root.step == 5 || root.step == 6 || (root.step == 0 && root.told) ? self.preferred-height : 0px;
        if root.step == 5: QuietButton {
            text: @tr("Restart now");
            icon: "refresh";
            outlined: true;
            clicked => { root.restart(); }
        }
        if (root.step == 0 && root.told) || (root.step == 6 && root.failure != 1): QuietButton {
            text: root.step == 6 ? @tr("Try again") : @tr("Install now");
            icon: "download";
            outlined: true;
            clicked => { root.install(); }
        }
        if (root.step == 0 && root.told) || root.step == 6: QuietButton {
            text: @tr("Open the release page");
            icon: "external";
            outlined: true;
            clicked => { root.open-release(); }
        }
    }
}

// Settings: categories on the left, the one chosen on the right. What changes something
// sensitive (the master password, the item lock, a keyfile, the unlock protection, sync and
// its devices, the extension's connection) opens a dialog that asks first, with the master
// password where it matters (`open-dialog`, shown by the window: see app.slint).
//   section: 0 security, 1 this vault, 2 sync, 3 browser extension, 4 appearance, 5 about.
//   dialog kinds: 1 master password, 2 unlock protection, 3 item lock, 4 make a keyfile,
//   10 use another keyfile, 11 remove the keyfile, 5 stop syncing, 6 remove a device,
//   7 add a device, 8 remove the backup server, 9 disconnect the extension.
export component SettingsPage inherits Rectangle {
    in property <int> error-code;
    in property <string> error-detail;
    in property <bool> busy;
    in property <bool> dark;
    in property <string> vault-path;
    in property <string> vault-id;
    in property <string> vault-file-name;
    in-out property <string> vault-name;
    in-out property <int> history-limit;
    in property <int> vault-items;
    in property <int> vault-folders;
    in property <int> kdf-memory;
    in property <int> kdf-passes;
    property <string> vault-kdf: root.kdf-current-method == 1 ? @tr("scrypt · {} MiB", root.kdf-memory)
        : root.kdf-current-method == 2 ? @tr("PBKDF2-SHA-256 · {} rounds", root.kdf-passes)
        : @tr("Argon2id · {} MiB · {} passes", root.kdf-memory, root.kdf-passes);
    // How a forgotten master password is recovered: 0 not at all, 1 the Recovery Key of an
    // older kit, 2 recovery parts.
    in property <int> vault-recovery;
    in-out property <int> auto-lock-minutes;
    in-out property <bool> lock-with-windows;
    in-out property <bool> secure-desktop;
    // The security log, newest first, and how many older lines aren't shown yet.
    in property <[SecurityLine]> security-log;
    in property <int> security-log-more;
    callback security-log-show-more();
    callback security-log-clear();
    property <bool> security-log-confirm;
    // 1 the Secret Key is kept under the security chip, 2 by Windows alone, 0 not known.
    in property <int> secret-key-kept;
    in-out property <int> clipboard-seconds;
    in-out property <bool> website-icons;
    in-out property <bool> leak-watch;
    in-out property <bool> close-to-tray;
    in-out property <bool> start-at-sign-in;
    in-out property <bool> start-in-tray;
    in-out property <bool> backdrop-on;
    in-out property <bool> browser-locked-fill;
    in-out property <bool> browser-extension;
    in-out property <bool> browser-saves;
    in-out property <bool> browser-passkeys;
    in-out property <bool> browser-warnings;
    in-out property <bool> browser-fill-notices;
    in-out property <bool> browser-always-asks;
    in-out property <bool> browser-whole-vault;
    in property <int> browser-ask-way;
    in property <bool> quick-unlock-available;
    in-out property <bool> quick-unlock-on;
    in property <string> app-version;
    // Check for updates (About): 0 not asked, 1 asking, 2 this is the newest, 3 a newer
    // version is out (update-version), 4 the question failed (update-detail).
    in property <int> update-state;
    in property <string> update-version;
    in property <string> update-detail;
    // Updates are looked for by themselves, every hour while the app runs.
    in-out property <bool> update-checks;
    callback check-updates();
    // The update installing itself (AppWindow's install-…), and the setting that lets it.
    in-out property <bool> update-install;
    in property <int> install-step;
    in property <int> install-done-kb;
    in property <int> install-total-kb;
    in property <string> install-version;
    in property <int> install-failure;
    in property <int> install-failed-at;
    in property <string> install-detail;
    callback install-update();
    callback restart-now();
    // This vault's icon on this computer ("" its initial), and the initial.
    in property <string> vault-icon;
    in property <string> vault-initial;
    callback vault-icon-chosen(string);
    callback open-release();
    callback quick-unlock-toggled(bool);
    callback settings-changed();
    callback start-at-sign-in-changed(bool);
    callback vault-settings-changed();
    callback appearance-changed(bool);
    in-out property <int> language;
    callback language-changed(int);
    // The category shown, and the dialog a button opens.
    in-out property <int> section;
    callback open-dialog(int);
    // The PIN or password typed for a newer item lock waiting from another device (or for
    // this computer's own one): the same check as a locked item's.
    callback guard-open-waiting();
    // Unlock protection (Argon2id cost): the level chosen on screen, the vault's current one
    // (-1 = custom values).
    in-out property <int> kdf-level: 1;
    in property <int> kdf-current: 1;
    // The hashing method: 0 Argon2id, 1 scrypt, 2 PBKDF2-SHA-256 (chosen on screen / current).
    in-out property <int> kdf-method;
    in property <int> kdf-current-method;
    in property <string> unlock-time;
    // Item lock: every item or only marked ones; what opens them (0 master password, 1 PIN,
    // 2 another password); what the vault uses now.
    in-out property <bool> guard-all;
    in-out property <int> guard-check;
    in property <int> guard-current-check;
    // Windows Hello as another way to open the item lock on this computer.
    in-out property <bool> guard-hello;
    in-out property <bool> browser-paired;
    in property <string> sync-folder;
    in property <int> sync-state;
    in property <int> sync-minutes: -1;
    in property <string> sync-detail;
    in property <int> sync-waiting;
    in property <string> sync-devices;
    in property <string> sync-this-device;
    // The kind of place (0 off, 1 folder, 2 server, 3 WebDAV), the setup dialog open (0 none,
    // 1 server, 2 WebDAV), the other devices (for Remove), the one Remove asks about.
    in property <int> sync-kind;
    in-out property <int> sync-form;
    in property <string> sync-setup-error;
    in property <bool> sync-busy;
    in property <[DeviceLine]> sync-others;
    in-out property <int> sync-removing: -1;
    in property <string> sync-invite;
    // A backup server synced too: where it is, why the main place or the backup didn't
    // answer in the last round ("" = it did), and the dialog that adds one.
    in property <string> sync-backup;
    in property <string> sync-main-down;
    in property <string> sync-backup-down;
    in-out property <bool> sync-backup-form;
    // The vault key was renewed on another device (its copies wait for the new Secret Key),
    // and how many devices still use the key this one renewed or took.
    in property <bool> sync-key-renewed;
    in property <int> sync-key-behind;
    callback sync-choose();
    callback sync-now();
    // Keyfile: whether the vault needs one, where it is.
    in property <bool> keyfile-on;
    in property <string> keyfile-path;
    // Browser extension → Add to a browser: the installed browsers (the default one first) and
    // the one picked; adding to one, by its index; the folder the extension is loaded from.
    // What is in use: 0 the copy built into the app, 1 a GitHub release, 2 the person's folder
    // (extension-local), at extension-version; choosing such a folder, and going back to
    // GitHub's releases.
    in property <[ExtensionBrowser]> extension-browsers;
    in-out property <int> extension-browser;
    callback add-extension(int);
    callback open-extension-folder();
    in property <int> extension-source;
    in property <string> extension-version;
    in property <string> extension-local;
    callback choose-extension-folder();
    callback use-extension-release();

    changed section => { scroll.content-y = 0; }

    HorizontalLayout {
        // The categories.
        Rectangle {
            width: 248px;
            background: Theme.panel;
            VerticalLayout {
                padding: 16px;
                padding-top: 40px;
                spacing: 4px;
                alignment: start;
                Text {
                    text: @tr("Settings");
                    font-size: Theme.title;
                    font-weight: 300;
                    color: Theme.ink;
                }
                Rectangle { height: 14px; }
                for tab[index] in [
                    { icon: "shield", text: @tr("Security"), detail: @tr("Locking, master password, item lock") },
                    { icon: "vault", text: @tr("This vault"), detail: @tr("Name, password history, file") },
                    { icon: "refresh", text: @tr("Sync"), detail: root.sync-kind == 0 ? @tr("Off") : root.sync-kind == 1 ? @tr("Through a folder") : root.sync-kind == 2 ? @tr("Through your server") : @tr("Through WebDAV") },
                    { icon: "browser", text: @tr("Browser extension"), detail: !root.browser-extension ? @tr("Off") : root.browser-paired ? @tr("Connected") : @tr("On, not connected yet") },
                    { icon: "sliders", text: @tr("Appearance"), detail: @tr("Theme, language, icons") },
                    { icon: "lifebuoy", text: @tr("About"), detail: @tr("Version {}", root.app-version) },
                ]: SettingsTab {
                    icon: tab.icon;
                    text: tab.text;
                    detail: tab.detail;
                    current: root.section == index;
                    clicked => { root.section = index; }
                }
            }
            Rectangle {
                x: parent.width - 1px;
                y: 0px;
                width: 1px;
                height: parent.height;
                background: Theme.rule;
            }
        }

        scroll := ScrollView {
            // No sideways scrolling: the page is as wide as the window, and what it holds wraps.
            content-width: self.visible-width;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 40px;
                padding-right: 48px;
                spacing: 16px;
                alignment: start;

                // ---- security
                if root.section == 0: VerticalLayout {
                    spacing: 16px;
                    PageTitle { text: @tr("Security"); }

                    SettingsCard {
                        icon: "shield";
                        title: @tr("Locking and clipboard");
                        summary: @tr("When the vault closes itself, and how long copied secrets stay on the clipboard.");
                        Stepper {
                            label: @tr("Lock after");
                            unit: @tr("min");
                            value <=> root.auto-lock-minutes;
                            minimum: 1;
                            maximum: 60;
                            changed => { root.settings-changed(); }
                        }
                        Check {
                            text: @tr("Also lock when Windows locks, sleeps or switches user");
                            checked <=> root.lock-with-windows;
                            toggled => { root.settings-changed(); }
                        }
                        Stepper {
                            label: @tr("Clear copied secrets after");
                            unit: @tr("s");
                            value <=> root.clipboard-seconds;
                            minimum: 5;
                            maximum: 120;
                            changed => { root.settings-changed(); }
                        }
                        if root.quick-unlock-available: HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Check {
                                text: @tr("Unlock with Windows Hello");
                                checked <=> root.quick-unlock-on;
                                toggled(on) => { root.quick-unlock-toggled(on); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("Open this vault with your face, fingerprint or Windows PIN instead of typing the master password. The key is made inside this computer's security chip and only works here, after Windows Hello checks it's you. Every 14 days the master password is asked once, so you don't forget it, and changing the master password turns this off. Anyone who knows your Windows PIN could open the vault on this computer.");
                                }
                            }
                        }
                    }

                    SettingsCard {
                        icon: "key";
                        title: @tr("Master password");
                        summary: @tr("Your items, Secret Key and recovery parts stay the same.");
                        hint: @tr("Changing it re-checks your current master password against the vault file, so someone using a computer you left unlocked can't do it.");
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: @tr("Change master password…");
                                icon: "key";
                                clicked => { root.open-dialog(1); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Check {
                                text: @tr("Offer to type it on a secure desktop");
                                checked <=> root.secure-desktop;
                                toggled => { root.settings-changed(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("The unlock screen gets a link that switches to a desktop of its own, as Windows does for its own password prompts, with only a small window to type the master password in. Programs on your normal desktop can't record those keys or that screen there. It doesn't stop a program that already runs as you from joining that desktop, nor anything deeper in Windows. Screen readers, the on-screen keyboard and other input tools don't work there: the normal field stays. Esc, or two minutes, brings your desktop back.");
                                }
                            }
                        }
                    }

                    SettingsCard {
                        icon: "pin";
                        title: @tr("Item lock");
                        summary: @tr("A second check before an open vault shows passwords, codes and hidden fields. Names, usernames and websites stay visible so you can find the account.");
                        hint: @tr("With a PIN or another password, the locked secrets are also encrypted with a key that only that PIN or password opens: a program that reads the open vault from your computer's memory still can't read items that are locked. A 4-digit PIN has only 10,000 combinations, and such a program could try them all in a few hours, so use 6 to 8 digits or a password for real strength. With the master password as the check nothing extra is encrypted; it only stops someone at your unlocked computer. One right answer opens every locked item for 5 minutes, or until you click Lock. After 5 wrong tries the whole vault locks. A forgotten PIN is replaced here, with your master password.");
                        Choice {
                            options: [@tr("Master password"), @tr("PIN"), @tr("Another password")];
                            selected <=> root.guard-check;
                        }
                        Text {
                            text: root.guard-check == 0 ? @tr("A check only: nothing extra is encrypted.")
                                : root.guard-check == 1 ? @tr("Locked secrets are encrypted, and only the PIN opens them. If you forget both the PIN and your master password, they can't be recovered, not even with your emergency kit.")
                                : @tr("Locked secrets are encrypted, and only this password opens them. If you forget both it and your master password, they can't be recovered, not even with your emergency kit.");
                            font-size: Theme.small;
                            color: Theme.graphite;
                            wrap: word-wrap;
                        }
                        // A newer item lock from another device waits for the move here.
                        Text {
                            text: Messages.guard-waiting(ItemLock.waiting);
                            visible: ItemLock.waiting != 0;
                            height: ItemLock.waiting != 0 ? self.preferred-height : 0px;
                            font-size: Theme.small;
                            color: Theme.ink;
                            wrap: word-wrap;
                        }
                        // Where both PINs (or passwords) are typed, also once this computer's
                        // own lock is open (with Windows Hello, say).
                        if ItemLock.waiting == 1 || ItemLock.waiting == 2: HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            SecretField {
                                width: ItemLock.waiting == 1 ? 180px : 320px;
                                field: 11;
                                eye: true;
                                placeholder: ItemLock.waiting == 1 ? @tr("PIN") : @tr("Item password");
                                error: root.error-code == 35;
                                accepted => { root.guard-open-waiting(); }
                            }
                            Button {
                                text: @tr("Open");
                                busy-text: @tr("Checking…");
                                busy: root.busy;
                                clicked => { root.guard-open-waiting(); }
                            }
                        }
                        Text {
                            text: (ItemLock.waiting == 1 || ItemLock.waiting == 2) && (root.error-code == 35 || root.error-code == 60) ? Messages.error(root.error-code, root.error-detail) : "";
                            height: self.text == "" ? 0px : self.preferred-height;
                            font-size: Theme.small;
                            color: root.error-code == 60 ? Theme.ink : Theme.seal;
                            wrap: word-wrap;
                        }
                        Check {
                            text: @tr("Lock every item (otherwise only items marked “Lock this item's secrets”)");
                            checked <=> root.guard-all;
                        }
                        if root.guard-check != 0 && root.quick-unlock-available: HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Check {
                                text: @tr("Open locked items with Windows Hello too");
                                checked <=> root.guard-hello;
                            }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("Your face, fingerprint or Windows PIN opens locked items on this computer, in the app and when the browser extension fills a login. The key that does it stays in this computer's security chip, which also slows down guessing, so this is stronger than a short PIN typed by hand. The item lock's PIN or password stays as the other way in, and is what you use on other devices. Saving asks Windows Hello once.");
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: @tr("Save item lock…");
                                icon: "pin";
                                clicked => { root.open-dialog(3); }
                            }
                        }
                    }

                    SettingsCard {
                        icon: "note";
                        title: @tr("Keyfile");
                        summary: root.keyfile-on
                            ? @tr("On: the vault opens only with your master password and this file.")
                            : @tr("Off. A keyfile is a file the vault needs together with your master password.");
                        hint: @tr("Keep the keyfile on a USB stick or another place apart from the vault. Someone who steals the vault file, your master password and even this computer's Secret Key still can't open it without the file. The file must never change, not even by one byte, and losing it (with no Recovery Key) locks you out for good: keep a second copy. Any file works, but one made here holds a full-strength random key. Setting or removing it turns Windows Hello off until you turn it on again.");
                        if root.keyfile-on: Fact {
                            label: @tr("File");
                            value: root.keyfile-path != "" ? root.keyfile-path : @tr("Not found on this computer");
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            if !root.keyfile-on: Button {
                                text: @tr("Create a keyfile…");
                                clicked => { root.open-dialog(4); }
                            }
                            VerticalLayout {
                                alignment: center;
                                QuietButton {
                                    outlined: true;
                                    text: root.keyfile-on ? @tr("Use another file…") : @tr("Use an existing file…");
                                    clicked => { root.open-dialog(10); }
                                }
                            }
                            if root.keyfile-on: VerticalLayout {
                                alignment: center;
                                QuietButton {
                                    outlined: true;
                                    text: @tr("Remove the keyfile…");
                                    tint: Theme.seal;
                                    clicked => { root.open-dialog(11); }
                                }
                            }
                        }
                    }

                    SettingsCard {
                        icon: "lock";
                        title: @tr("Unlock protection");
                        summary: @tr("How much work each guess at your master password costs, for you once per unlock and for anyone with a copy of the vault file every time they guess.");
                        hint: @tr("Your master password is stretched before it opens the vault. Argon2id is the method recommended today (RFC 9106, OWASP): it needs a lot of memory for every guess, which is what makes graphics cards and special chips slow at guessing. scrypt also needs memory but is older. PBKDF2-SHA-256 needs almost none, so it is the weakest of the three; it is here for people who must follow a rule that names it. Higher levels cost more per guess. Changing the method or level rewrites only the password lock of the vault, never your items.");
                        Choice {
                            options: ["Argon2id", "scrypt", "PBKDF2-SHA-256"];
                            selected <=> root.kdf-method;
                        }
                        if root.kdf-method != 0: Text {
                            text: root.kdf-method == 1 ? @tr("Weaker than Argon2id: scrypt also needs memory for every guess, but it is older and special hardware does better against it. Keep Argon2id unless you have a reason.")
                                : @tr("Much weaker than Argon2id: PBKDF2 needs almost no memory, so graphics cards guess thousands of times faster against it. Choose it only if you must, and then a long master password matters even more.");
                            font-size: Theme.small;
                            color: Theme.seal;
                            wrap: word-wrap;
                        }
                        Choice {
                            options: [@tr("Light"), @tr("Standard"), @tr("Strong"), @tr("Maximum")];
                            selected <=> root.kdf-level;
                        }
                        Text {
                            text: root.kdf-method == 1 ? (root.kdf-level == 0 ? @tr("128 MiB of memory for every guess. For older computers or ones with little memory.")
                                    : root.kdf-level == 1 ? @tr("256 MiB of memory for every guess. A good balance on most computers.")
                                    : root.kdf-level == 2 ? @tr("512 MiB of memory for every guess. Slower to guess, and to unlock.")
                                    : @tr("1 GiB of memory for every guess. Unlocking can take a few seconds and needs 1 GiB of free memory on every device that opens the vault."))
                                : root.kdf-method == 2 ? (root.kdf-level == 0 ? @tr("600,000 rounds, the least recommended today.")
                                    : root.kdf-level == 1 ? @tr("1,200,000 rounds.")
                                    : root.kdf-level == 2 ? @tr("2,400,000 rounds.")
                                    : @tr("5,000,000 rounds. Unlocking can take a few seconds."))
                                : root.kdf-level == 0 ? @tr("64 MiB of memory, 3 passes. For older computers or ones with little memory.")
                                : root.kdf-level == 1 ? @tr("256 MiB of memory, 3 passes. The default, a good balance on most computers.")
                                : root.kdf-level == 2 ? @tr("512 MiB of memory, 4 passes. Guessing gets about three times as slow; so does unlocking.")
                                : @tr("1 GiB of memory, 5 passes. The slowest to guess. Unlocking can take a few seconds and needs 1 GiB of free memory on every device that opens the vault.");
                            font-size: Theme.small;
                            color: Theme.graphite;
                            wrap: word-wrap;
                        }
                        Fact {
                            label: @tr("Now");
                            value: root.kdf-current < 0 ? @tr("Custom: {}", root.vault-kdf)
                                : root.unlock-time != "" ? @tr("{} · about {} s per unlock on this computer", root.vault-kdf, root.unlock-time)
                                : root.vault-kdf;
                        }
                        if root.kdf-level != root.kdf-current || root.kdf-method != root.kdf-current-method: HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            Button {
                                text: @tr("Apply…");
                                clicked => { root.open-dialog(2); }
                            }
                            VerticalLayout {
                                alignment: center;
                                QuietButton {
                                    text: @tr("Cancel");
                                    clicked => {
                                        root.kdf-level = Math.max(0, root.kdf-current);
                                        root.kdf-method = root.kdf-current-method;
                                    }
                                }
                            }
                        }
                    }

                    SettingsCard {
                        icon: "leaked";
                        title: @tr("Privacy");
                        summary: @tr("What the app may do on the network by itself.");
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Check {
                                text: @tr("Watch for leaked passwords every day");
                                checked <=> root.leak-watch;
                                toggled => { root.settings-changed(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("Once a day while the vault is open, every login's password is checked against the newest list of data breaches (Have I Been Pwned). Only the first 5 characters of each password's SHA-1 fingerprint leave this computer, never a password. As soon as one turns up in a new breach, the app tells you and Password health shows it. Off until you turn it on, since it uses the network by itself.");
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Check {
                                text: @tr("Show website icons");
                                checked <=> root.website-icons;
                                toggled => { root.settings-changed(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("Downloads each site's own icon directly from that site, once, over a secure connection, and keeps it encrypted with your vault. Nothing else is sent. Trade-off: someone watching your network (your provider, a public Wi-Fi) could see which sites were contacted, which hints at where you have accounts. Leave it off for maximum privacy.");
                                }
                            }
                        }
                    }

                    SettingsCard {
                        icon: "history";
                        title: @tr("Security log");
                        summary: @tr("What was done with this vault on this computer, newest first: unlocks and wrong passwords, what the browser extension was given, exports, the emergency kit, devices. Look here for anything you didn't do.");
                        hint: @tr("Kept on this computer only, encrypted so that only the open vault reads it, and never synced. It holds no password, only what happened, the site and the item's name. A program running as you could still delete it, so an empty log proves nothing.");
                        if root.security-log.length == 0: Text {
                            text: @tr("Nothing yet.");
                            font-size: Theme.small;
                            color: Theme.graphite;
                        }
                        for line in root.security-log: HorizontalLayout {
                            spacing: 12px;
                            Text {
                                width: 130px;
                                text: line.at;
                                font-size: Theme.small;
                                color: Theme.graphite;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                Text {
                                    text: Messages.security-event(line.kind, line.detail);
                                    font-size: Theme.small;
                                    color: line.kind == 0 || line.kind == 2 || line.kind == 14 ? Theme.seal : Theme.ink;
                                    overflow: elide;
                                }
                                if line.site != "" || line.title != "": Text {
                                    text: Messages.security-where(line.site, line.title);
                                    font-size: Theme.small;
                                    color: Theme.graphite;
                                    overflow: elide;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if root.security-log-more > 0: QuietButton {
                                outlined: true;
                                text: @tr("Show older ({})", root.security-log-more);
                                clicked => { root.security-log-show-more(); }
                            }
                            if !root.security-log-confirm: QuietButton {
                                text: @tr("Clear the log…");
                                clicked => { root.security-log-confirm = true; }
                            }
                            if root.security-log-confirm: Text {
                                text: @tr("Clear every line? One line will say when it was cleared.");
                                font-size: Theme.small;
                                color: Theme.ink;
                                vertical-alignment: center;
                            }
                            if root.security-log-confirm: QuietButton {
                                outlined: true;
                                text: @tr("Clear");
                                clicked => {
                                    root.security-log-confirm = false;
                                    root.security-log-clear();
                                }
                            }
                            if root.security-log-confirm: QuietButton {
                                text: @tr("Keep it");
                                clicked => { root.security-log-confirm = false; }
                            }
                        }
                    }

                    // How this computer keeps the Secret Key (CRYPTO.md §2.2.1).
                    if root.secret-key-kept != 0: SettingsCard {
                        icon: "shield";
                        title: @tr("Secret Key on this computer");
                        summary: root.secret-key-kept == 1
                            ? @tr("Kept under a key in this computer's security chip (TPM), which never leaves it. A copy of this computer's disk or of your Windows profile doesn't carry it.")
                            : @tr("Kept by Windows alone: this computer has no security chip (TPM) the app can use.");
                        hint: @tr("Your Secret Key and your master password together open the vault, so this computer keeps the Secret Key for you. A program running as you can still ask for it while you're signed in, as it could ask Windows; the chip stops it from being copied away and opened on another computer. If the chip is ever cleared or replaced, the vault asks once for the Secret Key from your emergency kit.");
                        if root.secret-key-kept == 2: Text {
                            text: @tr("Weaker than with a chip: a copy of your Windows profile, with your Windows password, opens it on another computer.");
                            font-size: Theme.small;
                            color: Theme.seal;
                            wrap: word-wrap;
                        }
                    }
                }

                // ---- this vault
                if root.section == 1: VerticalLayout {
                    spacing: 16px;
                    PageTitle { text: @tr("This vault"); }
                    SettingsCard {
                        icon: "vault";
                        title: @tr("Name and history");
                        summary: @tr("Stored inside the vault, encrypted: they follow it to every computer.");
                        HorizontalLayout {
                            spacing: 16px;
                            LineField {
                                horizontal-stretch: 1;
                                label: @tr("Name");
                                icon: "tag";
                                placeholder: root.vault-file-name;
                                error: root.error-code == 27;
                                text <=> root.vault-name;
                                accepted => { root.vault-settings-changed(); }
                            }
                            VerticalLayout {
                                alignment: end;
                                QuietButton {
                                    outlined: true;
                                    text: @tr("Rename");
                                    clicked => { root.vault-settings-changed(); }
                                }
                            }
                        }
                        if root.error-code == 27: ErrorText {
                            code: root.error-code;
                            detail: root.error-detail;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Stepper {
                                label: @tr("Old passwords kept per item");
                                value <=> root.history-limit;
                                minimum: 0;
                                maximum: 100;
                                changed => { root.vault-settings-changed(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("When you change an item's password, the old one is kept in its Password history, newest last, so you can go back if the change didn't take on the site. 0 keeps none. Lowering the number trims each item's history the next time its password changes.");
                                }
                            }
                        }
                    }
                    SettingsCard {
                        icon: "palette";
                        title: @tr("Icon on this computer");
                        summary: @tr("Shown with the vault's name in the title bar, on this computer only: each computer picks its own, and nothing of it goes into the vault.");
                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;
                            VerticalLayout {
                                alignment: start;
                                VaultMark {
                                    width: 44px;
                                    height: 44px;
                                    icon: root.vault-icon;
                                    initial: root.vault-initial;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                for row in 4: HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    for k in 8: Rectangle {
                                        property <string> glyph: FolderLook.icons[row * 8 + k];
                                        property <bool> chosen: root.vault-icon == self.glyph;
                                        width: 34px;
                                        height: 34px;
                                        border-radius: Theme.radius;
                                        background: self.chosen ? Theme.selected : vault-icon-touch.has-hover ? Theme.hover : transparent;
                                        border-width: self.chosen ? 1px : 0px;
                                        border-color: Theme.marker;
                                        accessible-role: button;
                                        accessible-label: self.glyph;
                                        Glyph {
                                            width: 17px;
                                            height: 17px;
                                            name: parent.glyph;
                                            tint: FolderLook.tint(parent.glyph, 0);
                                        }
                                        vault-icon-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.vault-icon-chosen(parent.glyph); }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    padding-top: 6px;
                                    QuietButton {
                                        text: @tr("Use its initial");
                                        outlined: true;
                                        clicked => { root.vault-icon-chosen(""); }
                                    }
                                }
                            }
                        }
                    }
                    SettingsCard {
                        icon: "stack";
                        title: @tr("What it holds");
                        summary: @tr("Read from the open vault.");
                        VerticalLayout {
                            spacing: 6px;
                            Fact { label: @tr("Items"); value: @tr("{} items in {} folders", root.vault-items, root.vault-folders); }
                            Fact { label: @tr("Encryption"); value: "XChaCha20-Poly1305 · " + root.vault-kdf; }
                            Fact {
                                label: @tr("Recovery");
                                value: root.vault-recovery == 2 ? @tr("Three recovery parts: any two bring back the Secret Key, all three a new master password")
                                    : root.vault-recovery == 1 ? @tr("The Recovery Key of an older kit: make a new kit to get recovery parts")
                                    : @tr("None: a forgotten master password can't be recovered");
                            }
                            Fact { label: @tr("File"); value: root.vault-path; }
                            Fact { label: @tr("Vault ID"); value: root.vault-id; mono: true; }
                        }
                    }
                }

                // ---- sync
                if root.section == 2: VerticalLayout {
                    spacing: 16px;
                    PageTitle { text: @tr("Sync"); }
                    SettingsCard {
                        icon: "refresh";
                        title: root.sync-kind == 0 ? @tr("Not syncing") : @tr("Syncing");
                        summary: @tr("Keeps this vault the same on your other devices: through a folder they all see (OneDrive, Google Drive, Dropbox, Syncthing, a network share), your own vault server, or a WebDAV folder (Nextcloud, a NAS). A phone needs the server or WebDAV.");
                        hint: @tr("Each device writes only its own copy, encrypted like the vault file: it opens only with your master password and Secret Key, which never leave your devices. With a folder this app sends nothing anywhere; the folder's own program carries the files. A server gets only these sealed copies and each device's public key, and every request is signed by the device. Copies are merged item by item: an item deleted on one device is deleted on all, and when the same item was changed on two, the newer version is kept and the other password goes into its history. An older copy put back is refused.");
                        if root.sync-kind == 0: HorizontalLayout {
                            alignment: start;
                            spacing: 12px;
                            QuietButton {
                                outlined: true;
                                icon: "folder";
                                text: @tr("Choose a folder…");
                                clicked => { root.sync-choose(); }
                            }
                            QuietButton {
                                outlined: true;
                                icon: "server";
                                text: @tr("Use a server…");
                                clicked => { root.sync-form = 1; }
                            }
                            QuietButton {
                                outlined: true;
                                icon: "cloud";
                                text: @tr("Use WebDAV…");
                                clicked => { root.sync-form = 2; }
                            }
                        }
                        if root.sync-kind != 0: VerticalLayout {
                            spacing: 8px;
                            Fact {
                                label: root.sync-kind == 1 ? @tr("Folder") : root.sync-kind == 2 ? @tr("Server") : @tr("WebDAV");
                                value: root.sync-folder;
                            }
                            if root.sync-backup != "": Fact {
                                label: @tr("Backup server");
                                value: root.sync-backup;
                            }
                            Fact {
                                label: @tr("Last synced");
                                value: root.sync-state == 2 ? @tr("Syncing…")
                                    : root.sync-state == 3 ? (root.sync-detail == "" ? @tr("Failed") : @tr("Failed: {}", root.sync-detail))
                                    : root.sync-minutes < 0 ? @tr("Not yet")
                                    : root.sync-minutes == 0 ? @tr("Just now")
                                    : @tr("{n} minute ago" | "{n} minutes ago" % root.sync-minutes);
                            }
                            if root.sync-state == 4: Fact {
                                label: @tr("Waiting");
                                value: @tr("{n} item changed on two devices waits for the item lock" | "{n} items changed on two devices wait for the item lock" % root.sync-waiting);
                            }
                            if root.sync-key-behind > 0: Fact {
                                label: @tr("Former key");
                                value: @tr("{n} device still uses the vault's former key: its changes come in once it takes the new one" | "{n} devices still use the vault's former key: their changes come in once they take the new one" % root.sync-key-behind);
                            }
                        }
                        if root.sync-kind != 0 && root.sync-key-renewed: Rectangle {
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.seal;
                            background: Theme.sheet;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                Text {
                                    text: @tr("The vault key was renewed on another device: its copies open only with the new Secret Key, from the new emergency kit made there. Type it once here to keep syncing.");
                                    font-size: Theme.body;
                                    color: Theme.ink;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    QuietButton {
                                        outlined: true;
                                        icon: "key";
                                        text: @tr("Type the new Secret Key…");
                                        clicked => { root.open-dialog(14); }
                                    }
                                }
                            }
                        }
                        if root.sync-backup != "" && (root.sync-main-down != "" || root.sync-backup-down != ""): Rectangle {
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.seal;
                            background: Theme.sheet;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text {
                                    text: root.sync-main-down != "" && root.sync-backup-down == ""
                                            ? @tr("The main place isn't answering. The vault keeps syncing through the backup server, and the main one catches up as soon as it answers (it is tried every minute).")
                                        : root.sync-main-down != "" && root.sync-backup-down != ""
                                            ? @tr("Neither the main place nor the backup server is answering. Changes stay on this computer and go out as soon as one answers.")
                                            : @tr("The backup server isn't answering. The vault keeps syncing through the main place, and the backup catches up as soon as it answers.");
                                    font-size: Theme.body;
                                    color: Theme.ink;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: root.sync-main-down != "" ? root.sync-main-down : root.sync-backup-down;
                                    font-size: Theme.small;
                                    color: Theme.graphite;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        if root.sync-setup-error != "" && root.sync-form == 0 && !root.sync-backup-form: Text {
                            text: root.sync-setup-error;
                            font-size: Theme.body;
                            color: Theme.seal;
                            wrap: word-wrap;
                        }
                        if root.sync-kind != 0: HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            Button {
                                text: root.sync-state == 2 ? @tr("Syncing…") : @tr("Sync now");
                                icon: "refresh";
                                enabled: root.sync-state != 2;
                                clicked => { root.sync-now(); }
                            }
                            if root.sync-kind == 2: VerticalLayout {
                                alignment: center;
                                QuietButton {
                                    outlined: true;
                                    icon: "pencil";
                                    text: @tr("Change the address…");
                                    clicked => { root.open-dialog(12); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                QuietButton {
                                    text: @tr("Stop syncing…");
                                    tint: Theme.seal;
                                    clicked => { root.open-dialog(5); }
                                }
                            }
                        }
                    }

                    if root.sync-kind != 0: SettingsCard {
                        icon: "phone";
                        title: @tr("Devices");
                        summary: @tr("The devices that sync this vault. Removing one isn't for good: it can join again later, as a new device, with a new invite.");
                        Fact {
                            label: @tr("This device");
                            value: root.sync-this-device;
                        }
                        for device[index] in root.sync-others: HorizontalLayout {
                            spacing: 12px;
                            Text {
                                width: 170px;
                                text: index == 0 ? @tr("Other devices") : "";
                                font-size: Theme.small;
                                color: Theme.graphite;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                Text {
                                    text: device.name;
                                    font-size: Theme.body;
                                    color: Theme.ink;
                                    overflow: elide;
                                }
                                if device.away: Text {
                                    text: @tr("No copy here yet: it synced somewhere else");
                                    font-size: Theme.small;
                                    color: Theme.graphite;
                                    overflow: elide;
                                }
                                if device.problem != "": Text {
                                    text: device.refused
                                        ? @tr("Its copy wasn't used (found {}): {}", device.problem-at, device.problem)
                                        : @tr("Its copy couldn't be read (found {}): {}", device.problem-at, device.problem);
                                    font-size: Theme.small;
                                    color: Theme.seal;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                QuietButton {
                                    text: @tr("Remove…");
                                    clicked => {
                                        root.sync-removing = index;
                                        root.open-dialog(6);
                                    }
                                }
                            }
                        }
                        if root.sync-kind == 2: HorizontalLayout {
                            alignment: start;
                            QuietButton {
                                outlined: true;
                                icon: "qr";
                                text: root.sync-busy ? @tr("Asking the server…") : @tr("Add a device…");
                                enabled: !root.sync-busy;
                                clicked => { root.open-dialog(7); }
                            }
                        }
                    }

                    if root.sync-kind != 0: SettingsCard {
                        icon: "server";
                        title: @tr("Backup server");
                        summary: root.sync-backup != ""
                            ? @tr("A second server keeps a copy too: while the main place is down the vault syncs through it, and the main one catches up as soon as it is back.")
                            : @tr("A second server can keep a copy too, so the vault keeps syncing while the main place is down.");
                        HorizontalLayout {
                            alignment: start;
                            spacing: 12px;
                            if root.sync-backup != "": QuietButton {
                                outlined: true;
                                icon: "pencil";
                                text: @tr("Change the address…");
                                clicked => { root.open-dialog(13); }
                            }
                            if root.sync-backup == "": QuietButton {
                                outlined: true;
                                icon: "plus";
                                text: @tr("Add a backup server…");
                                clicked => { root.sync-backup-form = true; }
                            }
                            if root.sync-backup != "": QuietButton {
                                outlined: true;
                                text: @tr("Remove the backup…");
                                tint: Theme.seal;
                                clicked => { root.open-dialog(8); }
                            }
                        }
                    }
                }

                // ---- browser extension
                if root.section == 3: VerticalLayout {
                    spacing: 16px;
                    PageTitle { text: @tr("Browser extension"); }
                    SettingsCard {
                        icon: "browser";
                        title: @tr("Connection with the browser");
                        summary: @tr("The extension fills and saves logins in Chrome, Edge, Firefox and the like by asking this app. Off, it can't reach the vault at all.");
                        hint: @tr("The extension keeps no passwords. The first time, it asks to be connected and this app asks for your master password; after that only that extension gets answers, only while the vault is open, only for the exact site a login was saved for (write *.example.com as the website to include every site under it), and only on pages with https. A login behind the item lock is opened for one fill, show or copy by Windows Hello or by its PIN, typed in the extension's own window. Copies are made by this app, out of clipboard history. Limit: a malicious program already running under your Windows account could copy the browser's data and ask like the extension, which is why the accounts that matter belong behind the item lock.");
                        Check {
                            text: @tr("Let the browser extension connect to this app");
                            checked <=> root.browser-extension;
                            toggled => { root.settings-changed(); }
                        }
                        if root.browser-paired: HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            Text {
                                text: @tr("An extension is connected to this vault.");
                                font-size: Theme.small;
                                color: Theme.ink;
                                vertical-alignment: center;
                            }
                            QuietButton {
                                outlined: true;
                                text: @tr("Disconnect…");
                                clicked => { root.open-dialog(9); }
                            }
                        }
                        if root.browser-extension && !root.browser-paired: Text {
                            text: @tr("Not connected yet: open the extension in the browser and click Connect.");
                            font-size: Theme.small;
                            color: Theme.graphite;
                            wrap: word-wrap;
                        }
                    }
                    if root.browser-extension: SettingsCard {
                        icon: "sliders";
                        title: @tr("What the extension may do");
                        summary: @tr("Kept on this computer. The extension follows them as soon as it next asks.");
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Check {
                                text: @tr("Ask for Windows Hello or the PIN every time the browser uses a password");
                                checked <=> root.browser-always-asks;
                                toggled => { root.settings-changed(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("Each fill, show or copy of a password, each one-time code and each passkey asks first, in that request: picking another login asks again. Windows Hello when it unlocks this vault or the item lock here, else the item lock's PIN or password, typed in the extension's own window. Off, only the logins behind the item lock ask.");
                                }
                            }
                        }
                        if root.browser-always-asks && root.browser-ask-way == 0: Text {
                            text: @tr("Nothing here can ask yet: turn on Windows Hello, or give the item lock a PIN.");
                            font-size: Theme.small;
                            color: Theme.seal;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Check {
                                text: @tr("List every login in the extension's window");
                                checked <=> root.browser-whole-vault;
                                toggled => { root.settings-changed(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("Off, the extension's window lists only the logins of the open site: whoever copied the extension's key from this browser learns no more than the sites it asks about. Items and folders kept out of the browser are never listed.");
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Check {
                                text: @tr("Offer to save logins typed into pages");
                                checked <=> root.browser-saves;
                                toggled => { root.settings-changed(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("After you sign in on a page, the extension offers to save the login here, or to update its password when it changed. Logins saved while the vault is locked wait, sealed, and join it at the next unlock. Off, nothing is offered or saved from the browser.");
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Check {
                                text: @tr("Warn when a page isn't the site a password belongs to");
                                checked <=> root.browser-warnings;
                                toggled => { root.settings-changed(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("When you paste or send the password of one of your logins on another site, or open a sign-in page that only looks like a site you have a login for (paypa1.com for paypal.com), the extension says so in the page and names the site. This app compares, from your vault's own sites; nothing is downloaded and the extension keeps nothing. Logins behind the item lock are never compared. The emergency kit's keys are refused in every page either way.");
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Check {
                                text: @tr("Make and use passkeys from this vault");
                                checked <=> root.browser-passkeys;
                                toggled => { root.settings-changed(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("When a site makes a passkey, it is saved in the login for that site, in this vault, and syncs with it; when a site asks for one, this vault answers. You see a login's passkeys on its page. Off, the browser handles passkeys as before.");
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Check {
                                text: @tr("Fill with Windows Hello while the vault is locked");
                                checked <=> root.browser-locked-fill;
                                toggled => { root.settings-changed(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("The app keeps the passwords of your logins for the extension in a file only Windows Hello opens, so a locked vault can still fill: each password asks for your face, fingerprint or Windows PIN. The item lock's PIN does not work here, because a copied file could be tried against every PIN away from this app. It needs Windows Hello on in Item lock and the app running (closed to the notification area is fine). Usernames and websites stay readable to your Windows account so the extension can list them.");
                                }
                            }
                        }
                        Check {
                            text: @tr("Show a notice here for every login the extension fills");
                            checked <=> root.browser-fill-notices;
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingsCard {
                        icon: "download";
                        title: @tr("Add to a browser");
                        summary: @tr("Updated with the app: each new version of Vault brings the extension's, and the extension reloads itself. Choose a browser: it opens on its extensions page, and the steps show here.");
                        if root.extension-browsers.length > 0: HorizontalLayout {
                            spacing: 12px;
                            BrowserPicker {
                                horizontal-stretch: 1;
                                browsers: root.extension-browsers;
                                selected <=> root.extension-browser;
                            }
                            VerticalLayout {
                                alignment: end;
                                QuietButton {
                                    outlined: true;
                                    text: @tr("Add to {}…", root.extension-browsers[root.extension-browser].name);
                                    clicked => { root.add-extension(root.extension-browser); }
                                }
                            }
                        }
                        // Written out rather than under an `if`, so that it wraps inside the card.
                        Text {
                            text: root.extension-browsers.length == 0 ? @tr("No browser was found where browsers are usually installed. Open the folder, then load it from your browser's extensions page: Developer mode, then Load unpacked.") : "";
                            visible: root.extension-browsers.length == 0;
                            height: root.extension-browsers.length == 0 ? self.preferred-height : 0px;
                            font-size: Theme.small;
                            color: Theme.graphite;
                            wrap: word-wrap;
                        }
                        // Where its files come from now (written out, so that it wraps in the card).
                        Text {
                            text: root.extension-source == 2 ? @tr("In use: version {} from your folder {}. Vault copies it into a folder of its own and follows your changes.", root.extension-version, root.extension-local)
                                : root.extension-source == 1 ? @tr("In use: version {} from the project's releases on GitHub, checked against the SHA-256 that GitHub lists.", root.extension-version)
                                : @tr("In use: version {}, built into this app. Newer ones come from the project's releases on GitHub when Vault looks for its own updates.", root.extension-version);
                            font-size: Theme.small;
                            color: Theme.graphite;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            QuietButton {
                                outlined: true;
                                icon: "folder";
                                text: @tr("Open the folder");
                                clicked => { root.open-extension-folder(); }
                            }
                            QuietButton {
                                outlined: true;
                                text: root.extension-source == 2 ? @tr("Use the extension from GitHub") : @tr("Use a folder on this computer instead…");
                                clicked => {
                                    if (root.extension-source == 2) {
                                        root.use-extension-release();
                                    } else {
                                        root.choose-extension-folder();
                                    }
                                }
                            }
                        }
                        if root.error-code >= 70 && root.error-code <= 72: ErrorText {
                            code: root.error-code;
                            detail: root.error-detail;
                        }
                    }
                }

                // ---- appearance
                if root.section == 4: VerticalLayout {
                    spacing: 16px;
                    PageTitle { text: @tr("Appearance"); }
                    SettingsCard {
                        icon: "sliders";
                        title: @tr("Look");
                        summary: @tr("How the app looks on this computer.");
                        Choice {
                            options: [@tr("Dark"), @tr("Light")];
                            selected: root.dark ? 0 : 1;
                            changed(index) => { root.appearance-changed(index == 0); }
                        }
                        // Each language is named in itself; the list follows src/i18n.rs → LANGUAGES.
                        HorizontalLayout {
                            Dropdown {
                                width: 280px;
                                label: @tr("Language");
                                icon: "globe";
                                options: [@tr("Same as Windows"), "English", "Português (Brasil)"];
                                marks: [@image-url("brand/flags/system.svg"), @image-url("brand/flags/us.svg"), @image-url("brand/flags/br.svg")];
                                selected <=> root.language;
                                changed(index) => { root.language-changed(index); }
                            }
                        }
                        Check {
                            text: @tr("The drawn texture behind the vault");
                            checked <=> root.backdrop-on;
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingsCard {
                        icon: "gear";
                        title: @tr("Starting and closing");
                        summary: @tr("When the app starts, and what closing the window does.");
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Check {
                                    text: @tr("Open when I sign in to Windows");
                                    checked <=> root.start-at-sign-in;
                                    toggled(on) => { root.start-at-sign-in-changed(on); }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Hint {
                                        text: @tr("Windows starts the app when you sign in, locked: nothing opens by itself, and the browser extension can reach it from the start. It shows in Task Manager's Startup apps, where it can be turned off too.");
                                    }
                                }
                            }
                            // Shown while the start at sign-in is on: it only matters then.
                            if root.start-at-sign-in: Check {
                                text: @tr("Start in the notification area, without opening the window");
                                checked <=> root.start-in-tray;
                                toggled => { root.settings-changed(); }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Check {
                                    text: @tr("Keep running in the notification area when the window is closed");
                                    checked <=> root.close-to-tray;
                                    toggled => { root.settings-changed(); }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Hint {
                                        text: @tr("Closing the window then hides it: nothing is drawn and the app uses very little, the browser extension keeps working, and the vault still locks itself after the idle time set in Security. Open it again from the icon next to the clock; its menu also locks the vault or quits.");
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- about
                if root.section == 5: VerticalLayout {
                    spacing: 16px;
                    PageTitle { text: @tr("About"); }
                    SettingsCard {
                        icon: "lifebuoy";
                        title: @tr("Vault {}", root.app-version);
                        summary: @tr("A password manager that keeps everything in one encrypted file on your devices. Free software under the GPL, version 3 or later.");
                        VerticalLayout {
                            spacing: 6px;
                            Fact { label: @tr("Version"); value: root.app-version; }
                            Fact { label: @tr("Encryption"); value: "XChaCha20-Poly1305 · Argon2id"; }
                            Fact { label: @tr("Status"); value: @tr("Early development, not audited yet: keep a copy of what matters elsewhere too."); }
                        }
                    }
                    SettingsCard {
                        icon: "download";
                        title: @tr("Updates");
                        summary: @tr("Asks GitHub, where the project's releases are, every hour while the app runs and when you press the button. Nothing about your vault is sent.");
                        VerticalLayout {
                            spacing: 10px;
                            Check {
                                text: @tr("Look for updates by itself");
                                checked <=> root.update-checks;
                                toggled => { root.settings-changed(); }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Check {
                                    text: @tr("Install updates by itself");
                                    checked <=> root.update-install;
                                    toggled => { root.settings-changed(); }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Hint {
                                        text: @tr("A newer version is downloaded, checked against the release's manifest (signed by the project's key, which the app carries) and put in this program's place. Vault then asks when to restart. Off, it is only told, and Install now does the same when you choose.");
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Button {
                                    text: @tr("Check for updates");
                                    busy-text: @tr("Checking…");
                                    busy: root.update-state == 1;
                                    enabled: root.install-step == 0 || root.install-step >= 5;
                                    clicked => { root.check-updates(); }
                                }
                            }
                            Rectangle {
                                height: root.update-state == 3 || root.install-step > 0 ? about-update.preferred-height : 0px;
                                visible: root.update-state == 3 || root.install-step > 0;
                                border-radius: Theme.radius;
                                border-width: 1px;
                                border-color: Theme.rule;
                                about-update := VerticalLayout {
                                padding: 14px;
                                UpdateCard {
                                    version: root.update-version;
                                    told: root.update-state == 3;
                                    step: root.install-step;
                                    done-kb: root.install-done-kb;
                                    total-kb: root.install-total-kb;
                                    installed: root.install-version;
                                    failure: root.install-failure;
                                    failed-at: root.install-failed-at;
                                    detail: root.install-detail;
                                    install => { root.install-update(); }
                                    restart => { root.restart-now(); }
                                    open-release => { root.open-release(); }
                                }
                                }
                            }
                            Text {
                                text: root.update-state == 2 ? @tr("This is the newest version.")
                                    : root.update-state == 4 ? @tr("Couldn't look for updates: {}", root.update-detail)
                                    : "";
                                height: self.text == "" ? 0px : self.preferred-height;
                                font-size: Theme.small;
                                color: root.update-state == 4 ? Theme.seal : Theme.ink;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Every one-time code in the vault, live.
export component AuthenticatorPage inherits Rectangle {
    in property <[AuthRow]> rows;
    in property <int> total;
    in-out property <string> search-text;
    // Some codes belong to locked items (hidden until the item lock's check: 0 master
    // password, 1 PIN, 2 password); or they are open now and can be locked again.
    in property <bool> locked;
    in property <bool> guarded-open;
    in property <int> check;
    in property <bool> hello;
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    callback unlock-hello();
    callback search(string);
    callback copy-code(int);
    callback open-item(int);
    callback unlock();
    callback lock-secrets();
    // A new item made for its codes only (the editor opens on "Authenticator").
    callback add-code();
    // A QR code read from a picture file: one key opens the editor with it, a transfer code
    // of another authenticator app goes to the import review.
    callback code-from-picture();

    ScrollView {
        // No sideways scrolling: the page is as wide as the window, and what it holds wraps.
        content-width: self.visible-width;
        VerticalLayout {
            padding: 40px;
            padding-right: 48px;
            spacing: 14px;
            alignment: start;

            HorizontalLayout {
                spacing: 16px;
                PageTitle {
                    text: @tr("Authenticator");
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    QuietButton {
                        icon: "qr";
                        text: @tr("From a QR picture…");
                        clicked => { root.code-from-picture(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    QuietButton {
                        outlined: true;
                        icon: "clock";
                        text: @tr("Add a code");
                        clicked => { root.add-code(); }
                    }
                }
            }
            Prose {
                text: @tr("Every two-step sign-in code in your vault, always current. Click Copy, then paste the code where the site asks for it.");
            }
            if root.locked: LockBox {
                check: root.check;
                text: root.check == 1 ? @tr("The codes of locked items are hidden and can't be copied. Your PIN opens all of them for 5 minutes.")
                    : root.check == 2 ? @tr("The codes of locked items are hidden and can't be copied. Your item password opens all of them for 5 minutes.")
                    : @tr("The codes of locked items are hidden and can't be copied. Your master password opens all of them for 5 minutes.");
                busy: root.busy;
                error-code: root.error-code;
                error-detail: root.error-detail;
                hello: root.hello;
                unlock-hello => { root.unlock-hello(); }
                unlock => { root.unlock(); }
            }
            if root.guarded-open: HorizontalLayout {
                alignment: start;
                QuietButton {
                    outlined: true;
                    text: @tr("Lock the codes again");
                    clicked => { root.lock-secrets(); }
                }
            }
            if root.total > 0: LineField {
                placeholder: @tr("Search codes");
                text <=> root.search-text;
                edited(text) => { root.search(text); }
            }
            if root.total == 0: Rectangle {
                border-radius: Theme.radius + 2px;
                border-width: 1px;
                border-color: Theme.rule;
                background: Theme.panel;
                VerticalLayout {
                    padding: 18px;
                    spacing: 8px;
                    Text {
                        text: @tr("No codes yet");
                        font-size: Theme.lead;
                        font-weight: 600;
                        color: Theme.ink;
                    }
                    Prose {
                        text: @tr("When a site offers two-step sign-in with an authenticator app, it shows a QR code and a text key (often under “Can't scan it?”). Click Add a code and paste that key, or edit the site's login and paste it into “One-time code secret”: its codes appear on this page, and you no longer need a separate authenticator app.");
                    }
                }
            }
            if root.total > 0 && root.rows.length == 0: Prose {
                text: @tr("Nothing matches “{}”.", root.search-text);
            }
            for row[index] in root.rows: Rectangle {
                height: 72px;
                border-radius: Theme.radius;
                background: Theme.panel;
                clip: true;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        ItemIcon {
                            icon: row.icon;
                            has-icon: row.has-icon;
                            initial: row.initial;
                            tint: row.tint;
                            kind: row.kind;
                            glyph: row.glyph;
                            glyph-color: row.glyph-color;
                            glyph-bg: row.glyph-bg;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        horizontal-stretch: 1;
                        title-text := Text {
                            text: row.title;
                            font-size: Theme.body;
                            font-weight: 600;
                            color: title-touch.has-hover ? Theme.accent-stroke : Theme.ink;
                            overflow: elide;
                            title-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.open-item(index); }
                            }
                        }
                        Text {
                            text: row.subtitle;
                            font-size: Theme.small;
                            color: Theme.graphite;
                            overflow: elide;
                        }
                    }
                    if row.locked: VerticalLayout {
                        alignment: center;
                        FieldIcon { name: "lock"; size: 18px; }
                    }
                    Text {
                        text: row.locked ? "••• •••" : row.code;
                        accessible-label: @tr("One-time code: shown on screen, not read aloud");
                        font-family: Theme.mono-font;
                        font-size: Theme.title;
                        color: row.locked ? Theme.faint : row.left <= 5 ? Theme.seal : Theme.ink;
                        vertical-alignment: center;
                    }
                    Text {
                        width: 34px;
                        text: row.locked ? "" : @tr("{} s", row.left);
                        font-size: Theme.small;
                        color: row.left <= 5 ? Theme.seal : Theme.faint;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                    VerticalLayout {
                        alignment: center;
                        QuietButton {
                            text: @tr("Copy");
                            enabled: !row.locked;
                            clicked => { root.copy-code(index); }
                        }
                    }
                }
                // Time left on this code.
                Rectangle {
                    x: 0;
                    y: parent.height - 3px;
                    height: 3px;
                    width: row.locked ? 0px : parent.width * row.left / Math.max(1, row.period);
                    background: row.left <= 5 ? Theme.seal : Theme.marker;
                    opacity: 0.8;
                }
            }
        }
    }
}

// Import from other password managers, encrypted backup, unencrypted export.
export component TransferPage inherits Rectangle {
    in property <int> error-code;
    in property <string> error-detail;
    in property <bool> busy;
    // 0 choose where from, 1 KDBX password, 2 review, 3 done
    in property <int> import-stage;
    in property <[SourceRow]> sources;
    // "" (nothing chosen) then every source name, for the "From" selector.
    in property <[string]> source-names: [""];
    in-out property <int> source: -1;
    // 0 from a browser (sources 0–7), 1 from a password manager or a file (8–15).
    in-out property <int> import-mode: root.source >= 8 ? 1 : 0;
    in property <string> import-file;
    in property <[ImportRow]> import-rows;
    in property <int> import-selected;
    in property <int> import-duplicates;
    in property <string> import-warnings;
    in property <int> import-added;
    // 0 keep the file's folders, 1 no folder, 2 all in one folder (`import-folder`).
    in-out property <int> import-target;
    // "" (a new folder) then every folder of the vault.
    in property <[string]> import-folders: [""];
    in-out property <int> import-folder;
    in-out property <string> import-new-folder;
    // The chosen file is an unencrypted export: offer to wipe it after importing.
    in property <bool> import-plaintext;
    in-out property <int> export-format;
    callback pick-source(int);
    callback open-browser();
    // Reading a browser's own store: possible for this source, how (0 directly, 1 from a CSV),
    // and which of its profiles.
    in property <bool> direct-supported;
    in-out property <int> browser-method;
    in property <[string]> browser-profiles;
    in-out property <int> browser-profile;
    callback import-direct();
    property <bool> direct: root.direct-supported && root.browser-method == 0;
    callback import-choose();
    callback import-open();
    callback import-toggle(int, bool);
    callback import-select-all(bool);
    callback import-confirm();
    callback import-cancel();
    callback import-wipe();
    callback export-backup();
    // "Export…": counted, then asked in a dialog (app.slint).
    callback export-ask();

    // Errors 11 (master password) belong to the export section; the rest to the import one.
    property <bool> export-error: root.error-code == 11;

    // How to make the export, for each place (same order as vault_import::Source::ALL).
    pure function steps(index: int) -> string {
        if (index == 0) { return @tr("In Chrome open Google Password Manager (button below), then Settings → Export passwords → Download file. Chrome asks for your Windows PIN and saves a .csv file."); }
        if (index == 1) { return @tr("In Edge open Passwords (button below), click … (More actions) → Export passwords, confirm with your Windows PIN and save the .csv file."); }
        if (index == 2) { return @tr("In Firefox open Passwords (button below), click … (menu) → Export passwords…, confirm, and save the .csv file."); }
        if (index == 3) { return @tr("In Brave open the Password Manager (button below), then Settings → Export passwords → Download file."); }
        if (index == 4 || index == 5) { return @tr("In Opera open the passwords settings (button below), click ⋮ next to “Saved passwords” → Export passwords, and save the .csv file."); }
        if (index == 6) { return @tr("In Vivaldi open the Password Manager (button below), then Settings → Export passwords, and save the .csv file."); }
        if (index == 7) { return @tr("On the Mac: in Safari choose File → Export → Passwords…, or in the Passwords app File → Export All Passwords. Copy the .csv file to this computer."); }
        if (index == 8) { return @tr("In Bitwarden: Tools (or Settings) → Export vault, format “.json” (not the encrypted one), confirm with your master password."); }
        if (index == 9) { return @tr("In 1Password 8: File → Export → pick the account → format CSV, and confirm with your password."); }
        if (index == 10) { return @tr("In LastPass: Advanced options → Export → confirm with your master password. A .csv file is downloaded."); }
        if (index == 11) { return @tr("Choose the .kdbx database itself (you'll type its password next), or a CSV from KeePassXC: Database → Export → CSV file."); }
        if (index == 12) { return @tr("In Dashlane (web app): My account → Settings → Export data → CSV. Unzip it and choose credentials.csv."); }
        if (index == 13) { return @tr("In Proton Pass: Settings → Export → format CSV, confirm with your password."); }
        if (index == 14) { return @tr("In NordPass: Settings → Export items → confirm with your master password. A .csv file is saved."); }
        return @tr("Any CSV with a header row (name, url, username, password…) or an unencrypted .json export from another manager.");
    }

    ScrollView {
        // No sideways scrolling: the page is as wide as the window, and what it holds wraps.
        content-width: self.visible-width;
        VerticalLayout {
            padding: 40px;
            padding-right: 48px;
            spacing: 14px;
            alignment: start;

            PageTitle { text: @tr("Import & export"); }

            SectionTitle { text: @tr("Import"); }

            if root.import-stage == 0: VerticalLayout {
                spacing: 14px;
                Prose {
                    text: @tr("Bring in passwords from a browser or another password manager. You see every entry, with passwords hidden, before anything is added to this vault.");
                }
                Choice {
                    options: [@tr("From a browser"), @tr("From a password manager or file")];
                    selected <=> root.import-mode;
                    changed => {
                        root.source = -1;
                        root.pick-source(-1);
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    SourcePicker {
                        width: 340px;
                        label: root.import-mode == 0 ? @tr("Browser") : @tr("Password manager or file");
                        sources: root.sources;
                        first: root.import-mode == 0 ? 0 : 8;
                        count: 8;
                        selected <=> root.source;
                        changed(i) => { root.pick-source(i); }
                    }
                    if root.source >= 0 && root.sources[root.source].browser: VerticalLayout {
                        alignment: end;
                        Text {
                            height: Theme.control-height + 4px;
                            vertical-alignment: center;
                            text: root.sources[root.source].installed ? @tr("Installed on this computer") : @tr("Not found on this computer");
                            font-size: Theme.small;
                            color: root.sources[root.source].installed ? Theme.good : Theme.faint;
                        }
                    }
                }
                if root.source >= 0 && root.direct-supported: Choice {
                    options: [@tr("Read it directly"), @tr("From an exported CSV file")];
                    selected <=> root.browser-method;
                }
                if root.source >= 0 && root.direct: VerticalLayout {
                    spacing: 12px;
                    Prose {
                        text: root.browser-profiles.length == 0
                            ? @tr("No saved passwords found for {} on this computer.", root.sources[root.source].name)
                            : @tr("Reads the passwords {} saved for your Windows account, here on this computer. Nothing is sent anywhere, and you review them before anything is added. Close {} first.", root.sources[root.source].name, root.sources[root.source].name);
                        color: Theme.ink;
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        if root.browser-profiles.length > 1: Dropdown {
                            width: 340px;
                            label: @tr("Profile");
                            icon: "user";
                            options: root.browser-profiles;
                            selected <=> root.browser-profile;
                        }
                        // Firefox can lock its passwords with a primary password of its own.
                        if root.source == 2 && root.browser-profiles.length > 0: SecretField {
                            width: 340px;
                            field: 8;
                            eye: true;
                            label: @tr("Firefox primary password");
                            icon: "key";
                            placeholder: @tr("Leave empty if you never set one");
                            error: root.error-code == 19;
                            accepted => { root.import-direct(); }
                        }
                    }
                }
                if root.source >= 0 && !root.direct: Prose {
                    text: root.steps(root.source);
                    color: Theme.ink;
                }
                ErrorText {
                    code: root.export-error ? 0 : root.error-code;
                    detail: root.error-detail;
                }
                if root.direct && root.browser-profiles.length > 0: HorizontalLayout {
                    alignment: start;
                    Button {
                        text: @tr("Read passwords from {}", root.sources[root.source].name);
                        busy-text: @tr("Reading…");
                        busy: root.busy;
                        clicked => { root.import-direct(); }
                    }
                }
                if !root.direct: HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    if root.source >= 0 && root.sources[root.source].browser && root.sources[root.source].installed: QuietButton {
                        outlined: true;
                        text: @tr("Open {} passwords", root.sources[root.source].name);
                        clicked => { root.open-browser(); }
                    }
                    Button {
                        text: @tr("Choose the exported file…");
                        busy-text: @tr("Reading…");
                        busy: root.busy;
                        clicked => { root.import-choose(); }
                    }
                }
            }

            if root.import-stage == 1: VerticalLayout {
                spacing: 12px;
                max-width: 460px;
                Prose {
                    text: @tr("“{}” is protected by a password (a KeePass-format database, or an export made here with “Protected by a password”). Type it to open the file; it is only used to read it.", root.import-file);
                }
                SecretField {
                    field: 8;
                    eye: true;
                    label: @tr("Password of the file");
                    icon: "key";
                    error: root.error-code == 19;
                    accepted => { root.import-open(); }
                }
                ErrorText {
                    code: root.error-code;
                    detail: root.error-detail;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Button {
                        text: @tr("Open");
                        busy-text: @tr("Opening…");
                        busy: root.busy;
                        clicked => { root.import-open(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        QuietButton {
                            text: @tr("Cancel");
                            clicked => { root.import-cancel(); }
                        }
                    }
                }
            }

            // Review: every entry, passwords hidden; pick what to add and where.
            if root.import-stage == 2: VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: @tr("Review “{}”", root.import-file);
                            font-size: Theme.lead;
                            font-weight: 600;
                            color: Theme.ink;
                            overflow: elide;
                        }
                        Text {
                            text: root.import-duplicates > 0
                                ? @tr("{} entries · {} already in your vault (unticked)", root.import-rows.length, root.import-duplicates)
                                : @tr("{n} entry" | "{n} entries" % root.import-rows.length);
                            font-size: Theme.small;
                            color: Theme.graphite;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 4px;
                            QuietButton {
                                text: @tr("Select all");
                                clicked => { root.import-select-all(true); }
                            }
                            QuietButton {
                                text: @tr("Select none");
                                clicked => { root.import-select-all(false); }
                            }
                        }
                    }
                }
                // On a card of its own, as in Settings: the page's texture stays behind it.
                Rectangle {
                    border-radius: Theme.radius + 2px;
                    border-width: 1px;
                    border-color: Theme.rule;
                    background: Theme.panel;
                    height: Math.min(380px, 44px + root.import-rows.length * 44px);
                    clip: true;
                    VerticalLayout {
                        // Header
                        Rectangle {
                            height: 36px;
                            background: Theme.sheet;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;
                                Rectangle { width: 18px; }
                                for heading[i] in [@tr("Title"), @tr("Username"), @tr("Password"), @tr("Folder")]: Text {
                                    horizontal-stretch: i < 2 ? 3 : 2;
                                    min-width: 0px;
                                    preferred-width: 0px;
                                    overflow: elide;
                                    text: heading;
                                    font-size: Theme.small;
                                    color: Theme.graphite;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        ScrollView {
                            // No sideways scrolling: the page is as wide as the window, and what it holds wraps.
                            content-width: self.visible-width;
                            VerticalLayout {
                                for row[index] in root.import-rows: Rectangle {
                                    height: 44px;
                                    background: review-touch.has-hover ? Theme.hover : transparent;
                                    opacity: row.include ? 1 : 0.55;
                                    review-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.import-toggle(index, !row.include); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 4px;
                                                background: row.include ? Theme.marker : Theme.field;
                                                border-width: row.include ? 0px : 1px;
                                                border-color: Theme.graphite;
                                                if row.include: Path {
                                                    width: 14px;
                                                    height: 14px;
                                                    viewbox-width: 24;
                                                    viewbox-height: 24;
                                                    commands: Sketch.check;
                                                    stroke: Theme.on-marker;
                                                    stroke-width: 2px;
                                                    fill: transparent;
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 3;
                                            min-width: 0px;
                                            preferred-width: 0px;
                                            alignment: center;
                                            Text {
                                                text: row.title;
                                                font-size: Theme.body;
                                                color: Theme.ink;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: row.duplicate ? @tr("Already in your vault") : row.site;
                                                font-size: Theme.small;
                                                color: row.duplicate ? Theme.accent-stroke : Theme.faint;
                                                overflow: elide;
                                                height: self.text != "" ? self.preferred-height : 0px;
                                            }
                                        }
                                        Text {
                                            horizontal-stretch: 3;
                                            min-width: 0px;
                                            preferred-width: 0px;
                                            text: row.username;
                                            font-size: Theme.body;
                                            color: Theme.graphite;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        HorizontalLayout {
                                            horizontal-stretch: 2;
                                            min-width: 0px;
                                            preferred-width: 0px;
                                            spacing: 6px;
                                            alignment: start;
                                            Text {
                                                text: row.has-password ? "••••••••" : @tr("none");
                                                font-size: Theme.body;
                                                color: row.has-password ? Theme.ink : Theme.faint;
                                                vertical-alignment: center;
                                            }
                                            if row.has-totp: VerticalLayout {
                                                alignment: center;
                                                Glyph { name: "clock"; width: 14px; height: 14px; }
                                            }
                                        }
                                        Text {
                                            horizontal-stretch: 2;
                                            min-width: 0px;
                                            preferred-width: 0px;
                                            text: row.folder;
                                            font-size: Theme.small;
                                            color: Theme.graphite;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Glyph { name: "folder"; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
                        Choice {
                            options: [@tr("Keep the file's folders"), @tr("No folder"), @tr("All in one folder")];
                            selected <=> root.import-target;
                        }
                    }
                    if root.import-target == 2: HorizontalLayout {
                        spacing: 16px;
                        Dropdown {
                            horizontal-stretch: 1;
                            label: @tr("Folder");
                            empty-text: @tr("A new folder…");
                            options: root.import-folders;
                            selected <=> root.import-folder;
                        }
                        if root.import-folder == 0: LineField {
                            horizontal-stretch: 1;
                            label: @tr("New folder name");
                            placeholder: @tr("e.g. From Chrome");
                            text <=> root.import-new-folder;
                        }
                    }
                }
                if root.import-warnings != "": Text {
                    text: root.import-warnings;
                    font-size: Theme.small;
                    color: Theme.graphite;
                    wrap: word-wrap;
                }
                ErrorText {
                    code: root.error-code;
                    detail: root.error-detail;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Button {
                        enabled: root.import-selected > 0;
                        text: root.import-selected == 0 ? @tr("Nothing selected") : @tr("Import {n} item" | "Import {n} items" % root.import-selected);
                        busy-text: @tr("Importing…");
                        busy: root.busy;
                        clicked => { root.import-confirm(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        QuietButton {
                            text: @tr("Cancel");
                            clicked => { root.import-cancel(); }
                        }
                    }
                }
            }

            if root.import-stage == 3: VerticalLayout {
                spacing: 12px;
                max-width: 620px;
                Text {
                    text: @tr("Imported {n} item." | "Imported {n} items." % root.import-added);
                    font-size: Theme.lead;
                    font-weight: 600;
                    color: Theme.ink;
                }
                if root.import-plaintext: Rectangle {
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.seal;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Prose {
                            text: @tr("“{}” holds your passwords in plain text. Delete it now: it is overwritten with zeros, then removed. Empty it from the recycle bin too if you copied it elsewhere.", root.import-file);
                            color: Theme.ink;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            Button {
                                text: @tr("Delete the file");
                                danger: true;
                                clicked => { root.import-wipe(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                QuietButton {
                                    text: @tr("Keep it");
                                    clicked => { root.import-cancel(); }
                                }
                            }
                        }
                    }
                }
                if !root.import-plaintext: HorizontalLayout {
                    alignment: start;
                    QuietButton {
                        text: @tr("Import another file");
                        clicked => { root.import-cancel(); }
                    }
                }
            }

            Rule { }
            SectionTitle {
                text: @tr("Export");
                hint: @tr("An encrypted backup is a copy of your vault file: it opens only with your master password and Secret Key, or with your emergency kit. The copy is read back and checked before the app calls it done. “Protected by a password” is one file with every item, encrypted with a password you choose for it: good for carrying your items to another computer, where Import reads it; it has that one password only, so make it long. A KeePass database is encrypted with a password (and a keyfile) you choose, for KeePass and the apps that read its files. JSON, CSV and Credential Exchange are NOT encrypted: anyone who gets the file can read every password (and, from a Credential Exchange file, sign in with your passkeys), and malware looks for exactly these files. Use them only to move to another password manager, then delete the file.");
            }
            HorizontalLayout {
                spacing: 16px;
                Dropdown {
                    width: 320px;
                    label: @tr("Format");
                    icon: "download";
                    options: [@tr("Encrypted backup (.vault)"), @tr("JSON, not encrypted"), @tr("CSV, not encrypted"), @tr("Protected by a password (.vaultx)"), @tr("KeePass database (.kdbx)"), @tr("Credential Exchange (CXF), not encrypted")];
                    selected <=> root.export-format;
                }
            }
            Prose {
                text: root.export-format == 0
                    ? @tr("Keep a copy on a USB drive or another disk. It stays encrypted.")
                    : root.export-format == 3
                        ? @tr("Every item in one file, attached files and passkeys included, encrypted with a password you choose for it. Import reads it back, here or on another computer. Without that password nobody can, you included.")
                    : root.export-format == 4
                        ? @tr("Every item in a KeePass database, encrypted with a password you choose (and a keyfile, if you like). KeePass, KeePassXC and KeePassDX open it, passkeys and attached files included.")
                    : root.export-format == 5
                        ? @tr("The format password managers exchange items in, passkeys included with their private keys. Not encrypted: import it into the other manager at once, then delete it.")
                    : root.export-format == 1
                        ? @tr("Keeps folders, cards and extra fields. Most password managers can read it.")
                        : @tr("Logins and notes only, one per row. Any program can read it.");
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: root.export-format == 0 ? @tr("Save a backup copy…") : @tr("Export…");
                    danger: root.export-format == 1 || root.export-format == 2 || root.export-format == 5;
                    clicked => {
                        // The other formats say what the file leaves out and ask for the
                        // master password (and a password for the file) in a dialog first
                        // (app.slint, ExportDialog).
                        if (root.export-format == 0) { root.export-backup(); } else { root.export-ask(); }
                    }
                }
            }
        }
    }
}

// Password health: what to fix first. Leaks (checked on request), weak, reused and old
// passwords, expired cards.
component HealthTile inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <string> icon;
    in property <bool> active;
    in property <bool> pending: false;
    callback clicked();
    horizontal-stretch: 1;
    min-width: 96px;
    height: 78px;
    border-radius: Theme.radius;
    background: root.active ? Theme.selected : tile-touch.has-hover ? Theme.hover : Theme.panel;
    border-width: 1px;
    border-color: root.active ? FieldColors.of(root.icon) : Theme.rule;
    accessible-role: button;
    accessible-label: root.label;
    tile-touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.pending ? "–" : root.count;
                font-size: Theme.headline;
                font-weight: 600;
                color: root.count > 0 && !root.pending ? Theme.ink : Theme.faint;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: start;
                FieldIcon { name: root.icon; size: 24px; }
            }
        }
        Text {
            text: root.label;
            font-size: Theme.small;
            color: Theme.graphite;
            overflow: elide;
        }
    }
}

export component HealthPage inherits Rectangle {
    in property <[HealthRow]> rows;
    // 0 leaked, 1 weak, 2 reused, 3 old, 4 expired cards
    in property <[int]> counts: [0, 0, 0, 0, 0];
    in property <int> logins;
    in property <int> score;
    in property <bool> leaks-checked;
    in property <bool> checking;
    in property <int> error-code;
    in property <string> error-detail;
    in-out property <int> filter: -1;
    callback filter-changed(int);
    callback check-leaks();
    callback open-row(int);

    ScrollView {
        // No sideways scrolling: the page is as wide as the window, and what it holds wraps.
        content-width: self.visible-width;
        VerticalLayout {
            padding: 40px;
            padding-right: 48px;
            spacing: 18px;
            alignment: start;

            HorizontalLayout {
                spacing: 20px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    PageTitle { text: @tr("Password health"); }
                    Prose {
                        text: root.logins == 0
                            ? @tr("Add some logins and their passwords are checked here.")
                            : @tr("{n} login checked on this computer. Fix the red ones first: a leaked or reused password is the usual way accounts are taken over." | "{n} logins checked on this computer. Fix the red ones first: a leaked or reused password is the usual way accounts are taken over." % root.logins);
                    }
                }
                // Overall score: share of logins with no problem.
                VerticalLayout {
                    alignment: start;
                    Rectangle {
                        width: 96px;
                        height: 96px;
                        border-radius: 48px;
                        border-width: 6px;
                        border-color: root.score >= 80 ? Theme.good : root.score >= 50 ? Theme.marker : Theme.seal;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.logins == 0 ? "–" : root.score;
                                font-size: Theme.headline;
                                font-weight: 600;
                                color: Theme.ink;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: @tr("score");
                                font-size: Theme.small;
                                color: Theme.graphite;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                HealthTile {
                    label: @tr("Leaked");
                    icon: "leaked";
                    count: root.counts[0];
                    pending: !root.leaks-checked;
                    active: root.filter == 0;
                    clicked => { root.filter = root.filter == 0 ? -1 : 0; root.filter-changed(root.filter); }
                }
                HealthTile {
                    label: @tr("Weak");
                    icon: "key";
                    count: root.counts[1];
                    active: root.filter == 1;
                    clicked => { root.filter = root.filter == 1 ? -1 : 1; root.filter-changed(root.filter); }
                }
                HealthTile {
                    label: @tr("Reused");
                    icon: "reused";
                    count: root.counts[2];
                    active: root.filter == 2;
                    clicked => { root.filter = root.filter == 2 ? -1 : 2; root.filter-changed(root.filter); }
                }
                HealthTile {
                    label: @tr("Over a year old");
                    icon: "old";
                    count: root.counts[3];
                    active: root.filter == 3;
                    clicked => { root.filter = root.filter == 3 ? -1 : 3; root.filter-changed(root.filter); }
                }
                HealthTile {
                    label: @tr("Expiring");
                    icon: "expired";
                    count: root.counts[4];
                    active: root.filter == 4;
                    clicked => { root.filter = root.filter == 4 ? -1 : 4; root.filter-changed(root.filter); }
                }
            }

            Rectangle {
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.rule;
                background: Theme.panel;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 16px;
                    VerticalLayout {
                        alignment: center;
                        FieldIcon { name: "shield"; size: 34px; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: root.leaks-checked ? @tr("Leak check done") : @tr("Check for leaked passwords");
                                font-size: Theme.body;
                                font-weight: 600;
                                color: Theme.ink;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Hint {
                                    text: @tr("Asks the Have I Been Pwned service (haveibeenpwned.com) whether each password appeared in a known breach. Your passwords never leave this computer: only the first 5 characters of each one's SHA-1 fingerprint are sent, and the service answers with hundreds of fingerprints that start the same way. The match is made here. Runs only when you click.");
                                }
                            }
                        }
                        Prose {
                            text: @tr("Compares your passwords with 900+ million leaked ones without sending them. Takes a few seconds.");
                            font-size: Theme.small;
                        }
                        ErrorText {
                            code: root.error-code;
                            detail: root.error-detail;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: root.leaks-checked ? @tr("Check again") : @tr("Check now");
                            busy-text: @tr("Checking…");
                            busy: root.checking;
                            clicked => { root.check-leaks(); }
                        }
                    }
                }
            }

            if root.rows.length == 0 && root.logins > 0: Prose {
                text: root.filter == -1 ? @tr("Nothing to fix. Well kept!") : @tr("Nothing here.");
            }
            VerticalLayout {
                spacing: 2px;
                for row[index] in root.rows: Rectangle {
                    height: 56px;
                    border-radius: Theme.radius;
                    background: row-touch.has-hover ? Theme.hover : transparent;
                    row-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.open-row(index); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            if row.kind != 1 || row.brand == 0: ItemIcon {
                                size: 34px;
                                icon: row.icon;
                                has-icon: row.has-icon;
                                initial: row.initial;
                                tint: row.tint;
                                kind: row.kind;
                            }
                            if row.kind == 1 && row.brand != 0: BrandMark { brand: row.brand; size: 40px; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: row.title;
                                font-size: Theme.body;
                                font-weight: 600;
                                color: Theme.ink;
                                overflow: elide;
                            }
                            // What is wrong, in plain words: red when it needs changing soon.
                            Text {
                                text: row.problem == 1 ? @tr("Found in data breaches {} times", row.detail)
                                    : row.problem == 2 ? (row.weakness != 0 ? Messages.weakness(row.weakness) : @tr("Easy to guess"))
                                    : row.problem == 3 ? @tr("Same password as {n} other login" | "Same password as {n} other logins" % row.count)
                                    : row.problem == 4 ? @tr("Last changed {}", Messages.ago(row.age-unit, row.age-amount))
                                    : row.weakness == 1 ? @tr("Expiry date {}", row.detail)
                                    : @tr("Expired in {}", row.detail);
                                font-size: Theme.small;
                                color: row.problem <= 3 ? Theme.seal : Theme.graphite;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}

// One action of the kit page: what it does in a few words, and in one line under them.
component KitAction inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> detail;
    callback clicked;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.detail;
    forward-focus: focus;
    height: Theme.touch ? 60px : 52px;
    border-radius: Theme.radius;
    background: touch.has-hover || focus.has-focus ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Glyph {
                width: 18px;
                height: 18px;
                name: root.icon;
                tint: Theme.graphite;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.text;
                font-size: Theme.body;
                color: Theme.ink;
                overflow: elide;
            }
            Text {
                text: root.detail;
                font-size: Theme.small;
                color: Theme.graphite;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: "›";
                font-size: 18px;
                color: Theme.faint;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

// A titled group of kit actions, in one hairline frame.
component KitGroup inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;
    // Side by side with a longer group: the frame stays its own height, at the top.
    alignment: start;
    Text {
        text: root.title;
        font-size: Theme.small;
        font-weight: 600;
        color: Theme.graphite;
    }
    Rectangle {
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.rule;
        background: Theme.sheet;
        VerticalLayout {
            padding: 4px;
            spacing: 0px;
            @children
        }
    }
}

// The emergency kit: shown after the master password is typed, then printed or saved as a PDF.
export component KitPage inherits Rectangle {
    in property <int> error-code;
    in property <string> error-detail;
    in property <bool> busy;
    in property <string> vault-path;
    in property <string> vault-id;
    in property <string> kit-secret-key;
    // The password of the kit's PDF files (CRYPTO.md §3.10).
    in property <string> kit-pdf-password;
    // The keys and the PDF password wait for the item lock (in use and closed): its check
    // (`check`: 1 PIN, 2 item password, else the master password; or Windows Hello) shows them.
    in property <bool> keys-locked;
    in property <int> check;
    in property <bool> hello;
    callback unlock();
    callback unlock-hello();
    callback copy-pdf-password();
    in property <string> kit-part-a;
    in property <string> kit-part-b;
    in property <string> kit-part-c;
    in property <int> vault-recovery;
    in-out property <bool> kit-filled: true;
    callback show-kit();
    callback hide-kit();
    callback new-parts();
    callback print-kit();
    callback save-kit();
    callback save-parts-apart();
    callback save-part-picture();

    // "Issue new parts" and "Renew the vault key" asked in dialogs over the window
    // (app.slint), and "Show my kit".
    in-out property <bool> confirming-new-key;
    in-out property <bool> confirming-renew;
    in-out property <bool> asking-kit;
    // Part C was saved in a picture: the printed kit leaves it out unless asked otherwise.
    in property <bool> part-c-pictured;
    in-out property <bool> leave-c-out;
    // The keys are drawn as dots until "Show" is pressed, then for 15 seconds.
    in-out property <bool> keys-shown: false;
    // Runs while they are shown (starting afresh each time), and hides them.
    Timer {
        interval: 15s;
        running: root.keys-shown;
        triggered => { root.keys-shown = false; }
    }
    // The saved files' password: dots too, shown on its own request for 15 seconds.
    in-out property <bool> pdf-password-shown: false;
    Timer {
        interval: 15s;
        running: root.pdf-password-shown;
        triggered => { root.pdf-password-shown = false; }
    }
    changed kit-secret-key => {
        if (root.kit-secret-key != "") { root.asking-kit = false; }
    }
    changed keys-locked => {
        if (root.keys-locked) {
            root.keys-shown = false;
            root.pdf-password-shown = false;
        }
    }
    changed kit-part-a => {
        root.confirming-new-key = false;
        root.confirming-renew = false;
    }

    ScrollView {
        // No sideways scrolling: the page is as wide as the window, and what it holds wraps.
        content-width: self.visible-width;
        VerticalLayout {
            padding: 40px;
            padding-right: 48px;
            spacing: 16px;
            alignment: start;

            PageTitle { text: @tr("Emergency kit"); }
            Prose {
                text: @tr("Your way back in if you lose this computer or forget the master password. Print it and keep the paper somewhere safe, away from the computer.");
            }

            // The master password is asked in a dialog (app.slint) before the kit shows.
            if root.kit-secret-key == "": HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("Show my kit…");
                    icon: "key";
                    clicked => { root.asking-kit = true; }
                }
            }

            if root.kit-secret-key != "": VerticalLayout {
                spacing: 16px;
                if root.keys-locked: LockBox {
                    max-width: 1000px;
                    check: root.check;
                    text: root.check == 1 ? @tr("The kit's keys and its PDF password are behind the item lock. Your PIN shows them for 5 minutes.")
                        : root.check == 2 ? @tr("The kit's keys and its PDF password are behind the item lock. Your item password shows them for 5 minutes.")
                        : @tr("The kit's keys and its PDF password are behind the item lock. Your master password shows them for 5 minutes.");
                    busy: root.busy;
                    error-code: root.error-code;
                    error-detail: root.error-detail;
                    hello: root.hello;
                    unlock => { root.unlock(); }
                    unlock-hello => { root.unlock-hello(); }
                }
                if !root.keys-locked: HorizontalLayout {
                    alignment: start;
                    spacing: 12px;
                    QuietButton {
                        outlined: true;
                        icon: root.keys-shown ? "eye-off" : "eye";
                        text: root.keys-shown ? @tr("Hide the keys") : @tr("Show the keys for 15 seconds");
                        clicked => { root.keys-shown = !root.keys-shown; }
                    }
                    if !root.keys-shown: VerticalLayout {
                        alignment: center;
                        Text {
                            text: @tr("Printing and saving use the keys as they are.");
                            font-size: Theme.small;
                            color: Theme.graphite;
                            overflow: elide;
                        }
                    }
                }
                KitSlip {
                    masked: !root.keys-shown || root.keys-locked;
                    max-width: 1000px;
                    vault-id: root.vault-id;
                    secret-key: root.kit-secret-key;
                    part-a: root.kit-part-a;
                    part-b: root.kit-part-b;
                    part-c: root.kit-part-c;
                    vault-path: root.vault-path;
                }
                if root.kit-part-a == "": Prose {
                    font-size: Theme.small;
                    max-width: 1000px;
                    text: root.vault-recovery == 2 ? @tr("The recovery parts aren't stored anywhere, so they can't be shown again: use the ones from the kit that issued them. Lost one? Issue new parts below; the old ones stop working.")
                        : root.vault-recovery == 1 ? @tr("This vault still uses the Recovery Key of an older kit, which opens it on its own. Issue recovery parts to replace it: three pieces kept apart, where any two bring back the Secret Key and all three a new master password.")
                        : @tr("This vault has no way to recover a forgotten master password. Issue recovery parts to add one.");
                }
                // The actions sit on a card of their own, so the page's texture stays behind them,
                // as wide as the page allows: printing on top, the two groups side by side.
                Rectangle {
                    max-width: 1000px;
                    border-radius: Theme.radius + 2px;
                    border-width: 1px;
                    border-color: Theme.rule;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        // Printing first (the one yellow thing), then the other ways to keep a copy,
                        // then changing the keys: each action says in a line what it does.
                        Choice {
                            options: [@tr("Print the keys"), @tr("Print empty boxes to fill in by hand")];
                            selected: root.kit-filled ? 0 : 1;
                            changed(index) => { root.kit-filled = index == 0; }
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 14px;
                            Button {
                                text: @tr("Print");
                                icon: "printer";
                                clicked => { root.print-kit(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.kit-filled ? @tr("Opens a temporary PDF that asks for the PDF password, wiped from this computer when the vault locks.")
                                        : @tr("Makes a temporary PDF, wiped from this computer when the vault locks.");
                                    font-size: Theme.small;
                                    color: Theme.graphite;
                                    overflow: elide;
                                }
                            }
                        }
                        // The password the printed and saved PDFs ask for, next to the actions
                        // that write them.
                        PdfPassword {
                            password: root.kit-pdf-password;
                            masked: !root.pdf-password-shown || root.keys-locked;
                            can-show: !root.keys-locked;
                            can-copy: !root.keys-locked;
                            toggle => { root.pdf-password-shown = !root.pdf-password-shown; }
                            copy => { root.copy-pdf-password(); }
                        }
                        // Part C kept in its picture: the paper kit then holds A and B only, so the
                        // three are never in one place (its page says C is kept apart, not where).
                        if root.kit-part-c != "" && root.part-c-pictured: Check {
                            text: @tr("Leave part C out of the printed kit: it is in the picture");
                            checked <=> root.leave-c-out;
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            KitGroup {
                                horizontal-stretch: 1;
                                title: @tr("Keep a copy in a file");
                                KitAction {
                                    icon: "download";
                                    text: @tr("Save as PDF…");
                                    detail: @tr("The Secret Key only. The recovery parts stay out.");
                                    clicked => { root.save-kit(); }
                                }
                                if root.kit-part-a != "": KitAction {
                                    icon: "stack";
                                    text: @tr("Save each part apart…");
                                    detail: @tr("Each recovery part in a PDF of its own.");
                                    clicked => { root.save-parts-apart(); }
                                }
                                if root.kit-part-c != "": KitAction {
                                    icon: "image";
                                    text: @tr("Save part C in a picture…");
                                    detail: @tr("Part C hidden in a copy of a photo of yours.");
                                    clicked => { root.save-part-picture(); }
                                }
                            }
                            KitGroup {
                                horizontal-stretch: 1;
                                title: @tr("Change the keys");
                                KitAction {
                                    icon: "refresh";
                                    text: root.vault-recovery == 2 ? @tr("New recovery parts") : @tr("Issue recovery parts");
                                    detail: root.vault-recovery == 2 ? @tr("The old parts stop working. Print the new kit.") : @tr("Three parts, kept apart: two bring back the Secret Key.");
                                    clicked => { root.confirming-new-key = true; }
                                }
                                KitAction {
                                    icon: "key";
                                    text: @tr("New Secret Key…");
                                    detail: @tr("If it may have leaked. The master password stays.");
                                    clicked => { root.confirming-renew = true; }
                                }
                            }
                        }
                        Text {
                            text: @tr("Files go to a folder on this computer or a USB drive, never to one a cloud service copies away. Keep the recovery parts apart from one another: together they open the vault without the master password.");
                            font-size: Theme.small;
                            color: Theme.faint;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;
                            QuietButton {
                                icon: "eye-off";
                                text: @tr("Hide the kit");
                                tint: Theme.graphite;
                                clicked => {
                                    root.confirming-new-key = false;
                                    root.confirming-renew = false;
                                    root.keys-shown = false;
                                    root.pdf-password-shown = false;
                                    root.hide-kit();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
