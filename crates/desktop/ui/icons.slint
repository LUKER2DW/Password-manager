// Small coloured line icons for fields (key for a password, envelope for an email…) and the
// card network marks. Icons are drawn on a 24 × 24 grid with a 1.6 px stroke; each kind of
// field keeps its own colour everywhere it appears.

import { Theme } from "theme.slint";
import { SourceRow } from "model.slint";

