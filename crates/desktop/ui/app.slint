import { Theme, Sketch, Secrets } from "theme.slint";
import { Screen, Panel, ItemRow, DetailField, FolderRow, CodeRow, AuthRow, RecentVault, EditField, HistoryRow, HealthRow, ImportRow, SourceRow, Messages } from "model.slint";
import { OnboardingScreen, UnlockScreen, RecoverScreen } from "welcome.slint";
import { VaultIndex, ItemList } from "vault.slint";
import { DetailPage, EditorPage, GeneratorPage, SettingsPage, KitPage, TransferPage, AuthenticatorPage, HealthPage } from "pages.slint";

export { Theme, Sketch, Secrets, Screen, Panel, ItemRow, DetailField, FolderRow, CodeRow, AuthRow, RecentVault, EditField, HistoryRow, HealthRow, ImportRow, SourceRow, Messages }

// Confirmation messages ("Copied", "Saved"): bottom-right, out of the way of page content.
component Notice inherits Rectangle {
    in property <string> text;
    height: label.preferred-height + 22px;
    width: Math.min(label.preferred-width + 36px, 420px);
    border-radius: Theme.radius;
    background: Theme.dark ? #2A3442 : #1F2A3D;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000050;
    label := Text {
        x: 18px;
        width: parent.width - 36px;
        text: root.text;
        font-size: Theme.body;
        color: #EEF1F5;
        wrap: word-wrap;
    }
}

export component AppWindow inherits Window {
    title: @tr("Vault");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 940px;
    min-height: 620px;
    background: Theme.canvas;
    default-font-family: Theme.ui-font;
    default-font-size: Theme.body;

    // ---- shared state ----
    in property <Screen> screen: Screen.unlock;
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    in property <int> notice-code;
    in property <string> notice-arg;
    in property <string> vault-path;
    in property <string> vault-id;

    // ---- onboarding / recovery ----
    in property <int> onboarding-step: 1;
    in property <bool> recovered;
    in property <string> suggestion;
    in property <string> kit-secret-key;
    in property <string> kit-recovery-key;
    in-out property <bool> kit-saved;
    callback create-vault();
    callback suggest-passphrase();
    callback use-suggestion();
    callback finish-onboarding();

    // ---- choosing among vaults ----
    in property <[RecentVault]> recent-vaults;
    in-out property <bool> choosing-vault;
    callback pick-vault(int);
    callback forget-vault(int);
    callback open-vault-file();
    callback new-vault-file();
    callback switch-vault();

    // ---- unlock / recover ----
    in property <bool> needs-secret-key;
    // Windows Hello: usable on this computer / set up for this vault / prompt open now.
    in property <bool> quick-unlock-available;
    in-out property <bool> quick-unlock-on;
    in property <bool> quick-waiting;
    callback unlock();
    callback quick-unlock();
    callback quick-unlock-toggled(bool);
    callback show-recovery();
    callback recover();
    callback back-to-unlock();

    // ---- vault ----
    in property <Panel> panel: Panel.detail;
    in property <[ItemRow]> items;
    in property <int> selected: -1;
    in property <int> total-items;
    in property <int> category;
    in property <[int]> counts: [0, 0, 0, 0, 0];
    in property <[FolderRow]> folders;
    in property <int> totp-count;
    in property <string> vault-name;
    // ---- password health ----
    in property <[HealthRow]> health-rows;
    in property <[int]> health-counts: [0, 0, 0, 0, 0];
    in property <int> health-total: -1;
    in property <int> health-logins;
    in property <int> health-score;
    in property <bool> leaks-checked;
    in property <bool> leaks-checking;
    in-out property <int> health-filter: -1;
    callback open-health();
    callback health-filter-changed(int);
    callback check-leaks();
    callback health-open(int);
    // ---- authenticator ----
    in property <[AuthRow]> auth-rows;
    in-out property <string> auth-search;
    callback open-authenticator();
    callback auth-search-changed(string);
    callback auth-copy(int);
    callback auth-open(int);
    // The folder being browsed (category >= 100), or "".
    in property <string> folder-name;
    in property <string> folder-icon;
    in property <int> folder-color;
    in-out property <bool> editing-folder;
    callback save-folder(string, string, int);
    callback create-folder(string);
    callback rename-folder(string);
    callback delete-folder();
    in-out property <string> search-text;
    callback search(string);
    callback select-category(int);
    callback select(int);
    callback new-item();
    callback open-generator();
    callback open-settings();
    callback lock();

    // ---- detail ----
    in property <bool> has-selection;
    in property <string> detail-title;
    in property <int> detail-kind;
    in property <image> detail-icon;
    in property <bool> detail-has-icon;
    in property <string> detail-initial;
    in property <color> detail-tint;
    in property <bool> detail-favorite;
    in property <string> detail-username;
    in property <bool> detail-has-password;
    in property <string> revealed-password;
    in property <int> reveal-left;
    in property <string> totp-code;
    in property <int> totp-left;
    in property <[string]> detail-urls;
    in property <string> detail-notes;
    in property <[DetailField]> detail-fields;
    in property <string> detail-folder;
    in property <int> detail-codes-total;
    in property <int> detail-codes-left;
    in property <[CodeRow]> detail-codes;
    callback show-codes();
    callback hide-codes();
    callback copy-code(int);
    callback toggle-code-used(int);
    in-out property <bool> notes-shown;
    in-out property <bool> confirming-delete;
    callback edit-item();
    callback toggle-favorite();
    callback delete-item();
    callback reveal();
    callback conceal();
    callback copy-username();
    callback copy-password();
    callback copy-totp();
    callback copy-field(int);
    in property <int> detail-brand;
    in property <bool> detail-username-is-email;
    in property <int> detail-strength-bits;
    in property <int> detail-strength-score;
    in property <int> detail-weakness;
    in property <int> detail-reused-by;
    in property <int> detail-age-unit;
    in property <int> detail-age-amount;
    in property <int> detail-history-count;
    in property <[HistoryRow]> detail-history;
    in property <bool> detail-history-shown;
    callback show-history();
    callback hide-history();
    callback reveal-history(int);
    callback copy-history(int);
    callback clear-history();

    // ---- editor ----
    in property <bool> editing-item;
    in property <bool> editor-is-new;
    in property <string> editor-password-shown;
    in-out property <int> ed-kind;
    in-out property <string> ed-title;
    in-out property <string> ed-username;
    in-out property <string> ed-url;
    in-out property <string> ed-icon-url;
    in-out property <string> ed-totp;
    in-out property <string> ed-notes;
    in-out property <bool> ed-favorite;
    in property <[string]> ed-folder-options: [""];
    in-out property <int> ed-folder;
    in-out property <string> ed-recovery-codes;
    in-out property <string> ed-card-number;
    in-out property <string> ed-card-expiry;
    in-out property <string> ed-card-code;
    in property <string> ed-card-brand;
    in property <int> ed-card-brand-mark;
    in property <int> ed-strength-bits;
    in property <int> ed-crack-unit;
    in property <int> ed-crack-amount;
    in property <int> ed-weakness;
    in property <[EditField]> ed-fields;
    callback card-number-edited(string);
    callback field-edited(int, bool, string);
    callback field-hidden(int, bool);
    callback field-remove(int);
    callback field-add();
    callback save-item();
    callback cancel-edit();
    callback toggle-show-password();
    callback generate-for-item();

    // ---- generator ----
    in property <string> gen-result;
    in property <int> gen-bits;
    in property <int> gen-crack-unit;
    in property <int> gen-crack-amount;
    in property <int> gen-crack-comparison;
    in-out property <int> gen-mode;
    in-out property <int> gen-length: 24;
    in-out property <int> gen-words: 6;
    in-out property <bool> gen-lowercase: true;
    in-out property <bool> gen-uppercase: true;
    in-out property <bool> gen-digits: true;
    in-out property <bool> gen-symbols: true;
    in-out property <bool> gen-avoid-ambiguous;
    in-out property <bool> gen-extended;
    in-out property <string> gen-also-use;
    in-out property <string> gen-never-use;
    in property <int> gen-alphabet;
    in-out property <int> gen-word-case;
    in-out property <bool> gen-number;
    in-out property <string> gen-separator: "-";
    in property <[string]> gen-wordlists: [""];
    in-out property <int> gen-wordlist;
    in property <bool> gen-wordlist-removable;
    callback regenerate();
    callback copy-generated();
    callback use-generated();
    callback add-wordlist();
    callback remove-wordlist();

    // ---- settings ----
    in-out property <int> auto-lock-minutes: 5;
    in-out property <int> clipboard-seconds: 20;
    in-out property <bool> website-icons;
    in property <string> vault-file-name;
    in-out property <string> vault-name-edit;
    in-out property <int> history-limit: 10;
    in property <int> vault-folders;
    in property <string> vault-kdf;
    in property <bool> vault-has-recovery;
    callback vault-settings-changed();
    callback settings-changed();
    callback appearance-changed(bool);
    callback change-password();
    callback show-kit();
    callback hide-kit();
    callback new-recovery-key();
    callback open-kit();
    callback print-kit();
    // ---- import & export ----
    in property <int> import-stage;
    in property <[SourceRow]> import-sources;
    in property <[string]> import-source-names: [""];
    in-out property <int> import-source: -1;
    in property <string> import-file;
    in property <[ImportRow]> import-rows;
    in property <int> import-selected;
    in property <int> import-duplicates;
    in property <string> import-warnings;
    in property <int> import-added;
    in-out property <int> import-target;
    in property <[string]> import-folders: [""];
    in-out property <int> import-folder;
    in-out property <string> import-new-folder;
    in property <bool> import-plaintext;
    in-out property <int> export-format;
    callback open-transfer();
    callback pick-source(int);
    callback open-browser();
    in property <bool> import-direct-supported;
    in-out property <int> import-browser-method;
    in property <[string]> import-browser-profiles;
    in-out property <int> import-browser-profile;
    callback import-direct();
    callback import-choose();
    callback import-open();
    callback import-toggle(int, bool);
    callback import-select-all(bool);
    callback import-confirm();
    callback import-cancel();
    callback import-wipe();
    callback export-backup();
    callback export-plain();
    callback save-kit();

    if root.screen == Screen.onboarding: OnboardingScreen {
        step: root.onboarding-step;
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        suggestion: root.suggestion;
        recovered: root.recovered;
        kit-vault-id: root.vault-id;
        kit-secret-key: root.kit-secret-key;
        kit-recovery-key: root.kit-recovery-key;
        kit-path: root.vault-path;
        kit-saved <=> root.kit-saved;
        create => { root.create-vault(); }
        suggest => { root.suggest-passphrase(); }
        use-suggestion => { root.use-suggestion(); }
        finish => { root.finish-onboarding(); }
        vaults: root.recent-vaults;
        choosing <=> root.choosing-vault;
        pick-vault(i) => { root.pick-vault(i); }
        forget-vault(i) => { root.forget-vault(i); }
        open-vault-file => { root.open-vault-file(); }
        new-vault-file => { root.new-vault-file(); }

        print-kit => { root.print-kit(); }
        save-kit => { root.save-kit(); }
    }

    if root.screen == Screen.unlock: UnlockScreen {
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        needs-secret-key: root.needs-secret-key;
        vault-path: root.vault-path;
        quick-available: root.quick-unlock-available;
        quick-unlock: root.quick-unlock-on;
        quick-waiting: root.quick-waiting;
        unlock => { root.unlock(); }
        quick => { root.quick-unlock(); }
        forgot => { root.show-recovery(); }
        vaults: root.recent-vaults;
        choosing <=> root.choosing-vault;
        pick-vault(i) => { root.pick-vault(i); }
        forget-vault(i) => { root.forget-vault(i); }
        open-vault-file => { root.open-vault-file(); }
        new-vault-file => { root.new-vault-file(); }

    }

    if root.screen == Screen.recover: RecoverScreen {
        busy: root.busy;
        error-code: root.error-code;
        error-detail: root.error-detail;
        recover => { root.recover(); }
        back => { root.back-to-unlock(); }
    }

    if root.screen == Screen.vault: HorizontalLayout {
        VaultIndex {
            width: 200px;
            category: root.category;
            counts: root.counts;
            folders: root.folders;
            totp-count: root.totp-count;
            health-count: root.health-total;
            vault-name: root.vault-name;
            panel: root.panel;
            open-health => { root.open-health(); }
            edit-folder(i) => {
                root.select-category(100 + i);
                root.editing-folder = true;
            }
            select-category(c) => { root.select-category(c); }
            create-folder(name) => { root.create-folder(name); }
            open-generator => { root.open-generator(); }
            open-settings => { root.open-settings(); }
            open-kit => { root.open-kit(); }
            open-transfer => { root.open-transfer(); }
            open-authenticator => { root.open-authenticator(); }
            lock => { root.lock(); }
            switch-vault => { root.switch-vault(); }
        }
        // Tool pages (generator, health, kit, import, settings, authenticator) take the whole
        // width next to the index; the item list belongs to browsing items only.
        Rectangle { width: 1px; background: Theme.rule; }
        if root.panel == Panel.detail || root.panel == Panel.editor: ItemList {
            width: 320px;
            items: root.items;
            selected: root.selected;
            total: root.total-items;
            folder-name: root.folder-name;
            folder-icon: root.folder-icon;
            folder-color: root.folder-color;
            editing-folder <=> root.editing-folder;
            save-folder(name, icon, color) => { root.save-folder(name, icon, color); }
            rename-folder(name) => { root.rename-folder(name); }
            delete-folder => { root.delete-folder(); }
            search-text <=> root.search-text;
            search(text) => { root.search(text); }
            select(index) => { root.select(index); }
            new-item => { root.new-item(); }
        }
        if root.panel == Panel.detail || root.panel == Panel.editor: Rectangle { width: 1px; background: Theme.rule; }
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.sheet;

            if root.panel == Panel.detail: DetailPage {
                has-item: root.has-selection;
                title: root.detail-title;
                kind: root.detail-kind;
                favorite: root.detail-favorite;
                icon: root.detail-icon;
                has-icon: root.detail-has-icon;
                initial: root.detail-initial;
                tint: root.detail-tint;
                username: root.detail-username;
                has-password: root.detail-has-password;
                revealed-password: root.revealed-password;
                reveal-left: root.reveal-left;
                totp-code: root.totp-code;
                totp-left: root.totp-left;
                urls: root.detail-urls;
                notes: root.detail-notes;
                fields: root.detail-fields;
                folder: root.detail-folder;
                codes-total: root.detail-codes-total;
                codes-left: root.detail-codes-left;
                codes: root.detail-codes;
                show-codes => { root.show-codes(); }
                hide-codes => { root.hide-codes(); }
                copy-code(i) => { root.copy-code(i); }
                toggle-code-used(i) => { root.toggle-code-used(i); }
                notes-shown <=> root.notes-shown;
                confirming-delete <=> root.confirming-delete;
                edit => { root.edit-item(); }
                toggle-favorite => { root.toggle-favorite(); }
                delete => { root.delete-item(); }
                reveal => { root.reveal(); }
                conceal => { root.conceal(); }
                copy-username => { root.copy-username(); }
                copy-password => { root.copy-password(); }
                copy-totp => { root.copy-totp(); }
                copy-field(i) => { root.copy-field(i); }
                brand: root.detail-brand;
                username-is-email: root.detail-username-is-email;
                strength-bits: root.detail-strength-bits;
                strength-score: root.detail-strength-score;
                weakness: root.detail-weakness;
                reused-by: root.detail-reused-by;
                age-unit: root.detail-age-unit;
                age-amount: root.detail-age-amount;
                history-count: root.detail-history-count;
                history: root.detail-history;
                history-shown: root.detail-history-shown;
                show-history => { root.show-history(); }
                hide-history => { root.hide-history(); }
                reveal-history(i) => { root.reveal-history(i); }
                copy-history(i) => { root.copy-history(i); }
                clear-history => { root.clear-history(); }
            }
            if root.panel == Panel.editor: EditorPage {
                is-new: root.editor-is-new;
                error-code: root.error-code;
                error-detail: root.error-detail;
                password-shown: root.editor-password-shown;
                kind <=> root.ed-kind;
                title <=> root.ed-title;
                username <=> root.ed-username;
                url <=> root.ed-url;
                icon-url <=> root.ed-icon-url;
                totp <=> root.ed-totp;
                notes <=> root.ed-notes;
                favorite <=> root.ed-favorite;
                folder-options: root.ed-folder-options;
                folder <=> root.ed-folder;
                recovery-codes <=> root.ed-recovery-codes;
                card-number <=> root.ed-card-number;
                card-expiry <=> root.ed-card-expiry;
                card-code <=> root.ed-card-code;
                card-brand: root.ed-card-brand;
                card-brand-mark: root.ed-card-brand-mark;
                strength-bits: root.ed-strength-bits;
                crack-unit: root.ed-crack-unit;
                crack-amount: root.ed-crack-amount;
                weakness: root.ed-weakness;
                card-number-edited(text) => { root.card-number-edited(text); }
                fields: root.ed-fields;
                field-edited(i, is-name, text) => { root.field-edited(i, is-name, text); }
                field-hidden(i, on) => { root.field-hidden(i, on); }
                field-remove(i) => { root.field-remove(i); }
                field-add => { root.field-add(); }
                save => { root.save-item(); }
                cancel => { root.cancel-edit(); }
                toggle-show-password => { root.toggle-show-password(); }
                generate-password => { root.generate-for-item(); }
            }
            if root.panel == Panel.generator: GeneratorPage {
                result: root.gen-result;
                bits: root.gen-bits;
                crack-unit: root.gen-crack-unit;
                crack-amount: root.gen-crack-amount;
                crack-comparison: root.gen-crack-comparison;
                editing: root.editing-item;
                mode <=> root.gen-mode;
                length <=> root.gen-length;
                words <=> root.gen-words;
                lowercase <=> root.gen-lowercase;
                uppercase <=> root.gen-uppercase;
                digits <=> root.gen-digits;
                symbols <=> root.gen-symbols;
                avoid-ambiguous <=> root.gen-avoid-ambiguous;
                extended <=> root.gen-extended;
                also-use <=> root.gen-also-use;
                never-use <=> root.gen-never-use;
                alphabet: root.gen-alphabet;
                word-case <=> root.gen-word-case;
                number <=> root.gen-number;
                separator <=> root.gen-separator;
                wordlists: root.gen-wordlists;
                wordlist <=> root.gen-wordlist;
                wordlist-removable: root.gen-wordlist-removable;
                error-code: root.error-code;
                error-detail: root.error-detail;
                regenerate => { root.regenerate(); }
                copy => { root.copy-generated(); }
                use-for-item => { root.use-generated(); }
                add-wordlist => { root.add-wordlist(); }
                remove-wordlist => { root.remove-wordlist(); }
            }
            if root.panel == Panel.settings: SettingsPage {
                error-code: root.error-code;
                error-detail: root.error-detail;
                busy: root.busy;
                dark: Theme.dark;
                vault-path: root.vault-path;
                vault-id: root.vault-id;
                auto-lock-minutes <=> root.auto-lock-minutes;
                clipboard-seconds <=> root.clipboard-seconds;
                website-icons <=> root.website-icons;
                vault-file-name: root.vault-file-name;
                vault-name <=> root.vault-name-edit;
                history-limit <=> root.history-limit;
                vault-items: root.counts[0];
                vault-folders: root.vault-folders;
                vault-kdf: root.vault-kdf;
                vault-has-recovery: root.vault-has-recovery;
                vault-settings-changed => { root.vault-settings-changed(); }
                quick-unlock-available: root.quick-unlock-available;
                quick-unlock-on <=> root.quick-unlock-on;
                quick-unlock-toggled(on) => { root.quick-unlock-toggled(on); }
                settings-changed => { root.settings-changed(); }
                appearance-changed(dark) => { root.appearance-changed(dark); }
                change-password => { root.change-password(); }
            }
            if root.panel == Panel.authenticator: AuthenticatorPage {
                rows: root.auth-rows;
                total: root.totp-count;
                search-text <=> root.auth-search;
                search(text) => { root.auth-search-changed(text); }
                copy-code(i) => { root.auth-copy(i); }
                open-item(i) => { root.auth-open(i); }
            }
            if root.panel == Panel.transfer: TransferPage {
                error-code: root.error-code;
                error-detail: root.error-detail;
                busy: root.busy;
                import-stage: root.import-stage;
                sources: root.import-sources;
                source-names: root.import-source-names;
                source <=> root.import-source;
                import-file: root.import-file;
                import-rows: root.import-rows;
                import-selected: root.import-selected;
                import-duplicates: root.import-duplicates;
                import-warnings: root.import-warnings;
                import-added: root.import-added;
                import-target <=> root.import-target;
                import-folders: root.import-folders;
                import-folder <=> root.import-folder;
                import-new-folder <=> root.import-new-folder;
                import-plaintext: root.import-plaintext;
                export-format <=> root.export-format;
                pick-source(i) => { root.pick-source(i); }
                open-browser => { root.open-browser(); }
                direct-supported: root.import-direct-supported;
                browser-method <=> root.import-browser-method;
                browser-profiles: root.import-browser-profiles;
                browser-profile <=> root.import-browser-profile;
                import-direct => { root.import-direct(); }
                import-choose => { root.import-choose(); }
                import-open => { root.import-open(); }
                import-toggle(i, on) => { root.import-toggle(i, on); }
                import-select-all(on) => { root.import-select-all(on); }
                import-confirm => { root.import-confirm(); }
                import-cancel => { root.import-cancel(); }
                import-wipe => { root.import-wipe(); }
                export-backup => { root.export-backup(); }
                export-plain => { root.export-plain(); }
            }
            if root.panel == Panel.health: HealthPage {
                rows: root.health-rows;
                counts: root.health-counts;
                logins: root.health-logins;
                score: root.health-score;
                leaks-checked: root.leaks-checked;
                checking: root.leaks-checking;
                error-code: root.error-code;
                error-detail: root.error-detail;
                filter <=> root.health-filter;
                filter-changed(f) => { root.health-filter-changed(f); }
                check-leaks => { root.check-leaks(); }
                open-row(i) => { root.health-open(i); }
            }
            if root.panel == Panel.kit: KitPage {
                error-code: root.error-code;
                error-detail: root.error-detail;
                busy: root.busy;
                vault-path: root.vault-path;
                vault-id: root.vault-id;
                kit-secret-key: root.kit-secret-key;
                kit-recovery-key: root.kit-recovery-key;
                show-kit => { root.show-kit(); }
                hide-kit => { root.hide-kit(); }
                new-recovery-key => { root.new-recovery-key(); }
                print-kit => { root.print-kit(); }
                save-kit => { root.save-kit(); }
            }

            if root.notice-code != 0: Notice {
                x: parent.width - self.width - 28px;
                y: parent.height - self.height - 24px;
                text: Messages.notice(root.notice-code, root.notice-arg);
            }
        }
    }
}
