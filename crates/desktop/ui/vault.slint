// The unlocked vault: index on the left, item list in the middle.

import { ListView } from "std-widgets.slint";
import { Theme, Sketch } from "theme.slint";
import { ItemRow, Panel, Messages } from "model.slint";
import { Button, QuietButton, LineField, MarkStroke, ItemIcon } from "widgets.slint";

component IndexTab inherits Rectangle {
    in property <string> text;
    in property <int> count: -1;
    in property <bool> active;
    callback clicked;

    accessible-role: tab;
    accessible-label: root.text;
    height: 34px;
    border-radius: Theme.radius;
    background: touch.has-hover && !root.active ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Rectangle {
            horizontal-stretch: 1;
            label := Text {
                x: 0;
                text: root.text;
                font-size: Theme.body;
                font-weight: root.active ? 600 : 400;
                color: root.active ? Theme.ink : Theme.graphite;
            }
            MarkStroke {
                x: -2px;
                y: parent.height / 2 + 9px;
                width: label.preferred-width + 4px;
                variant: 1;
                reveal: root.active ? 1 : 0;
                animate reveal { duration: Theme.sweep; easing: ease-out; }
            }
        }
        if root.count >= 0: Text {
            text: root.count;
            font-size: Theme.small;
            color: Theme.faint;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component ListRow inherits Rectangle {
    in property <ItemRow> item;
    in property <bool> selected;
    callback clicked;

    accessible-role: list-item;
    accessible-label: root.item.title;
    height: 58px;

    Rectangle {
        x: 10px;
        width: parent.width - 20px;
        y: 2px;
        height: parent.height - 4px;
        border-radius: Theme.radius;
        background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
        animate background { duration: Theme.quick; }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                ItemIcon {
                    icon: root.item.icon;
                    has-icon: root.item.has-icon;
                    initial: root.item.initial;
                    tint: root.item.tint;
                    kind: root.item.kind;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                Text {
                    text: root.item.title;
                    font-size: Theme.body;
                    font-weight: 600;
                    color: Theme.ink;
                    overflow: elide;
                }
                Text {
                    text: root.item.subtitle != "" ? root.item.subtitle : Messages.kind-name(root.item.kind);
                    font-size: Theme.small;
                    color: Theme.graphite;
                    overflow: elide;
                }
            }
            if root.item.favorite: VerticalLayout {
                alignment: center;
                Path {
                    width: 13px;
                    height: 13px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Sketch.star;
                    stroke: Theme.accent-stroke;
                    stroke-width: 1.4px;
                    fill: transparent;
                }
            }
        }
        touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }
    }
}

export component VaultIndex inherits Rectangle {
    in property <int> category;
    in property <[int]> counts;
    in property <Panel> panel;
    callback select-category(int);
    callback open-generator();
    callback open-settings();
    callback lock();

    background: Theme.panel;
    property <bool> browsing: root.panel != Panel.generator && root.panel != Panel.settings;

    VerticalLayout {
        padding: 18px;
        padding-top: 22px;
        spacing: 2px;
        Text {
            x: 10px;
            text: @tr("Vault");
            font-size: Theme.title;
            font-weight: 600;
            color: Theme.ink;
        }
        Rectangle { height: 18px; }
        IndexTab { text: @tr("All items"); count: root.counts[0]; active: root.category == 0 && root.browsing; clicked => { root.select-category(0); } }
        IndexTab { text: @tr("Favorites"); count: root.counts[1]; active: root.category == 1 && root.browsing; clicked => { root.select-category(1); } }
        IndexTab { text: @tr("Logins"); count: root.counts[2]; active: root.category == 2 && root.browsing; clicked => { root.select-category(2); } }
        IndexTab { text: @tr("Cards"); count: root.counts[3]; active: root.category == 3 && root.browsing; clicked => { root.select-category(3); } }
        IndexTab { text: @tr("Secure notes"); count: root.counts[4]; active: root.category == 4 && root.browsing; clicked => { root.select-category(4); } }
        Rectangle { vertical-stretch: 1; }
        IndexTab { text: @tr("Password generator"); active: root.panel == Panel.generator; clicked => { root.open-generator(); } }
        IndexTab { text: @tr("Settings"); active: root.panel == Panel.settings; clicked => { root.open-settings(); } }
        Rectangle { height: 8px; }
        IndexTab { text: @tr("Lock now"); clicked => { root.lock(); } }
    }
}

export component ItemList inherits Rectangle {
    in property <[ItemRow]> items;
    in property <int> selected;
    in property <int> total;
    in-out property <string> search-text;
    callback search(string);
    callback select(int);
    callback new-item();

    background: Theme.panel;

    VerticalLayout {
        padding-top: 20px;
        padding-bottom: 10px;
        spacing: 12px;
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 10px;
            LineField {
                horizontal-stretch: 1;
                placeholder: @tr("Search");
                text <=> root.search-text;
                edited(text) => { root.search(text); }
            }
            Button {
                text: @tr("New item");
                clicked => { root.new-item(); }
            }
        }
        if root.items.length == 0: VerticalLayout {
            padding-left: 22px;
            padding-right: 22px;
            alignment: start;
            Text {
                text: root.total == 0
                    ? @tr("Nothing here yet. Add your first login with New item. Coming from another password manager? Run the vault import command in a terminal.")
                    : @tr("Nothing matches “{}”.", root.search-text);
                font-size: Theme.body;
                color: Theme.graphite;
                wrap: word-wrap;
            }
        }
        if root.items.length > 0: ListView {
            vertical-stretch: 1;
            for item[index] in root.items: ListRow {
                item: item;
                selected: index == root.selected;
                clicked => { root.select(index); }
            }
        }
    }
}
