// The unlocked vault: index on the left, item list in the middle.

import { ListView } from "std-widgets.slint";
import { Theme, Sketch } from "theme.slint";
import { ItemRow, FolderRow, Panel, Messages } from "model.slint";
import { Button, QuietButton, LineField, MarkStroke, ItemIcon } from "widgets.slint";
import { BrandMark, Glyph } from "icons.slint";

component IndexTab inherits Rectangle {
    in property <string> text;
    // icons.slint name; "" for none.
    in property <string> icon;
    in property <int> count: -1;
    in property <bool> active;
    callback clicked;

    accessible-role: tab;
    accessible-label: root.text;
    height: 34px;
    border-radius: Theme.radius;
    background: touch.has-hover && !root.active ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Glyph {
                width: 16px;
                height: 16px;
                name: root.icon;
                opacity: root.active ? 1 : 0.8;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            label := Text {
                x: 0;
                text: root.text;
                font-size: Theme.body;
                font-weight: root.active ? 600 : 400;
                color: root.active ? Theme.ink : Theme.graphite;
            }
            MarkStroke {
                x: -2px;
                y: parent.height / 2 + 9px;
                width: label.preferred-width + 4px;
                variant: 1;
                reveal: root.active ? 1 : 0;
                animate reveal { duration: Theme.sweep; easing: ease-out; }
            }
        }
        if root.count >= 0: Text {
            text: root.count;
            font-size: Theme.small;
            color: Theme.faint;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component ListRow inherits Rectangle {
    in property <ItemRow> item;
    in property <bool> selected;
    callback clicked;

    accessible-role: list-item;
    accessible-label: root.item.title;
    height: 58px;

    Rectangle {
        x: 10px;
        width: parent.width - 20px;
        y: 2px;
        height: parent.height - 4px;
        border-radius: Theme.radius;
        background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
        animate background { duration: Theme.quick; }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                width: 34px;
                if root.item.kind != 1 || root.item.brand == 0: ItemIcon {
                    icon: root.item.icon;
                    has-icon: root.item.has-icon;
                    initial: root.item.initial;
                    tint: root.item.tint;
                    kind: root.item.kind;
                }
                if root.item.kind == 1 && root.item.brand != 0: BrandMark {
                    brand: root.item.brand;
                    size: 34px;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                Text {
                    text: root.item.title;
                    font-size: Theme.body;
                    font-weight: 600;
                    color: Theme.ink;
                    overflow: elide;
                }
                Text {
                    text: root.item.subtitle != "" ? root.item.subtitle : Messages.kind-name(root.item.kind);
                    font-size: Theme.small;
                    color: Theme.graphite;
                    overflow: elide;
                }
            }
            if root.item.favorite: VerticalLayout {
                alignment: center;
                Path {
                    width: 13px;
                    height: 13px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Sketch.star;
                    stroke: Theme.accent-stroke;
                    stroke-width: 1.4px;
                    fill: transparent;
                }
            }
        }
        touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }
    }
}

export component VaultIndex inherits Rectangle {
    in property <int> category;
    in property <[int]> counts;
    in property <[FolderRow]> folders;
    in property <int> totp-count;
    in property <int> health-count;
    in property <string> vault-name;
    in property <Panel> panel;
    callback open-health();
    callback select-category(int);
    callback create-folder(string);
    callback open-generator();
    callback open-settings();
    callback open-kit();
    callback open-transfer();
    callback open-authenticator();
    callback lock();
    callback switch-vault();

    background: Theme.panel;
    property <bool> browsing: root.panel != Panel.generator && root.panel != Panel.settings && root.panel != Panel.kit && root.panel != Panel.transfer && root.panel != Panel.authenticator && root.panel != Panel.health;
    property <bool> adding-folder;
    property <string> new-folder-name;

    VerticalLayout {
        padding: 18px;
        padding-top: 22px;
        spacing: 2px;
        Text {
            x: 10px;
            width: parent.width - 10px;
            text: root.vault-name != "" ? root.vault-name : @tr("Vault");
            font-size: Theme.title;
            font-weight: 600;
            color: Theme.ink;
            overflow: elide;
        }
        Rectangle { height: 18px; }
        // Categories and folders scroll together when there are many folders.
        Flickable {
            vertical-stretch: 1;
            viewport-height: tabs.preferred-height;
            tabs := VerticalLayout {
                spacing: 2px;
                alignment: start;
                IndexTab { text: @tr("All items"); icon: "stack"; count: root.counts[0]; active: root.category == 0 && root.browsing; clicked => { root.select-category(0); } }
                IndexTab { text: @tr("Favorites"); icon: "star"; count: root.counts[1]; active: root.category == 1 && root.browsing; clicked => { root.select-category(1); } }
                IndexTab { text: @tr("Logins"); icon: "key"; count: root.counts[2]; active: root.category == 2 && root.browsing; clicked => { root.select-category(2); } }
                IndexTab { text: @tr("Cards"); icon: "card"; count: root.counts[3]; active: root.category == 3 && root.browsing; clicked => { root.select-category(3); } }
                IndexTab { text: @tr("Secure notes"); icon: "note"; count: root.counts[4]; active: root.category == 4 && root.browsing; clicked => { root.select-category(4); } }
                IndexTab { text: @tr("Authenticator"); icon: "clock"; count: root.totp-count; active: root.panel == Panel.authenticator; clicked => { root.open-authenticator(); } }

                Rectangle { height: 16px; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    height: 26px;
                    Text {
                        text: @tr("Folders");
                        font-size: Theme.small;
                        font-weight: 600;
                        color: Theme.faint;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    add := Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: Theme.radius;
                        background: add-touch.has-hover ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: @tr("New folder");
                        Text {
                            text: "+";
                            font-size: Theme.lead;
                            color: Theme.graphite;
                        }
                        add-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.new-folder-name = "";
                                root.adding-folder = true;
                            }
                        }
                    }
                }
                for folder[index] in root.folders: IndexTab {
                    text: folder.name;
                    icon: "folder";
                    count: folder.count;
                    active: root.category == 100 + index && root.browsing;
                    clicked => { root.select-category(100 + index); }
                }
                if root.folders.length == 0 && !root.adding-folder: HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: @tr("Group items, e.g. all your Google accounts. Click + to add one.");
                        font-size: Theme.small;
                        color: Theme.faint;
                        wrap: word-wrap;
                    }
                }
                if root.adding-folder: VerticalLayout {
                    padding-top: 4px;
                    spacing: 6px;
                    name-field := LineField {
                        placeholder: @tr("Folder name");
                        text <=> root.new-folder-name;
                        accepted => {
                            if (root.new-folder-name != "") {
                                root.create-folder(root.new-folder-name);
                            }
                            root.adding-folder = false;
                        }
                        init => { self.focus(); }
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 4px;
                        QuietButton {
                            text: @tr("Add");
                            clicked => {
                                if (root.new-folder-name != "") {
                                    root.create-folder(root.new-folder-name);
                                }
                                root.adding-folder = false;
                            }
                        }
                        QuietButton {
                            text: @tr("Cancel");
                            tint: Theme.graphite;
                            clicked => { root.adding-folder = false; }
                        }
                    }
                }
            }
        }
        Rectangle { height: 12px; }
        IndexTab { text: @tr("Password health"); icon: "heart"; count: root.health-count; active: root.panel == Panel.health; clicked => { root.open-health(); } }
        IndexTab { text: @tr("Password generator"); icon: "sparkle"; active: root.panel == Panel.generator; clicked => { root.open-generator(); } }
        IndexTab { text: @tr("Emergency kit"); icon: "lifebuoy"; active: root.panel == Panel.kit; clicked => { root.open-kit(); } }
        IndexTab { text: @tr("Import & export"); icon: "swap"; active: root.panel == Panel.transfer; clicked => { root.open-transfer(); } }
        IndexTab { text: @tr("Settings"); icon: "gear"; active: root.panel == Panel.settings; clicked => { root.open-settings(); } }
        Rectangle { height: 8px; }
        IndexTab { text: @tr("Lock now"); icon: "lock"; clicked => { root.lock(); } }
        IndexTab { text: @tr("Switch vault"); icon: "vault"; clicked => { root.switch-vault(); } }
    }
}

export component ItemList inherits Rectangle {
    in property <[ItemRow]> items;
    in property <int> selected;
    in property <int> total;
    // Name of the folder being browsed, or "" when browsing a category.
    in property <string> folder-name;
    in-out property <string> search-text;
    callback search(string);
    callback select(int);
    callback new-item();
    callback rename-folder(string);
    callback delete-folder();

    property <bool> renaming;
    property <string> rename-text;
    property <bool> confirming-delete;
    changed folder-name => {
        root.renaming = false;
        root.confirming-delete = false;
    }

    background: Theme.panel;

    VerticalLayout {
        padding-top: 20px;
        padding-bottom: 10px;
        spacing: 12px;
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 10px;
            LineField {
                horizontal-stretch: 1;
                placeholder: @tr("Search");
                text <=> root.search-text;
                edited(text) => { root.search(text); }
            }
            Button {
                text: @tr("New item");
                clicked => { root.new-item(); }
            }
        }
        // Folder header: its name, rename and delete.
        if root.folder-name != "": VerticalLayout {
            padding-left: 22px;
            padding-right: 20px;
            spacing: 8px;
            if !root.renaming && !root.confirming-delete: HorizontalLayout {
                spacing: 4px;
                Text {
                    text: root.folder-name;
                    font-size: Theme.lead;
                    font-weight: 600;
                    color: Theme.ink;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                QuietButton {
                    text: @tr("Rename");
                    tint: Theme.graphite;
                    clicked => {
                        root.rename-text = root.folder-name;
                        root.renaming = true;
                    }
                }
                QuietButton {
                    text: @tr("Delete");
                    tint: Theme.graphite;
                    clicked => { root.confirming-delete = true; }
                }
            }
            if root.renaming: HorizontalLayout {
                spacing: 6px;
                LineField {
                    horizontal-stretch: 1;
                    text <=> root.rename-text;
                    accepted => {
                        root.rename-folder(root.rename-text);
                        root.renaming = false;
                    }
                    init => { self.focus(); }
                }
                QuietButton {
                    text: @tr("Save");
                    clicked => {
                        root.rename-folder(root.rename-text);
                        root.renaming = false;
                    }
                }
            }
            if root.confirming-delete: VerticalLayout {
                spacing: 6px;
                Text {
                    text: @tr("Delete the folder “{}”? Its items stay in your vault, just without a folder.", root.folder-name);
                    font-size: Theme.small;
                    color: Theme.graphite;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 6px;
                    Button {
                        text: @tr("Delete folder");
                        danger: true;
                        clicked => {
                            root.confirming-delete = false;
                            root.delete-folder();
                        }
                    }
                    QuietButton {
                        text: @tr("Cancel");
                        clicked => { root.confirming-delete = false; }
                    }
                }
            }
        }
        if root.items.length == 0: VerticalLayout {
            padding-left: 22px;
            padding-right: 22px;
            alignment: start;
            Text {
                text: root.total == 0
                    ? @tr("Nothing here yet. Add your first login with New item, or bring everything over from another password manager in Import & export.")
                    : root.search-text != "" ? @tr("Nothing matches “{}”.", root.search-text)
                    : root.folder-name != "" ? @tr("This folder is empty. Choose it in an item's Folder box to file the item here.")
                    : @tr("Nothing here yet.");
                font-size: Theme.body;
                color: Theme.graphite;
                wrap: word-wrap;
            }
        }
        if root.items.length > 0: ListView {
            vertical-stretch: 1;
            for item[index] in root.items: ListRow {
                item: item;
                selected: index == root.selected;
                clicked => { root.select(index); }
            }
        }
    }
}
