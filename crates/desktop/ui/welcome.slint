// Onboarding (new vault), unlock and recovery.

import { Theme, Sketch } from "theme.slint";
import { Messages } from "model.slint";
import { Button, QuietButton, SecretField, Check, MarkStroke, Hint } from "widgets.slint";
import { KitSlip } from "kit.slint";

component StepMark inherits HorizontalLayout {
    in property <int> number;
    in property <string> text;
    in property <bool> active;
    in property <bool> done;
    spacing: 12px;
    alignment: start;
    Rectangle {
        width: 22px;
        height: 30px;
        if root.done: Path {
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Sketch.check;
            stroke: Theme.accent-stroke;
            stroke-width: 2px;
            fill: transparent;
        }
        if !root.done: Text {
            text: root.number;
            font-size: Theme.body;
            font-weight: 600;
            color: root.active ? Theme.ink : Theme.faint;
        }
    }
    Rectangle {
        width: label.preferred-width;
        height: 30px;
        label := Text {
            x: 0;
            text: root.text;
            font-size: Theme.body;
            color: root.active || root.done ? Theme.ink : Theme.faint;
        }
        MarkStroke {
            x: -2px;
            y: parent.height - 6px;
            width: label.preferred-width + 4px;
            reveal: root.active ? 1 : 0;
            animate reveal { duration: Theme.sweep; easing: ease-out; }
        }
    }
}

component Heading inherits Text {
    font-size: Theme.headline;
    font-weight: 300;
    color: Theme.ink;
    wrap: word-wrap;
}

component Prose inherits Text {
    font-size: Theme.body;
    color: Theme.graphite;
    wrap: word-wrap;
}

component ErrorLine inherits Text {
    in property <int> code;
    in property <string> detail;
    text: Messages.error(root.code, root.detail);
    font-size: Theme.body;
    color: Theme.seal;
    wrap: word-wrap;
    visible: root.code != 0;
    height: root.code != 0 ? self.preferred-height : 0px;
}

export component OnboardingScreen inherits Rectangle {
    in property <int> step: 1;
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    in property <string> suggestion;
    in property <bool> recovered: false;
    in property <string> kit-vault-id;
    in property <string> kit-secret-key;
    in property <string> kit-recovery-key;
    in property <string> kit-path;
    in-out property <bool> kit-saved;
    callback create();
    callback suggest();
    callback use-suggestion();
    callback finish();

    background: Theme.canvas;

    HorizontalLayout {
        padding: 56px;
        padding-left: 64px;
        spacing: 72px;

        VerticalLayout {
            width: 180px;
            spacing: 6px;
            alignment: start;
            Text {
                text: root.recovered ? @tr("Recovered") : @tr("New vault");
                font-size: Theme.title;
                font-weight: 600;
                color: Theme.ink;
            }
            Rectangle { height: 22px; }
            StepMark {
                number: 1;
                text: @tr("Master password");
                active: root.step == 1;
                done: root.step > 1;
            }
            StepMark {
                number: 2;
                text: @tr("Emergency kit");
                active: root.step == 2;
            }
        }

        if root.step == 1: VerticalLayout {
            max-width: 500px;
            spacing: 18px;
            alignment: start;

            Heading { text: @tr("Choose a master password"); }
            Prose {
                text: @tr("It's the only password you'll need to remember. Together with a Secret Key that this app creates, it locks everything else. Nobody can reset it for you.");
            }
            master := SecretField {
                field: 0;
                label: @tr("Master password");
                hint: @tr("Something you'll remember that nobody could guess: several random words work best (try Suggest a passphrase). At least 12 characters. You'll type it every time you unlock, and it can't be reset.");
                error: root.error-code == 4 || root.error-code == 5;
                accepted => { confirm.focus(); }
            }
            confirm := SecretField {
                field: 1;
                label: @tr("Type it again");
                hint: @tr("The same password once more, to catch typos.");
                error: root.error-code == 4;
                accepted => { root.create(); }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                QuietButton {
                    text: root.suggestion == "" ? @tr("Suggest a passphrase") : @tr("Suggest another");
                    clicked => { root.suggest(); }
                }
                VerticalLayout {
                    alignment: center;
                    Hint {
                        text: @tr("Six random words from the EFF word list: about 77 bits of entropy, far beyond guessing, and easier to remember than a jumble of symbols.");
                    }
                }
            }
            if root.suggestion != "": Rectangle {
                height: suggestion-layout.preferred-height;
                border-radius: Theme.radius;
                background: Theme.panel;
                suggestion-layout := VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text {
                        text: root.suggestion;
                        font-family: Theme.mono-font;
                        font-size: Theme.lead;
                        color: Theme.ink;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 12px;
                        QuietButton {
                            text: @tr("Use this passphrase");
                            clicked => { root.use-suggestion(); }
                        }
                        Prose {
                            text: @tr("Learn it by heart before you continue.");
                            font-size: Theme.small;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            ErrorLine {
                code: root.error-code;
                detail: root.error-detail;
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("Create vault");
                    busy-text: @tr("Creating your vault…");
                    busy: root.busy;
                    clicked => { root.create(); }
                }
            }
        }

        if root.step == 2: VerticalLayout {
            max-width: 560px;
            spacing: 18px;
            alignment: start;

            Heading { text: @tr("Save your emergency kit"); }
            Prose {
                text: root.recovered
                    ? @tr("Your Secret Key changed. Replace the old one in your emergency kit, or write a new kit. Your Recovery Key still works.")
                    : @tr("If you lose this computer or forget your master password, these keys are the only way back in. Write them down or print them, and keep the paper somewhere safe.");
            }
            KitSlip {
                vault-id: root.kit-vault-id;
                secret-key: root.kit-secret-key;
                recovery-key: root.kit-recovery-key;
                vault-path: root.kit-path;
            }
            Check {
                text: @tr("I wrote these down and keep them somewhere safe");
                checked <=> root.kit-saved;
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("Open my vault");
                    enabled: root.kit-saved;
                    clicked => { root.finish(); }
                }
            }
        }
    }
}

export component UnlockScreen inherits Rectangle {
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    in property <bool> needs-secret-key;
    in property <string> vault-path;
    callback unlock();
    callback forgot();

    background: Theme.canvas;
    forward-focus: password;

    HorizontalLayout {
        padding-left: 120px;
        padding-right: 64px;
        alignment: start;
        VerticalLayout {
            width: 420px;
            spacing: 16px;
            alignment: center;

            Path {
                width: 44px;
                height: 50px;
                viewbox-width: 64;
                viewbox-height: 72;
                commands: Sketch.padlock;
                stroke: Theme.accent-stroke;
                stroke-width: 1.6px;
                fill: transparent;
            }
            Text {
                text: @tr("Locked");
                font-size: Theme.display;
                font-weight: 300;
                color: Theme.ink;
            }
            Prose {
                text: root.vault-path;
                font-size: Theme.small;
                color: Theme.faint;
            }
            Rectangle { height: 4px; }
            if root.needs-secret-key: VerticalLayout {
                spacing: 12px;
                Prose {
                    text: @tr("This computer hasn't opened this vault before. Type the Secret Key from your emergency kit once; it will be remembered here.");
                }
                SecretField {
                    field: 2;
                    label: @tr("Secret Key");
                    hint: @tr("Copy it from your emergency kit: it starts with S0- followed by four groups of seven characters. Dashes, spaces and capitals don't matter, and a typo is caught before anything happens.");
                    placeholder: "S0-";
                    error: root.error-code == 2 || root.error-code == 3;
                    accepted => { password.focus(); }
                }
            }
            password := SecretField {
                field: 0;
                label: @tr("Master password");
                hint: @tr("The master password you chose when you created this vault.");
                error: root.error-code == 1;
                accepted => { root.unlock(); }
            }
            ErrorLine {
                code: root.error-code;
                detail: root.error-detail;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 12px;
                Button {
                    text: @tr("Unlock");
                    busy-text: @tr("Unlocking…");
                    busy: root.busy;
                    clicked => { root.unlock(); }
                }
                VerticalLayout {
                    alignment: center;
                    QuietButton {
                        text: @tr("Forgot it? Use your emergency kit");
                        tint: Theme.graphite;
                        clicked => { root.forgot(); }
                    }
                }
            }
        }
    }
}

export component RecoverScreen inherits Rectangle {
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    callback recover();
    callback back();

    background: Theme.canvas;

    HorizontalLayout {
        padding-left: 120px;
        padding-right: 64px;
        alignment: start;
        VerticalLayout {
            width: 460px;
            spacing: 16px;
            alignment: center;

            Heading { text: @tr("Recover access"); }
            Prose {
                text: @tr("Type the Recovery Key from your emergency kit, then choose a new master password. You'll also get a new Secret Key.");
            }
            SecretField {
                field: 3;
                label: @tr("Recovery Key");
                hint: @tr("Copy it from your emergency kit: the longer key, starting with R0- and nine groups of six characters. Dashes, spaces and capitals don't matter.");
                placeholder: "R0-";
                error: root.error-code == 8;
            }
            SecretField {
                field: 0;
                label: @tr("New master password");
                hint: @tr("The password you'll unlock with from now on. At least 12 characters; several random words work best.");
                error: root.error-code == 4 || root.error-code == 5;
            }
            SecretField {
                field: 1;
                label: @tr("Type it again");
                hint: @tr("The same new password once more, to catch typos.");
                error: root.error-code == 4;
                accepted => { root.recover(); }
            }
            ErrorLine {
                code: root.error-code;
                detail: root.error-detail;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 12px;
                Button {
                    text: @tr("Recover vault");
                    busy-text: @tr("Recovering…");
                    busy: root.busy;
                    clicked => { root.recover(); }
                }
                VerticalLayout {
                    alignment: center;
                    QuietButton {
                        text: @tr("Back");
                        tint: Theme.graphite;
                        clicked => { root.back(); }
                    }
                }
            }
        }
    }
}
