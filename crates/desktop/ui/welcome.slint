// Onboarding (new vault), unlock and recovery.
//
// All three share one layout: a side panel on the left (brand, where you are, what is set up)
// and the form centered in the space on the right.

import { Theme, Sketch } from "theme.slint";
import { Messages, RecentVault } from "model.slint";
import { Button, QuietButton, SecretField, Check, MarkStroke, Hint, Rule } from "widgets.slint";
import { KitSlip } from "kit.slint";

component StepMark inherits HorizontalLayout {
    in property <int> number;
    in property <string> text;
    in property <bool> active;
    in property <bool> done;
    spacing: 12px;
    alignment: start;
    Rectangle {
        width: 22px;
        height: 30px;
        if root.done: Path {
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Sketch.check;
            stroke: Theme.accent-stroke;
            stroke-width: 2px;
            fill: transparent;
        }
        if !root.done: Text {
            text: root.number;
            font-size: Theme.body;
            font-weight: 600;
            color: root.active ? Theme.ink : Theme.faint;
        }
    }
    Rectangle {
        width: label.preferred-width;
        height: 30px;
        label := Text {
            x: 0;
            text: root.text;
            font-size: Theme.body;
            color: root.active || root.done ? Theme.ink : Theme.faint;
        }
        MarkStroke {
            x: -2px;
            y: parent.height - 6px;
            width: label.preferred-width + 4px;
            reveal: root.active ? 1 : 0;
            animate reveal { duration: Theme.sweep; easing: ease-out; }
        }
    }
}

component Heading inherits Text {
    font-size: Theme.headline;
    font-weight: 300;
    color: Theme.ink;
    wrap: word-wrap;
}

component Prose inherits Text {
    font-size: Theme.body;
    color: Theme.graphite;
    wrap: word-wrap;
}

component ErrorLine inherits Text {
    in property <int> code;
    in property <string> detail;
    text: Messages.error(root.code, root.detail);
    font-size: Theme.body;
    color: Theme.seal;
    wrap: word-wrap;
    visible: root.code != 0;
    height: root.code != 0 ? self.preferred-height : 0px;
}

// One line of "what is true here": a check when it is, a hollow dot when it isn't (yet).
component Fact inherits HorizontalLayout {
    in property <string> text;
    in property <bool> ok: true;
    spacing: 10px;
    VerticalLayout {
        alignment: start;
        padding-top: 1px;
        Rectangle {
            width: 16px;
            height: 16px;
            if root.ok: Path {
                width: 15px;
                height: 15px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Sketch.check;
                stroke: Theme.accent-stroke;
                stroke-width: 2px;
                fill: transparent;
            }
            if !root.ok: Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                border-width: 1.5px;
                border-color: Theme.faint;
            }
        }
    }
    Text {
        text: root.text;
        font-size: Theme.small;
        color: root.ok ? Theme.graphite : Theme.faint;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

// Left side panel: brand at the top, then whatever the screen puts in it.
component SidePanel inherits Rectangle {
    background: Theme.panel;
    min-width: 340px;
    max-width: 440px;
    horizontal-stretch: 0.6;

    VerticalLayout {
        padding: 40px;
        padding-bottom: 36px;
        spacing: 0px;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Path {
                width: 20px;
                height: 23px;
                viewbox-width: 64;
                viewbox-height: 72;
                commands: Sketch.padlock;
                stroke: Theme.accent-stroke;
                stroke-width: 1.4px;
                fill: transparent;
            }
            Text {
                text: "Vault";
                font-size: Theme.lead;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
            }
        }
        @children
    }
}

// The right side: content centered in the free space, at a comfortable reading width.
component FormArea inherits Rectangle {
    in property <length> form-width: 400px;
    horizontal-stretch: 1;
    background: Theme.canvas;
    HorizontalLayout {
        padding: 48px;
        alignment: center;
        VerticalLayout {
            min-width: 280px;
            preferred-width: root.form-width;
            max-width: root.form-width;
            alignment: center;
            @children
        }
    }
}

component Spacer inherits Rectangle {
    vertical-stretch: 1;
}

// Pick one of the vaults this computer has opened, open another file, or create a new vault.
component VaultChooser inherits VerticalLayout {
    in property <[RecentVault]> vaults;
    in property <bool> can-go-back: true;
    callback pick(int);
    callback forget(int);
    callback open-file();
    callback new-file();
    callback back();

    spacing: 14px;
    Heading { text: @tr("Choose a vault"); }
    Prose {
        text: @tr("Vaults opened on this computer. Each one has its own master password and Secret Key.");
    }
    VerticalLayout {
        spacing: 4px;
        for vault[index] in root.vaults: Rectangle {
            height: 56px;
            border-radius: Theme.radius;
            background: vault.current ? Theme.selected : row-touch.has-hover && !vault.missing ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: vault.name;
            row-touch := TouchArea {
                mouse-cursor: vault.missing ? MouseCursor.default : MouseCursor.pointer;
                clicked => {
                    if (!vault.missing) { root.pick(index); }
                }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Path {
                        width: 16px;
                        height: 18px;
                        viewbox-width: 64;
                        viewbox-height: 72;
                        commands: Sketch.padlock;
                        stroke: vault.missing ? Theme.faint : Theme.accent-stroke;
                        stroke-width: 1.3px;
                        fill: transparent;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: vault.name;
                        font-size: Theme.body;
                        font-weight: 600;
                        color: vault.missing ? Theme.faint : Theme.ink;
                        overflow: elide;
                    }
                    Text {
                        text: vault.missing ? @tr("File not found: {}", vault.location) : vault.location;
                        font-size: Theme.small;
                        color: Theme.faint;
                        overflow: elide;
                    }
                }
                if vault.current: Text {
                    text: @tr("selected");
                    font-size: Theme.small;
                    color: Theme.graphite;
                    vertical-alignment: center;
                }
                if !vault.current: VerticalLayout {
                    alignment: center;
                    QuietButton {
                        text: @tr("Remove from list");
                        tint: Theme.faint;
                        clicked => { root.forget(index); }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        spacing: 8px;
        QuietButton {
            text: @tr("Open a vault file…");
            outlined: true;
            clicked => { root.open-file(); }
        }
        QuietButton {
            text: @tr("Create a new vault…");
            outlined: true;
            clicked => { root.new-file(); }
        }
    }
    if root.can-go-back: HorizontalLayout {
        alignment: start;
        QuietButton {
            text: @tr("Back");
            tint: Theme.graphite;
            clicked => { root.back(); }
        }
    }
}

export component OnboardingScreen inherits Rectangle {
    in property <int> step: 1;
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    in property <string> suggestion;
    in property <bool> recovered: false;
    in property <string> kit-vault-id;
    in property <string> kit-secret-key;
    in property <string> kit-recovery-key;
    in property <string> kit-path;
    in-out property <bool> kit-saved;
    callback create();
    callback suggest();
    callback use-suggestion();
    callback finish();
    callback print-kit();
    callback save-kit();
    // Vault chooser
    in property <[RecentVault]> vaults;
    in-out property <bool> choosing;
    callback pick-vault(int);
    callback forget-vault(int);
    callback open-vault-file();
    callback new-vault-file();

    background: Theme.canvas;

    HorizontalLayout {
        SidePanel {
            Rectangle { height: 56px; }
            Text {
                text: root.recovered ? @tr("Recovered") : @tr("New vault");
                font-size: Theme.headline;
                font-weight: 300;
                color: Theme.ink;
            }
            Rectangle { height: 20px; }
            if !root.recovered: StepMark {
                number: 1;
                text: @tr("Master password");
                active: root.step == 1;
                done: root.step > 1;
            }
            StepMark {
                number: root.recovered ? 1 : 2;
                text: @tr("Emergency kit");
                active: root.step == 2;
            }
            Spacer { }
            VerticalLayout {
                spacing: 12px;
                vertical-stretch: 0;
                Fact { text: @tr("Everything is encrypted on this computer before it is saved."); }
                Fact { text: @tr("Opening it takes your master password plus a Secret Key the app creates."); }
                Fact { text: @tr("Nothing is sent anywhere."); }
                Fact { text: @tr("Your emergency kit is the way back in if you forget the password."); }
            }
        }
        Rectangle { width: 1px; background: Theme.rule; }

        if root.step == 1: FormArea {
            form-width: 460px;
            if root.choosing: VaultChooser {
                vaults: root.vaults;
                pick(i) => { root.pick-vault(i); }
                forget(i) => { root.forget-vault(i); }
                open-file => { root.open-vault-file(); }
                new-file => { root.new-vault-file(); }
                back => { root.choosing = false; }
            }
            if !root.choosing: VerticalLayout {
                spacing: 18px;

                Heading { text: @tr("Choose a master password"); }
                Prose {
                    text: @tr("It's the only password you'll need to remember. Nobody can reset it for you, so pick one you won't forget.");
                }
                master := SecretField {
                    field: 0;
                    label: @tr("Master password");
                    required: true;
                    hint: @tr("Something you'll remember that nobody could guess: several random words work best (try Suggest a passphrase). At least 12 characters. You'll type it every time you unlock, and it can't be reset.");
                    error: root.error-code == 4 || root.error-code == 5;
                    accepted => { confirm.focus(); }
                }
                confirm := SecretField {
                    field: 1;
                    label: @tr("Type it again");
                    required: true;
                    error: root.error-code == 4;
                    accepted => { root.create(); }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    QuietButton {
                        text: root.suggestion == "" ? @tr("Suggest a passphrase") : @tr("Suggest another");
                        clicked => { root.suggest(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        Hint {
                            text: @tr("Six random words from the EFF word list: about 77 bits of entropy, far beyond guessing, and easier to remember than a jumble of symbols.");
                        }
                    }
                }
                if root.suggestion != "": Rectangle {
                    height: suggestion-layout.preferred-height;
                    border-radius: Theme.radius;
                    background: Theme.panel;
                    suggestion-layout := VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            text: root.suggestion;
                            font-family: Theme.mono-font;
                            font-size: Theme.lead;
                            color: Theme.ink;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 12px;
                            QuietButton {
                                text: @tr("Use this passphrase");
                                clicked => { root.use-suggestion(); }
                            }
                            Prose {
                                text: @tr("Learn it by heart before you continue.");
                                font-size: Theme.small;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                ErrorLine {
                    code: root.error-code;
                    detail: root.error-detail;
                }
                Button {
                    text: @tr("Create vault");
                    busy-text: @tr("Creating your vault…");
                    busy: root.busy;
                    clicked => { root.create(); }
                }
                HorizontalLayout {
                    alignment: start;
                    QuietButton {
                        text: @tr("I already have a vault: open it");
                        tint: Theme.graphite;
                        clicked => { root.choosing = true; }
                    }
                }
            }
        }

        if root.step == 2: FormArea {
            form-width: 560px;
            VerticalLayout {
                spacing: 18px;

                Heading { text: @tr("Save your emergency kit"); }
                Prose {
                    text: root.recovered
                        ? @tr("Your Secret Key changed. Replace the old one in your emergency kit, or write a new kit. Your Recovery Key still works.")
                        : @tr("If you lose this computer or forget your master password, these keys are the only way back in. Write them down or print them, and keep the paper somewhere safe.");
                }
                KitSlip {
                    vault-id: root.kit-vault-id;
                    secret-key: root.kit-secret-key;
                    recovery-key: root.kit-recovery-key;
                    vault-path: root.kit-path;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    QuietButton {
                        text: @tr("Print");
                        outlined: true;
                        clicked => { root.print-kit(); }
                    }
                    QuietButton {
                        text: @tr("Save as PDF…");
                        clicked => { root.save-kit(); }
                    }
                }
                Check {
                    text: @tr("I wrote these down and keep them somewhere safe");
                    checked <=> root.kit-saved;
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: @tr("Open my vault");
                        enabled: root.kit-saved;
                        clicked => { root.finish(); }
                    }
                }
            }
        }
    }
}

export component UnlockScreen inherits Rectangle {
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    in property <bool> needs-secret-key;
    in property <string> vault-path;
    // Windows Hello: usable on this computer / set up for this vault / prompt open now.
    in property <bool> quick-available;
    in property <bool> quick-unlock;
    in property <bool> quick-waiting;
    callback unlock();
    callback quick();
    callback forgot();
    // Vault chooser
    in property <[RecentVault]> vaults;
    in-out property <bool> choosing;
    callback pick-vault(int);
    callback forget-vault(int);
    callback open-vault-file();
    callback new-vault-file();


    property <bool> hello-first: root.quick-unlock && !root.needs-secret-key;

    background: Theme.canvas;

    HorizontalLayout {
        SidePanel {
            Spacer { }
            Path {
                width: 84px;
                height: 95px;
                viewbox-width: 64;
                viewbox-height: 72;
                commands: Sketch.padlock;
                stroke: Theme.accent-stroke;
                stroke-width: 1.8px;
                fill: transparent;
            }
            Rectangle { height: 22px; }
            Text {
                text: @tr("Locked");
                font-size: Theme.display;
                font-weight: 300;
                color: Theme.ink;
            }
            Rectangle { height: 8px; }
            Prose {
                text: @tr("Everything inside is encrypted on this computer.");
            }
            Spacer { }
            VerticalLayout {
                spacing: 12px;
                vertical-stretch: 0;
                Fact {
                    text: root.needs-secret-key
                        ? @tr("This computer needs your Secret Key once")
                        : @tr("Secret Key saved on this computer");
                    ok: !root.needs-secret-key;
                }
                if root.quick-available: Fact {
                    text: root.quick-unlock
                        ? @tr("Windows Hello is set up")
                        : @tr("Windows Hello is off (Settings → Locking)");
                    ok: root.quick-unlock;
                }
                Fact { text: @tr("Locks itself when you step away"); }
                Rectangle { height: 4px; }
                Text {
                    text: root.vault-path;
                    font-size: Theme.small;
                    color: Theme.faint;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle { width: 1px; background: Theme.rule; }

        FormArea {
            form-width: 420px;
            if root.choosing: VaultChooser {
                vaults: root.vaults;
                pick(i) => { root.pick-vault(i); }
                forget(i) => { root.forget-vault(i); }
                open-file => { root.open-vault-file(); }
                new-file => { root.new-vault-file(); }
                back => { root.choosing = false; }
            }
            if !root.choosing: VerticalLayout {
                spacing: 16px;

                Heading { text: @tr("Unlock your vault"); }
                if root.hello-first: VerticalLayout {
                    spacing: 18px;
                    Button {
                        text: @tr("Unlock with Windows Hello");
                        busy-text: @tr("Waiting for Windows Hello…");
                        busy: root.quick-waiting;
                        enabled: !root.busy;
                        clicked => { root.quick(); }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Rule { }
                        }
                        Text {
                            text: @tr("or use your master password");
                            font-size: Theme.small;
                            color: Theme.faint;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Rule { }
                        }
                    }
                }
                if root.needs-secret-key: VerticalLayout {
                    spacing: 12px;
                    Prose {
                        text: @tr("This computer hasn't opened this vault before. Type the Secret Key from your emergency kit once; it will be remembered here.");
                    }
                    SecretField {
                        field: 2;
                        label: @tr("Secret Key");
                        required: true;
                        hint: @tr("Copy it from your emergency kit: it starts with S0- followed by four groups of seven characters. Dashes, spaces and capitals don't matter, and a typo is caught before anything happens.");
                        placeholder: "S0-";
                        error: root.error-code == 2 || root.error-code == 3;
                        accepted => { password.focus(); }
                    }
                }
                password := SecretField {
                    field: 0;
                    label: @tr("Master password");
                    required: true;
                    error: root.error-code == 1;
                    init => { self.focus(); }
                    accepted => { root.unlock(); }
                }
                ErrorLine {
                    code: root.error-code;
                    detail: root.error-detail;
                }
                // One yellow button per screen: with Windows Hello on, it is the Hello one.
                if !root.hello-first: Button {
                    text: @tr("Unlock");
                    busy-text: @tr("Unlocking…");
                    busy: root.busy;
                    clicked => { root.unlock(); }
                }
                if root.hello-first: QuietButton {
                    text: root.busy && !root.quick-waiting ? @tr("Unlocking…") : @tr("Unlock with password");
                    outlined: true;
                    enabled: !root.busy;
                    clicked => { root.unlock(); }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    QuietButton {
                        text: @tr("Forgot it? Use your emergency kit");
                        tint: Theme.graphite;
                        clicked => { root.forgot(); }
                    }
                    QuietButton {
                        text: @tr("Use another vault");
                        tint: Theme.graphite;
                        clicked => { root.choosing = true; }
                    }
                }
            }
        }
    }
}

export component RecoverScreen inherits Rectangle {
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    callback recover();
    callback back();

    background: Theme.canvas;

    HorizontalLayout {
        SidePanel {
            Rectangle { height: 56px; }
            Text {
                text: @tr("Recover access");
                font-size: Theme.headline;
                font-weight: 300;
                color: Theme.ink;
            }
            Rectangle { height: 20px; }
            StepMark { number: 1; text: @tr("Recovery Key"); active: true; }
            StepMark { number: 2; text: @tr("New master password"); }
            StepMark { number: 3; text: @tr("New emergency kit"); }
            Spacer { }
            VerticalLayout {
                spacing: 12px;
                vertical-stretch: 0;
                Fact { text: @tr("Your items stay exactly as they are."); }
                Fact { text: @tr("You get a new Secret Key; the old one stops working."); }
                Fact { text: @tr("Your Recovery Key keeps working."); }
            }
        }
        Rectangle { width: 1px; background: Theme.rule; }

        FormArea {
            form-width: 420px;
            VerticalLayout {
                spacing: 16px;

                Heading { text: @tr("Use your emergency kit"); }
                Prose {
                    text: @tr("Type the Recovery Key from your emergency kit, then choose a new master password.");
                }
                SecretField {
                    field: 3;
                    label: @tr("Recovery Key");
                    required: true;
                    hint: @tr("Copy it from your emergency kit: the longer key, starting with R0- and nine groups of six characters. Dashes, spaces and capitals don't matter.");
                    placeholder: "R0-";
                    error: root.error-code == 8;
                }
                SecretField {
                    field: 0;
                    label: @tr("New master password");
                    required: true;
                    error: root.error-code == 4 || root.error-code == 5;
                }
                SecretField {
                    field: 1;
                    label: @tr("Type it again");
                    required: true;
                    error: root.error-code == 4;
                    accepted => { root.recover(); }
                }
                ErrorLine {
                    code: root.error-code;
                    detail: root.error-detail;
                }
                Button {
                    text: @tr("Recover vault");
                    busy-text: @tr("Recovering…");
                    busy: root.busy;
                    clicked => { root.recover(); }
                }
                HorizontalLayout {
                    alignment: start;
                    QuietButton {
                        text: @tr("Back to unlock");
                        tint: Theme.graphite;
                        clicked => { root.back(); }
                    }
                }
            }
        }
    }
}
