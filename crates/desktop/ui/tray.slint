// The menu of the icon in the notification area: a small window of its own instead of the
// system's plain menu. Thin and quiet, like the menus of other apps there: words only, two
// grey status lines between hairlines. It opens next to the pointer and closes when it loses
// focus (see src/tray.rs).

import { Theme } from "theme.slint";

component TrayItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: 30px;
    border-radius: 5px;
    background: root.enabled && touch.has-hover ? (Theme.dark ? #FFFFFF14 : #0000000F) : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
        font-size: 13px;
        color: root.enabled ? Theme.ink : Theme.faint;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component TrayNote inherits Text {
    height: 22px;
    font-size: 13px;
    color: Theme.graphite;
    vertical-alignment: center;
    overflow: elide;
}

component TrayRule inherits Rectangle {
    height: 9px;
    Rectangle {
        height: 1px;
        background: Theme.dark ? #FFFFFF1F : #0000001A;
    }
}

export component TrayMenu inherits Window {
    // The vault is locked (Lock now is greyed out), its name, and the minutes left before
    // the auto-lock.
    in property <bool> locked: true;
    in property <string> vault-name;
    in property <int> minutes-left: 5;
    callback open();
    callback lock();
    callback quit();
    callback dismiss();

    title: @tr("Vault");
    no-frame: true;
    always-on-top: true;
    // Only the card is drawn; the corners around it stay see-through.
    background: transparent;
    default-font-family: Theme.ui-font;
    width: 196px;
    height: root.content-height;
    // The window's height, for the off-screen screenshots.
    out property <length> content-height: card.preferred-height + 2 * root.margin;
    // Room for the shadow.
    property <length> margin: 6px;

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            reject
        }
    }

    card := Rectangle {
        x: root.margin;
        y: root.margin;
        width: root.width - 2 * root.margin;
        height: self.preferred-height;
        background: Theme.dark ? #22262D : #F9FAFB;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.dark ? #FFFFFF14 : #00000014;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000060;
        VerticalLayout {
            padding: 5px;
            spacing: 0px;
            TrayItem {
                text: @tr("Open Vault");
                clicked => { root.open(); }
            }
            TrayRule { }
            // Where things stand, in grey.
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 2px;
                padding-bottom: 2px;
                if root.vault-name != "": TrayNote { text: root.vault-name; }
                TrayNote {
                    text: root.locked ? @tr("Locked") : @tr("Unlocked · {n} min left" | "Unlocked · {n} min left" % root.minutes-left);
                }
            }
            TrayRule { }
            TrayItem {
                text: @tr("Lock now");
                enabled: !root.locked;
                clicked => { root.lock(); }
            }
            TrayItem {
                text: @tr("Quit");
                clicked => { root.quit(); }
            }
        }
    }
}
