// Right-hand pages of the vault: item detail, editor, generator, settings.

import { ScrollView } from "std-widgets.slint";
import { Theme, Sketch } from "theme.slint";
import { DetailField, Messages } from "model.slint";
import { Button, QuietButton, LineField, NotesField, SecretField, Check, Stepper, Choice, Rule, Hint, ItemIcon, Slider } from "widgets.slint";
import { KitSlip } from "kit.slint";

component PageTitle inherits Text {
    font-size: Theme.headline;
    font-weight: 300;
    color: Theme.ink;
    wrap: word-wrap;
}

component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> hint;
    spacing: 8px;
    alignment: start;
    Text {
        text: root.text;
        font-size: Theme.lead;
        font-weight: 600;
        color: Theme.ink;
        vertical-alignment: center;
    }
    if root.hint != "": VerticalLayout {
        alignment: center;
        Hint { text: root.hint; }
    }
}

component Prose inherits Text {
    font-size: Theme.body;
    color: Theme.graphite;
    wrap: word-wrap;
}

component ErrorText inherits Text {
    in property <int> code;
    in property <string> detail;
    text: Messages.error(root.code, root.detail);
    visible: root.code != 0;
    // Takes no space when there is nothing to say.
    height: root.code != 0 ? self.preferred-height : 0px;
    font-size: Theme.body;
    color: Theme.seal;
    wrap: word-wrap;
}

// One labelled value on the item page, with its actions on the right.
component FieldRow inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> value;
    in property <bool> mono: false;
    in property <bool> large: false;
    spacing: 0px;
    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        HorizontalLayout {
            width: 150px;
            spacing: 6px;
            alignment: start;
            Text {
                text: root.label;
                font-size: Theme.body;
                color: Theme.graphite;
                vertical-alignment: center;
            }
            if root.hint != "": VerticalLayout {
                alignment: center;
                Hint { text: root.hint; }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.value;
            font-family: root.mono ? Theme.mono-font : Theme.ui-font;
            font-size: root.large ? Theme.title : Theme.body;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        @children
    }
    Rule { }
}

export component DetailPage inherits Rectangle {
    in property <bool> has-item;
    in property <string> title;
    in property <int> kind;
    in property <bool> favorite;
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> initial;
    in property <color> tint;
    in property <string> username;
    in property <bool> has-password;
    in property <string> revealed-password;
    in property <int> reveal-left;
    in property <string> totp-code;
    in property <int> totp-left;
    in property <[string]> urls;
    in property <string> notes;
    in property <[DetailField]> fields;
    in-out property <bool> notes-shown;
    in-out property <bool> confirming-delete;
    callback edit();
    callback toggle-favorite();
    callback delete();
    callback reveal();
    callback conceal();
    callback copy-username();
    callback copy-password();
    callback copy-totp();
    callback copy-field(int);

    if !root.has-item: VerticalLayout {
        padding: 48px;
        alignment: start;
        Prose {
            text: @tr("Pick an item on the left, or add a new one.");
        }
    }

    if root.has-item: ScrollView {
        VerticalLayout {
            padding: 44px;
            padding-right: 48px;
            spacing: 0px;
            alignment: start;

            HorizontalLayout {
                padding-bottom: 22px;
                spacing: 16px;
                VerticalLayout {
                    alignment: center;
                    ItemIcon {
                        size: 48px;
                        icon: root.icon;
                        has-icon: root.has-icon;
                        initial: root.initial;
                        tint: root.tint;
                        kind: root.kind;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    alignment: center;
                    PageTitle { text: root.title; }
                    Text {
                        text: Messages.kind-name(root.kind);
                        font-size: Theme.small;
                        color: Theme.graphite;
                    }
                }
                VerticalLayout {
                    alignment: start;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: Theme.radius;
                        background: star-touch.has-hover ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: root.favorite ? @tr("Remove from favorites") : @tr("Add to favorites");
                        Path {
                            width: 20px;
                            height: 20px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Sketch.star;
                            stroke: root.favorite ? Theme.accent-stroke : Theme.graphite;
                            stroke-width: 1.5px;
                            fill: transparent;
                        }
                        star-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-favorite(); }
                        }
                    }
                }
            }
            Rule { }

            if root.username != "": FieldRow {
                label: root.kind == 1 ? @tr("Name on card") : @tr("Username");
                value: root.username;
                QuietButton {
                    text: @tr("Copy");
                    clicked => { root.copy-username(); }
                }
            }

            if root.has-password: FieldRow {
                label: root.kind == 1 ? @tr("PIN or code") : @tr("Password");
                value: root.revealed-password != "" ? root.revealed-password : "••••••••••••";
                mono: root.revealed-password != "";
                if root.revealed-password != "": Text {
                    text: @tr("hides in {} s", root.reveal-left);
                    font-size: Theme.small;
                    color: Theme.faint;
                    vertical-alignment: center;
                }
                QuietButton {
                    text: root.revealed-password != "" ? @tr("Hide") : @tr("Show");
                    clicked => {
                        if (root.revealed-password != "") { root.conceal(); } else { root.reveal(); }
                    }
                }
                QuietButton {
                    text: @tr("Copy");
                    clicked => { root.copy-password(); }
                }
            }

            if root.totp-code != "": FieldRow {
                label: @tr("One-time code");
                hint: @tr("The code for two-step sign-in, made from the secret saved in this item. It changes every 30 seconds.");
                value: root.totp-code;
                mono: true;
                large: true;
                Text {
                    text: @tr("{} s", root.totp-left);
                    font-size: Theme.small;
                    color: root.totp-left <= 5 ? Theme.seal : Theme.faint;
                    vertical-alignment: center;
                }
                QuietButton {
                    text: @tr("Copy");
                    clicked => { root.copy-totp(); }
                }
            }

            for url in root.urls: FieldRow {
                label: @tr("Website");
                value: url;
            }

            for field[index] in root.fields: FieldRow {
                label: field.label;
                value: field.sensitive ? "••••••••" : field.value;
                QuietButton {
                    text: @tr("Copy");
                    clicked => { root.copy-field(index); }
                }
            }

            if root.notes != "": VerticalLayout {
                padding-top: 14px;
                spacing: 8px;
                Text {
                    text: @tr("Notes");
                    font-size: Theme.body;
                    color: Theme.graphite;
                }
                if root.notes-shown: Text {
                    text: root.notes;
                    font-size: Theme.body;
                    color: Theme.ink;
                    wrap: word-wrap;
                }
                if !root.notes-shown: HorizontalLayout {
                    alignment: start;
                    QuietButton {
                        outlined: true;
                        text: @tr("Show notes");
                        clicked => { root.notes-shown = true; }
                    }
                }
            }

            Rectangle { height: 26px; }

            if !root.confirming-delete: HorizontalLayout {
                alignment: start;
                spacing: 6px;
                QuietButton {
                    outlined: true;
                    text: @tr("Edit");
                    clicked => { root.edit(); }
                }
                QuietButton {
                    outlined: true;
                    text: @tr("Delete");
                    tint: Theme.seal;
                    clicked => { root.confirming-delete = true; }
                }
            }
            if root.confirming-delete: VerticalLayout {
                spacing: 12px;
                Text {
                    text: @tr("Delete “{}”? This can't be undone.", root.title);
                    font-size: Theme.body;
                    color: Theme.ink;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Button {
                        text: @tr("Delete");
                        danger: true;
                        clicked => { root.delete(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        QuietButton {
                            text: @tr("Keep it");
                            clicked => { root.confirming-delete = false; }
                        }
                    }
                }
            }
        }
    }
}

export component EditorPage inherits Rectangle {
    in property <bool> is-new;
    in property <int> error-code;
    in property <string> error-detail;
    in property <string> password-shown;
    in-out property <int> kind;
    in-out property <string> title;
    in-out property <string> username;
    in-out property <string> url;
    in-out property <string> totp;
    in-out property <string> notes;
    in-out property <bool> favorite;
    callback save();
    callback cancel();
    callback toggle-show-password();
    callback generate-password();

    ScrollView {
        VerticalLayout {
            padding: 40px;
            padding-right: 48px;
            spacing: 16px;
            alignment: start;

            HorizontalLayout {
                spacing: 16px;
                PageTitle {
                    text: root.is-new ? @tr("New item") : @tr("Edit item");
                    horizontal-stretch: 1;
                }
                Choice {
                    options: [@tr("Login"), @tr("Card"), @tr("Secure note")];
                    selected <=> root.kind;
                }
            }
            LineField {
                label: @tr("Title");
                placeholder: root.kind == 1 ? @tr("Visa ending 4242") : root.kind == 2 ? @tr("Home Wi-Fi") : @tr("GitHub");
                text <=> root.title;
                error: root.error-code == 9;
            }
            if root.kind != 2: HorizontalLayout {
                spacing: 16px;
                LineField {
                    label: root.kind == 1 ? @tr("Name on card") : @tr("Username or email");
                    hint: root.kind == 1
                        ? @tr("The name exactly as it's printed on the card.")
                        : @tr("What you type in the site's username or email box when you sign in.");
                    placeholder: root.kind == 1 ? "" : @tr("you@example.com");
                    text <=> root.username;
                }
                if root.kind == 0: LineField {
                    label: @tr("Website");
                    placeholder: "https://";
                    text <=> root.url;
                }
            }
            if root.kind != 2: HorizontalLayout {
                spacing: 16px;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    SecretField {
                        horizontal-stretch: 1;
                        field: 4;
                        label: root.kind == 1 ? @tr("PIN or security code") : @tr("Password");
                        hint: root.kind == 1
                            ? @tr("The card's PIN, or the 3–4 digit code on the back. Leave it empty if you'd rather not store it.")
                            : @tr("The password for this account. Signing up or changing it on the site? Click Generate for a strong one, then use it there.");
                        revealed: root.password-shown;
                    }
                    VerticalLayout {
                        alignment: end;
                        QuietButton {
                            text: root.password-shown != "" ? @tr("Hide") : @tr("Show");
                            clicked => { root.toggle-show-password(); }
                        }
                    }
                    VerticalLayout {
                        alignment: end;
                        QuietButton {
                            text: @tr("Generate");
                            clicked => { root.generate-password(); }
                        }
                    }
                }
                if root.kind == 0: LineField {
                    horizontal-stretch: 1;
                    label: @tr("One-time code secret");
                    hint: @tr("Optional. Only for sites with two-step sign-in through an authenticator app. When you turn it on, the site shows a QR code and a text key (often under “Can't scan it?”): paste that key here, or an otpauth:// link. This item will then show the 6-digit codes.");
                    placeholder: @tr("otpauth:// link or key");
                    mono: true;
                    error: root.error-code == 10;
                    text <=> root.totp;
                }
            }
            NotesField {
                label: @tr("Notes");
                text <=> root.notes;
            }
            ErrorText {
                code: root.error-code;
                detail: root.error-detail;
            }
            HorizontalLayout {
                spacing: 8px;
                Check {
                    text: @tr("Favorite");
                    checked <=> root.favorite;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    QuietButton {
                        text: @tr("Cancel");
                        clicked => { root.cancel(); }
                    }
                }
                Button {
                    text: @tr("Save");
                    clicked => { root.save(); }
                }
            }
        }
    }
}

export component GeneratorPage inherits Rectangle {
    in property <string> result;
    in property <int> bits;
    in property <int> crack-unit;
    in property <int> crack-amount;
    in property <bool> editing;
    in-out property <int> mode;
    in-out property <int> length;
    in-out property <int> words;
    in-out property <bool> lowercase;
    in-out property <bool> uppercase;
    in-out property <bool> digits;
    in-out property <bool> symbols;
    in-out property <bool> avoid-ambiguous;
    in-out property <bool> capitalize;
    in-out property <bool> number;
    in-out property <int> separator;
    callback regenerate();
    callback copy();
    callback use-for-item();

    ScrollView {
        VerticalLayout {
            padding: 40px;
            padding-right: 48px;
            spacing: 16px;
            alignment: start;

            PageTitle { text: @tr("Password generator"); }

            Rectangle {
                min-height: output.preferred-height + 36px;
                border-radius: Theme.radius;
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.rule;
                output := Text {
                    x: 18px;
                    width: parent.width - 36px;
                    text: root.result;
                    font-family: Theme.mono-font;
                    font-size: Theme.title;
                    color: Theme.ink;
                    wrap: word-wrap;
                }
            }
            // Strength: a thin meter that fills up to 128 bits.
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.rule;
                Rectangle {
                    x: 0;
                    width: parent.width * Math.min(1, root.bits / 128);
                    border-radius: 2px;
                    background: root.bits >= 70 ? Theme.good : root.bits >= 50 ? Theme.marker : Theme.seal;
                    animate width { duration: 160ms; easing: ease-out; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: Messages.crack-time(root.crack-unit, root.crack-amount);
                    font-size: Theme.body;
                    font-weight: 600;
                    color: root.bits >= 70 ? Theme.good : root.bits >= 50 ? Theme.ink : Theme.seal;
                    vertical-alignment: center;
                }
                Text {
                    text: @tr("· {} bits", root.bits);
                    font-size: Theme.small;
                    color: Theme.faint;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Hint {
                        text: @tr("Estimated for the worst realistic case: a site you use is breached, its password list leaks, and an attacker with a rack of graphics cards tries a trillion guesses per second. On average they'd find it halfway through. Each extra bit doubles the time.");
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Button {
                    text: @tr("Copy");
                    clicked => { root.copy(); }
                }
                VerticalLayout {
                    alignment: center;
                    QuietButton {
                        text: @tr("Generate another");
                        clicked => { root.regenerate(); }
                    }
                }
                if root.editing: VerticalLayout {
                    alignment: center;
                    QuietButton {
                        text: @tr("Use for this item");
                        clicked => { root.use-for-item(); }
                    }
                }
            }

            Rule { }

            // Length (or number of words): drag the bar.
            HorizontalLayout {
                spacing: 16px;
                Text {
                    text: root.mode == 0 ? @tr("Length") : @tr("Words");
                    font-size: Theme.body;
                    color: Theme.ink;
                    vertical-alignment: center;
                    width: 120px;
                }
                if root.mode == 0: Slider {
                    label: @tr("Length");
                    minimum: 8;
                    maximum: 100;
                    value <=> root.length;
                    changed => { root.regenerate(); }
                }
                if root.mode == 1: Slider {
                    label: @tr("Words");
                    minimum: 3;
                    maximum: 12;
                    value <=> root.words;
                    changed => { root.regenerate(); }
                }
                Text {
                    text: root.mode == 0 ? root.length : root.words;
                    font-size: Theme.lead;
                    font-weight: 600;
                    color: Theme.ink;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    width: 44px;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Check {
                    text: @tr("Use words instead (a passphrase)");
                    checked: root.mode == 1;
                    toggled(on) => {
                        root.mode = on ? 1 : 0;
                        root.regenerate();
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Hint {
                        text: @tr("A passphrase is a few random words, like correct-horse-battery-staple: as strong as a long random password but much easier to read and type. Good for passwords you type by hand, such as a computer login.");
                    }
                }
            }

            if root.mode == 0: GridLayout {
                spacing-horizontal: 24px;
                spacing-vertical: 10px;
                Row {
                    Check { text: @tr("Lowercase (a–z)"); checked <=> root.lowercase; toggled => { root.regenerate(); } }
                    Check { text: @tr("Capitals (A–Z)"); checked <=> root.uppercase; toggled => { root.regenerate(); } }
                }
                Row {
                    Check { text: @tr("Digits (0–9)"); checked <=> root.digits; toggled => { root.regenerate(); } }
                    Check { text: @tr("Symbols (!@#$…)"); checked <=> root.symbols; toggled => { root.regenerate(); } }
                }
                Row {
                    Check { text: @tr("Leave out look-alikes (I l 1 O 0 o)"); checked <=> root.avoid-ambiguous; toggled => { root.regenerate(); } colspan: 2; }
                }
            }
            if root.mode == 1: VerticalLayout {
                spacing: 10px;
                GridLayout {
                    spacing-horizontal: 24px;
                    Row {
                        Check { text: @tr("Capitalize each word"); checked <=> root.capitalize; toggled => { root.regenerate(); } }
                        Check { text: @tr("Add a digit"); checked <=> root.number; toggled => { root.regenerate(); } }
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    Text {
                        text: @tr("Between words");
                        font-size: Theme.body;
                        color: Theme.ink;
                        vertical-alignment: center;
                        width: 120px;
                    }
                    Choice {
                        options: [@tr("- dash"), @tr(". dot"), @tr("_ underscore"), @tr("space")];
                        selected <=> root.separator;
                        changed => { root.regenerate(); }
                    }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <int> error-code;
    in property <string> error-detail;
    in property <bool> busy;
    in property <bool> dark;
    in property <string> vault-path;
    in property <string> vault-id;
    in property <string> kit-secret-key;
    in property <string> kit-recovery-key;
    in-out property <int> auto-lock-minutes;
    in-out property <int> clipboard-seconds;
    in-out property <bool> website-icons;
    in property <bool> quick-unlock-available;
    in-out property <bool> quick-unlock-on;
    callback quick-unlock-toggled(bool);
    callback settings-changed();
    callback appearance-changed(bool);
    callback change-password();
    callback show-kit();
    callback hide-kit();
    callback new-recovery-key();

    ScrollView {
        VerticalLayout {
            padding: 40px;
            padding-right: 48px;
            spacing: 14px;
            alignment: start;

            PageTitle { text: @tr("Settings"); }

            SectionTitle { text: @tr("Appearance"); }
            Choice {
                options: [@tr("Dark"), @tr("Light")];
                selected: root.dark ? 0 : 1;
                changed(index) => { root.appearance-changed(index == 0); }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Check {
                    text: @tr("Show website icons");
                    checked <=> root.website-icons;
                    toggled => { root.settings-changed(); }
                }
                VerticalLayout {
                    alignment: center;
                    Hint {
                        text: @tr("Downloads each site's own icon directly from that site, once, over a secure connection, and keeps it encrypted with your vault. Nothing else is sent. Trade-off: someone watching your network (your provider, a public Wi-Fi) could see which sites were contacted, which hints at where you have accounts. Leave it off for maximum privacy.");
                    }
                }
            }

            Rule { }
            SectionTitle {
                text: @tr("Locking");
            }
            Stepper {
                label: @tr("Lock after");
                unit: @tr("min");
                value <=> root.auto-lock-minutes;
                minimum: 1;
                maximum: 60;
                changed => { root.settings-changed(); }
            }
            Stepper {
                label: @tr("Clear copied secrets after");
                unit: @tr("s");
                value <=> root.clipboard-seconds;
                minimum: 5;
                maximum: 120;
                changed => { root.settings-changed(); }
            }
            if root.quick-unlock-available: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Check {
                    text: @tr("Unlock with Windows Hello");
                    checked <=> root.quick-unlock-on;
                    toggled(on) => { root.quick-unlock-toggled(on); }
                }
                VerticalLayout {
                    alignment: center;
                    Hint {
                        text: @tr("Open this vault with your face, fingerprint or Windows PIN instead of typing the master password. The key is made inside this computer's security chip and only works here, after Windows Hello checks it's you. Every 14 days the master password is asked once, so you don't forget it, and changing the master password turns this off. Anyone who knows your Windows PIN could open the vault on this computer.");
                    }
                }
            }

            Rule { }
            SectionTitle {
                text: @tr("Master password and emergency kit");
                hint: @tr("These changes re-check your current master password against the vault file, so someone using an unlocked computer can't make them.");
            }
            SecretField {
                field: 5;
                label: @tr("Current master password");
                error: root.error-code == 11;
            }
            HorizontalLayout {
                spacing: 16px;
                SecretField {
                    field: 6;
                    label: @tr("New master password");
                    hint: @tr("Only to change it. At least 12 characters; leave both new-password boxes empty to just show the Secret Key or issue a new Recovery Key.");
                    error: root.error-code == 4 || root.error-code == 5;
                }
                SecretField {
                    field: 7;
                    label: @tr("Type it again");
                    error: root.error-code == 4;
                }
            }
            ErrorText {
                code: root.error-code;
                detail: root.error-detail;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Button {
                    text: @tr("Change master password");
                    busy-text: @tr("Working…");
                    busy: root.busy;
                    clicked => { root.change-password(); }
                }
                VerticalLayout {
                    alignment: center;
                    QuietButton {
                        text: root.kit-secret-key == "" ? @tr("Show Secret Key") : @tr("Hide kit");
                        clicked => {
                            if (root.kit-secret-key == "") { root.show-kit(); } else { root.hide-kit(); }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    QuietButton {
                        text: @tr("Issue a new Recovery Key");
                        clicked => { root.new-recovery-key(); }
                    }
                }
            }
            if root.kit-secret-key != "": KitSlip {
                vault-id: root.vault-id;
                secret-key: root.kit-secret-key;
                recovery-key: root.kit-recovery-key;
                vault-path: root.vault-path;
            }

            Rule { }
            SectionTitle { text: @tr("This vault"); }
            Prose { text: @tr("File: {}", root.vault-path); }
            Prose { text: @tr("Vault ID: {}", root.vault-id); }
        }
    }
}
