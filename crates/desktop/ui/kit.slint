import { Theme } from "theme.slint";
import { Hint, Rule } from "widgets.slint";

component KitLine inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> value;
    in property <bool> large: false;
    spacing: 5px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text {
            text: root.label;
            font-size: Theme.small;
            color: #5F6B7D;
            vertical-alignment: center;
        }
        if root.hint != "": VerticalLayout {
            alignment: center;
            Hint { text: root.hint; }
        }
    }
    Text {
        text: root.value;
        font-family: Theme.mono-font;
        font-size: root.large ? Theme.title : Theme.body;
        color: #1F2A3D;
        wrap: word-wrap;
    }
}

// The emergency kit as a slip of paper. It stays light in both themes, because it is the one
// screen meant to be copied onto paper — and the only place the handwriting font appears.
export component KitSlip inherits Rectangle {
    in property <string> vault-id;
    in property <string> secret-key;
    in property <string> recovery-key;
    in property <string> vault-path;

    background: #F7F5EE;
    border-radius: 4px;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000040;
    min-height: layout.preferred-height;

    layout := VerticalLayout {
        padding: 26px;
        spacing: 16px;

        HorizontalLayout {
            Text {
                text: @tr("Emergency kit");
                font-size: Theme.title;
                font-weight: 600;
                color: #1F2A3D;
                horizontal-stretch: 1;
            }
            Text {
                text: @tr("keep on paper, away from the computer");
                font-family: Theme.hand-font;
                font-size: Theme.body;
                color: #5F6B7D;
                vertical-alignment: center;
            }
        }
        Rectangle { height: 1px; background: #D9D5C9; }

        KitLine {
            label: @tr("Secret Key");
            hint: @tr("Generated by the app. It is combined with your master password, so a stolen vault file is useless without it. This computer remembers it; on a new computer you type it once from this kit.");
            value: root.secret-key;
            large: true;
        }
        if root.recovery-key != "": KitLine {
            label: @tr("Recovery Key");
            hint: @tr("Opens the vault on its own, for when you forget the master password or lose the Secret Key. Anyone holding it can open your vault, so keep it apart from your devices.");
            value: root.recovery-key;
        }
        KitLine {
            label: @tr("Vault ID");
            value: root.vault-id;
        }
        VerticalLayout {
            spacing: 4px;
            Text {
                text: @tr("Master password");
                font-size: Theme.small;
                color: #5F6B7D;
            }
            Rectangle {
                height: 26px;
                Text {
                    x: 0;
                    text: @tr("write it here, by hand");
                    font-family: Theme.hand-font;
                    font-size: Theme.body;
                    color: #9AA5B3;
                }
            }
            Rectangle { height: 1px; background: #1F2A3D; }
        }
        if root.vault-path != "": Text {
            text: @tr("Vault file: {}", root.vault-path);
            font-size: Theme.small;
            color: #5F6B7D;
            wrap: word-wrap;
        }
    }
}
