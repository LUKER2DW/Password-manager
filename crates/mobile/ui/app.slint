// The phone app's window: one column, one thing at a time.
//
// Tokens, widgets and icons are the desktop app's (crates/desktop/ui), with `Theme.touch` on:
// the two apps share one design. What is here is the phone's own layout (see docs/MOBILE.md).

import { Theme, Sketch, Secrets } from "../../desktop/ui/theme.slint";
import { Button, QuietButton, EyeButton, LineField, NotesField, SecretField, Check, Slider, Choice, ItemIcon, MarkStroke, Logo, Rule } from "../../desktop/ui/widgets.slint";
import { Glyph } from "../../desktop/ui/icons.slint";

export { Theme, Sketch, Secrets }

// The phone opens a vault made on the computer; it never makes one.
export enum Screen { start, unlock, vault }
export enum Place { items, codes, generator, settings }
export enum Page { none, item, editor }

// One line of the list.
export struct ItemRow {
    title: string,
    detail: string,
    initial: string,
    tint: color,
    kind: int,          // 0 login, 1 card, 2 note, 3 passkey
    favorite: bool,
    locked: bool,
}

// One line of the Codes place.
export struct CodeRow {
    title: string,
    account: string,
    code: string,       // "" while the item is locked
    left: int,
    period: int,
    initial: string,
    tint: color,
}

// Every sentence the phone app shows for a code sent by Rust.
export global Words {
    pure public function error(code: int, detail: string) -> string {
        if (code == 1) { return @tr("That didn't open the vault. Check the master password (and the Secret Key, if you typed it)."); }
        if (code == 2) { return @tr("That file isn't a vault. Choose the .vault file from your computer."); }
        if (code == 3) { return @tr("That isn't a Secret Key. It starts with S0- and is printed on your emergency kit."); }
        if (code == 4) { return @tr("The vault file can't be read ({}).", detail); }
        if (code == 5) { return @tr("Give it a name first."); }
        if (code == 6) { return @tr("Not saved ({}). Your change is still on screen: try again.", detail); }
        if (code == 7) { return @tr("That isn't it. Try again."); }
        if (code == 8) { return @tr("This vault file is older than the one this phone opened last. Bring the newest copy from your computer."); }
        if (code == 9) { return @tr("This vault also needs its keyfile, which the phone app can't use yet."); }
        if (code == 10) { return @tr("That isn't a setup key for one-time codes. Paste the key the site shows under “Can't scan it?”."); }
        if (code == 11) { return @tr("Pick at least one kind of character."); }
        return detail;
    }
    pure public function notice(code: int, arg: string) -> string {
        if (code == 1) { return @tr("Password copied. The clipboard is cleared in {} seconds.", arg); }
        if (code == 2) { return @tr("Username copied."); }
        if (code == 3) { return @tr("Saved."); }
        if (code == 4) { return @tr("“{}” deleted.", arg); }
        if (code == 5) { return @tr("Code copied. The clipboard is cleared in {} seconds.", arg); }
        if (code == 6) { return @tr("Website copied."); }
        if (code == 7) { return @tr("Copied. The clipboard is cleared in {} seconds.", arg); }
        if (code == 8) { return @tr("This phone's record of the vault's newest version couldn't be read, so it started again. The old file was kept."); }
        if (code == 9) { return @tr("Synced: {} changes came from your other devices.", arg); }
        return "";
    }
}

// A line icon that isn't among the shared ones.
component Stroke inherits Path {
    in property <color> tint: Theme.graphite;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.tint;
    stroke-width: 2px * self.width / 24px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

// The bar on top of a page: where you are, a way back, one action at most.
component TopBar inherits Rectangle {
    in property <string> title;
    in property <string> back;          // "" = no way back
    in property <string> action;        // "" = none
    in property <string> action-icon;
    callback went-back;
    callback acted;
    height: 56px;
    HorizontalLayout {
        padding-left: root.back != "" ? 4px : 20px;
        // The page's gutter, so the action lines up with the content under it.
        padding-right: 20px;
        spacing: 4px;
        if root.back != "": Rectangle {
            width: back-label.preferred-width + 44px;
            border-radius: Theme.radius;
            background: back-touch.pressed ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: root.back;
            Stroke {
                x: 10px;
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                commands: "M15 5 L8 12 L15 19";
                tint: Theme.ink;
            }
            back-label := Text {
                x: 34px;
                text: root.back;
                font-size: Theme.body;
                color: Theme.ink;
                vertical-alignment: center;
            }
            back-touch := TouchArea { clicked => { root.went-back(); } }
        }
        Text {
            text: root.title;
            font-size: Theme.title;
            font-weight: 300;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
        }
        if root.action != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            QuietButton {
                text: root.action;
                icon: root.action-icon;
                outlined: true;
                clicked => { root.acted(); }
            }
        }
    }
}

// One of the four places at the bottom.
component PlaceTab inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    in property <int> variant;
    callback clicked;
    horizontal-stretch: 1;
    accessible-role: tab;
    accessible-label: root.text;
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            alignment: center;
            Glyph {
                width: 22px;
                height: 22px;
                name: root.icon;
                tint: root.active ? Theme.ink : Theme.graphite;
            }
        }
        label := Text {
            text: root.text;
            font-size: Theme.small;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Theme.ink : Theme.graphite;
            horizontal-alignment: center;
        }
    }
    MarkStroke {
        x: (parent.width - label.preferred-width) / 2 - 2px;
        y: parent.height - 9px;
        width: label.preferred-width + 4px;
        variant: root.variant;
        reveal: root.active ? 1 : 0;
        animate reveal { duration: Theme.sweep; easing: ease-out; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// A filter over the list: a word that gets a soft pill when chosen.
component Filter inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 36px;
    width: label.preferred-width + 26px;
    border-radius: 18px;
    background: root.active ? Theme.selected : transparent;
    accessible-role: button;
    accessible-label: root.text;
    label := Text {
        text: root.text;
        font-size: Theme.body;
        font-weight: root.active ? 600 : 400;
        color: root.active ? Theme.ink : Theme.graphite;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// One fact of an item: its name, its value, and what a tap on the right does.
component Fact inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <string> value;
    in property <bool> mono;
    in property <bool> large;
    in property <string> action;
    callback acted;
    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 7px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Glyph { width: 15px; height: 15px; name: root.icon; }
            }
            Text {
                text: root.label;
                font-size: Theme.small;
                color: Theme.graphite;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.value;
                font-size: root.large ? Theme.headline : Theme.lead;
                font-family: root.mono ? Theme.mono-font : Theme.ui-font;
                color: Theme.ink;
                vertical-alignment: center;
                wrap: root.large ? no-wrap : word-wrap;
                horizontal-stretch: 1;
                min-width: 0px;
            }
            @children
            if root.action != "": VerticalLayout {
                alignment: center;
                QuietButton { text: root.action; outlined: true; clicked => { root.acted(); } }
            }
        }
    }
    Rule { y: parent.height - 1px; }
}

// A confirmation, just above the places.
component Toast inherits Rectangle {
    in property <string> text;
    height: label.preferred-height + 22px;
    border-radius: Theme.radius;
    background: Theme.dark ? #2B3645 : #1F2A3D;
    label := Text {
        x: 16px;
        width: parent.width - 32px;
        text: root.text;
        font-size: Theme.body;
        color: #E3E8EF;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}

component ErrorLine inherits Text {
    font-size: Theme.body;
    color: Theme.seal;
    wrap: word-wrap;
}

export component PhoneWindow inherits Window {
    title: "Vault";
    preferred-width: 390px;
    preferred-height: 844px;
    min-width: 320px;
    background: Theme.canvas;
    default-font-family: Theme.ui-font;
    default-font-size: Theme.body;

    // Room the system keeps for itself (status bar, gesture bar), set by the shell.
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    in-out property <Screen> screen: Screen.start;
    in-out property <Place> place: Place.items;
    in-out property <Page> page: Page.none;
    in property <bool> busy;
    in property <int> error-code;
    in property <string> error-detail;
    in property <int> notice-code;
    in property <string> notice-arg;

    // Bringing a vault in, and unlock
    in property <string> vault-name;
    in property <bool> needs-secret-key;
    in property <bool> incoming;        // a chosen file waits to open
    in property <bool> has-copy;        // the phone already keeps a vault
    callback pick-vault();              // the shell shows the system's file picker
    callback cancel-incoming();
    callback unlock();

    // The list
    in property <[ItemRow]> items;
    in property <int> total;
    in-out property <string> search;
    in-out property <int> filter;       // 0 all, 1 favourites, 2 logins, 3 cards, 4 notes
    callback search-changed(string);
    callback filter-changed(int);
    callback open-item(int);
    callback new-item();

    // One item
    in property <string> d-title;
    in property <string> d-initial;
    in property <color> d-tint;
    in property <int> d-kind;
    in property <bool> d-favorite;
    in property <string> d-username;
    in property <bool> d-has-password;
    in property <string> d-password;    // shown only while asked for
    in property <string> d-website;
    in property <string> d-notes;
    in property <string> d-card;
    in property <string> d-code;
    in property <int> d-code-left;
    in property <int> d-code-period;
    in property <bool> d-has-code;
    // The item lock stands in front of this item's secrets: 0 no, 1 master password, 2 PIN,
    // 3 item password.
    in property <int> d-check;
    callback close-item();
    callback edit-item();
    callback toggle-favorite();
    callback toggle-password();
    callback copy(int);                 // 0 username, 1 password, 2 code, 3 website
    callback unlock-item();

    // The editor
    in property <bool> ed-new;
    in-out property <int> ed-kind;      // 0 login, 1 note
    in-out property <string> ed-title;
    in-out property <string> ed-username;
    in-out property <string> ed-website;
    in-out property <string> ed-totp;
    in-out property <string> ed-notes;
    in-out property <bool> ed-favorite;
    in property <string> ed-password;   // shown only while asked for
    in property <bool> ed-confirm-delete;
    callback ed-toggle-password();
    callback ed-generate();
    callback save-item();
    callback cancel-edit();
    callback delete-item();

    // Codes
    in property <[CodeRow]> codes;
    callback copy-code(int);

    // Generator
    in property <string> gen-password;
    in property <int> gen-bits;
    in-out property <int> gen-mode;     // 0 characters, 1 words
    in-out property <int> gen-length: 20;
    in-out property <int> gen-words: 6;
    in-out property <bool> gen-upper: true;
    in-out property <bool> gen-lower: true;
    in-out property <bool> gen-digits: true;
    in-out property <bool> gen-symbols: true;
    callback gen-changed();
    callback gen-copy();

    // Settings
    in-out property <int> lock-choice;  // 0: 1 minute, 1: 5 minutes, 2: 15 minutes
    in property <string> vault-path;
    in property <string> app-version;
    callback theme-changed(bool);
    callback lock-choice-changed(int);
    // Sync: whether this build can (not in the browser preview), the server ("" = off), what
    // happened last (0 off, 1 synced, 2 syncing, 3 failed), minutes since the last round, why
    // it failed, the invite line pasted from the computer.
    in property <bool> sync-available;
    in property <string> sync-place;
    in property <int> sync-state;
    in property <int> sync-minutes: -1;
    in property <string> sync-detail;
    in property <bool> sync-busy;
    in-out property <string> sync-invite-typed;
    callback sync-join();
    callback sync-now();
    callback sync-stop();
    callback lock-now();

    property <length> gutter: 20px;
    // What sits at the bottom of the open vault: the places, and a page's main button.
    property <length> bottom-bar: root.page == Page.editor ? 72px
        : root.page == Page.item ? 0px
        : 63px + (root.place == Place.generator || root.place == Place.settings ? 72px : 0px);

    VerticalLayout {
        padding-top: root.inset-top;
        padding-bottom: root.inset-bottom;

        // ---------------------------------------------------------------- no vault yet
        // The vault is made on the computer; the phone opens a copy of its file.
        if root.screen == Screen.start: VerticalLayout {
            padding: root.gutter;
            padding-top: 72px;
            spacing: 14px;
            HorizontalLayout { alignment: start; Logo { width: 72px; height: 72px; } }
            Text {
                text: @tr("No vault on this phone yet");
                font-size: Theme.headline;
                font-weight: 300;
                color: Theme.ink;
                wrap: word-wrap;
            }
            Text {
                text: @tr("The phone opens the vault you made on your computer. Copy its .vault file to the phone, then choose it here.");
                font-size: Theme.body;
                color: Theme.graphite;
                wrap: word-wrap;
            }
            // How the file gets here, in the order most people have at hand.
            VerticalLayout {
                padding-top: 6px;
                spacing: 10px;
                for way in [
                    @tr("A USB cable: drop the file into the phone's Download folder."),
                    @tr("Quick Share or Bluetooth from the computer."),
                    @tr("A drive or folder you already sync between the two."),
                ]: HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        padding-top: 7px;
                        alignment: start;
                        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.graphite; }
                    }
                    Text {
                        text: way;
                        font-size: Theme.body;
                        color: Theme.ink;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        min-width: 0px;
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
            Text {
                text: @tr("The file alone opens nothing: it also needs your master password and the Secret Key from your emergency kit.");
                font-size: Theme.small;
                color: Theme.graphite;
                wrap: word-wrap;
            }
            if root.error-code != 0: ErrorLine { text: Words.error(root.error-code, root.error-detail); }
            Button { text: @tr("Choose the vault file"); clicked => { root.pick-vault(); } }
        }

        // ---------------------------------------------------------------- unlock
        if root.screen == Screen.unlock: Rectangle {
            Image {
                width: parent.width;
                height: parent.height * 0.46;
                y: 0;
                source: Theme.dark ? @image-url("../../desktop/ui/brand/lock-scene.svg") : @image-url("../../desktop/ui/brand/lock-scene-light.svg");
                image-fit: cover;
                opacity: 0.55;
            }
            // The wall fades into the page.
            Rectangle {
                width: parent.width;
                height: parent.height * 0.46;
                background: @linear-gradient(180deg, Theme.canvas.transparentize(1) 0%, Theme.canvas.transparentize(0.35) 55%, Theme.canvas 100%);
            }
            VerticalLayout {
                padding: root.gutter;
                spacing: 14px;
                Rectangle { vertical-stretch: 5; }
                HorizontalLayout { alignment: start; Logo { width: 64px; height: 64px; } }
                Text {
                    text: root.vault-name != "" ? root.vault-name : @tr("Your vault");
                    font-size: Theme.headline;
                    font-weight: 300;
                    color: Theme.ink;
                    overflow: elide;
                }
                Text {
                    text: root.needs-secret-key
                        ? @tr("First time on this phone: it needs the Secret Key from your emergency kit, once.")
                        : root.incoming && root.has-copy
                        ? @tr("Type your master password. The file you chose replaces the phone's copy once it opens.")
                        : @tr("Locked. Type your master password to open it.");
                    font-size: Theme.body;
                    color: Theme.graphite;
                    wrap: word-wrap;
                }
                if root.needs-secret-key: SecretField {
                    field: 1;
                    label: @tr("Secret Key");
                    icon: "shield";
                    placeholder: "S0-…";
                    error: root.error-code == 3;
                }
                SecretField {
                    field: 0;
                    label: @tr("Master password");
                    icon: "key";
                    error: root.error-code == 1;
                    accepted => { root.unlock(); }
                }
                if root.error-code != 0: ErrorLine { text: Words.error(root.error-code, root.error-detail); }
                Button {
                    text: @tr("Open my vault");
                    busy: root.busy;
                    busy-text: @tr("Opening…");
                    clicked => { root.unlock(); }
                }
                // A chosen file that isn't the right one: another, or back to what was here.
                if root.incoming: HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    QuietButton { text: @tr("Another file"); icon: "folder"; outlined: true; clicked => { root.pick-vault(); } }
                    QuietButton { text: @tr("Cancel"); clicked => { root.cancel-incoming(); } }
                }
                Rectangle { vertical-stretch: 2; }
            }
        }

        // ---------------------------------------------------------------- the open vault
        if root.screen == Screen.vault: Rectangle {
            // ---- the four places
            if root.page == Page.none: VerticalLayout {
                if root.place == Place.items: VerticalLayout {
                    vertical-stretch: 1;
                    TopBar {
                        title: root.vault-name != "" ? root.vault-name : @tr("Vault");
                        action: @tr("New");
                        acted => { root.new-item(); }
                    }
                    VerticalLayout {
                        padding-left: root.gutter;
                        padding-right: root.gutter;
                        padding-bottom: 6px;
                        spacing: 10px;
                        Rectangle {
                            height: Theme.control-height;
                            border-radius: Theme.radius;
                            background: Theme.field;
                            border-width: 1px;
                            border-color: Theme.rule;
                            Stroke {
                                x: 12px;
                                y: (parent.height - self.height) / 2;
                                width: 18px;
                                height: 18px;
                                commands: "M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 Z M16.2 16.2 L20.5 20.5";
                            }
                            if find.text == "": Text {
                                x: 40px;
                                text: @tr("Search {} items", root.total);
                                color: Theme.faint;
                                font-size: Theme.body;
                                vertical-alignment: center;
                            }
                            find := TextInput {
                                x: 40px;
                                width: parent.width - 52px;
                                height: parent.height;
                                text <=> root.search;
                                font-size: Theme.body;
                                color: Theme.ink;
                                vertical-alignment: center;
                                single-line: true;
                                selection-background-color: Theme.marker;
                                selection-foreground-color: Theme.on-marker;
                                accessible-label: @tr("Search");
                                edited => { root.search-changed(self.text); }
                            }
                        }
                        Flickable {
                            height: 36px;
                            content-width: filters.preferred-width;
                            filters := HorizontalLayout {
                                spacing: 2px;
                                alignment: start;
                                for name[index] in [@tr("All"), @tr("Favourites"), @tr("Logins"), @tr("Cards"), @tr("Notes")]: Filter {
                                    text: name;
                                    active: root.filter == index;
                                    clicked => {
                                        root.filter = index;
                                        root.filter-changed(index);
                                    }
                                }
                            }
                        }
                    }
                    Rule { }
                    if root.items.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        padding: root.gutter;
                        padding-top: 48px;
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: root.total == 0 ? @tr("Nothing saved yet") : @tr("Nothing matches");
                            font-size: Theme.title;
                            font-weight: 300;
                            color: Theme.ink;
                        }
                        Text {
                            text: root.total == 0
                                ? @tr("Tap New to save your first login or note.")
                                : @tr("Try another word, or look under All.");
                            font-size: Theme.body;
                            color: Theme.graphite;
                            wrap: word-wrap;
                        }
                    }
                    if root.items.length > 0: Flickable {
                        vertical-stretch: 1;
                        content-height: rows.preferred-height;
                        rows := VerticalLayout {
                            alignment: start;
                            for row[index] in root.items: Rectangle {
                                height: 64px;
                                background: row-touch.pressed ? Theme.hover : transparent;
                                accessible-role: list-item;
                                accessible-label: row.title;
                                HorizontalLayout {
                                    padding-left: root.gutter;
                                    padding-right: root.gutter;
                                    spacing: 14px;
                                    VerticalLayout {
                                        alignment: center;
                                        ItemIcon { size: 40px; initial: row.initial; tint: row.tint; kind: row.kind; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        Text {
                                            text: row.title;
                                            font-size: Theme.lead;
                                            color: Theme.ink;
                                            overflow: elide;
                                        }
                                        if row.detail != "": Text {
                                            text: row.detail;
                                            font-size: Theme.small;
                                            color: Theme.graphite;
                                            overflow: elide;
                                        }
                                    }
                                    if row.favorite: VerticalLayout {
                                        alignment: center;
                                        Path {
                                            width: 18px;
                                            height: 18px;
                                            viewbox-width: 24;
                                            viewbox-height: 24;
                                            commands: Sketch.star;
                                            stroke: Theme.accent-stroke;
                                            stroke-width: 1.6px;
                                            fill: transparent;
                                        }
                                    }
                                    if row.locked: VerticalLayout {
                                        alignment: center;
                                        Glyph { width: 16px; height: 16px; name: "lock"; tint: Theme.graphite; }
                                    }
                                }
                                row-touch := TouchArea { clicked => { root.open-item(index); } }
                            }
                        }
                    }
                }

                if root.place == Place.codes: VerticalLayout {
                    vertical-stretch: 1;
                    TopBar { title: @tr("Codes"); }
                    if root.codes.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        padding: root.gutter;
                        padding-top: 48px;
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: @tr("No one-time codes yet");
                            font-size: Theme.title;
                            font-weight: 300;
                            color: Theme.ink;
                        }
                        Text {
                            text: @tr("When a site offers two-step sign-in with an authenticator app, paste its setup key into the login here. The six digits then show up on this page.");
                            font-size: Theme.body;
                            color: Theme.graphite;
                            wrap: word-wrap;
                        }
                    }
                    if root.codes.length > 0: Flickable {
                        vertical-stretch: 1;
                        content-height: code-rows.preferred-height;
                        code-rows := VerticalLayout {
                            alignment: start;
                            for row[index] in root.codes: Rectangle {
                                height: 84px;
                                background: code-touch.pressed ? Theme.hover : transparent;
                                accessible-role: list-item;
                                accessible-label: row.title;
                                HorizontalLayout {
                                    padding-left: root.gutter;
                                    padding-right: root.gutter;
                                    spacing: 14px;
                                    VerticalLayout {
                                        alignment: center;
                                        ItemIcon { size: 40px; initial: row.initial; tint: row.tint; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        Text {
                                            text: row.account != "" ? row.title + "  " + row.account : row.title;
                                            font-size: Theme.small;
                                            color: Theme.graphite;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: row.code != "" ? row.code : @tr("Locked: open the login first");
                                            font-family: row.code != "" ? Theme.mono-font : Theme.ui-font;
                                            font-size: row.code != "" ? Theme.headline : Theme.body;
                                            color: row.code != "" ? Theme.ink : Theme.graphite;
                                        }
                                    }
                                    if row.code != "": VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: row.left;
                                            font-size: Theme.body;
                                            color: row.left <= 5 ? Theme.seal : Theme.graphite;
                                            horizontal-alignment: right;
                                            min-width: 24px;
                                        }
                                    }
                                }
                                // The time left drains under the row.
                                if row.code != "": Rectangle {
                                    x: root.gutter;
                                    y: parent.height - 3px;
                                    height: 2px;
                                    width: (parent.width - 2 * root.gutter) * row.left / Math.max(1, row.period);
                                    background: row.left <= 5 ? Theme.seal : Theme.marker;
                                    animate width { duration: 900ms; }
                                }
                                code-touch := TouchArea { clicked => { root.copy-code(index); } }
                            }
                        }
                    }
                }

                if root.place == Place.generator: VerticalLayout {
                    vertical-stretch: 1;
                    TopBar { title: @tr("Generator"); }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: gen.preferred-height;
                        gen := VerticalLayout {
                            padding: root.gutter;
                            padding-top: 4px;
                            spacing: 16px;
                            alignment: start;
                            Rectangle {
                                border-radius: Theme.radius;
                                background: Theme.field;
                                border-width: 1px;
                                border-color: Theme.rule;
                                height: Math.max(88px, made.preferred-height + 32px);
                                made := Text {
                                    x: 16px;
                                    width: parent.width - 32px;
                                    text: root.gen-password;
                                    font-family: Theme.mono-font;
                                    font-size: Theme.title;
                                    color: Theme.ink;
                                    wrap: char-wrap;
                                    vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.rule;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * Math.min(1, root.gen-bits / 128);
                                        border-radius: 2px;
                                        background: root.gen-bits < 50 ? Theme.seal : root.gen-bits < 70 ? Theme.marker : Theme.good;
                                        animate width { duration: Theme.sweep; }
                                    }
                                }
                                Text {
                                    text: root.gen-bits < 50 ? @tr("Weak: {} bits. Make it longer.", root.gen-bits)
                                        : root.gen-bits < 70 ? @tr("Fair: {} bits.", root.gen-bits)
                                        : @tr("Strong: {} bits.", root.gen-bits);
                                    font-size: Theme.small;
                                    color: Theme.graphite;
                                }
                            }
                            Choice {
                                options: [@tr("Characters"), @tr("Words")];
                                selected <=> root.gen-mode;
                                changed => { root.gen-changed(); }
                            }
                            if root.gen-mode == 0: VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    Text { text: @tr("Length"); color: Theme.graphite; font-size: Theme.small; horizontal-stretch: 1; }
                                    Text { text: root.gen-length; color: Theme.ink; font-size: Theme.body; }
                                }
                                Slider {
                                    label: @tr("Length");
                                    minimum: 8;
                                    maximum: 64;
                                    value <=> root.gen-length;
                                    changed => { root.gen-changed(); }
                                }
                                Check { text: @tr("Capital letters"); checked <=> root.gen-upper; toggled => { root.gen-changed(); } }
                                Check { text: @tr("Small letters"); checked <=> root.gen-lower; toggled => { root.gen-changed(); } }
                                Check { text: @tr("Digits"); checked <=> root.gen-digits; toggled => { root.gen-changed(); } }
                                Check { text: @tr("Symbols"); checked <=> root.gen-symbols; toggled => { root.gen-changed(); } }
                            }
                            if root.gen-mode == 1: VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    Text { text: @tr("Words"); color: Theme.graphite; font-size: Theme.small; horizontal-stretch: 1; }
                                    Text { text: root.gen-words; color: Theme.ink; font-size: Theme.body; }
                                }
                                Slider {
                                    label: @tr("Words");
                                    minimum: 3;
                                    maximum: 12;
                                    value <=> root.gen-words;
                                    changed => { root.gen-changed(); }
                                }
                            }
                            if root.error-code != 0: ErrorLine { text: Words.error(root.error-code, root.error-detail); }
                        }
                    }
                    HorizontalLayout {
                        padding: root.gutter;
                        padding-top: 10px;
                        padding-bottom: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            QuietButton {
                                text: @tr("Another");
                                icon: "refresh";
                                outlined: true;
                                clicked => { root.gen-changed(); }
                            }
                        }
                        Button {
                            horizontal-stretch: 1;
                            text: @tr("Copy");
                            enabled: root.gen-password != "";
                            clicked => { root.gen-copy(); }
                        }
                    }
                }

                if root.place == Place.settings: VerticalLayout {
                    vertical-stretch: 1;
                    TopBar { title: @tr("Settings"); }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: prefs.preferred-height;
                        prefs := VerticalLayout {
                            padding: root.gutter;
                            padding-top: 4px;
                            spacing: 6px;
                            alignment: start;
                            Text { text: @tr("Look"); font-size: Theme.small; color: Theme.graphite; }
                            Choice {
                                options: [@tr("Dark"), @tr("Light")];
                                selected: Theme.dark ? 0 : 1;
                                changed(index) => { root.theme-changed(index == 0); }
                            }
                            Rectangle { height: 10px; }
                            Text { text: @tr("Lock by itself after"); font-size: Theme.small; color: Theme.graphite; }
                            Choice {
                                options: [@tr("1 minute"), @tr("5 minutes"), @tr("15 minutes")];
                                selected <=> root.lock-choice;
                                changed(index) => { root.lock-choice-changed(index); }
                            }
                            Rectangle { height: 10px; }
                            Rule { }
                            Fact {
                                label: @tr("This vault");
                                icon: "vault";
                                value: @tr("{} items", root.total);
                            }
                            Fact {
                                label: @tr("Kept in");
                                icon: "folder";
                                value: root.vault-path;
                            }
                            if root.sync-available: VerticalLayout {
                                padding-top: 12px;
                                padding-bottom: 6px;
                                spacing: 8px;
                                Text { text: @tr("Sync"); font-size: Theme.small; color: Theme.graphite; }
                                if root.sync-place == "": VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: @tr("Keep this phone and your computers the same through your vault server. On the computer: Settings, Sync, Add a device. Then paste the line it shows here.");
                                        font-size: Theme.small;
                                        color: Theme.ink;
                                        wrap: word-wrap;
                                    }
                                    LineField {
                                        placeholder: "vaultsync:1?server=…";
                                        mono: true;
                                        text <=> root.sync-invite-typed;
                                        accepted => { root.sync-join(); }
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        QuietButton {
                                            text: root.sync-busy ? @tr("Joining…") : @tr("Join");
                                            outlined: true;
                                            enabled: !root.sync-busy;
                                            clicked => { root.sync-join(); }
                                        }
                                    }
                                }
                                if root.sync-place != "": VerticalLayout {
                                    spacing: 8px;
                                    Fact {
                                        label: @tr("Server");
                                        icon: "globe";
                                        value: root.sync-place;
                                    }
                                    Fact {
                                        label: @tr("Last synced");
                                        icon: "clock";
                                        value: root.sync-state == 2 ? @tr("Syncing…")
                                            : root.sync-state == 3 ? @tr("Failed")
                                            : root.sync-minutes < 0 ? @tr("Not yet")
                                            : root.sync-minutes == 0 ? @tr("Just now")
                                            : @tr("{n} minute ago" | "{n} minutes ago" % root.sync-minutes);
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: 10px;
                                        QuietButton {
                                            text: @tr("Sync now");
                                            outlined: true;
                                            enabled: root.sync-state != 2;
                                            clicked => { root.sync-now(); }
                                        }
                                        QuietButton {
                                            text: @tr("Stop syncing");
                                            clicked => { root.sync-stop(); }
                                        }
                                    }
                                }
                                if root.sync-state == 3 && root.sync-detail != "": ErrorLine {
                                    text: root.sync-detail;
                                }
                            }
                            VerticalLayout {
                                padding-top: 12px;
                                padding-bottom: 6px;
                                spacing: 8px;
                                Text {
                                    text: root.sync-place == "" ? @tr("Changed the vault on the computer? Bring its newest file here, or join your vault server above.") : @tr("A copy from elsewhere (a backup, another computer) can still be brought in by hand.");
                                    font-size: Theme.small;
                                    color: Theme.graphite;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    QuietButton {
                                        text: @tr("Bring a newer copy");
                                        icon: "folder";
                                        outlined: true;
                                        clicked => { root.pick-vault(); }
                                    }
                                }
                                // Only what choosing a file can go wrong with.
                                if root.error-code == 2 || root.error-code == 4 || root.error-code == 9: ErrorLine {
                                    text: Words.error(root.error-code, root.error-detail);
                                }
                            }
                            Fact {
                                label: @tr("App");
                                icon: "shield";
                                value: @tr("Version {}. Free software under the GPL, version 3 or later.", root.app-version);
                            }
                            Rectangle { height: 10px; }
                            Text {
                                text: @tr("Still to come on the phone: fingerprint unlock, filling into other apps, and scanning the invite's QR code.");
                                font-size: Theme.small;
                                color: Theme.graphite;
                                wrap: word-wrap;
                            }
                        }
                    }
                    VerticalLayout {
                        padding: root.gutter;
                        padding-top: 10px;
                        padding-bottom: 12px;
                        Button { text: @tr("Lock now"); clicked => { root.lock-now(); } }
                    }
                }

                Rule { }
                HorizontalLayout {
                    height: 62px;
                    PlaceTab { text: @tr("Vault"); icon: "vault"; variant: 0; active: root.place == Place.items; clicked => { root.place = Place.items; } }
                    PlaceTab { text: @tr("Codes"); icon: "clock"; variant: 1; active: root.place == Place.codes; clicked => { root.place = Place.codes; } }
                    PlaceTab { text: @tr("Generator"); icon: "sparkle"; variant: 2; active: root.place == Place.generator; clicked => { root.place = Place.generator; root.gen-changed(); } }
                    PlaceTab { text: @tr("Settings"); icon: "gear"; variant: 0; active: root.place == Place.settings; clicked => { root.place = Place.settings; } }
                }
            }

            // ---- one item, over the places
            if root.page == Page.item: VerticalLayout {
                TopBar {
                    back: @tr("Vault");
                    action: root.d-check == 0 ? @tr("Edit") : "";
                    action-icon: "pencil";
                    went-back => { root.close-item(); }
                    acted => { root.edit-item(); }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: facts.preferred-height;
                    facts := VerticalLayout {
                        padding-left: root.gutter;
                        padding-right: root.gutter;
                        padding-bottom: 24px;
                        alignment: start;
                        HorizontalLayout {
                            padding-top: 4px;
                            padding-bottom: 14px;
                            spacing: 16px;
                            ItemIcon { size: 56px; initial: root.d-initial; tint: root.d-tint; kind: root.d-kind; }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                Text {
                                    text: root.d-title;
                                    font-size: Theme.title;
                                    color: Theme.ink;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: Theme.radius;
                                    background: star-touch.pressed ? Theme.hover : transparent;
                                    accessible-role: button;
                                    accessible-label: root.d-favorite ? @tr("Remove from favourites") : @tr("Add to favourites");
                                    Path {
                                        width: 24px;
                                        height: 24px;
                                        viewbox-width: 24;
                                        viewbox-height: 24;
                                        commands: Sketch.star;
                                        stroke: root.d-favorite ? Theme.accent-stroke : Theme.graphite;
                                        stroke-width: 1.7px;
                                        fill: root.d-favorite ? Theme.marker.transparentize(0.75) : transparent;
                                    }
                                    star-touch := TouchArea { clicked => { root.toggle-favorite(); } }
                                }
                            }
                        }
                        Rule { }
                        if root.d-username != "": Fact {
                            label: @tr("Username");
                            icon: "user";
                            value: root.d-username;
                            action: @tr("Copy");
                            acted => { root.copy(0); }
                        }
                        if root.d-card != "": Fact {
                            label: @tr("Card");
                            icon: "card";
                            value: root.d-card;
                        }
                        // The item lock: what is behind it shows after its check.
                        if root.d-check != 0: VerticalLayout {
                            padding-top: 16px;
                            padding-bottom: 16px;
                            spacing: 12px;
                            Text {
                                text: root.d-check == 1 ? @tr("The password and codes of this item are locked. Type your master password to see them.")
                                    : root.d-check == 2 ? @tr("The password and codes of this item are locked. Type the item PIN to see them.")
                                    : @tr("The password and codes of this item are locked. Type the item password to see them.");
                                font-size: Theme.body;
                                color: Theme.graphite;
                                wrap: word-wrap;
                            }
                            SecretField {
                                field: 2;
                                label: root.d-check == 1 ? @tr("Master password") : root.d-check == 2 ? @tr("Item PIN") : @tr("Item password");
                                icon: "lock";
                                error: root.error-code == 7;
                                accepted => { root.unlock-item(); }
                            }
                            if root.error-code != 0: ErrorLine { text: Words.error(root.error-code, root.error-detail); }
                            Button {
                                text: @tr("Show the secrets");
                                busy: root.busy;
                                busy-text: @tr("Checking…");
                                clicked => { root.unlock-item(); }
                            }
                        }
                        if root.d-check == 0 && root.d-has-password: Fact {
                            label: @tr("Password");
                            icon: "key";
                            value: root.d-password != "" ? root.d-password : "••••••••••";
                            mono: root.d-password != "";
                            action: @tr("Copy");
                            acted => { root.copy(1); }
                            VerticalLayout {
                                alignment: center;
                                EyeButton { open: root.d-password != ""; clicked => { root.toggle-password(); } }
                            }
                        }
                        if root.d-check == 0 && root.d-has-code: Fact {
                            label: @tr("One-time code, {} s left", root.d-code-left);
                            icon: "clock";
                            value: root.d-code;
                            mono: true;
                            large: true;
                            action: @tr("Copy");
                            acted => { root.copy(2); }
                        }
                        if root.d-website != "": Fact {
                            label: @tr("Website");
                            icon: "globe";
                            value: root.d-website;
                            action: @tr("Copy");
                            acted => { root.copy(3); }
                        }
                        if root.d-notes != "": Fact {
                            label: @tr("Notes");
                            icon: "note";
                            value: root.d-notes;
                        }
                    }
                }
            }

            // ---- the editor, over the places
            if root.page == Page.editor: VerticalLayout {
                TopBar {
                    title: root.ed-new ? @tr("New") : @tr("Edit");
                    back: @tr("Cancel");
                    went-back => { root.cancel-edit(); }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: form.preferred-height;
                    form := VerticalLayout {
                        padding: root.gutter;
                        padding-top: 4px;
                        spacing: 16px;
                        alignment: start;
                        if root.ed-new: Choice {
                            options: [@tr("Login"), @tr("Note")];
                            selected <=> root.ed-kind;
                        }
                        LineField {
                            label: @tr("Name");
                            icon: "tag";
                            required: true;
                            placeholder: root.ed-kind == 0 ? @tr("The site or app") : @tr("What the note is about");
                            text <=> root.ed-title;
                            error: root.error-code == 5;
                        }
                        if root.ed-kind == 0: LineField {
                            label: @tr("Username");
                            icon: "user";
                            text <=> root.ed-username;
                        }
                        if root.ed-kind == 0: VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 6px;
                                SecretField {
                                    horizontal-stretch: 1;
                                    field: 3;
                                    label: @tr("Password");
                                    icon: "key";
                                    revealed: root.ed-password;
                                }
                                VerticalLayout {
                                    alignment: end;
                                    EyeButton { open: root.ed-password != ""; clicked => { root.ed-toggle-password(); } }
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                QuietButton {
                                    text: @tr("Make a strong one");
                                    icon: "sparkle";
                                    outlined: true;
                                    clicked => { root.ed-generate(); }
                                }
                            }
                        }
                        if root.ed-kind == 0: LineField {
                            label: @tr("Website");
                            icon: "globe";
                            placeholder: "example.com";
                            text <=> root.ed-website;
                        }
                        if root.ed-kind == 0: LineField {
                            label: @tr("One-time code key");
                            icon: "clock";
                            hint: @tr("Paste the setup key the site shows for its authenticator app, often under “Can't scan it?”. Leave it empty if the site has none.");
                            mono: true;
                            text <=> root.ed-totp;
                            error: root.error-code == 10;
                        }
                        NotesField {
                            label: @tr("Notes");
                            icon: "note";
                            field-height: root.ed-kind == 0 ? 96px : 220px;
                            text <=> root.ed-notes;
                        }
                        Check { text: @tr("Favourite"); checked <=> root.ed-favorite; }
                        if root.error-code != 0: ErrorLine { text: Words.error(root.error-code, root.error-detail); }
                        if !root.ed-new: HorizontalLayout {
                            alignment: start;
                            QuietButton {
                                text: root.ed-confirm-delete ? @tr("Tap again to delete it for good") : @tr("Delete");
                                icon: "trash";
                                tint: Theme.seal;
                                clicked => { root.delete-item(); }
                            }
                        }
                    }
                }
                VerticalLayout {
                    padding: root.gutter;
                    padding-top: 10px;
                    padding-bottom: 12px;
                    Button { text: @tr("Save"); clicked => { root.save-item(); } }
                }
            }

            if root.notice-code != 0: Toast {
                x: root.gutter;
                width: parent.width - 2 * root.gutter;
                y: parent.height - self.height - 12px - root.bottom-bar;
                text: Words.notice(root.notice-code, root.notice-arg);
            }
        }
    }
}
